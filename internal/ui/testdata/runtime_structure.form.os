Процедура Собрать()
    Группа = ЭтаФорма.Элементы.Добавить("Дополнительно", "ГруппаФормы", ЭтаФорма.Элементы.Корень, 0);
    Группа.Заголовок = "Дополнительные поля";
    Поле = ЭтаФорма.Элементы.Добавить("Черновик", "ПолеВвода", Группа);
    Поле.Имя = "Комментарий";
    Поле.Вид = "ПолеВвода";
    Поле.ПутьКДанным = "Объект.Комментарий";
    Поле.УстановитьДействие("ПриИзменении", "Изменён");
    Поле.ТолькоПросмотр = Истина;
    Поле.Доступность = Ложь;
    Поле.Видимость = Ложь;
    Если ЭтаФорма.Элементы.Найти("КОММЕНТАРИЙ").Имя <> "Комментарий" Тогда
        ВызватьИсключение "индекс не обновлён";
    КонецЕсли;
    Если ЭтаФорма.Элементы.дополнительно.Дочерние.Количество() <> 1 Тогда
        ВызватьИсключение "неверные дочерние";
    КонецЕсли;
    Если Поле.Родитель.Имя <> "Дополнительно" Тогда
        ВызватьИсключение "неверный родитель";
    КонецЕсли;
КонецПроцедуры

Процедура Изменить()
    Поле = ThisForm.Elements.Find("Комментарий");
    ThisForm.Elements.Move(Поле, ThisForm.Elements.Root, 2);
    Поле.Visible = Истина;
    Поле.Enabled = Истина;
    Поле.ReadOnly = Ложь;
    Поле.Title = "Обновлённый комментарий";
    ThisForm.Elements.Remove(ThisForm.Elements.Дополнительно);
    Если ЭтаФорма.Элементы.Найти("Дополнительно") <> Неопределено Тогда
        ВызватьИсключение "удалённый элемент остался в индексе";
    КонецЕсли;
КонецПроцедуры

Процедура Изменён()
КонецПроцедуры

Процедура Повторить()
    ЭтаФорма.Элементы.Комментарий.Заголовок = "Повтор";
КонецПроцедуры
