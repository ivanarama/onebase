Функция Сформировать()
    Макет = ПолучитьМакет("Main");
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ИмяФайла = "КПИ_" + Параметры.Период;
    ТабДок.ОриентацияСтраницы = "Ландшафт";
    ТабДок.ФиксацияСверху = 1;
    ТабДок.ФиксацияСлева = 1;
    ТабДок.ОтображатьСетку = Ложь;
    Шапка = Макет.ПолучитьОбласть("Шапка");
    Шапка.Параметры.Период = Параметры.Период;
    ТабДок.Вывести(Шапка);
    ТабДок.ПовторитьПриПечати(Шапка, Истина);
    ТабДок.НачатьАвтогруппировкуСтрок();
    Всего = 0;
    Для Бригада = 1 По 2 Цикл
        Группа = Макет.ПолучитьОбласть("Группа");
        Группа.Параметры.Название = "Бригада " + Строка(Бригада);
        ТабДок.Вывести(Группа, 1, "Бригада", Истина);
        Для Мастер = 1 По 3 Цикл
            СтрокаМакета = Макет.ПолучитьОбласть("Строка");
            СтрокаМакета.Параметры.Название = "Мастер " + Строка(Мастер);
            СтрокаМакета.Параметры.Значение = 12500.5;
            ТабДок.Вывести(СтрокаМакета, 2, "Мастер", Истина);
            Для Заявка = 1 По 2 Цикл
                Деталь = Макет.ПолучитьОбласть("Строка");
                Деталь.Параметры.Название = "Заявка " + Строка(Заявка);
                Деталь.Параметры.Значение = 12500.5;
                ТабДок.Вывести(Деталь, 3, "Заявка", Истина);
                Всего = Всего + 12500.5;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    ТабДок.ЗакончитьАвтогруппировкуСтрок();
    Итог = ПолучитьМакет("Summary").ПолучитьОбласть("Итог");
    Итог.Параметры.Сумма = Всего;
    ТабДок.Вывести(Итог);
    Возврат ТабДок;
КонецФункции
