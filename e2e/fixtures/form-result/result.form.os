Процедура OnOpen()
    Объект.DisplayNumber = Строка(Параметры.Record.Номер);
КонецПроцедуры

Процедура Next()
    Новая = Документы.Orders.Создать();
    Новая.Номер = "NEXT";
    Новая.Записать();
    ОткрытьФорму(Новая.Ссылка);
    ЗакрытьФормуРезультата();
КонецПроцедуры

Процедура Close()
    ЗакрытьФормуРезультата();
КонецПроцедуры

Процедура BeforeClose(Отказ)
    Если Параметры.Record.Комментарий = "veto" Тогда
        Отказ = Истина;
    КонецЕсли;
КонецПроцедуры
