Процедура FindClick()
    // Следующий «поиск» — по текущему результату: R1 → R2 (счётчик-реквизит
    // не размещён на форме и между событиями не ездит).
    Имя = "R1";
    Для Каждого Стр Из Объект.Results Цикл
        Если Стр.Name = "R1" Тогда
            Имя = "R2";
        КонецЕсли;
    КонецЦикла;
    Объект.Selected = "";
    Объект.Results.Очистить();
    Новая = Объект.Results.Добавить();
    Новая.Name = Имя;
КонецПроцедуры

Процедура RowActivated(Элемент)
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Объект.Selected = ТекущаяСтрока.Name;
КонецПроцедуры
