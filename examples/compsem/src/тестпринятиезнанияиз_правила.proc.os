// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/знание.feature.
// Функция: Принятие знания из поставки
// Сценарий: правила загружаются из позиционных колонок
// Шаг-таблица:
//   Дано поставка правил из двух строк
//   Когда загружено знание версии 1
//   То правило «КУПИТЬ-Глаг» имеет вид «frame»
//   То позиция 1 правила «КУПИТЬ-Глаг» роль «владелец» падеж «Род» предлог «у»
//   То правило «ГДЕ-Нареч» имеет вид «вопрос»

Процедура Выполнить()
    // Дано поставка правил из двух строк
    ПоставкаПравил = "frame" + Символы.Таб + "КУПИТЬ" + Символы.Таб + "Глаг" + Символы.Таб + "КЛ_Владение" + Символы.Таб
        + "у+Сущ.Род:владелец,Сущ.Вин.КЛ_Товар:объект" + Символы.Таб
        + "купить_1.СВ_Объект=#" + Символы.Таб
        + "владелец{Род,у,1};объект{Вин,,2}" + Символы.Таб
        + "" + Символы.Таб + "один" + Символы.ПС
        + "вопрос" + Символы.Таб + "ГДЕ" + Символы.Таб + "Нареч" + Символы.Таб + "КЛ_Локация" + Символы.Таб
        + "Сущ.Пред:локация" + Символы.Таб
        + "локация.СВ_Место=#" + Символы.Таб
        + "локация{Пред,,1}" + Символы.Таб
        + "" + Символы.Таб + "один"
    // Когда загружено знание версии 1
    Попытка
        Знание.ПрименитьПравила(ПоставкаПравил, 1)
        ОтказЗагрузки = ""
    Исключение
        ОтказЗагрузки = "отказ"
    КонецПопытки
    // То правило «КУПИТЬ-Глаг» имеет вид «frame»
    П = Справочники.Правила.НайтиПоКоду("КУПИТЬ-Глаг")
    ВидПравила = ?(ЗначениеЗаполнено(П), ЗначениеРеквизитаОбъекта(П, "Вид"), "")
    Утверждать.Равно(ВидПравила, "frame", "правило «КУПИТЬ-Глаг» имеет вид «frame»")
    // То позиция 1 правила «КУПИТЬ-Глаг» роль «владелец» падеж «Род» предлог «у»
    П = Справочники.Правила.НайтиПоКоду("КУПИТЬ-Глаг")
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Р.Роль, Р.Падеж, Р.Предлог ИЗ РегистрСведений.Позиции_правил КАК Р ГДЕ Р.Правило = &П И Р.Порядок = &Порядок"
    З.УстановитьПараметр("П", П)
    З.УстановитьПараметр("Порядок", ?(ПустаяСтрока(1), 1, Число(1)))
    ПозицияПравила = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        ПозицияПравила = Стр.Роль + "." + Стр.Падеж + "." + Стр.Предлог
    КонецЦикла
    Утверждать.Равно(ПозицияПравила, "владелец" + "." + "Род" + "." + "у", "позиция 1 правила «КУПИТЬ-Глаг» роль «владелец» падеж «Род» предлог «у»")
    // То правило «ГДЕ-Нареч» имеет вид «вопрос»
    П = Справочники.Правила.НайтиПоКоду("ГДЕ-Нареч")
    ВидПравила = ?(ЗначениеЗаполнено(П), ЗначениеРеквизитаОбъекта(П, "Вид"), "")
    Утверждать.Равно(ВидПравила, "вопрос", "правило «ГДЕ-Нареч» имеет вид «вопрос»")
КонецПроцедуры
