// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/роли.feature.
// Функция: Права агентов
// Сценарий: наблюдатель не пишет знание
// Шаг-таблица:
//   Дано подготовлен счётчик проверок ролей
//   То роль «Наблюдатель» не может писать справочник «Классы»
//   То роль «Наблюдатель» может читать справочник «Классы»
//   То роль «Владелец_знания» может писать справочник «Классы»
//   То роль «Разбор_и_мир» не может писать справочник «Классы»
//   То проверено 4 прав ролей

Процедура Выполнить()
    // Дано подготовлен счётчик проверок ролей
    ПроверокРолей = 0
    // То роль «Наблюдатель» не может писать справочник «Классы»
    ПроверокРолей = ПроверокРолей + 1
    Утверждать.РольНеМожет("Наблюдатель", "справочник", "Классы", "write", "роль «" + "Наблюдатель" + "» не может писать справочник «" + "Классы" + "»")
    // То роль «Наблюдатель» может читать справочник «Классы»
    ПроверокРолей = ПроверокРолей + 1
    Утверждать.РольМожет("Наблюдатель", "справочник", "Классы", "read", "роль «" + "Наблюдатель" + "» может читать справочник «" + "Классы" + "»")
    // То роль «Владелец_знания» может писать справочник «Классы»
    ПроверокРолей = ПроверокРолей + 1
    Утверждать.РольМожет("Владелец_знания", "справочник", "Классы", "write", "роль «" + "Владелец_знания" + "» может писать справочник «" + "Классы" + "»")
    // То роль «Разбор_и_мир» не может писать справочник «Классы»
    ПроверокРолей = ПроверокРолей + 1
    Утверждать.РольНеМожет("Разбор_и_мир", "справочник", "Классы", "write", "роль «" + "Разбор_и_мир" + "» не может писать справочник «" + "Классы" + "»")
    // То проверено 4 прав ролей
    // Счётчик обязан совпасть с числом шагов: ассерт, который не вызван,
    // проверку роли не доказывает.
    Утверждать.Равно(ПроверокРолей, 4, "проверено 4 прав ролей")
КонецПроцедуры
