// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/проведение.feature.
// Функция: Проведение текста в ленту
// Сценарий: текст проводится по предложениям
// Шаг-таблица:
//   Дано подготовлен счётчик проверок ролей
//   Дано текст «Кот спит. Дом открыт» с источником «поставка»
//   Когда текст проведён
//   То лента содержит 2 событий
//   То событие 1 ленты имеет значение «Кот спит»
//   То событие 2 ленты имеет источник «поставка»

Процедура Выполнить()
    // Дано подготовлен счётчик проверок ролей
    ПроверокРолей = 0
    // Дано текст «Кот спит. Дом открыт» с источником «поставка»
    Д = Документы.Текст.Создать();
    Д.Номер = "TEXT-1";
    Д.ИсходныйТекст = "Кот спит. Дом открыт";
    Д.Источник = "поставка";
    Д.Статус = "Новая";
    ТекстСсылка = Д.Записать();
    // Когда текст проведён
    ТекстСсылка.ПолучитьОбъект().Провести()
    // То лента содержит 2 событий
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.Лента_событий.СрезПоследних(&Т) КАК Л"
    З.УстановитьПараметр("Т", ТекстСсылка)
    СобытияЛенты = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        СобытияЛенты = Стр.Н
    КонецЦикла
    Утверждать.Равно(СобытияЛенты, 2, "лента содержит 2 событий")
    // То событие 1 ленты имеет значение «Кот спит»
    // Срез последних отдаёт измерения; ресурс строки читается менеджером
    // записи по ключу измерений — срез ресурсов запросом не покрыт (план 222 §4).
    З = РегистрыСведений.Лента_событий.СоздатьМенеджерЗаписи()
    З.Текст = ТекстСсылка
    З.Момент = Число(1)
    З.Экземпляр = "Предложение_" + Число(1)
    З.Свойство = Справочники.Свойства.НайтиПоКоду("—")
    З.Прочитать()
    ЗначениеСобытия = ?(З.Выбран(), З.Значение, "")
    Утверждать.Равно(ЗначениеСобытия, "Кот спит", "событие 1 ленты имеет значение «Кот спит»")
    // То событие 2 ленты имеет источник «поставка»
    З = РегистрыСведений.Лента_событий.СоздатьМенеджерЗаписи()
    З.Текст = ТекстСсылка
    З.Момент = Число(2)
    З.Экземпляр = "Предложение_" + Число(2)
    З.Свойство = Справочники.Свойства.НайтиПоКоду("—")
    З.Прочитать()
    ИсточникСобытия = ?(З.Выбран(), З.Источник, "")
    Утверждать.Равно(ИсточникСобытия, "поставка", "событие 2 ленты имеет источник «поставка»")
КонецПроцедуры
