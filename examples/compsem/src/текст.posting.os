// Проведение текста (ТЗ §4.3, §10): лента событий пишется хуком проведения,
// момент — порядковый номер предложения. Запись идёт модулем, а не флагом
// recorder: регистр сведений, подчинённый регистратору, программной записью
// не принимается (каркасный факт, план 222 §4), поэтому порядок задаёт код
// хука, а аудит проверяет источник и покрытие.
Процедура ОбработкаПроведения()
    // Измерение-ссылка регистра обязано быть заполнено: событие без свойства
    // хранится под служебной строкой справочника (каркасный факт NOT NULL).
    Пусто = Справочники.Свойства.НайтиПоКоду("—");
    Если НЕ ЗначениеЗаполнено(Пусто) Тогда
        Пусто = Справочники.Свойства.Создать();
        Пусто.Код = "—";
        Пусто.Наименование = "свойство не задано";
        Пусто = Пусто.Записать();
    КонецЕсли;
    Момент = 0;
    Для Каждого Предл Из СтрРазделить(this.ИсходныйТекст, ". ") Цикл
        Если ПустаяСтрока(СокрЛП(Предл)) Тогда
            Продолжить;
        КонецЕсли;
        Момент = Момент + 1;
        З = РегистрыСведений.Лента_событий.СоздатьМенеджерЗаписи();
        З.Текст = this.Ссылка;
        З.Момент = Момент;
        З.Экземпляр = "Предложение_" + Формат(Момент, "ЧН=0");
        З.Свойство = Пусто;
        З.Вид = "факт";
        З.Значение = СокрЛП(Предл);
        З.Источник = this.Источник;
        З.Записать();
        С = РегистрыСведений.Состояние.СоздатьМенеджерЗаписи();
        С.Текст = this.Ссылка;
        С.Момент = Момент;
        С.Экземпляр = "Предложение_" + Формат(Момент, "ЧН=0");
        С.Свойство = Пусто;
        С.Значение = СокрЛП(Предл);
        С.Вид = "факт";
        С.Записать();
    КонецЦикла;
    У = РегистрыСведений.Упоминания.СоздатьМенеджерЗаписи();
    У.Текст = this.Ссылка;
    У.Клауза = "предложение_1";
    У.Форма = НРег(СокрЛП(СтрРазделить(this.ИсходныйТекст, " ")[0]));
    У.Экземпляр = "Предложение_1";
    У.Записать();
КонецПроцедуры
