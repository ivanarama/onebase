// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/морфология.feature.
// Функция: Морфология горячего пути
// Сценарий: форма слова даёт класс из леммы
// Шаг-таблица:
//   Дано поставка слов «ЧЕЛОВЕК» с парадигмой «м1»
//   Когда загружен словарь версии 1
//   То форма «человека» даёт класс «КЛ_Человек»
//   То слова «человечек» в словаре нет

Процедура Выполнить()
    // Дано поставка слов «ЧЕЛОВЕК» с парадигмой «м1»
    ПоставкаСлов = "'ЧЕЛОВЕК'" + Символы.Таб + "Сущ" + Символы.Таб + "КЛ_Человек" + Символы.Таб + "'м1'"
    ПоставкаПарадигм = "'м1' Сущ 'ЧЕЛОВЕК' Им.Един='ЧЕЛОВЕК' Род.Един=человека"
    // Когда загружен словарь версии 1
    Знание.ПрименитьСловарь(ПоставкаСлов, ПоставкаПарадигм, 1)
    // То форма «человека» даёт класс «КЛ_Человек»
    З = РегистрыСведений.Формы_лексикона.СоздатьМенеджерЗаписи()
    З.Форма = "человека"
    З.Прочитать()
    КлассФормы = ?(З.Выбран(), ЗначениеРеквизитаОбъекта(З.Класс, "Код"), "")
    Утверждать.Равно(КлассФормы, "КЛ_Человек", "форма «человека» даёт класс «КЛ_Человек»")
    // То слова «человечек» в словаре нет
    З = РегистрыСведений.Формы_лексикона.СоздатьМенеджерЗаписи()
    З.Форма = "человечек"
    З.Прочитать()
    ФормаЕсть = З.Выбран()
    Утверждать.Ложь(ФормаЕсть, "слова «человечек» в словаре нет")
КонецПроцедуры
