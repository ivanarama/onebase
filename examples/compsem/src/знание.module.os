// Загрузка знания поставщика (ТЗ §2.1, §3.1): позиционные TSV-колонки,
// «#» — комментарий, манифест задаёт версию и формат. Горячий путь разбора
// строится словарём точных форм (ТЗ §2.1, приложение §6).
//
//   onebase procrun --project examples/compsem --sqlite compsem.db \
//       --proc ЗагрузитьЗнание --file Файл=rules.txt --set Версия=1
//
// Текст поставляется строкой: путь к файлу читает обработка, модуль работает
// с содержимым и манифестом. Разбор формы слова — словарь точных форм,
// анализ окончания во вторичном контуре (ТЗ §2.1).
Перем ВсегоПравил;
Перем ВсегоНовыхПравил;
Перем ВсегоФорм;
Перем ВсегоЛемм;
Перем ВсегоПозиций;
Перем ВсегоФормПоставки;
Перем ВсегоФормБезЛеммы;

Процедура СбросСчётчиков()
    ВсегоПравил = 0;
    ВсегоНовыхПравил = 0;
    ВсегоФорм = 0;
    ВсегоЛемм = 0;
    ВсегоПозиций = 0;
    ВсегоФормПоставки = 0;
    ВсегоФормБезЛеммы = 0;
КонецПроцедуры

Функция ПрименитьСловарь(ТекстСлов, ТекстПарадигм, Версия) Экспорт
    // words.txt: Лемма, ЧастьРечи, КЛ, метка парадигмы. Сначала слова и классы,
    // затем парадигмы: форма слова привязывается к классу леммы.
    СбросСчётчиков();
    СоздатьСлова(ТекстСлов);
    ЗаполнитьФормы(ТекстПарадигм);
    Возврат ВсегоФорм;
КонецФункции

Функция ПрименитьПравила(Текст, Версия) Экспорт
    // rules.txt, 9 позиционных колонок (приложение §1): вид, ключ, часть речи,
    // класс, позиции, заполнение, печать, профиль, вид ответа. Строка, которую
    // импорт не может свёрстать, — отказ: поставка не принимается вслепую.
    СбросСчётчиков();
    ПрофильПоУмолчанию = СоздатьПрофиль("-");
    Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС) Цикл
        Если ПустаяСтрока(СокрЛП(Стр)) Тогда
            Продолжить;
        КонецЕсли;
        Если Лев(СокрЛП(Стр), 1) = "#" Тогда
            Продолжить;
        КонецЕсли;
        Кол = СтрРазделить(Стр, Символы.Таб);
        Если Кол.Количество() <> 9 Тогда
            ВызватьИсключение "rules.txt: " + Формат(Кол.Количество(), "ЧН=0")
                + " колонки, нужно 9: " + Стр;
        КонецЕсли;
        Код = СокрЛП(Кол[1]) + "-" + СокрЛП(Кол[2]);
        Об = Справочники.Правила.НайтиПоКоду(Код);
        Если ЗначениеЗаполнено(Об) Тогда
            Об = Об.ПолучитьОбъект();
        Иначе
            Об = Справочники.Правила.Создать();
            Об.Код = Код;
            ВсегоНовыхПравил = ВсегоНовыхПравил + 1;
        КонецЕсли;
        Об.Вид = ?(СокрЛП(Кол[0]) = "вопрос", "вопрос", "frame");
        Об.Ключ = СокрЛП(Кол[1]);
        Об.ЧастьРечи = СокрЛП(Кол[2]);
        Об.Класс = СоздатьКласс(СокрЛП(Кол[3]));
        Об.Основа = СокрЛП(Кол[1]);
        Об.Заполнение = СокрЛП(Кол[5]);
        Об.Печать = СокрЛП(Кол[6]);
        Об.ВидОтвет = СокрЛП(Кол[8]);
        Об.Версия = Версия;
        ИмяПрофиля = СокрЛП(Кол[7]);
        Если ПустаяСтрока(ИмяПрофиля) Тогда
            Об.Профиль = ПрофильПоУмолчанию;
        Иначе
            Об.Профиль = СоздатьПрофиль(ИмяПрофиля);
        КонецЕсли;
        Ссылка = Об.Записать();
        ВсегоПравил = ВсегоПравил + 1;
        ЗаполнитьПозиции(Ссылка, СокрЛП(Кол[4]), СокрЛП(Кол[6]));
    КонецЦикла;
    Возврат ВсегоПравил;
КонецФункции

Функция Итог() Экспорт
    Возврат "правил " + Формат(ВсегоПравил, "ЧН=0")
        + ", новых " + Формат(ВсегоНовыхПравил, "ЧН=0")
        + ", позиций " + Формат(ВсегоПозиций, "ЧН=0")
        + ", форм " + Формат(ВсегоФорм, "ЧН=0")
        + " из " + Формат(ВсегоФормПоставки, "ЧН=0")
        + ", без леммы " + Формат(ВсегоФормБезЛеммы, "ЧН=0")
        + ", лемм " + Формат(ВсегоЛемм, "ЧН=0");
КонецФункции

// ── helpers ────────────────────────────────────────────────────────────────

Процедура СоздатьСлова(ТекстСлов)
    Для Каждого Стр Из СтрРазделить(ТекстСлов, Символы.ПС) Цикл
        Если ПустаяСтрока(СокрЛП(Стр)) Тогда
            Продолжить;
        КонецЕсли;
        Если Лев(СокрЛП(Стр), 1) = "#" Тогда
            Продолжить;
        КонецЕсли;
        Кол = СтрРазделить(Стр, Символы.Таб);
        Если Кол.Количество() < 4 Тогда
            ВызватьИсключение "words.txt: колонок меньше 4: " + Стр;
        КонецЕсли;
        Лемма = СокрЛП(Кол[0]);
        Класс = СоздатьКласс(СокрЛП(Кол[2]));
        Метка = СокрЛП(Кол[3]);
        Парадигма = Неопределено;
        Если ЗначениеЗаполнено(Метка) Тогда
            Парадигма = СоздатьПарадигму(Метка);
        КонецЕсли;
        Л = Справочники.Лексикон.НайтиПоКоду(Лемма);
        Если НЕ ЗначениеЗаполнено(Л) Тогда
            Л = Справочники.Лексикон.Создать();
            Л.Код = Лемма;
            Л.Наименование = НРег(Лемма);
            Л.Класс = Класс;
            Л.Парадигма = Парадигма;
            Л.Статус = "не проверено";
            Л.Записать();
            ВсегоЛемм = ВсегоЛемм + 1;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьФормы(Текст)
    // Строка парадигмы: метка, часть речи, лемма, затем Граммема=Форма.
    // Форма слова — точный ключ словаря, по нему горячий путь берёт класс.
    Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС) Цикл
        Если ПустаяСтрока(СокрЛП(Стр)) Тогда
            Продолжить;
        КонецЕсли;
        Если Лев(СокрЛП(Стр), 1) = "#" Тогда
            Продолжить;
        КонецЕсли;
        Токен = СтрРазделить(СокрЛП(Стр), " ");
        Если Токен.Количество() < 3 Тогда
            Продолжить;
        КонецЕсли;
        Метка = СокрЛП(Токен[0]);
        Лемма = СокрЛП(Токен[2]);
        Л = Справочники.Лексикон.НайтиПоКоду(Лемма);
        Если НЕ ЗначениеЗаполнено(Л) Тогда
            // Форма слова, которого нет в поставке лемм, горячим путём не
            // берётся: словарь точных форм покрывает только проверенные леммы.
            ВсегоФормБезЛеммы = ВсегоФормБезЛеммы + (Токен.Количество() - 3);
            Продолжить;
        КонецЕсли;
        Парадигма = СоздатьПарадигму(Метка);
        Н = 3;
        Пока Н < Токен.Количество() Цикл
            Части = СтрРазделить(Токен[Н], "=");
            Если Части.Количество() = 2 Тогда
                ВсегоФормПоставки = ВсегоФормПоставки + 1
                ЗаписатьФорму(НРег(СокрЛП(Части[1])), ЗначениеРеквизитаОбъекта(Л, "Класс"), Парадигма, СокрЛП(Части[0]));
            КонецЕсли;
            Н = Н + 1;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Функция СоздатьКласс(Код)
    С = Справочники.Классы.НайтиПоКоду(Код);
    Если ЗначениеЗаполнено(С) Тогда
        Возврат С;
    КонецЕсли;
    С = Справочники.Классы.Создать();
    С.Код = Код;
    С.Наименование = Код;
    Возврат С.Записать();
КонецФункции

Функция СоздатьПарадигму(Метка)
    П = Справочники.Парадигмы.НайтиПоКоду(Метка);
    Если ЗначениеЗаполнено(П) Тогда
        Возврат П;
    КонецЕсли;
    П = Справочники.Парадигмы.Создать();
    П.Код = Метка;
    П.Наименование = Метка;
    П.Метка = Метка;
    Возврат П.Записать();
КонецФункции

Функция СоздатьПрофиль(Имя)
    П = Справочники.Профили_вывода.НайтиПоКоду(Имя);
    Если ЗначениеЗаполнено(П) Тогда
        Возврат П;
    КонецЕсли;
    П = Справочники.Профили_вывода.Создать();
    П.Код = Имя;
    П.Наименование = Имя;
    Возврат П.Записать();
КонецФункции

Процедура ЗаписатьФорму(Форма, Класс, Парадигма, Метка)
    З = РегистрыСведений.Формы_лексикона.СоздатьМенеджерЗаписи();
    З.Прочитать();
    Если З.Выбран() Тогда
        Возврат;
    КонецЕсли;
    З.Форма = Форма;
    З.Класс = Класс;
    З.Парадигма = Парадигма;
    З.Метка = Метка;
    З.Записать();
    ВсегоФорм = ВсегоФорм + 1;
КонецПроцедуры

Процедура ЗаполнитьПозиции(Правило, Позиции, Печать)
    // col5 задаёт требуемый класс и роль, col7 — падеж, предлог и порядок
    // печати. Позиция без порядка печати идёт регистром отдельной строкой:
    // требования правила и печатная сборка ответа разделены.
    Печ = СтрРазделить(Печать, ";");
    Н = 0;
    Для Каждого Эл Из Печ Цикл
        Если ПустаяСтрока(СокрЛП(Эл)) Тогда
            Продолжить;
        КонецЕсли;
        Роль = СокрЛП(СтрРазделить(Эл, "{")[0]);
        Внутрь = СтрЗаменить(Эл, Роль + "{", "");
        Внутрь = СтрЗаменить(Внутрь, "}", "");
        Кол = СтрРазделить(Внутрь, ",");
        Н = Н + 1;
        ЗаписатьПозицию(Правило, Н, Роль, СокрЛП(Кол[0]), СокрЛП(Кол[1]), "", Неопределено);
    КонецЦикла;
    Для Каждого Эл Из СтрРазделить(Позиции, ",") Цикл
        Если ПустаяСтрока(СокрЛП(Эл)) Тогда
            Продолжить;
        КонецЕсли;
        Части = СтрРазделить(Эл, ":");
        Роль = СокрЛП(Части[Части.Количество() - 1]);
        Лев = СокрЛП(Части[0]);
        Предлог = "";
        Если СтрСодержит(Лев, "+") Тогда
            Раз = СтрРазделить(Лев, "+");
            Предлог = СокрЛП(Раз[0]);
            Лев = СокрЛП(Раз[1]);
        КонецЕсли;
        Токен = СтрРазделить(Лев, ".");
        ЧастьРечи = СокрЛП(Токен[0]);
        Класс_требуемый = Неопределено;
        Для Каждого Т Из Токен Цикл
            Если СтрСодержит(Т, "КЛ_") Тогда
                Класс_требуемый = СоздатьКласс(СокрЛП(Т));
            КонецЕсли;
        КонецЦикла;
        ЗаписатьПозицию(Правило, 0, Роль, "", Предлог, ЧастьРечи, Класс_требуемый);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьПозицию(Правило, Порядок, Роль, Падеж, Предлог, ЧастьРечи, Класс)
    З = РегистрыСведений.Позиции_правил.СоздатьМенеджерЗаписи();
    З.Правило = Правило;
    З.Порядок = Порядок;
    З.Роль = Роль;
    З.Падеж = Падеж;
    З.Предлог = Предлог;
    З.ЧастьРечи = ЧастьРечи;
    З.Класс_требуемый = Класс;
    З.Записать();
    ВсегоПозиций = ВсегоПозиций + 1;
КонецПроцедуры
