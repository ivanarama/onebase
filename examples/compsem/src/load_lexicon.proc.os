// Обработка загрузки лексикона: оба файла приходят содержимым. Парадигма без
// леммы форму не даёт, лемма без парадигмы остаётся служебным словом.
Процедура Выполнить(Слова, Парадигмы, Версия)
    Если НЕ ЗначениеЗаполнено(Слова) Тогда
        ВызватьИсключение "нужен файл лемм (words.txt)";
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Парадигмы) Тогда
        ВызватьИсключение "нужен файл парадигм (paradigms.txt)";
    КонецЕсли;
    Форм = Знание.ПрименитьСловарь(Слова, Парадигмы, Версия);
    Сообщить("загружено форм " + Формат(Форм, "ЧН=0"));
    Сообщить(Знание.Итог());
КонецПроцедуры
