// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/знание.feature.
// Функция: Принятие знания из поставки
// Сценарий: строка без колонок не становится правилом
// Шаг-таблица:
//   Дано поставка правила без колонок
//   Когда загружено знание версии 1
//   То загрузка знания отвергнута

Процедура Выполнить()
    // Дано поставка правила без колонок
    ПоставкаПравил = "# комментарий" + Символы.ПС + "КУПИТЬ Глаг КЛ_Владение"
    // Когда загружено знание версии 1
    Попытка
        Знание.ПрименитьПравила(ПоставкаПравил, 1)
        ОтказЗагрузки = ""
    Исключение
        ОтказЗагрузки = "отказ"
    КонецПопытки
    // То загрузка знания отвергнута
    // Отказ обязан остаться признаком отказа, а не текстом ошибки:
    // загрузка, которая не отвергла кривую строку, тест не проходит.
    ОтказЗагрузки = ОтказЗагрузки = "отказ"
    Утверждать.Истина(ОтказЗагрузки, "загрузка знания отвергнута")
КонецПроцедуры
