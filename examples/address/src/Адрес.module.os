// Прикладное представление: схема и подписи принадлежат конфигурации.
Функция Представление(Объект) Экспорт
    Текст = "";
    Текст = ДобавитьЧасть(Текст, "г. ", Объект.Город);
    Текст = ДобавитьЧасть(Текст, "ул. ", Объект.Улица);
    Текст = ДобавитьЧасть(Текст, "д. ", Объект.Дом);
    Текст = ДобавитьЧасть(Текст, "корп. ", Объект.Корпус);
    Текст = ДобавитьЧасть(Текст, "кв. ", Объект.Квартира);
    Текст = ДобавитьЧасть(Текст, "подъезд ", Объект.Подъезд);
    Текст = ДобавитьЧасть(Текст, "этаж ", Объект.Этаж);
    Текст = ДобавитьЧасть(Текст, "домофон ", Объект.Домофон);
    Если Текст = "" Тогда
        // Старую строку не разбираем и не заменяем догадками.
        Если Объект.ИсходныйАдрес <> Неопределено Тогда
            Возврат Объект.ИсходныйАдрес;
        КонецЕсли;
    КонецЕсли;
    Возврат Текст;
КонецФункции

Функция ДобавитьЧасть(Текст, Подпись, Значение)
    Если Значение = Неопределено Тогда
        Возврат Текст;
    КонецЕсли;
    Часть = СокрЛП(Строка(Значение));
    Если Часть = "" Тогда
        Возврат Текст;
    КонецЕсли;
    Если Текст <> "" Тогда
        Текст = Текст + ", ";
    КонецЕсли;
    Возврат Текст + Подпись + Часть;
КонецФункции

Функция ДанныеДляОбмена(Объект) Экспорт
    Данные = Новый Соответствие;
    // Явная схема обмена: не сериализуем служебные поля объекта.
    Данные.Вставить("Город", СтроковоеЗначение(Объект.Город));
    Данные.Вставить("Улица", СтроковоеЗначение(Объект.Улица));
    Данные.Вставить("Дом", СтроковоеЗначение(Объект.Дом));
    Данные.Вставить("Корпус", СтроковоеЗначение(Объект.Корпус));
    Данные.Вставить("Квартира", СтроковоеЗначение(Объект.Квартира));
    Данные.Вставить("Подъезд", СтроковоеЗначение(Объект.Подъезд));
    Данные.Вставить("Этаж", СтроковоеЗначение(Объект.Этаж));
    Данные.Вставить("Домофон", СтроковоеЗначение(Объект.Домофон));
    Данные.Вставить("ИсходныйАдрес", СтроковоеЗначение(Объект.ИсходныйАдрес));
    Данные.Вставить("АдресПредставление", Представление(Объект));
    Возврат Данные;
КонецФункции

Функция СтроковоеЗначение(Значение)
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Значение);
КонецФункции
