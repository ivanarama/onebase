Процедура Выполнить()
    Ссылка = Документы.Наряд.НайтиПоНомеру(this.Номер);
    Если Ссылка = Неопределено Тогда
        ВызватьИсключение("Наряд не найден: " + this.Номер);
    КонецЕсли;
    Объект = Ссылка.ПолучитьОбъект();
    Сообщить(ЗаписатьJSON(Адрес.ДанныеДляОбмена(Объект)));
КонецПроцедуры
