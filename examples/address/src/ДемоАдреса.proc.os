Процедура Выполнить()
    Наряд = Документы.Наряд.Создать();
    Наряд.Город = "Белград";
    Наряд.Улица = "Примерная";
    Наряд.Дом = "12А";
    Наряд.Корпус = "2";
    Наряд.Квартира = "07";
    Наряд.Подъезд = "3";
    Наряд.Этаж = "0";
    Наряд.Домофон = "07#";
    Наряд.Записать();
    Сообщить("Создан наряд " + Наряд.Номер);
    Сообщить(Наряд.АдресПредставление);
КонецПроцедуры
