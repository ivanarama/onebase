// Самостоятельный публичный пример управляемой формы магазина.
Процедура ПриОткрытии()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Статус) Тогда
        Объект.Статус = Перечисления.СтатусЗаказа.Новый;
    КонецЕсли;
    ОбновитьИсторию();
КонецПроцедуры

Процедура ПокупательИзменён()
    Объект.АдресДоставки = Неопределено;
    Объект.Телефон = "";
    Если ЗначениеЗаполнено(Объект.Покупатель) Тогда
        Покупатель = Объект.Покупатель.ПолучитьОбъект();
        Объект.Телефон = Покупатель.Телефон;
    КонецЕсли;
    ОбновитьИсторию();
КонецПроцедуры

Процедура ГородИзменён()
    Объект.ПунктВыдачи = Неопределено;
КонецПроцедуры

Процедура СпособИзменён()
    Если Строка(Объект.СпособПолучения) = "Доставка" Тогда
        Объект.ПунктВыдачи = Неопределено;
        Объект.Город = Неопределено;
    Иначе
        Объект.АдресДоставки = Неопределено;
    КонецЕсли;
КонецПроцедуры

Процедура ОбновитьИсторию()
    Объект.История.Очистить();
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        Возврат;
    КонецЕсли;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Номер, Дата, Сумма, Валюта, Статус"
        + " ИЗ Документ.ЗаказПокупателя ГДЕ Покупатель = &Покупатель"
        + " УПОРЯДОЧИТЬ ПО Дата УБЫВ";
    З.УстановитьПараметр("Покупатель", Объект.Покупатель);
    Для Каждого Заказ Из З.Выполнить() Цикл
        Если Строка(Заказ.Ссылка) <> Строка(Объект.Ссылка) Тогда
            Стр = Объект.История.Добавить();
            Стр.Номер = Заказ.Номер;
            Стр.Дата = Формат(Заказ.Дата, "ДФ=dd.MM.yyyy HH:mm");
            Стр.Сумма = Заказ.Сумма;
            Стр.Валюта = Заказ.Валюта;
            Стр.Статус = Заказ.Статус;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Пересчитать()
    РаботаСЗаказами.Пересчитать(Объект);
КонецПроцедуры

Процедура ПередЗаписью()
    Если Строка(Объект.Статус) = "Новый" Тогда
        РаботаСЗаказами.Пересчитать(Объект);
    КонецЕсли;
    РаботаСЗаказами.ПроверитьПолучение(Объект);
КонецПроцедуры

Процедура ПринятьЗаказ()
    Если Строка(Объект.Статус) <> "Новый" Тогда
        ВызватьИсключение "Подтвердить можно только новый заказ";
    КонецЕсли;
    РаботаСЗаказами.ПроверитьПодтверждение(Объект);
    Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
        Объект.Ответственный = ТекущийПользователь().Ссылка;
    КонецЕсли;
    Объект.Статус = Перечисления.СтатусЗаказа.ВРаботе;
    Объект.Записать();
    Сообщить("Заказ подтверждён");
КонецПроцедуры

Процедура ЗавершитьЗаказ()
    Если Строка(Объект.Статус) <> "ВРаботе" Тогда
        ВызватьИсключение "Сначала подтвердите заказ";
    КонецЕсли;
    Объект.Статус = Перечисления.СтатусЗаказа.Выполнен;
    Объект.Записать();
    Сообщить("Заказ выполнен");
КонецПроцедуры

Процедура СпроситьОтмену()
    ПоказатьВопрос("Отменить этот заказ?", "ДаНет", "Подтверждение отмены");
КонецПроцедуры

Процедура ОтветНаОтмену()
    Если ВопросОтвет <> "Да" Тогда
        Возврат;
    КонецЕсли;
    Если Строка(Объект.Статус) = "Выполнен" ИЛИ Строка(Объект.Статус) = "Отменён" Тогда
        ВызватьИсключение "Обработка заказа уже завершена";
    КонецЕсли;
    Объект.Статус = Перечисления.СтатусЗаказа.Отменён;
    Объект.Записать();
    Сообщить("Заказ отменён");
КонецПроцедуры

Процедура ПодобратьТовары()
    Если НЕ ЗначениеЗаполнено(Объект.Сайт) Тогда
        ВызватьИсключение "Выберите сайт";
    КонецЕсли;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка КАК Идентификатор, Наименование, Артикул, Цена, Валюта"
        + " ИЗ Справочник.Товары ГДЕ Сайт = &Сайт И СтатусПубликации = &Статус"
        + " УПОРЯДОЧИТЬ ПО Наименование";
    З.УстановитьПараметр("Сайт", Объект.Сайт);
    З.УстановитьПараметр("Статус", Перечисления.СтатусПубликации.Опубликовано);
    Данные = Новый Массив;
    Для Каждого Товар Из З.Выполнить() Цикл
        Данные.Добавить(Новый Структура("Идентификатор,Наименование,Артикул,Цена,Валюта,Количество",
            Строка(Товар.Идентификатор), Товар.Наименование, Товар.Артикул, Товар.Цена, Товар.Валюта, 0));
    КонецЦикла;
    Колонки = Новый Массив;
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип", "Наименование", "Товар", "string"));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип", "Цена", "Цена", "number"));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Количество", "Количество", "number", Истина));
    Конфиг = Новый Структура("Заголовок,ПолеПоиска,ПолеКоличества", "Добавить товары к заказу", "Наименование", "Количество");
    ПоказатьПодбор(Данные, Колонки, Конфиг);
КонецПроцедуры

Процедура ТоварыВыбраны()
    Если Строка(Объект.Статус) <> "Новый" Тогда
        ВызватьИсключение "Состав подтверждённого заказа менять нельзя";
    КонецЕсли;
    Для Каждого Выбор Из ПодборРезультат Цикл
        Количество = Число(Выбор.Количество);
        Если Количество > 0 Тогда
            // Клиент диалога передаёт ID и количество. Название, валюту и цену
            // берём из базы, а не доверяем полям возвращённой строки.
            Товар = Справочники.Товары.НайтиПоИдентификатору(Выбор.id).ПолучитьОбъект();
            Если Товар.Сайт <> Объект.Сайт ИЛИ Строка(Товар.СтатусПубликации) <> "Опубликовано" Тогда
                ВызватьИсключение "Товар недоступен на этом сайте";
            КонецЕсли;
            Если ЗначениеЗаполнено(Объект.Валюта) И Объект.Валюта <> Товар.Валюта Тогда
                ВызватьИсключение "В заказе нельзя смешивать валюты";
            КонецЕсли;
            Объект.Валюта = Товар.Валюта;
            Стр = Объект.Товары.Добавить();
            Стр.Товар = Товар.Ссылка;
            Стр.Наименование = Товар.Наименование;
            Стр.Артикул = Товар.Артикул;
            Стр.Цена = Товар.Цена;
            Стр.Количество = Количество;
        КонецЕсли;
    КонецЦикла;
    Пересчитать();
КонецПроцедуры
