// Публичный сайт: единственная точка входа для посетителя (план 129, слайс C3).
//
// Обработчик тонкий: разбор адреса и подбор контента живут в Роутер.module.os,
// сборка HTML — в Рендер.module.os. Так рендер можно проверить обработкой,
// не поднимая сервер.
//
// Проверить вручную:
//   onebase run --project examples/cms --sqlite cms.db --port 8080
//   curl -i http://localhost:8080/hs/site/            → главная
//   curl -i http://localhost:8080/hs/site/about       → страница по слагу
//   curl -i http://localhost:8080/hs/site/нет-такой   → 404 со страницей ошибки

Функция Роутер(Запрос) Экспорт
    Путь = Запрос.ПараметрыURL.Получить("путь");
    Возврат Роутер.Обработать(Путь, Запрос);
КонецФункции

Функция Роботс(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.УстановитьЗаголовок("Content-Type", "text/plain; charset=utf-8");
    Если Сайт = Неопределено Тогда
        Ответ.УстановитьТелоИзСтроки("User-agent: *" + Символы.ПС + "Disallow:");
    Иначе
        Текст = ЗначениеРеквизитаОбъекта(Сайт, "РоботсTxt");
        Если ПустаяСтрока(Текст) Тогда
            Текст = "User-agent: *" + Символы.ПС + "Disallow:";
        КонецЕсли;
        Ответ.УстановитьТелоИзСтроки(Текст);
    КонецЕсли;
    Возврат Ответ;
КонецФункции
