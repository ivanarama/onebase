// Публичный сайт: единственная точка входа для посетителя (план 129, слайс C3).
//
// Обработчик тонкий: разбор адреса и подбор контента живут в Роутер.module.os,
// сборка HTML — в Рендер.module.os. Так рендер можно проверить обработкой,
// не поднимая сервер.
//
// Проверить вручную:
//   onebase run --project examples/cms --sqlite cms.db --port 8080
//   curl -i http://localhost:8080/hs/site/            → главная
//   curl -i http://localhost:8080/hs/site/about       → страница по слагу
//   curl -i http://localhost:8080/hs/site/нет-такой   → 404 со страницей ошибки

Функция Роутер(Запрос) Экспорт
    Путь = Запрос.ПараметрыURL.Получить("путь");
    Возврат Роутер.Обработать(Путь, Запрос);
КонецФункции

// Стили отдаются отдельным файлом, а не блоком <style> в макете: так CSS
// кэшируется браузером, страница остаётся под строгим style-src 'self', и
// html/template не участвует в CSS-контексте.
Функция Стили(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.УстановитьЗаголовок("Content-Type", "text/css; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Рендер.СтильСайта(Сайт));
    Возврат Ответ;
КонецФункции

Функция КартаСайта(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.УстановитьЗаголовок("Content-Type", "application/xml; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(SEO.Sitemap(Сайт));
    Возврат Ответ;
КонецФункции

// Поиск по сайту опирается на полнотекстовый индекс платформы (план 82):
// состав задан блоком fulltext: в метаданных Страниц и Новостей.
//
// Права поиска — права ВЫЗЫВАЮЩЕГО, а сервис анонимный, поэтому в выдачу
// попадает только то, что доступно без авторизации. Проверку публикации
// роутер всё равно делает повторно: индекс знает о существовании черновика,
// но показывать его посетителю нельзя.
Функция Поиск(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Строка_ = СокрЛП(Строка(Запрос.ПараметрЗапроса("q")));
    Возврат Рендер.СтраницаПоиска(Сайт, Строка_, Роутер.НайтиПоТексту(Сайт, Строка_));
КонецФункции

Функция Роботс(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.УстановитьЗаголовок("Content-Type", "text/plain; charset=utf-8");
    Если Сайт = Неопределено Тогда
        Ответ.УстановитьТелоИзСтроки("User-agent: *" + Символы.ПС + "Disallow:");
    Иначе
        Текст = Сайт.РоботсTxt;
        Если ПустаяСтрока(Текст) Тогда
            Текст = "User-agent: *" + Символы.ПС + "Disallow:";
        КонецЕсли;
        Ответ.УстановитьТелоИзСтроки(Текст);
    КонецЕсли;
    Возврат Ответ;
КонецФункции
