// Запись через публичные менеджеры объектов проверяет и серверные хуки.
Процедура Выполнить()
    Анна = Справочники.Покупатели.Создать();
    Анна.Наименование = "Тест — первый покупатель";
    Покупатель = Анна.Записать();
    Павел = Справочники.Покупатели.Создать();
    Павел.Наименование = "Тест — второй покупатель";
    ДругойПокупатель = Павел.Записать();
    Адрес = Справочники.АдресаДоставки.Создать();
    Адрес.Наименование = "Адрес первого";
    Адрес.Владелец = Покупатель;
    СсылкаАдреса = Адрес.Записать();
    Город = Справочники.Города.Создать();
    Город.Наименование = "Тест — первый город";
    СсылкаГорода = Город.Записать();
    ДругойГород = Справочники.Города.Создать();
    ДругойГород.Наименование = "Тест — второй город";
    СсылкаДругогоГорода = ДругойГород.Записать();
    Пункт = Справочники.ПунктыВыдачи.Создать();
    Пункт.Наименование = "Тестовый пункт";
    Пункт.Владелец = СсылкаГорода;
    СсылкаПункта = Пункт.Записать();

    Заказ = Документы.ЗаказПокупателя.Создать();
    Заказ.Дата = ТекущаяДатаВремя();
    Заказ.Статус = Перечисления.СтатусЗаказа.Новый;
    Заказ.Покупатель = ДругойПокупатель;
    Заказ.АдресДоставки = СсылкаАдреса;
    ОшибкаЗаписи(Заказ, "Адрес принадлежит другому покупателю", "Подмена покупателя отклоняется вне формы");
    Заказ.Покупатель = Покупатель;
    Заказ.СпособПолучения = Перечисления.СпособПолучения.Доставка;
    Заказ.Записать();
    Утверждать.Заполнено(Заказ.Ссылка, "Адрес своего покупателя записывается");

    Заказ.АдресДоставки = Неопределено;
    Заказ.СпособПолучения = Перечисления.СпособПолучения.Самовывоз;
    Заказ.Город = СсылкаДругогоГорода;
    Заказ.ПунктВыдачи = СсылкаПункта;
    ОшибкаЗаписи(Заказ, "Пункт выдачи находится в другом городе", "Чужой город отклоняется вне формы");
    Заказ.Город = СсылкаГорода;
    Заказ.Статус = Перечисления.СтатусЗаказа.ВРаботе;
    ОшибкаЗаписи(Заказ, "Добавьте товары", "Пустой заказ нельзя подтвердить через менеджер");
    Заказ.Статус = Перечисления.СтатусЗаказа.Новый;
    Стр = Заказ.Товары.Добавить();
    Стр.Наименование = "Название при покупке";
    Стр.Цена = 790;
    Стр.Количество = 2;
    Заказ.Валюта = "RUB";
    РаботаСЗаказами.Пересчитать(Заказ);
    Заказ.Записать();
    Утверждать.Равно(Заказ.Сумма, 1580, "Сумма рассчитана по строкам");
    Заказ.Статус = Перечисления.СтатусЗаказа.ВРаботе;
    Заказ.Записать();
    Заказ.Статус = Перечисления.СтатусЗаказа.Выполнен;
    Заказ.Записать();
    Прочитанный = Заказ.Ссылка.ПолучитьОбъект();
    Утверждать.Равно(Строка(Прочитанный.Статус), "Выполнен", "Рабочий маршрут доходит до выполнения");
    Утверждать.Равно(Прочитанный.Сумма, 1580, "Смена статуса сохраняет сумму");
    Заказ.Статус = Перечисления.СтатусЗаказа.Новый;
    Попытка
        Заказ.Записать();
        Утверждать.Провалить("Завершённый заказ нельзя вернуть в Новый");
    Исключение
        Утверждать.Истина(Истина, "Строгий маршрут отклоняет возврат завершённого заказа");
    КонецПопытки;
    Утверждать.РольМожет("МенеджерЗаказов", "документ", "ЗаказПокупателя", "write", "Менеджер обрабатывает заказы");
    Утверждать.РольНеМожет("МенеджерЗаказов", "справочник", "Товары", "write", "Менеджер не меняет каталог товаров");
    Утверждать.РольНеМожет("МенеджерЗаказов", "справочник", "ШаблоныСайта", "write", "Менеджер не меняет оформление сайта");
    Утверждать.РольНеМожет("МенеджерЗаказов", "обработка", "ПодготовитьДемоЗаказов", "run", "Менеджер не запускает заполнение базы");
КонецПроцедуры

Процедура ОшибкаЗаписи(Заказ, Ожидание, Описание)
    Текст = "";
    Попытка
        Заказ.Записать();
    Исключение
        Текст = ОписаниеОшибки();
    КонецПопытки;
    Утверждать.Истина(СтрНайти(Текст, Ожидание) > 0, Описание + ": " + Текст);
КонецПроцедуры
