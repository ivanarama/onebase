// HTTP-приём заявок с сайта (план 129, слайс C8).
//
// Обработчик тонкий: разбор и валидация — в Формы.module.os, чтобы их можно
// было проверить обработкой без поднятого сервера.
//
// Ответ отдаётся HTML-страницей, а не JSON: форма отправляется обычным
// <form method="post">, без JavaScript. Сайт должен работать и с отключёнными
// скриптами — это не идеология, а нижняя граница доступности.
Функция Отправить(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Код = Запрос.ПараметрыURL.Получить("код");
    Форма = Формы.НайтиФорму(Код);
    Если Форма = Неопределено Тогда
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Форма не найдена", "Проверьте адрес формы.");
    КонецЕсли;

    Данные = Запрос.ФормаДанные();
    Результат = Формы.Принять(Форма, Данные);
    Заголовок = "Заявка принята";
    Если Результат.Код <> 200 Тогда
        Заголовок = "Заявку не удалось отправить";
    КонецЕсли;
    Возврат Рендер.СтраницаСообщение(Сайт, Результат.Код, Заголовок, Результат.Сообщение);
КонецФункции
