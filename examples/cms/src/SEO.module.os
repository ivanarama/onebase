// SEO: канонические адреса и карта сайта (план 129, слайс C5).
//
// Канонический адрес нужен, чтобы одна и та же страница, доступная по
// нескольким адресам (с параметрами, из меню, из письма), не делила вес в
// поиске между дублями.
//
// sitemap.xml собирается на лету и кэшируется тем же кэшем ответов, что и
// страницы (план 126): регламентное задание для этого не нужно, пока сайт
// умещается в тысячи адресов.

// БазовыйАдрес — «https://домен» сайта. Пустой домен гасит canonical целиком
// (Канонический() возвращает пустую строку, и {{if}} не рисует тег): лучше без
// canonical, чем canonical на выдуманный домен.
Функция БазовыйАдрес(Сайт) Экспорт
    Если Сайт = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    // «<nil>» проверяется наравне с пустотой: незаполненный или отсутствующий
    // реквизит приходит именно такой строкой, она непустая — и canonical
    // уезжал на «https://<nil>/». Симметрично проверке в Префикс() ниже.
    Домен = СокрЛП(Строка(Сайт.Домен));
    Если ПустаяСтрока(Домен) ИЛИ Домен = "<nil>" Тогда
        Возврат "";
    КонецЕсли;
    Если Лев(НРег(Домен), 4) = "http" Тогда
        Возврат Домен;
    КонецЕсли;
    Возврат "https://" + Домен;
КонецФункции

// Префикс — часть пути, под которой сайт виден СНАРУЖИ (реквизит сайта).
// Пусто = сайт отдаётся в корне домена: так и работает рекомендованная схема с
// reverse proxy «/ → /hs/site/». Значение нормализуется здесь, чтобы «hs/site»,
// «/hs/site» и «/hs/site/» давали один и тот же адрес.
Функция Префикс(Сайт) Экспорт
    Если Сайт = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Значение = СокрЛП(Строка(Сайт.ПрефиксПути));
    Если ПустаяСтрока(Значение) ИЛИ Значение = "<nil>" ИЛИ Значение = "/" Тогда
        Возврат "";
    КонецЕсли;
    Если Лев(Значение, 1) <> "/" Тогда
        Значение = "/" + Значение;
    КонецЕсли;
    Пока Прав(Значение, 1) = "/" Цикл
        Значение = Лев(Значение, СтрДлина(Значение) - 1);
    КонецЦикла;
    Возврат Значение;
КонецФункции

// ПрефиксСервиса — адрес СОСЕДНЕГО сервиса (форм) при том же расположении
// сайта. Форма живёт в другом сервисе платформы, чем страницы, поэтому её
// префикс нельзя брать у сайта: при «/hs/site» формы лежат в «/hs/forms».
//
// Пустой префикс сайта означает reverse proxy, отдающий сайт в корне домена;
// для форм в этом случае возвращается платформенный адрес «/hs/<имя>» — прокси
// обязан пропускать и его, иначе отправка формы уедет в 404. Про это сказано в
// README рядом с рецептом прокси.
Функция ПрефиксСервиса(Сайт, Имя) Экспорт
    П = Префикс(Сайт);
    Если ПустаяСтрока(П) Тогда
        Возврат "/hs/" + Имя;
    КонецЕсли;
    Позиция = 0;
    Для Сч = 1 По СтрДлина(П) Цикл
        Если Сред(П, Сч, 1) = "/" Тогда
            Позиция = Сч;
        КонецЕсли;
    КонецЦикла;
    Если Позиция = 0 Тогда
        Возврат "/" + Имя;
    КонецЕсли;
    Возврат Лев(П, Позиция) + Имя;
КонецФункции

Функция Канонический(Сайт, Путь) Экспорт
    База = БазовыйАдрес(Сайт);
    Если ПустаяСтрока(База) Тогда
        Возврат "";
    КонецЕсли;
    Возврат База + Префикс(Сайт) + "/" + СокрЛП(Строка(Путь));
КонецФункции

// Sitemap возвращает XML со всеми опубликованными адресами.
//
// XML собирается строкой с ЯВНЫМ экранированием, а не объектом ШаблонHTML:
// html/template экранирует XML-декларацию как текст («&lt;?xml»), и документ
// перестаёт быть XML. Проверено на живом ответе — поисковик такой файл
// отвергнет молча, поэтому правило простое: ШаблонHTML только для HTML.
Функция Sitemap(Сайт) Экспорт
    Адреса = Новый Массив;
    Если Сайт = Неопределено Тогда
        Возврат ПустойSitemap();
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Сайт.Ссылка) Тогда
        Возврат ПустойSitemap();
    КонецЕсли;

    База = БазовыйАдрес(Сайт);
    ПрефиксСайта = Префикс(Сайт);

    Добавить(Адреса, База, ПрефиксСайта, "", Неопределено);

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Слаг, СтатусПубликации, ДатаПубликации
    |ИЗ Справочник.Страницы
    |ГДЕ Сайт = &Сайт";
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Роутер.Опубликовано(Стр) И Не ПустаяСтрока(Строка(Стр.Слаг)) Тогда
            Добавить(Адреса, База, ПрефиксСайта, Строка(Стр.Слаг), Стр.ДатаПубликации);
        КонецЕсли;
    КонецЦикла;

    ЗН = Новый Запрос;
    ЗН.Текст = "ВЫБРАТЬ Слаг, СтатусПубликации, ДатаПубликации
    |ИЗ Справочник.Новости
    |ГДЕ Сайт = &Сайт";
    ЗН.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Для Каждого Стр Из ЗН.Выполнить() Цикл
        Если Роутер.Опубликовано(Стр) И Не ПустаяСтрока(Строка(Стр.Слаг)) Тогда
            Добавить(Адреса, База, ПрефиксСайта, "news/" + Строка(Стр.Слаг), Стр.ДатаПубликации);
        КонецЕсли;
    КонецЦикла;

    // Витрина каталога: сам раздел, группы и карточки товаров. Без этого
    // импортированный каталог остаётся невидимым для поисковика, даже когда
    // страницы у него есть (#1014).
    ЗТ = Новый Запрос;
    ЗТ.Текст = "ВЫБРАТЬ Слаг, СтатусПубликации, ДатаПубликации, is_folder КАК ЭтоГруппа
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт";
    ЗТ.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Позиции = ЗТ.Выполнить();
    Если Позиции.Количество() > 0 Тогда
        Добавить(Адреса, База, ПрефиксСайта, "catalog", Неопределено);
    КонецЕсли;
    Для Каждого Стр Из Позиции Цикл
        Слаг = СокрЛП(Строка(Стр.Слаг));
        Если ПустаяСтрока(Слаг) ИЛИ Слаг = "<nil>" Тогда
            Продолжить;
        КонецЕсли;
        Если Стр.ЭтоГруппа Тогда
            Добавить(Адреса, База, ПрефиксСайта, "catalog/" + Слаг, Неопределено);
        ИначеЕсли Роутер.Опубликовано(Стр) Тогда
            Добавить(Адреса, База, ПрефиксСайта, "product/" + Слаг, Стр.ДатаПубликации);
        КонецЕсли;
    КонецЦикла;

    Текст = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
        + "<urlset xmlns=""http://www.sitemaps.org/schemas/sitemap/0.9"">" + Символы.ПС;
    Для Каждого Элемент Из Адреса Цикл
        Текст = Текст + "<url><loc>" + ЭкранироватьXML(Элемент.Адрес) + "</loc>";
        Если ЗначениеЗаполнено(Элемент.Изменён) Тогда
            // Дата приходит из SQLite строкой вида «2026-08-16T21:00:00Z», и
            // Формат её не разбирает. Для lastmod нужен только день, поэтому
            // берём первые десять символов ISO-представления.
            Текст = Текст + "<lastmod>" + Лев(СтрЗаменить(Строка(Элемент.Изменён), " ", "T"), 10) + "</lastmod>";
        КонецЕсли;
        Текст = Текст + "</url>" + Символы.ПС;
    КонецЦикла;
    Возврат Текст + "</urlset>";
КонецФункции

Функция ПустойSitemap()
    Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
        + "<urlset xmlns=""http://www.sitemaps.org/schemas/sitemap/0.9"">" + Символы.ПС
        + "</urlset>";
КонецФункции

// ЭкранироватьXML закрывает символы, ломающие документ. Амперсанд первым:
// иначе замены превратят уже вставленные сущности в «&amp;lt;».
Функция ЭкранироватьXML(Значение) Экспорт
    Текст = Строка(Значение);
    Текст = СтрЗаменить(Текст, "&", "&amp;");
    Текст = СтрЗаменить(Текст, "<", "&lt;");
    Текст = СтрЗаменить(Текст, ">", "&gt;");
    Текст = СтрЗаменить(Текст, """", "&quot;");
    Возврат Текст;
КонецФункции

Процедура Добавить(Адреса, База, Префикс, Путь, Дата)
    Элемент = Новый Структура;
    Элемент.Вставить("Адрес", База + Префикс + "/" + Путь);
    Элемент.Вставить("Изменён", Дата);
    Адреса.Добавить(Элемент);
КонецПроцедуры
