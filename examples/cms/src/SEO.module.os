// SEO: канонические адреса и карта сайта (план 129, слайс C5).
//
// Канонический адрес нужен, чтобы одна и та же страница, доступная по
// нескольким адресам (с параметрами, из меню, из письма), не делила вес в
// поиске между дублями.
//
// sitemap.xml собирается на лету и кэшируется тем же кэшем ответов, что и
// страницы (план 126): регламентное задание для этого не нужно, пока сайт
// умещается в тысячи адресов.

// БазовыйАдрес — «https://домен» сайта. Пустой домен даёт относительные
// адреса: лучше без canonical, чем canonical на выдуманный домен.
Функция БазовыйАдрес(Сайт) Экспорт
    Если Сайт = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Домен = СокрЛП(Строка(Сайт.Домен));
    Если ПустаяСтрока(Домен) Тогда
        Возврат "";
    КонецЕсли;
    Если Лев(НРег(Домен), 4) = "http" Тогда
        Возврат Домен;
    КонецЕсли;
    Возврат "https://" + Домен;
КонецФункции

Функция Канонический(Сайт, Путь) Экспорт
    База = БазовыйАдрес(Сайт);
    Если ПустаяСтрока(База) Тогда
        Возврат "";
    КонецЕсли;
    Хвост = СокрЛП(Строка(Путь));
    Если ПустаяСтрока(Хвост) Тогда
        Возврат База + "/hs/site/";
    КонецЕсли;
    Возврат База + "/hs/site/" + Хвост;
КонецФункции

// Sitemap возвращает XML со всеми опубликованными адресами.
//
// XML собирается строкой с ЯВНЫМ экранированием, а не объектом ШаблонHTML:
// html/template экранирует XML-декларацию как текст («&lt;?xml»), и документ
// перестаёт быть XML. Проверено на живом ответе — поисковик такой файл
// отвергнет молча, поэтому правило простое: ШаблонHTML только для HTML.
Функция Sitemap(Сайт) Экспорт
    Адреса = Новый Массив;
    База = БазовыйАдрес(Сайт);

    Добавить(Адреса, База, "", Неопределено);

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Слаг, СтатусПубликации, ДатаПубликации ИЗ Справочник.Страницы";
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Роутер.Опубликовано(Стр) И Не ПустаяСтрока(Строка(Стр.Слаг)) Тогда
            Добавить(Адреса, База, Строка(Стр.Слаг), Стр.ДатаПубликации);
        КонецЕсли;
    КонецЦикла;

    ЗН = Новый Запрос;
    ЗН.Текст = "ВЫБРАТЬ Слаг, СтатусПубликации, ДатаПубликации ИЗ Справочник.Новости";
    Для Каждого Стр Из ЗН.Выполнить() Цикл
        Если Роутер.Опубликовано(Стр) И Не ПустаяСтрока(Строка(Стр.Слаг)) Тогда
            Добавить(Адреса, База, "news/" + Строка(Стр.Слаг), Стр.ДатаПубликации);
        КонецЕсли;
    КонецЦикла;

    Текст = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
        + "<urlset xmlns=""http://www.sitemaps.org/schemas/sitemap/0.9"">" + Символы.ПС;
    Для Каждого Элемент Из Адреса Цикл
        Текст = Текст + "<url><loc>" + ЭкранироватьXML(Элемент.Адрес) + "</loc>";
        Если ЗначениеЗаполнено(Элемент.Изменён) Тогда
            // Дата приходит из SQLite строкой вида «2026-08-16T21:00:00Z», и
            // Формат её не разбирает. Для lastmod нужен только день, поэтому
            // берём первые десять символов ISO-представления.
            Текст = Текст + "<lastmod>" + Лев(СтрЗаменить(Строка(Элемент.Изменён), " ", "T"), 10) + "</lastmod>";
        КонецЕсли;
        Текст = Текст + "</url>" + Символы.ПС;
    КонецЦикла;
    Возврат Текст + "</urlset>";
КонецФункции

// ЭкранироватьXML закрывает символы, ломающие документ. Амперсанд первым:
// иначе замены превратят уже вставленные сущности в «&amp;lt;».
Функция ЭкранироватьXML(Значение) Экспорт
    Текст = Строка(Значение);
    Текст = СтрЗаменить(Текст, "&", "&amp;");
    Текст = СтрЗаменить(Текст, "<", "&lt;");
    Текст = СтрЗаменить(Текст, ">", "&gt;");
    Текст = СтрЗаменить(Текст, """", "&quot;");
    Возврат Текст;
КонецФункции

Процедура Добавить(Адреса, База, Путь, Дата)
    Элемент = Новый Структура;
    Элемент.Вставить("Адрес", База + "/hs/site/" + Путь);
    Элемент.Вставить("Изменён", Дата);
    Адреса.Добавить(Элемент);
КонецПроцедуры
