// Запускается ПОСЛЕ ЗаполнитьТестовуюБазу в отдельной демонстрационной базе.
// Все имена и контакты вымышлены. Повторный запуск сохраняет ручные изменения.
Процедура Выполнить()
    Сайт = Справочники.Сайты.НайтиПоНаименованию("Демо-сайт");
    Если НЕ ЗначениеЗаполнено(Сайт) Тогда
        ВызватьИсключение "Сначала выполните обработку ЗаполнитьТестовуюБазу";
    КонецЕсли;
    Покупатель = СоздатьПокупателя("Анна Примерова", "+7 (000) 000-00-01", "anna@example.test");
    Другой = СоздатьПокупателя("Павел Демонстрационный", "+7 (000) 000-00-02", "pavel@example.test");
    Адрес = СоздатьАдрес("Дом — Анна", "Учебный проспект, дом 10", Покупатель);
    СоздатьАдрес("Офис — Анна", "Демонстрационная улица, дом 20", Покупатель);
    СоздатьАдрес("Дом — Павел", "Примерная улица, дом 30", Другой);
    Город = СоздатьГород("Учебный город");
    ДругойГород = СоздатьГород("Демонстрационный город");
    СоздатьПункт("Центральный — Учебный город", "Учебная площадь, дом 1", Город);
    СоздатьПункт("Вокзальный — Учебный город", "Учебная улица, дом 2", Город);
    СоздатьПункт("Парковый — Демонстрационный город", "Примерный проезд, дом 3", ДругойГород);
    Товар = СоздатьТовар("Керамическая кружка", "demo-mug", "DEMO-001", 790, Сайт);
    СоздатьТовар("Ежедневник без дат", "demo-notebook", "DEMO-002", 1190, Сайт);
    СоздатьТовар("Настольный органайзер", "demo-organizer", "DEMO-003", 1590, Сайт);
    // История видна после ручного связывания нового заказа с покупателем.
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказПокупателя ГДЕ Комментарий = &Метка";
    З.УстановитьПараметр("Метка", "Демо: предыдущая покупка Анны");
    Если З.Выполнить().Количество() = 0 Тогда
        Заказ = Документы.ЗаказПокупателя.Создать();
        Заказ.Дата = ТекущаяДатаВремя();
        Заказ.Сайт = Сайт;
        Заказ.Наименование = "Анна Примерова";
        Заказ.Контакт = "anna@example.test";
        Заказ.Покупатель = Покупатель;
        Заказ.Телефон = "+7 (000) 000-00-01";
        Заказ.СпособПолучения = Перечисления.СпособПолучения.Доставка;
        Заказ.АдресДоставки = Адрес;
        Заказ.Комментарий = "Демо: предыдущая покупка Анны";
        Заказ.Валюта = "RUB";
        Заказ.Статус = Перечисления.СтатусЗаказа.Новый;
        Стр = Заказ.Товары.Добавить();
        Стр.Товар = Товар;
        Стр.Наименование = "Керамическая кружка";
        Стр.Артикул = "DEMO-001";
        Стр.Цена = 790;
        Стр.Количество = 1;
        РаботаСЗаказами.Пересчитать(Заказ);
        Заказ.Записать();
        Заказ.Статус = Перечисления.СтатусЗаказа.ВРаботе;
        Заказ.Записать();
        Заказ.Статус = Перечисления.СтатусЗаказа.Выполнен;
        Заказ.Записать();
    КонецЕсли;
    Сообщить("Готово: 2 покупателя, 3 адреса, 2 города, 3 пункта выдачи и 3 товара. Откройте /hs/site/catalog");
КонецПроцедуры

Функция СоздатьПокупателя(Имя, Телефон, Почта)
    Ссылка = Справочники.Покупатели.НайтиПоНаименованию(Имя);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Объект = Справочники.Покупатели.Создать();
    Объект.Наименование = Имя;
    Объект.Телефон = Телефон;
    Объект.Почта = Почта;
    Возврат Объект.Записать();
КонецФункции

Функция СоздатьАдрес(Имя, Текст, Владелец)
    Ссылка = Справочники.АдресаДоставки.НайтиПоНаименованию(Имя);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Объект = Справочники.АдресаДоставки.Создать();
    Объект.Наименование = Имя;
    Объект.Адрес = Текст;
    Объект.Владелец = Владелец;
    Возврат Объект.Записать();
КонецФункции

Функция СоздатьГород(Имя)
    Ссылка = Справочники.Города.НайтиПоНаименованию(Имя);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Объект = Справочники.Города.Создать();
    Объект.Наименование = Имя;
    Возврат Объект.Записать();
КонецФункции

Функция СоздатьПункт(Имя, Адрес, Владелец)
    Ссылка = Справочники.ПунктыВыдачи.НайтиПоНаименованию(Имя);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Объект = Справочники.ПунктыВыдачи.Создать();
    Объект.Наименование = Имя;
    Объект.Адрес = Адрес;
    Объект.Владелец = Владелец;
    Возврат Объект.Записать();
КонецФункции

Функция СоздатьТовар(Имя, Слаг, Артикул, Цена, Сайт)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Товары ГДЕ Сайт = &Сайт И Слаг = &Слаг";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("Слаг", Слаг);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Товары.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    Объект = Справочники.Товары.Создать();
    Объект.Наименование = Имя;
    Объект.Сайт = Сайт;
    Объект.Слаг = Слаг;
    Объект.Артикул = Артикул;
    Объект.Цена = Цена;
    Объект.Валюта = "RUB";
    Объект.Описание = "<p>Вымышленный товар для демонстрации сайта и заказов.</p>";
    Объект.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Объект.ДатаПубликации = ТекущаяДатаВремя();
    Возврат Объект.Записать();
КонецФункции
