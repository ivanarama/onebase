// Приём заявок с сайта (план 129, слайс C8).
//
// Валидация здесь не формальность: это единственная точка, где в базу попадают
// данные от анонимного посетителя. Правила простые и явные — регулярные
// выражения (план 124) вместо цепочек СтрНайти, которые никто не перечитывает.
//
// Что НЕ делаем: не отбрасываем подозрительное молча. Заявка с необычным
// адресом почты сохраняется со статусом «Спам» — живой человек не должен
// исчезать бесследно из-за нашей эвристики.

// НайтиФорму возвращает описание формы по коду (или Неопределено).
Функция НайтиФорму(Код) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Код, ЗаголовокФормы, ТекстКнопки,
    |ТекстБлагодарности, ТребоватьТелефон, Активна
    |ИЗ Справочник.ФормыОбратнойСвязи";
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Не Стр.Активна Тогда
            Продолжить;
        КонецЕсли;
        Если НРег(СокрЛП(Строка(Стр.Код))) = НРег(СокрЛП(Строка(Код))) Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// ПроверитьПочту — RE2-шаблон намеренно нестрогий: задача не отсеять почту по
// букве RFC, а поймать очевидный мусор. Строгая проверка отказывает живым
// адресам, и это дороже, чем принять пару спамных.
Функция ПроверитьПочту(Значение) Экспорт
    Рег = Новый Регекс("^[^@\s]+@[^@\s]+\.[a-zа-я]{2,}$", "i");
    Возврат Рег.Совпадает(СокрЛП(Строка(Значение)));
КонецФункции

// ПроверитьТелефон принимает любой человеческий формат: +7 (999) 000-11-22,
// 89990001122, 8-999-000-11-22. Сравнивается число цифр, а не разметка.
Функция ПроверитьТелефон(Значение) Экспорт
    ТолькоЦифры = Новый Регекс("\D").Заменить(Строка(Значение), "");
    Возврат СтрДлина(ТолькоЦифры) >= 10 И СтрДлина(ТолькоЦифры) <= 15;
КонецФункции

// ПохожеНаСпам — дешёвые признаки, не претендующие на антиспам-движок:
// ссылки в сообщении и подозрительно длинный текст без пробелов.
Функция ПохожеНаСпам(Сообщение) Экспорт
    Если Новый Регекс("https?://", "i").Совпадает(Строка(Сообщение)) Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Новый Регекс("\S{60,}").Совпадает(Строка(Сообщение));
КонецФункции

// Принять разбирает поля и создаёт заявку. Возвращает Структуру
// {Код, Сообщение} — код HTTP и текст для посетителя.
Функция Принять(Форма, Данные) Экспорт
    Результат = Новый Структура;

    // Honeypot: поле, скрытое стилями. Человек его не видит и не заполняет,
    // бот заполняет всё подряд. Отвечаем как при успехе — иначе бот узнает,
    // что попался, и подстроится.
    Если Не ПустаяСтрока(Поле(Данные, "website")) Тогда
        Результат.Вставить("Код", 200);
        Результат.Вставить("Сообщение", "Спасибо, заявка принята.");
        Возврат Результат;
    КонецЕсли;

    // Имена полей латиницей намеренно: кириллическое имя поля зависит от того,
    // как клиент его закодировал, и внешний скрипт легко пришлёт не UTF-8.
    // Подписи для посетителя при этом остаются русскими — они в разметке.
    Имя = Поле(Данные, "name");
    Контакт = Поле(Данные, "contact");
    Сообщение = Поле(Данные, "message");

    Если ПустаяСтрока(Имя) Тогда
        Возврат Отказ(Результат, "Укажите, как к вам обращаться.");
    КонецЕсли;
    Если ПустаяСтрока(Контакт) Тогда
        Возврат Отказ(Результат, "Укажите почту или телефон для ответа.");
    КонецЕсли;

    ЭтоПочта = ПроверитьПочту(Контакт);
    ЭтоТелефон = ПроверитьТелефон(Контакт);
    Если Не ЭтоПочта И Не ЭтоТелефон Тогда
        Возврат Отказ(Результат, "Не похоже на почту или телефон — проверьте контакт.");
    КонецЕсли;
    Если Форма.ТребоватьТелефон И Не ЭтоТелефон Тогда
        Возврат Отказ(Результат, "Для этой формы нужен номер телефона.");
    КонецЕсли;

    Заявка = Справочники.Заявки.Создать();
    Заявка.Наименование = Имя;
    Заявка.Форма = Форма.Ссылка;
    Заявка.Дата = ТекущаяДатаВремя();
    Заявка.Контакт = Контакт;
    Заявка.Сообщение = Сообщение;
    Если ПохожеНаСпам(Сообщение) Тогда
        Заявка.Статус = Перечисления.СтатусЗаявки.Спам;
        Заявка.Комментарий = "Отмечено автоматически: ссылка или длинная строка без пробелов";
    Иначе
        Заявка.Статус = Перечисления.СтатусЗаявки.Новая;
    КонецЕсли;
    Заявка.Записать();

    Результат.Вставить("Код", 200);
    Благодарность = СокрЛП(Строка(Форма.ТекстБлагодарности));
    Если ПустаяСтрока(Благодарность) Тогда
        Благодарность = "Спасибо, заявка принята.";
    КонецЕсли;
    Результат.Вставить("Сообщение", Благодарность);
    Возврат Результат;
КонецФункции

// Поле читает значение формы как строку.
//
// Отдельная функция, потому что Строка(Неопределено) даёт «<nil>», а не пустую
// строку: непереданное поле выглядело бы заполненным. На этом сразу попался
// honeypot — незаполненная ловушка считалась сработавшей, и КАЖДАЯ заявка
// молча отбрасывалась с видом успеха. Проверено живой отправкой формы.
Функция Поле(Данные, Имя) Экспорт
    Значение = Данные.Получить(Имя);
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция Отказ(Результат, Текст) Экспорт
    Результат.Вставить("Код", 422);
    Результат.Вставить("Сообщение", Текст);
    Возврат Результат;
КонецФункции
