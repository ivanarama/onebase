// Сборка HTML публичного сайта (план 129, слайсы C3–C5).
//
// ЕДИНСТВЕННЫЙ способ собрать разметку здесь — объект ШаблонHTML (план 125).
// Склейка строк запрещена не из вкуса: значения из базы обязаны экранироваться
// по контексту вставки, иначе заголовок статьи с угловой скобкой ломает
// вёрстку, а с тегом script — исполняется у посетителя.
//
// Меню и списки передаются в шаблон ДАННЫМИ (массивами структур), а не готовым
// HTML: иначе их пришлось бы помечать доверенной разметкой, и заголовок,
// введённый контент-менеджером, обошёл бы экранирование. Через
// БезопасныйHTML проходит только содержимое richtext-полей — санитайзер
// оставляет форматирование и вырезает скрипты.

// МакетПоУмолчанию используется, пока у сайта не выбран шаблон: чистая база
// должна отдавать рабочую страницу, а не ошибку «шаблон не найден».
Функция МакетПоУмолчанию() Экспорт
    Возврат "<!doctype html>
    |<html lang=""{{.Язык}}"">
    |<head>
    |<meta charset=""utf-8"">
    |<meta name=""viewport"" content=""width=device-width, initial-scale=1"">
    |<title>{{.SEOЗаголовок}}</title>
    |{{if .Описание}}<meta name=""description"" content=""{{.Описание}}"">{{end}}
    |{{if .Канонический}}<link rel=""canonical"" href=""{{.Канонический}}"">{{end}}
    |<meta property=""og:type"" content=""website"">
    |<meta property=""og:title"" content=""{{.SEOЗаголовок}}"">
    |{{if .Описание}}<meta property=""og:description"" content=""{{.Описание}}"">{{end}}
    |{{if .OGКартинка}}<meta property=""og:image"" content=""{{.OGКартинка}}"">{{end}}
    |<link rel=""stylesheet"" href=""{{.Префикс}}/style.css"">
    |</head>
    |<body>
    |<header class=""site-header"">
    |<div class=""site-bar"">
    |<a class=""site-title"" href=""{{.Префикс}}/"">{{.НазваниеСайта}}</a>
    |<nav class=""site-menu""><ul>
    |{{range .Меню}}<li{{if .Активный}} class=""active""{{end}}><a href=""{{.Адрес}}"">{{.Заголовок}}</a></li>{{end}}
    |</ul></nav>
    |<form class=""site-search"" method=""get"" action=""{{.Префикс}}/search"" role=""search"">
    |<input name=""q"" type=""search"" placeholder=""Поиск по сайту"" value=""{{.Поиск}}"" aria-label=""Поиск по сайту"">
    |<button type=""submit"">Найти</button>
    |</form>
    |</div>
    |</header>
    |<main class=""site-main {{.КлассСтраницы}}"">
    |<h1>{{.Заголовок}}</h1>
    |{{if .Цена}}<div class=""price"">{{.Цена}}</div>{{end}}
    |{{if .Картинка}}<img class=""cover"" src=""{{.Картинка}}"" alt=""{{.Заголовок}}"">{{end}}
    |{{.Содержимое}}
    |{{if .Сообщение}}<p class=""form-result"">{{.Сообщение}}</p>{{end}}
    |{{if .Форма}}<form class=""feedback"" method=""post"" action=""{{.ПрефиксФорм}}/submit/{{.Форма.Код}}"">
    |<h2>{{.Форма.Заголовок}}</h2>
    |<label>Как к вам обращаться<input name=""name"" required></label>
    |<label>Почта или телефон<input name=""contact"" required></label>
    |<label>Сообщение<textarea name=""message"" rows=""4""></textarea></label>
    |<input class=""hp"" name=""website"" tabindex=""-1"" autocomplete=""off"">
    |<button type=""submit"">{{.Форма.ТекстКнопки}}</button>
    |</form>{{end}}
    |{{if .Список}}<ul class=""cards"">
    |{{range .Список}}<li class=""card"">
    |<a class=""card-media"" href=""{{.Адрес}}"" tabindex=""-1"" aria-hidden=""true"">
    |{{if .Картинка}}<img src=""{{.Картинка}}"" alt="""" loading=""lazy"">{{else}}<span class=""card-noimg""></span>{{end}}
    |</a>
    |<div class=""card-body"">
    |<a class=""card-title"" href=""{{.Адрес}}"">{{.Заголовок}}</a>
    |{{if .Дата}}<time class=""card-date"">{{дата .Дата ""02.01.2006""}}</time>{{end}}
    |<div class=""card-text"">{{.Анонс}}</div>
    |{{if .Цена}}<div class=""card-price"">{{.Цена}}</div>{{end}}
    |</div>
    |</li>{{end}}
    |</ul>{{end}}
    |</main>
    |<footer class=""site-footer"">
    |<div class=""footer-inner"">
    |<div class=""footer-name"">{{.НазваниеСайта}}</div>
    |<nav class=""footer-menu""><ul>
    |{{range .МенюПодвала}}<li><a href=""{{.Адрес}}"">{{.Заголовок}}</a></li>{{end}}
    |</ul></nav>
    |</div>
    |</footer>
    |</body>
    |</html>";
КонецФункции

// СтильСайта возвращает CSS сайта. Палитра подставляется переменными, чтобы
// шаблон и произвольный CSS пользовались одними именами. Сайт — структура
// параметров из Роутер.ТекущийСайт, а не ссылка (см. комментарий там).
Функция СтильСайта(Сайт) Экспорт
    Если Сайт = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Основной = Сайт.ЦветОсновной;
    Дополнительный = Сайт.ЦветДополнительный;
    Фон = Сайт.ЦветФона;
    Свой = Сайт.CSS;

    Переменные = ":root{--основной:" + ЗначениеИлиУмолчание(Основной, "#2563eb")
        + ";--дополнительный:" + ЗначениеИлиУмолчание(Дополнительный, "#0f172a")
        + ";--фон:" + ЗначениеИлиУмолчание(Фон, "#ffffff")
        // Нейтральные тона не берутся из палитры сайта намеренно: их три на все
        // случаи, а палитра — про акцент. Иначе редактор, поменявший основной
        // цвет, случайно перекрашивает рамки и подписи.
        + ";--поверхность:#f8fafc;--граница:#e2e8f0;--приглушённый:#64748b}";
    Базовый = "*,*::before,*::after{box-sizing:border-box}"
        + "body{margin:0;background:var(--фон);color:var(--дополнительный);"
        + "font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;line-height:1.55}"
        + "img{max-width:100%;height:auto}"
        // ── шапка: белая полоса с акцентом, а не сплошная заливка ──
        + ".site-header{position:sticky;top:0;z-index:5;background:var(--фон);"
        + "border-bottom:1px solid var(--граница)}"
        + ".site-bar{max-width:1120px;margin:0 auto;padding:12px 24px;display:flex;"
        + "align-items:center;gap:16px;flex-wrap:wrap}"
        + ".site-title{color:var(--дополнительный);text-decoration:none;font-weight:700;"
        + "font-size:20px;letter-spacing:.02em;margin-right:auto}"
        + ".site-menu ul{list-style:none;display:flex;gap:18px;margin:0;padding:0;flex-wrap:wrap}"
        + ".site-menu a{color:var(--дополнительный);text-decoration:none;opacity:.75;font-size:15px}"
        + ".site-menu a:hover{opacity:1}"
        + ".site-menu li.active a{opacity:1;color:var(--основной);font-weight:600}"
        + ".site-search{display:flex;gap:6px}"
        + ".site-search input{padding:8px 12px;border:1px solid var(--граница);border-radius:8px;"
        + "background:var(--поверхность);min-width:180px;font:inherit}"
        + ".site-search button{padding:8px 14px;border:0;border-radius:8px;background:var(--основной);"
        + "color:#fff;cursor:pointer;font:inherit}"
        // ── содержимое ──
        + ".site-main{max-width:1120px;margin:0 auto;padding:28px 24px 48px}"
        + ".site-main h1{font-size:30px;line-height:1.2;margin:0 0 16px}"
        + ".cover{border-radius:12px;margin:0 0 18px;border:1px solid var(--граница);"
        + "max-height:420px;object-fit:contain;background:var(--поверхность);padding:12px}"
        // Цена карточки товара: крупная, сразу под названием — за ней и приходят.
        + ".price{font-size:28px;font-weight:700;margin:0 0 16px}"
        // Карточка товара — две колонки: фото слева, название с ценой и
        // описанием справа. Иначе снимок страницы — одинокая картинка и
        // половина экрана пустоты.
        + ".site-main.product{display:grid;grid-template-columns:minmax(240px,380px) 1fr;"
        + "gap:4px 32px;align-items:start}"
        + ".site-main.product h1{grid-column:2;grid-row:1;margin:0 0 8px}"
        + ".site-main.product .price{grid-column:2;grid-row:2}"
        + ".site-main.product .cover{grid-column:1;grid-row:1/span 4;margin:0;align-self:start}"
        + ".site-main.product>*:not(h1):not(.price):not(.cover){grid-column:2}"
        // ── витрина карточками ──
        + ".cards{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:18px;"
        + "grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}"
        + ".card{display:flex;flex-direction:column;border:1px solid var(--граница);"
        + "border-radius:14px;overflow:hidden;background:var(--фон);transition:box-shadow .15s,transform .15s}"
        + ".card:hover{box-shadow:0 8px 24px rgba(15,23,42,.10);transform:translateY(-2px)}"
        + ".card-media{display:block;aspect-ratio:4/3;background:var(--поверхность);overflow:hidden}"
        + ".card-media img{width:100%;height:100%;object-fit:contain;padding:10px}"
        // Позиция без картинки не должна ломать сетку: место занимает пустая
        // плашка того же размера, иначе карточки съезжают по высоте.
        + ".card-noimg{display:block;width:100%;height:100%;background:"
        + "repeating-linear-gradient(45deg,var(--поверхность),var(--поверхность) 10px,#f1f5f9 10px,#f1f5f9 20px)}"
        // flex:1 обязателен: сетка растягивает карточки до одной высоты, но без
        // этого тело остаётся по содержимому, и «margin-top:auto» у цены не
        // выравнивает ценники — они пляшут по строке вслед за длиной названия.
        + ".card-body{flex:1;display:flex;flex-direction:column;gap:6px;padding:12px 14px 16px}"
        + ".card-title{color:var(--дополнительный);text-decoration:none;font-weight:600;line-height:1.35}"
        + ".card-title:hover{color:var(--основной)}"
        + ".card-date{font-size:13px;color:var(--приглушённый)}"
        + ".card-text{font-size:14px;color:var(--приглушённый)}"
        // Цена — крупная и последней строкой: карточки в ряду разной высоты, и
        // ценники должны стоять на одной линии, а не плавать по сетке.
        + ".card-price{margin-top:auto;padding-top:8px;font-size:19px;font-weight:700;"
        + "color:var(--дополнительный)}"
        // ── форма обратной связи ──
        + ".feedback{max-width:520px;margin:28px 0 0;padding:20px;border:1px solid var(--граница);"
        + "border-radius:14px;background:var(--поверхность)}"
        + ".feedback h2{margin:0 0 8px;font-size:20px}"
        + ".feedback label{display:block;margin:12px 0;font-size:14px;color:var(--приглушённый)}"
        + ".feedback input,.feedback textarea{display:block;width:100%;margin-top:4px;padding:9px 12px;"
        + "border:1px solid var(--граница);border-radius:8px;font:inherit;background:var(--фон)}"
        + ".feedback button{margin-top:14px;padding:11px 20px;border:0;border-radius:9px;"
        + "background:var(--основной);color:#fff;cursor:pointer;font:inherit;font-weight:600}"
        + ".form-result{padding:12px 16px;background:var(--поверхность);border:1px solid var(--граница);"
        + "border-radius:10px}"
        // Honeypot прячем стилями, а не type=hidden: скрытое поле бот
        // распознаёт по типу и пропускает, а невидимое глазу — заполняет.
        + ".hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}"
        // ── подвал ──
        + ".site-footer{border-top:1px solid var(--граница);background:var(--поверхность);"
        + "color:var(--приглушённый)}"
        + ".footer-inner{max-width:1120px;margin:0 auto;padding:20px 24px;display:flex;gap:16px;"
        + "align-items:center;flex-wrap:wrap}"
        + ".footer-name{font-weight:600;color:var(--дополнительный);margin-right:auto}"
        + ".footer-menu ul{list-style:none;display:flex;gap:16px;margin:0;padding:0;flex-wrap:wrap}"
        + ".footer-menu a{color:var(--приглушённый);text-decoration:none}"
        + ".footer-menu a:hover{color:var(--дополнительный)}"
        // ── телефон ──
        + "@media(max-width:640px){.site-bar{padding:10px 16px}.site-search{width:100%;order:3}"
        + ".site-search input{flex:1;min-width:0}.site-main{padding:20px 16px 36px}"
        + ".site-main h1{font-size:24px}"
        + ".cards{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}"
        // На телефоне две колонки не помещаются: карточка товара идёт одной,
        // фото сверху.
        + ".site-main.product{display:block}.site-main.product .cover{margin:0 0 16px}}";
    Возврат Переменные + Базовый + ЗначениеИлиУмолчание(Свой, "");
КонецФункции

// ТекстЗначения приводит поле результата запроса к строке для разметки.
//
// Незаполненная ссылка (например, товар без картинки в медиатеке) даёт не
// Неопределено и не пустоту, а строку «<nil>» — она непустая и потому
// проходит и проверку ПустаяСтрока(), и {{if}} в шаблоне. Так в разметку
// попадал src="<nil>": браузер запрашивал несуществующий адрес и рисовал
// битую картинку, а в og:image «<nil>» уезжал в соцсети.
Функция ТекстЗначения(Значение) Экспорт
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Результат = СокрЛП(Строка(Значение));
    Если Результат = "<nil>" Тогда
        Возврат "";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЗначениеИлиУмолчание(Значение, Умолчание) Экспорт
    Результат = ТекстЗначения(Значение);
    Если ПустаяСтрока(Результат) Тогда
        Возврат Умолчание;
    КонецЕсли;
    Возврат Результат;
КонецФункции

// СобратьМакет — общий скелет: подставляет данные в шаблон сайта и отдаёт HTML.
Функция СобратьМакет(Сайт, Данные) Экспорт
    Текст = "";
    Если Сайт <> Неопределено Тогда
        Текст = ЗначениеИлиУмолчание(Сайт.МакетHTML, "");
    КонецЕсли;
    Если ПустаяСтрока(Текст) Тогда
        Текст = МакетПоУмолчанию();
    КонецЕсли;
    Макет = Новый ШаблонHTML(Текст);
    Возврат Макет.Заполнить(Данные);
КонецФункции

// ДанныеСтраницы собирает поля, общие для любой страницы сайта.
Функция ДанныеСтраницы(Сайт, Путь, Заголовок, Описание, СодержимоеHTML) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("Заголовок", Заголовок);
    Данные.Вставить("SEOЗаголовок", Заголовок);
    Данные.Вставить("Описание", Описание);
    Данные.Вставить("Содержимое", БезопасныйHTML(СодержимоеHTML));
    Данные.Вставить("Меню", Меню.Пункты(Сайт, "Главное", Путь));
    Данные.Вставить("МенюПодвала", Меню.Пункты(Сайт, "Подвал", Путь));
    Данные.Вставить("Список", Новый Массив);
    Данные.Вставить("Канонический", SEO.Канонический(Сайт, Путь));
    // Префикс сайта нужен и в макете: ссылки шапки, поиск и таблица стилей
    // раньше собирались с зашитым «/hs/site/» и за reverse proxy вели в никуда
    // — той же болезнью, что canonical и sitemap до #1014.
    Данные.Вставить("Префикс", SEO.Префикс(Сайт));
    // Форма обратной связи живёт в ДРУГОМ сервисе (/hs/forms), поэтому её
    // префикс отдельный: за прокси, отдающим сайт в корне, он тоже свой.
    Данные.Вставить("ПрефиксФорм", SEO.ПрефиксСервиса(Сайт, "forms"));
    // Картинка страницы служит и иллюстрацией, и превью для соцсетей:
    // раздельные поля означали бы, что одно из них рано или поздно забудут.
    Данные.Вставить("Картинка", "");
    // Цена есть у каждой страницы, пусть и пустая: макет один на все страницы,
    // а «{{if .Цена}}» на отсутствующем ключе — не то же самое, что на пустом.
    Данные.Вставить("Цена", "");
    // Класс страницы позволяет ОДНОМУ макету раскладывать карточку товара в две
    // колонки, а остальные страницы — в одну. Без него пришлось бы заводить
    // второй шаблон, то есть чинить вёрстку дважды.
    Данные.Вставить("КлассСтраницы", "");
    Данные.Вставить("Форма", Неопределено);
    Данные.Вставить("Сообщение", "");
    Данные.Вставить("Поиск", "");
    Данные.Вставить("OGКартинка", "");
    Если Сайт = Неопределено Тогда
        Данные.Вставить("НазваниеСайта", "Сайт");
        Данные.Вставить("Язык", "ru");
    Иначе
        Данные.Вставить("НазваниеСайта", Сайт.Наименование);
        Данные.Вставить("Язык", ЗначениеИлиУмолчание(Сайт.Язык, "ru"));
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ОтветHTML(Код, HTML) Экспорт
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.УстановитьЗаголовок("Content-Type", "text/html; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(HTML);
    Возврат Ответ;
КонецФункции

Функция Страница(Сайт, Стр, Путь) Экспорт
    Заголовок = ЗначениеИлиУмолчание(Стр.Заголовок, Стр.Наименование);
    Данные = ДанныеСтраницы(Сайт, Путь, Заголовок, ЗначениеИлиУмолчание(Стр.ОписаниеSEO, ""),
        ЗначениеИлиУмолчание(Стр.Содержимое, ""));
    // Заголовок в теле страницы — человеческий, в <title> — SEO-вариант: они
    // совпадают редко, и подмена одного другим портит либо вёрстку, либо выдачу.
    Данные.Вставить("SEOЗаголовок", ЗначениеИлиУмолчание(Стр.ЗаголовокSEO, Заголовок));
    // Активность формы проверяется ЗДЕСЬ, а не только на приёме: иначе
    // выключенная форма остаётся на странице и отвечает 404 при отправке —
    // посетитель заполняет её впустую (#1014).
    Если ЗначениеЗаполнено(Стр.ФормаКод) И Стр.ФормаАктивна Тогда
        Форма = Новый Структура;
        Форма.Вставить("Код", Строка(Стр.ФормаКод));
        Форма.Вставить("Заголовок", ЗначениеИлиУмолчание(Стр.ФормаЗаголовок, "Напишите нам"));
        Форма.Вставить("ТекстКнопки", ЗначениеИлиУмолчание(Стр.ФормаКнопка, "Отправить"));
        Данные.Вставить("Форма", Форма);
    КонецЕсли;
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// СписокНовостей — страница /news: анонсы опубликованных материалов.
Функция СписокНовостей(Сайт, Новости, Путь) Экспорт
    Данные = ДанныеСтраницы(Сайт, Путь, "Новости", "Новости и статьи", "");
    Данные.Вставить("Список", Новости);
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// КарточкаНовости — страница /news/<слаг>.
Функция КарточкаНовости(Сайт, Стр, Путь) Экспорт
    Заголовок = Строка(Стр.Наименование);
    Данные = ДанныеСтраницы(Сайт, Путь, Заголовок, ЗначениеИлиУмолчание(Стр.ОписаниеSEO, ""),
        ЗначениеИлиУмолчание(Стр.Содержимое, ЗначениеИлиУмолчание(Стр.Анонс, "")));
    Данные.Вставить("SEOЗаголовок", ЗначениеИлиУмолчание(Стр.ЗаголовокSEO, Заголовок));
    Картинка = ТекстЗначения(Стр.КартинкаСсылка);
    Данные.Вставить("Картинка", Картинка);
    Данные.Вставить("OGКартинка", Картинка);
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// СписокТоваров — витрина: /catalog и /catalog/<группа>. Список рисуется тем
// же блоком макета, что новости и поиск: посетителю незачем видеть разницу
// между разделами, а конфигуратору — держать три почти одинаковых куска HTML.
Функция СписокТоваров(Сайт, Группа, Элементы, Путь) Экспорт
    Заголовок = "Каталог";
    Описание = "Каталог товаров";
    Если Группа <> Неопределено Тогда
        Заголовок = Строка(Группа.Наименование);
        Описание = "Товары раздела «" + Заголовок + "»";
    КонецЕсли;
    Данные = ДанныеСтраницы(Сайт, Путь, Заголовок, Описание, "");
    Данные.Вставить("Список", Элементы);
    Если Элементы.Количество() = 0 Тогда
        // Пустой раздел без объяснения выглядит поломкой сайта, а не пустым
        // разделом: посетитель видит заголовок и белое поле под ним.
        Данные.Вставить("Сообщение", "В этом разделе пока нет позиций.");
    КонецЕсли;
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// КарточкаТовара — страница /product/<слаг>.
Функция КарточкаТовара(Сайт, Товар, Путь) Экспорт
    Заголовок = Строка(Товар.Наименование);
    Цена = Роутер.ЦенаСтрокой(Товар.Цена, Товар.Валюта);
    Содержимое = "";
    Подпись = Роутер.ПодписьТовара(Товар);
    Если Не ПустаяСтрока(Подпись) Тогда
        // Без класса: содержимое страницы проходит через санитайзер, и
        // атрибуты он срезает — класс в разметке создавал бы иллюзию стиля.
        // Поэтому крупная цена идёт не сюда, а отдельным полем макета.
        Содержимое = "<p>" + Подпись + "</p>";
    КонецЕсли;
    Описание = СокрЛП(Строка(Товар.Описание));
    Если Не ПустаяСтрока(Описание) И Описание <> "<nil>" Тогда
        Содержимое = Содержимое + Описание;
    КонецЕсли;

    // Описание для поисковика — артикул И цена, как было до выноса цены в
    // отдельное поле. Одна цена в сниппете выдачи читается обрывком строки, а
    // не описанием товара, и артикул из неё пропадает совсем.
    ОписаниеПоУмолчанию = Подпись;
    Если Не ПустаяСтрока(Цена) Тогда
        Если ПустаяСтрока(ОписаниеПоУмолчанию) Тогда
            ОписаниеПоУмолчанию = Цена;
        Иначе
            ОписаниеПоУмолчанию = ОписаниеПоУмолчанию + " · " + Цена;
        КонецЕсли;
    КонецЕсли;

    Данные = ДанныеСтраницы(Сайт, Путь, Заголовок,
        ЗначениеИлиУмолчание(Товар.ОписаниеSEO, ОписаниеПоУмолчанию), Содержимое);
    Данные.Вставить("Цена", Цена);
    Данные.Вставить("КлассСтраницы", "product");
    Данные.Вставить("SEOЗаголовок", ЗначениеИлиУмолчание(Товар.ЗаголовокSEO, Заголовок));

    // Картинка из медиатеки приоритетнее адреса из выгрузки: своя лежит рядом
    // и переживёт чужой сервер, с которого каталог импортировали.
    Картинка = ТекстЗначения(Товар.КартинкаСсылка);
    Если ПустаяСтрока(Картинка) Тогда
        Картинка = ТекстЗначения(Товар.КартинкаURL);
    КонецЕсли;
    Данные.Вставить("Картинка", Картинка);
    Данные.Вставить("OGКартинка", Картинка);
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// СтраницаСообщение — страница-подтверждение (заявка принята, ошибка ввода).
// Живёт в рендере, а не в модуле сервиса: функции внутри одного .service.os
// НЕ видят друг друга, и вспомогательная процедура рядом с обработчиком
// оборачивается ошибкой «unknown function» уже в рантайме.
Функция СтраницаСообщение(Сайт, Код, Заголовок, Текст) Экспорт
    Данные = ДанныеСтраницы(Сайт, "", Заголовок, "", "");
    Данные.Вставить("Заголовок", Заголовок);
    Данные.Вставить("Сообщение", Текст);
    Возврат ОтветHTML(Код, СобратьМакет(Сайт, Данные));
КонецФункции

// СтраницаПоиска показывает выдачу тем же списком, что и новости: посетителю
// незачем видеть разницу между разделами.
Функция СтраницаПоиска(Сайт, Строка_, Найдено) Экспорт
    Заголовок = "Поиск";
    Если Не ПустаяСтрока(Строка_) Тогда
        Заголовок = "Поиск: " + Строка_;
    КонецЕсли;
    Данные = ДанныеСтраницы(Сайт, "search", Заголовок, "", "");
    Данные.Вставить("Заголовок", Заголовок);
    Данные.Вставить("Список", Найдено);
    Если Не ПустаяСтрока(Строка_) И Найдено.Количество() = 0 Тогда
        Данные.Вставить("Сообщение", "Ничего не нашлось. Попробуйте другое слово.");
    КонецЕсли;
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// СайтПуст — главная страница базы, в которой ещё нет контента.
//
// Пустая база отвечала на корень 404 «Страница не найдена»: администратор,
// открывший сайт сразу после migrate, видел ошибку и решал, что сломалось.
// Ошибка тут неуместна — сайт не сломан, он пустой, и это разные вещи. 404
// остаётся для несуществующих адресов: там он правильный ответ и поисковику,
// и посетителю.
Функция СайтПуст(Сайт) Экспорт
    Данные = ДанныеСтраницы(Сайт, "", "Сайт готов к наполнению", "", "");
    Данные.Вставить("Заголовок", "Сайт готов к наполнению");
    // Инструкция собирается ШаблономHTML наравне со всем остальным: правило
    // «никакой склейки строк в разметку» не знает исключений для служебных
    // страниц — иначе оно перестаёт быть правилом.
    Шаблон = Новый ШаблонHTML("<p>Здесь пока нет ни одной опубликованной страницы.</p>
    |<p>Добавьте первую страницу в разделе «Сайт» → «Страницы» и укажите
    |слаг <b>главная</b> — она станет главной страницей сайта.</p>
    |<p>Чтобы посмотреть, как сайт выглядит с содержимым, заполните базу
    |демо-контентом: обработка «Заполнить демо-контент сайта».</p>");
    Данные.Вставить("Содержимое", БезопасныйHTML(Шаблон.Заполнить(Новый Структура)));
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// АдресНеПривязан — 404 для адреса, на который не отвечает ни один сайт базы.
//
// Отдельная страница, а не «Сайт готов к наполнению»: сайт в базе есть, пуст не
// он, а совпадение по адресу. Прежний общий ответ утверждал обратное — при
// полном каталоге предлагал завести первую страницу, и администратор шёл искать
// пропавший контент вместо того, чтобы поправить домен.
//
// Чужие домены посетителю не показываем: объяснение адресовано администратору,
// а перечень сайтов базы — не его дело.
Функция АдресНеПривязан(Хост) Экспорт
    Данные = ДанныеСтраницы(Неопределено, "", "Здесь пока нет сайта", "", "");
    Данные.Вставить("Заголовок", "Здесь пока нет сайта");
    // Хост приходит из заголовка запроса, то есть от постороннего: в разметку
    // он попадает ТОЛЬКО через шаблон, иначе это отражённый XSS.
    //
    // Выделение — <b>, а не <code>: санитайзер richtext пропускает лишь свой
    // список тегов, и <code> из него молча исчезает вместе с выделением.
    Шаблон = Новый ШаблонHTML("{{if .Хост}}<p>Ни один сайт базы не отвечает на адрес
    |<b>{{.Хост}}</b>.</p>{{else}}<p>Ни один сайт базы не отвечает на этот адрес.</p>{{end}}
    |<p>Откройте карточку сайта («Сайт» → «Сайты») и впишите этот адрес в поле
    |«Домен» — либо звёздочку <b>*</b>, чтобы сайт отвечал на любой адрес.</p>");
    Параметры = Новый Структура;
    Параметры.Вставить("Хост", Хост);
    Данные.Вставить("Содержимое", БезопасныйHTML(Шаблон.Заполнить(Параметры)));
    Возврат ОтветHTML(404, СобратьМакет(Неопределено, Данные));
КонецФункции

// НеНайдено отдаёт 404 в оформлении сайта: посетитель, попавший на битую
// ссылку, должен остаться на сайте, а не увидеть системный текст.
Функция НеНайдено(Сайт, Путь) Экспорт
    Данные = ДанныеСтраницы(Сайт, Путь, "Страница не найдена", "", "");
    // Адрес подставляем данными, а не в HTML: иначе путь из запроса попал бы
    // в разметку без экранирования — это отражённый XSS в чистом виде.
    Данные.Вставить("Содержимое", "");
    Данные.Вставить("Заголовок", "Страница не найдена");
    Возврат ОтветHTML(404, СобратьМакет(Сайт, Данные));
КонецФункции

Функция Редирект(Адрес, Код) Экспорт
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.УстановитьЗаголовок("Location", Адрес);
    Ответ.УстановитьЗаголовок("Content-Type", "text/plain; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки("Адрес изменился: " + Адрес);
    Возврат Ответ;
КонецФункции
