// Сборка HTML публичного сайта (план 129, слайсы C3–C5).
//
// ЕДИНСТВЕННЫЙ способ собрать разметку здесь — объект ШаблонHTML (план 125).
// Склейка строк запрещена не из вкуса: значения из базы обязаны экранироваться
// по контексту вставки, иначе заголовок статьи с угловой скобкой ломает
// вёрстку, а с тегом script — исполняется у посетителя.
//
// Меню и списки передаются в шаблон ДАННЫМИ (массивами структур), а не готовым
// HTML: иначе их пришлось бы помечать доверенной разметкой, и заголовок,
// введённый контент-менеджером, обошёл бы экранирование. Через
// БезопасныйHTML проходит только содержимое richtext-полей — санитайзер
// оставляет форматирование и вырезает скрипты.

// МакетПоУмолчанию используется, пока у сайта не выбран шаблон: чистая база
// должна отдавать рабочую страницу, а не ошибку «шаблон не найден».
Функция МакетПоУмолчанию() Экспорт
    Возврат "<!doctype html>
    |<html lang=""{{.Язык}}"">
    |<head>
    |<meta charset=""utf-8"">
    |<meta name=""viewport"" content=""width=device-width, initial-scale=1"">
    |<title>{{.SEOЗаголовок}}</title>
    |{{if .Описание}}<meta name=""description"" content=""{{.Описание}}"">{{end}}
    |{{if .Канонический}}<link rel=""canonical"" href=""{{.Канонический}}"">{{end}}
    |<meta property=""og:type"" content=""website"">
    |<meta property=""og:title"" content=""{{.SEOЗаголовок}}"">
    |{{if .Описание}}<meta property=""og:description"" content=""{{.Описание}}"">{{end}}
    |{{if .OGКартинка}}<meta property=""og:image"" content=""{{.OGКартинка}}"">{{end}}
    |<link rel=""stylesheet"" href=""/hs/site/style.css"">
    |</head>
    |<body>
    |<header class=""site-header"">
    |<a class=""site-title"" href=""/hs/site/"">{{.НазваниеСайта}}</a>
    |<nav class=""site-menu""><ul>
    |{{range .Меню}}<li{{if .Активный}} class=""active""{{end}}><a href=""{{.Адрес}}"">{{.Заголовок}}</a></li>{{end}}
    |</ul></nav>
    |</header>
    |<main class=""site-main"">
    |<h1>{{.Заголовок}}</h1>
    |{{if .Картинка}}<img class=""cover"" src=""{{.Картинка}}"" alt=""{{.Заголовок}}"">{{end}}
    |{{.Содержимое}}
    |{{if .Сообщение}}<p class=""form-result"">{{.Сообщение}}</p>{{end}}
    |{{if .Форма}}<form class=""feedback"" method=""post"" action=""/hs/forms/submit/{{.Форма.Код}}"">
    |<h2>{{.Форма.Заголовок}}</h2>
    |<label>Как к вам обращаться<input name=""name"" required></label>
    |<label>Почта или телефон<input name=""contact"" required></label>
    |<label>Сообщение<textarea name=""message"" rows=""4""></textarea></label>
    |<input class=""hp"" name=""website"" tabindex=""-1"" autocomplete=""off"">
    |<button type=""submit"">{{.Форма.ТекстКнопки}}</button>
    |</form>{{end}}
    |{{if .Список}}<ul class=""news-list"">
    |{{range .Список}}<li class=""news-item"">
    |{{if .Картинка}}<img class=""thumb"" src=""{{.Картинка}}"" alt=""{{.Заголовок}}"">{{end}}
    |<a href=""{{.Адрес}}"">{{.Заголовок}}</a>
    |{{if .Дата}}<time>{{дата .Дата ""02.01.2006""}}</time>{{end}}
    |<div class=""news-anons"">{{.Анонс}}</div>
    |</li>{{end}}
    |</ul>{{end}}
    |</main>
    |<footer class=""site-footer"">
    |<nav class=""footer-menu""><ul>
    |{{range .МенюПодвала}}<li><a href=""{{.Адрес}}"">{{.Заголовок}}</a></li>{{end}}
    |</ul></nav>
    |<div>{{.НазваниеСайта}}</div>
    |</footer>
    |</body>
    |</html>";
КонецФункции

// СтильСайта возвращает CSS сайта. Палитра подставляется переменными, чтобы
// шаблон и произвольный CSS пользовались одними именами. Сайт — структура
// параметров из Роутер.ТекущийСайт, а не ссылка (см. комментарий там).
Функция СтильСайта(Сайт) Экспорт
    Если Сайт = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Основной = Сайт.ЦветОсновной;
    Дополнительный = Сайт.ЦветДополнительный;
    Фон = Сайт.ЦветФона;
    Свой = Сайт.CSS;

    Переменные = ":root{--основной:" + ЗначениеИлиУмолчание(Основной, "#2563eb")
        + ";--дополнительный:" + ЗначениеИлиУмолчание(Дополнительный, "#0f172a")
        + ";--фон:" + ЗначениеИлиУмолчание(Фон, "#ffffff") + "}";
    Базовый = "body{margin:0;background:var(--фон);color:var(--дополнительный);"
        + "font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;line-height:1.55}"
        + ".site-header,.site-footer{padding:16px 24px;background:var(--основной);color:#fff}"
        + ".site-title{color:#fff;text-decoration:none;font-weight:600}"
        + ".site-menu ul,.footer-menu ul{list-style:none;display:flex;gap:16px;margin:8px 0 0;padding:0}"
        + ".site-menu a,.footer-menu a{color:#fff;text-decoration:none;opacity:.85}"
        + ".site-menu li.active a{opacity:1;text-decoration:underline}"
        + ".site-main{max-width:860px;margin:0 auto;padding:24px}"
        + ".news-list{list-style:none;padding:0}"
        + ".news-item{padding:12px 0;border-bottom:1px solid rgba(0,0,0,.08)}"
        + ".news-item time{display:block;font-size:13px;opacity:.7;margin:4px 0}"
        + ".cover{max-width:100%;height:auto;border-radius:8px;margin:12px 0}"
        + ".thumb{float:left;width:96px;height:auto;margin:0 12px 8px 0;border-radius:6px}"
        + ".feedback label{display:block;margin:10px 0}"
        + ".feedback input,.feedback textarea{display:block;width:100%;padding:8px;"
        + "border:1px solid rgba(0,0,0,.2);border-radius:6px}"
        + ".feedback button{margin-top:12px;padding:10px 18px;border:0;border-radius:6px;"
        + "background:var(--основной);color:#fff;cursor:pointer}"
        + ".form-result{padding:10px 14px;background:rgba(0,0,0,.05);border-radius:6px}"
        // Honeypot прячем стилями, а не type=hidden: скрытое поле бот
        // распознаёт по типу и пропускает, а невидимое глазу — заполняет.
        + ".hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}";
    Возврат Переменные + Базовый + ЗначениеИлиУмолчание(Свой, "");
КонецФункции

Функция ЗначениеИлиУмолчание(Значение, Умолчание) Экспорт
    Если Значение = Неопределено ИЛИ ПустаяСтрока(Строка(Значение)) Тогда
        Возврат Умолчание;
    КонецЕсли;
    Возврат Строка(Значение);
КонецФункции

// СобратьМакет — общий скелет: подставляет данные в шаблон сайта и отдаёт HTML.
Функция СобратьМакет(Сайт, Данные) Экспорт
    Текст = "";
    Если Сайт <> Неопределено Тогда
        Текст = ЗначениеИлиУмолчание(Сайт.МакетHTML, "");
    КонецЕсли;
    Если ПустаяСтрока(Текст) Тогда
        Текст = МакетПоУмолчанию();
    КонецЕсли;
    Макет = Новый ШаблонHTML(Текст);
    Возврат Макет.Заполнить(Данные);
КонецФункции

// ДанныеСтраницы собирает поля, общие для любой страницы сайта.
Функция ДанныеСтраницы(Сайт, Путь, Заголовок, Описание, СодержимоеHTML) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("Заголовок", Заголовок);
    Данные.Вставить("SEOЗаголовок", Заголовок);
    Данные.Вставить("Описание", Описание);
    Данные.Вставить("Содержимое", БезопасныйHTML(СодержимоеHTML));
    Данные.Вставить("Меню", Меню.Пункты("Главное", Путь));
    Данные.Вставить("МенюПодвала", Меню.Пункты("Подвал", Путь));
    Данные.Вставить("Список", Новый Массив);
    Данные.Вставить("Канонический", SEO.Канонический(Сайт, Путь));
    // Картинка страницы служит и иллюстрацией, и превью для соцсетей:
    // раздельные поля означали бы, что одно из них рано или поздно забудут.
    Данные.Вставить("Картинка", "");
    Данные.Вставить("Форма", Неопределено);
    Данные.Вставить("Сообщение", "");
    Данные.Вставить("OGКартинка", "");
    Если Сайт = Неопределено Тогда
        Данные.Вставить("НазваниеСайта", "Сайт");
        Данные.Вставить("Язык", "ru");
    Иначе
        Данные.Вставить("НазваниеСайта", Сайт.Наименование);
        Данные.Вставить("Язык", ЗначениеИлиУмолчание(Сайт.Язык, "ru"));
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ОтветHTML(Код, HTML) Экспорт
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.УстановитьЗаголовок("Content-Type", "text/html; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(HTML);
    Возврат Ответ;
КонецФункции

Функция Страница(Сайт, Стр, Путь) Экспорт
    Заголовок = ЗначениеИлиУмолчание(Стр.Заголовок, Стр.Наименование);
    Данные = ДанныеСтраницы(Сайт, Путь, Заголовок, ЗначениеИлиУмолчание(Стр.ОписаниеSEO, ""),
        ЗначениеИлиУмолчание(Стр.Содержимое, ""));
    // Заголовок в теле страницы — человеческий, в <title> — SEO-вариант: они
    // совпадают редко, и подмена одного другим портит либо вёрстку, либо выдачу.
    Данные.Вставить("SEOЗаголовок", ЗначениеИлиУмолчание(Стр.ЗаголовокSEO, Заголовок));
    Если ЗначениеЗаполнено(Стр.ФормаКод) Тогда
        Форма = Новый Структура;
        Форма.Вставить("Код", Строка(Стр.ФормаКод));
        Форма.Вставить("Заголовок", ЗначениеИлиУмолчание(Стр.ФормаЗаголовок, "Напишите нам"));
        Форма.Вставить("ТекстКнопки", ЗначениеИлиУмолчание(Стр.ФормаКнопка, "Отправить"));
        Данные.Вставить("Форма", Форма);
    КонецЕсли;
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// СписокНовостей — страница /news: анонсы опубликованных материалов.
Функция СписокНовостей(Сайт, Новости, Путь) Экспорт
    Данные = ДанныеСтраницы(Сайт, Путь, "Новости", "Новости и статьи", "");
    Данные.Вставить("Список", Новости);
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// КарточкаНовости — страница /news/<слаг>.
Функция КарточкаНовости(Сайт, Стр, Путь) Экспорт
    Заголовок = Строка(Стр.Наименование);
    Данные = ДанныеСтраницы(Сайт, Путь, Заголовок, ЗначениеИлиУмолчание(Стр.ОписаниеSEO, ""),
        ЗначениеИлиУмолчание(Стр.Содержимое, ЗначениеИлиУмолчание(Стр.Анонс, "")));
    Данные.Вставить("SEOЗаголовок", ЗначениеИлиУмолчание(Стр.ЗаголовокSEO, Заголовок));
    Картинка = Строка(Стр.КартинкаСсылка);
    Данные.Вставить("Картинка", Картинка);
    Данные.Вставить("OGКартинка", Картинка);
    Возврат ОтветHTML(200, СобратьМакет(Сайт, Данные));
КонецФункции

// СтраницаСообщение — страница-подтверждение (заявка принята, ошибка ввода).
// Живёт в рендере, а не в модуле сервиса: функции внутри одного .service.os
// НЕ видят друг друга, и вспомогательная процедура рядом с обработчиком
// оборачивается ошибкой «unknown function» уже в рантайме.
Функция СтраницаСообщение(Сайт, Код, Заголовок, Текст) Экспорт
    Данные = ДанныеСтраницы(Сайт, "", Заголовок, "", "");
    Данные.Вставить("Заголовок", Заголовок);
    Данные.Вставить("Сообщение", Текст);
    Возврат ОтветHTML(Код, СобратьМакет(Сайт, Данные));
КонецФункции

// НеНайдено отдаёт 404 в оформлении сайта: посетитель, попавший на битую
// ссылку, должен остаться на сайте, а не увидеть системный текст.
Функция НеНайдено(Сайт, Путь) Экспорт
    Данные = ДанныеСтраницы(Сайт, Путь, "Страница не найдена", "", "");
    // Адрес подставляем данными, а не в HTML: иначе путь из запроса попал бы
    // в разметку без экранирования — это отражённый XSS в чистом виде.
    Данные.Вставить("Содержимое", "");
    Данные.Вставить("Заголовок", "Страница не найдена");
    Возврат ОтветHTML(404, СобратьМакет(Сайт, Данные));
КонецФункции

Функция Редирект(Адрес, Код) Экспорт
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.УстановитьЗаголовок("Location", Адрес);
    Ответ.УстановитьЗаголовок("Content-Type", "text/plain; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки("Адрес изменился: " + Адрес);
    Возврат Ответ;
КонецФункции
