// Модуль объекта справочника «Медиа».
//
// Картинка из поля карточки становится доступной сайту в момент записи:
// ОпубликоватьКартинку выдаёт непредсказуемый адрес /pub/<токен>, который и
// кладётся в реквизит. Публиковать в момент рендера нельзя — GET-запрос
// посетителя не должен писать в базу.
//
// Снятие галки «Активен» отзывает публикацию: ссылка перестаёт работать сразу,
// а не после чистки кэша.
Процедура ПриЗаписи() Экспорт
    Если ЗначениеЗаполнено(ЭтотОбъект.Файл) Тогда
        Если ЭтотОбъект.Активен Тогда
            Опции = Новый Структура;
            Опции.Вставить("Имя", ЭтотОбъект.Наименование);
            ЭтотОбъект.ПубличнаяСсылка = ОпубликоватьКартинку(ЭтотОбъект.Файл, Опции);
        Иначе
            СнятьПубликациюКартинки(ЭтотОбъект.Файл);
            ЭтотОбъект.ПубличнаяСсылка = "";
        КонецЕсли;
    КонецЕсли;
    СброситьКэшСервисов("Сайт");
КонецПроцедуры
