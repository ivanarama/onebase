// Роутер публичного сайта (план 129, слайс C3).
//
// Разбирает адрес и решает, ЧТО показать; как это выглядит — дело Рендера.
// Разделение не косметическое: подбор контента проверяется обработкой без
// сервера, а рендер можно менять, не трогая правила адресов.
//
// Порядок решений жёсткий и важен:
//   1. редирект (301) — старые адреса не должны отвечать 404 после переезда;
//   2. страница по слагу;
//   3. 404 — со страницей ошибки, а не голым текстом.
//
// Неопубликованный материал даёт 404, а не 403: существование черновика — тоже
// информация, и «доступ запрещён» подсказывает, что по этому адресу что-то есть.

// ТекущийСайт возвращает сайт по домену запроса. Домен сравнивается без учёта
// регистра и порта; если совпадения нет — первый активный сайт (типовой случай
// «одна база — один сайт», когда домен ещё не прописан).
Функция ТекущийСайт(Запрос) Экспорт
    Хост = "";
    Если Запрос <> Неопределено Тогда
        Хост = НРег(Запрос.Заголовки.Получить("Host"));
        Если Не ПустаяСтрока(Хост) Тогда
            Поз = СтрНайти(Хост, ":");
            Если Поз > 0 Тогда
                Хост = Лев(Хост, Поз - 1);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Домен, Активен ИЗ Справочник.Сайты";
    Результат = З.Выполнить();

    Запасной = Неопределено;
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Если Запасной = Неопределено Тогда
            Запасной = Стр.Ссылка;
        КонецЕсли;
        Если Не ПустаяСтрока(Хост) И НРег(Стр.Домен) = Хост Тогда
            Возврат Стр.Ссылка;
        КонецЕсли;
    КонецЦикла;
    Возврат Запасной;
КонецФункции

// НормализоватьПуть приводит адрес к каноничному виду: без ведущего и
// замыкающего слэша, в нижнем регистре. Пустая строка = главная страница.
Функция НормализоватьПуть(Путь) Экспорт
    Значение = СокрЛП(Строка(Путь));
    Пока Лев(Значение, 1) = "/" Цикл
        Значение = Сред(Значение, 2);
    КонецЦикла;
    Пока СтрДлина(Значение) > 0 И Прав(Значение, 1) = "/" Цикл
        Значение = Лев(Значение, СтрДлина(Значение) - 1);
    КонецЦикла;
    Возврат НРег(Значение);
КонецФункции

// НайтиРедирект возвращает адрес назначения или пустую строку.
Функция НайтиРедирект(Путь) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Откуда, Куда, Код, Активен ИЗ Справочник.Редиректы";
    Результат = З.Выполнить();
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Откуда) = Путь Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// НайтиСтраницу подбирает опубликованную страницу по слагу. Пустой путь —
// главная: страница со слагом «главная» либо первая опубликованная по порядку.
Функция НайтиСтраницу(Путь) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Заголовок, Содержимое, СтатусПубликации,
    |ДатаПубликации, ЗаголовокSEO, ОписаниеSEO, Порядок
    |ИЗ Справочник.Страницы";
    Результат = З.Выполнить();

    Искомый = Путь;
    Если ПустаяСтрока(Искомый) Тогда
        Искомый = "главная";
    КонецЕсли;

    Первая = Неопределено;
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если Первая = Неопределено Тогда
            Первая = Стр;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Слаг) = Искомый Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;

    // Главная работает и без страницы со слагом «главная»: иначе свежая база
    // отвечала бы 404 на собственный корень, и это выглядело бы поломкой.
    Если ПустаяСтрока(Путь) Тогда
        Возврат Первая;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// Опубликовано — единая проверка видимости материала: статус и дата. Держать её
// в одном месте важно, иначе черновик рано или поздно утечёт наружу через
// какой-нибудь один забытый список.
Функция Опубликовано(Стр) Экспорт
    Если Строка(Стр.СтатусПубликации) <> "Опубликовано" Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Стр.ДатаПубликации <> Неопределено И ЗначениеЗаполнено(Стр.ДатаПубликации) Тогда
        Если Стр.ДатаПубликации > ТекущаяДатаВремя() Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Возврат Истина;
КонецФункции

// Обработать — точка входа сервиса.
Функция Обработать(Путь, Запрос) Экспорт
    Сайт = ТекущийСайт(Запрос);
    Нормализованный = НормализоватьПуть(Путь);

    // Канонизацией адреса (301 с /about/ на /about) роутер НЕ занимается:
    // платформа сама отбрасывает пустые сегменты при разборе шаблона {*путь},
    // а сравнение исходного адреса с нормализованным ломается на кириллице —
    // путь приходит в процентном кодировании, и приведение к нижнему регистру
    // меняет сами escape-последовательности. Проверено на /нет-такой:
    // «канонизация» отвечала 301 на саму себя вместо честного 404.
    Редирект = НайтиРедирект(Нормализованный);
    Если Редирект <> Неопределено Тогда
        Код = 301;
        Если Редирект.Код = 302 Тогда
            Код = 302;
        КонецЕсли;
        Возврат Рендер.Редирект(Редирект.Куда, Код);
    КонецЕсли;

    Страница = НайтиСтраницу(Нормализованный);
    Если Страница <> Неопределено Тогда
        Возврат Рендер.Страница(Сайт, Страница);
    КонецЕсли;

    Возврат Рендер.НеНайдено(Сайт, Нормализованный);
КонецФункции
