// Роутер публичного сайта (план 129, слайс C3).
//
// Разбирает адрес и решает, ЧТО показать; как это выглядит — дело Рендера.
// Разделение не косметическое: подбор контента проверяется обработкой без
// сервера, а рендер можно менять, не трогая правила адресов.
//
// Порядок решений жёсткий и важен:
//   1. редирект (301) — старые адреса не должны отвечать 404 после переезда;
//   2. страница по слагу;
//   3. 404 — со страницей ошибки, а не голым текстом.
//
// Неопубликованный материал даёт 404, а не 403: существование черновика — тоже
// информация, и «доступ запрещён» подсказывает, что по этому адресу что-то есть.

// ТекущийСайт возвращает СТРУКТУРУ с параметрами сайта. Поле Ссылка в ней
// сохраняет выбранный сайт и обязательно для изоляции всех публичных выборок.
//
// Ссылка из результата запроса не разыменовывает реквизиты в контексте
// HTTP-сервиса: ЗначениеРеквизитаОбъекта(Ссылка, "Домен") молча возвращает
// Неопределено, и в canonical уезжает «https://<nil>/…». Поэтому всё нужное
// (включая поля стиля и шаблона) берётся ОДНИМ запросом с разыменованием
// через точку — заодно это дешевле цепочки обращений на каждый рендер.
//
// Домен сравнивается без учёта регистра и порта. Запасной активный сайт
// используется только без Host (например, в тесте); неизвестный Host не должен
// получать содержимое чужого сайта.
Функция ТекущийСайт(Запрос) Экспорт
    Хост = "";
    Если Запрос <> Неопределено Тогда
        Хост = НормализоватьДомен(Запрос.Заголовки.Получить("Host"));
    КонецЕсли;

    З = Новый Запрос;
    // ПрефиксПути обязателен в выборке: Сайт здесь — СТРОКА РЕЗУЛЬТАТА, а не
    // объект, и невыбранного реквизита у неё нет. Без него SEO.Префикс молча
    // возвращал пустоту, и canonical с меню теряли префикс — при том что в
    // базе он заполнен (#1014).
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Домен, Язык, РоботсTxt, Активен, ПрефиксПути,
    |Стиль.ЦветОсновной КАК ЦветОсновной, Стиль.ЦветДополнительный КАК ЦветДополнительный,
    |Стиль.ЦветФона КАК ЦветФона, Стиль.CSS КАК CSS, Шаблон.МакетHTML КАК МакетHTML
    |ИЗ Справочник.Сайты";
    Результат = З.Выполнить();

    Запасной = Неопределено;
    Совпадение = Неопределено;
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Параметры = ПараметрыСайта(Стр);
        Если Запасной = Неопределено Тогда
            Запасной = Параметры;
        КонецЕсли;
        Если Не ПустаяСтрока(Хост) И НормализоватьДомен(Стр.Домен) = Хост Тогда
            // Старые строки могли появиться до UNIQUE и канонизации. Два
            // совпадения нельзя разрешать порядком строк: это выбрало бы
            // произвольного tenant-а. Неоднозначный Host закрываем целиком.
            Если Совпадение <> Неопределено Тогда
                Возврат Неопределено;
            КонецЕсли;
            Совпадение = Параметры;
        КонецЕсли;
    КонецЦикла;
    Если Совпадение <> Неопределено Тогда
        Возврат Совпадение;
    КонецЕсли;
    Если ПустаяСтрока(Хост) Тогда
        Возврат Запасной;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// НормализоватьДомен задаёт единое правило для записи сайта и HTTP Host:
// пробелы/регистр несущественны, порт не является частью домена. IDNA здесь
// намеренно не делается: платформа не предоставляет надёжного преобразования.
Функция НормализоватьДомен(Домен) Экспорт
    Значение = НРег(СокрЛП(Строка(Домен)));
    Если ПустаяСтрока(Значение) ИЛИ Значение = "<nil>" Тогда
        Возврат "";
    КонецЕсли;
    Поз = СтрНайти(Значение, ":");
    Если Поз > 0 Тогда
        Значение = Лев(Значение, Поз - 1);
    КонецЕсли;
    Возврат СокрЛП(Значение);
КонецФункции

Функция ПараметрыСайта(Стр) Экспорт
    П = Новый Структура;
    П.Вставить("Ссылка", Стр.Ссылка);
    П.Вставить("Наименование", Строка(Стр.Наименование));
    // Legacy-строка могла сохраниться до канонизации ПриЗаписи. Наружу (SEO,
    // sitemap) всё равно отдаём тот же домен, по которому выбрали Host.
    П.Вставить("Домен", НормализоватьДомен(Стр.Домен));
    П.Вставить("Язык", СокрЛП(Строка(Стр.Язык)));
    П.Вставить("РоботсTxt", Строка(Стр.РоботсTxt));
    // Префикс обязан попасть в структуру: наружу отдаётся именно она, и
    // «Сайт.ПрефиксПути» у остальных модулей читается отсюда, а не из строки
    // запроса. Без этой строки canonical, sitemap и меню теряли префикс при
    // заполненном реквизите — правка выглядела сделанной и не работала (#1014).
    П.Вставить("ПрефиксПути", СокрЛП(Строка(Стр.ПрефиксПути)));
    П.Вставить("ЦветОсновной", Строка(Стр.ЦветОсновной));
    П.Вставить("ЦветДополнительный", Строка(Стр.ЦветДополнительный));
    П.Вставить("ЦветФона", Строка(Стр.ЦветФона));
    П.Вставить("CSS", Строка(Стр.CSS));
    П.Вставить("МакетHTML", Строка(Стр.МакетHTML));
    Возврат П;
КонецФункции

// Все публичные запросы принимают структуру из ТекущийСайт и завершаются
// без данных, если сайт не выбран. Это не позволяет пустому параметру
// превратиться в неявный поиск по всей базе.
Функция УстановитьПараметрСайта(З, Сайт)
    Если Сайт = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Сайт.Ссылка) Тогда
        Возврат Ложь;
    КонецЕсли;
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Возврат Истина;
КонецФункции

// НормализоватьПуть приводит адрес к каноничному виду: без ведущего и
// замыкающего слэша, в нижнем регистре. Пустая строка = главная страница.
Функция НормализоватьПуть(Путь) Экспорт
    Значение = СокрЛП(Строка(Путь));
    Пока Лев(Значение, 1) = "/" Цикл
        Значение = Сред(Значение, 2);
    КонецЦикла;
    Пока СтрДлина(Значение) > 0 И Прав(Значение, 1) = "/" Цикл
        Значение = Лев(Значение, СтрДлина(Значение) - 1);
    КонецЦикла;
    Возврат НРег(Значение);
КонецФункции

// НайтиРедирект возвращает адрес назначения текущего сайта или пустую строку.
Функция НайтиРедирект(Сайт, Путь) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Откуда, Куда, Код, Активен
    |ИЗ Справочник.Редиректы
    |ГДЕ Сайт = &Сайт";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Результат = З.Выполнить();
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Откуда) = Путь Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// НайтиСтраницу подбирает опубликованную страницу по слагу. Пустой путь —
// главная: страница со слагом «главная» либо первая опубликованная по порядку.
Функция НайтиСтраницу(Сайт, Путь) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Заголовок, Содержимое, СтатусПубликации,
    |ДатаПубликации, ЗаголовокSEO, ОписаниеSEO, Порядок,
    |Форма.Код КАК ФормаКод, Форма.ЗаголовокФормы КАК ФормаЗаголовок,
    |Форма.ТекстКнопки КАК ФормаКнопка, Форма.Активна КАК ФормаАктивна
    |ИЗ Справочник.Страницы
    |ГДЕ Сайт = &Сайт";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Результат = З.Выполнить();

    // Аргумент нормализуем ЗДЕСЬ, а не полагаемся на вызывающего: функция
    // публичная, и адрес к ней приходит не только из Обработать. Тест
    // «слаг ищется без учёта регистра» падал именно на этом.
    Искомый = НормализоватьПуть(Путь);
    Если ПустаяСтрока(Искомый) Тогда
        Искомый = "главная";
    КонецЕсли;

    Первая = Неопределено;
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если Первая = Неопределено Тогда
            Первая = Стр;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Слаг) = Искомый Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;

    // Главная работает и без страницы со слагом «главная»: иначе свежая база
    // отвечала бы 404 на собственный корень, и это выглядело бы поломкой.
    Если ПустаяСтрока(НормализоватьПуть(Путь)) Тогда
        Возврат Первая;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// Опубликовано — единая проверка видимости материала: статус и дата. Держать её
// в одном месте важно, иначе черновик рано или поздно утечёт наружу через
// какой-нибудь один забытый список.
Функция Опубликовано(Стр) Экспорт
    Если Строка(Стр.СтатусПубликации) <> "Опубликовано" Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Стр.ДатаПубликации <> Неопределено И ЗначениеЗаполнено(Стр.ДатаПубликации) Тогда
        // Дата ОБЯЗАТЕЛЬНО через Дата(): из запроса на SQLite она приходит
        // строкой «2026-08-18T00:00:00Z», и сравнение с ТекущаяДатаВремя()
        // тогда идёт не как даты, а как текст. В тексте символ «T» больше
        // пробела из представления времени, поэтому материал, изданный
        // СЕГОДНЯ, оказывался «из будущего» и прятался: на UTC-хосте сразу
        // после наполнения демо-данными главная отдавала 404, а карта сайта
        // пустела. На машине с положительным смещением (MSK) дефект не виден
        // — там сохранённая полночь уезжает во вчера по UTC и префиксы дат
        // расходятся. Объектный путь (ПолучитьОбъект) дату приводит сам,
        // путь запроса — нет.
        Если Дата(Стр.ДатаПубликации) > ТекущаяДатаВремя() Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Возврат Истина;
КонецФункции

// АнонсыНовостей — данные для списка /news: только опубликованные, свежие
// сверху. Возвращает Массив структур, разметку рисует шаблон.
// ОтдатьПоМаршруту исполняет правило. Неопределено означает «правило подошло,
// но контента нет» — вызывающий отдаёт 404 сам, чтобы страница ошибки была
// одна на все случаи.
Функция ОтдатьПоМаршруту(Сайт, Маршрут, Путь, Запрос) Экспорт
    Тип = НРег(СокрЛП(Строка(Маршрут.ТипКонтента)));
    Слаг = Строка(Маршрут.Слаг);

    Если Тип = "новости" Тогда
        Если ПустаяСтрока(Слаг) Тогда
            Категория = "";
            Если Запрос <> Неопределено Тогда
                Категория = СокрЛП(Строка(Запрос.ПараметрЗапроса("категория")));
            КонецЕсли;
            Если Категория = "<nil>" Тогда
                Категория = "";
            КонецЕсли;
            Возврат Рендер.СписокНовостей(Сайт, АнонсыНовостей(Сайт, Категория), Путь);
        КонецЕсли;
        Новость = НайтиНовость(Сайт, Слаг);
        Если Новость = Неопределено Тогда
            Возврат Рендер.НеНайдено(Сайт, Путь);
        КонецЕсли;
        Возврат Рендер.КарточкаНовости(Сайт, Новость, Путь);
    КонецЕсли;

    Если Тип = "каталог" Тогда
        Возврат Каталог(Сайт, Путь, Слаг, Запрос);
    КонецЕсли;

    Если Тип = "товар" Тогда
        Товар = НайтиТовар(Сайт, Слаг);
        Если Товар = Неопределено Тогда
            Возврат Рендер.НеНайдено(Сайт, Путь);
        КонецЕсли;
        Возврат Рендер.КарточкаТовара(Сайт, Товар, Путь);
    КонецЕсли;

    Если Тип = "страница" Тогда
        Страница = НайтиСтраницу(Сайт, ?(ПустаяСтрока(Слаг), Путь, Слаг));
        Если Страница = Неопределено Тогда
            // Не 404 сразу: ниже путь ещё проверяется как главная страница.
            Возврат Неопределено;
        КонецЕсли;
        Возврат Рендер.Страница(Сайт, Страница, Путь);
    КонецЕсли;

    // Неизвестный тип контента — не молчаливый 404: правило есть, но
    // конфигурация просит того, чего роутер не умеет.
    Возврат Рендер.СтраницаСообщение(Сайт, 500, "Маршрут настроен неверно",
        "Тип контента «" + Строка(Маршрут.ТипКонтента) + "» роутер не поддерживает.");
КонецФункции

// ─── таблица маршрутов (план 129, решение 5) ─────────────────────────────────
//
// «Роутер — таблица правил, а не поиск слага»: справочник МаршрутыURL задаёт
// шаблон адреса и тип контента, поэтому структуру адресов меняют записью в
// справочнике, а не правкой модуля. Раньше адреса были зашиты в код (= "news",
// Лев(…, 5) = "news/"), а справочник не читал никто (#1014).
//
// Пустой справочник НЕ ломает сайт: тогда действуют правила по умолчанию —
// ровно те, что были зашиты. Иначе первая же база без заполненного справочника
// отвечала бы 404 на всё, а причина была бы не видна.

// Шаблон: сегменты, разделённые «/», где «{слаг}» — подстановка. Примеры:
// «news», «news/{слаг}», «catalog/{слаг}», «{слаг}» (любая страница).
Функция МаршрутыПоУмолчанию() Экспорт
    Правила = Новый Массив;
    // Корень сайта: нормализованный путь пустой, поэтому шаблон записывается
    // как «/» — иначе правило нельзя было бы завести в справочнике (пустой
    // шаблон там считается незаполненным).
    Правила.Добавить(Правило("/", "Страница", 5));
    Правила.Добавить(Правило("news", "Новости", 10));
    Правила.Добавить(Правило("news/{слаг}", "Новости", 20));
    Правила.Добавить(Правило("catalog", "Каталог", 30));
    Правила.Добавить(Правило("catalog/{слаг}", "Каталог", 40));
    Правила.Добавить(Правило("product/{слаг}", "Товар", 50));
    // Страница — последняя: её шаблон «{слаг}» совпадает с любым односегментным
    // адресом и перекрыл бы разделы, стой он выше.
    Правила.Добавить(Правило("{слаг}", "Страница", 100));
    Возврат Правила;
КонецФункции

Функция Правило(Шаблон, ТипКонтента, Приоритет) Экспорт
    П = Новый Структура;
    П.Вставить("Шаблон", Шаблон);
    П.Вставить("ТипКонтента", ТипКонтента);
    П.Вставить("Приоритет", Приоритет);
    Возврат П;
КонецФункции

// Маршруты читает активные правила выбранного сайта; при пустом наборе
// возвращает умолчания.
Функция Маршруты(Сайт) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Шаблон, ТипКонтента, Приоритет, Активен
    |ИЗ Справочник.МаршрутыURL
    |ГДЕ Сайт = &Сайт
    |УПОРЯДОЧИТЬ ПО Приоритет, Шаблон";
    Правила = Новый Массив;
    Если УстановитьПараметрСайта(З, Сайт) Тогда
        Для Каждого Стр Из З.Выполнить() Цикл
            Если Не Стр.Активен Тогда
                Продолжить;
            КонецЕсли;
            Шаблон = СокрЛП(Строка(Стр.Шаблон));
            Тип = СокрЛП(Строка(Стр.ТипКонтента));
            Если ПустаяСтрока(Шаблон) ИЛИ ПустаяСтрока(Тип) Тогда
                // Правило без шаблона или типа ничего не значит: пропускаем, а не
                // пытаемся угадать.
                Продолжить;
            КонецЕсли;
            Правила.Добавить(Правило(Шаблон, Тип, Стр.Приоритет));
        КонецЦикла;
    КонецЕсли;
    // Умолчания добавляются ПОСЛЕ правил справочника, а не вместо них: иначе
    // одна заведённая строка выключала бы все остальные адреса сайта разом, и
    // администратор получал бы сплошной 404 за добавление маршрута. Правило с
    // тем же шаблоном перекрывает умолчание — оно проверяется раньше.
    Для Каждого Умолчание Из МаршрутыПоУмолчанию() Цикл
        Если Не ЕстьШаблон(Правила, Умолчание.Шаблон) Тогда
            Правила.Добавить(Умолчание);
        КонецЕсли;
    КонецЦикла;
    Возврат Правила;
КонецФункции

Функция ЕстьШаблон(Правила, Шаблон)
    Искомый = НРег(СокрЛП(Строка(Шаблон)));
    Для Каждого Правило_ Из Правила Цикл
        Если НРег(СокрЛП(Строка(Правило_.Шаблон))) = Искомый Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// ПодобратьМаршрут возвращает Структуру {ТипКонтента, Слаг, Шаблон} или
// Неопределено. Сначала пробуются шаблоны БЕЗ подстановок: «news» должен
// выиграть у «{слаг}» независимо от приоритетов, иначе список новостей
// перекрывался бы страницей с таким же слагом.
// ЕстьКонтент отвечает, наполнен ли сайт хоть чем-нибудь публикуемым.
//
// Проверяются страницы, новости и товары — включая черновики: наличие
// неопубликованного материала означает, что базой уже занимались, и
// приглашение «добавьте первую страницу» будет неуместным.
Функция ЕстьКонтент(Сайт) Экспорт
    Если Сайт = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ЕстьХотьОдна("Справочник.Страницы", Сайт)
        ИЛИ ЕстьХотьОдна("Справочник.Новости", Сайт)
        ИЛИ ЕстьХотьОдна("Справочник.Товары", Сайт);
КонецФункции

Функция ЕстьХотьОдна(ИмяТаблицы, Сайт)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка ИЗ " + ИмяТаблицы + " ГДЕ Сайт = &Сайт";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Истина;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция ПодобратьМаршрут(Сайт, Путь) Экспорт
    Правила = Маршруты(Сайт);
    Совпадение = ПодобратьСреди(Правила, Путь, Ложь);
    Если Совпадение <> Неопределено Тогда
        Возврат Совпадение;
    КонецЕсли;
    Возврат ПодобратьСреди(Правила, Путь, Истина);
КонецФункции

Функция ПодобратьСреди(Правила, Путь, СПодстановками)
    Для Каждого Правило_ Из Правила Цикл
        Шаблон = Строка(Правило_.Шаблон);
        ЕстьПодстановка = СтрНайти(Шаблон, "{") > 0;
        Если ЕстьПодстановка <> СПодстановками Тогда
            Продолжить;
        КонецЕсли;
        Слаг = СовпалШаблон(Шаблон, Путь);
        Если Слаг = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Результат = Новый Структура;
        Результат.Вставить("ТипКонтента", Правило_.ТипКонтента);
        Результат.Вставить("Слаг", Слаг);
        Результат.Вставить("Шаблон", Шаблон);
        Возврат Результат;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// СовпалШаблон возвращает значение подстановки («» если её в шаблоне нет) или
// Неопределено, если адрес шаблону не соответствует. Путь приходит уже
// нормализованным: без ведущего слэша и в нижнем регистре.
Функция СовпалШаблон(Шаблон, Путь) Экспорт
    Образец = НРег(СокрЛП(Шаблон));
    Если Образец = "/" Тогда
        Образец = "";
    КонецЕсли;
    ЧастиШ = СтрРазделить(Образец, "/");
    ЧастиП = СтрРазделить(СокрЛП(Строка(Путь)), "/");
    Если ЧастиШ.Количество() <> ЧастиП.Количество() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Слаг = "";
    Для Сч = 0 По ЧастиШ.Количество() - 1 Цикл
        Сегмент = ЧастиШ[Сч];
        Значение = ЧастиП[Сч];
        Если Лев(Сегмент, 1) = "{" Тогда
            Если ПустаяСтрока(Значение) Тогда
                // Пустой сегмент подстановкой быть не может: «news/» — это не
                // карточка новости с пустым слагом, а список.
                Возврат Неопределено;
            КонецЕсли;
            Слаг = Значение;
        ИначеЕсли Сегмент <> НРег(Значение) Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Возврат Слаг;
КонецФункции

// ─── витрина каталога (план 129, п. 2) ───────────────────────────────────────
//
// Импортированный каталог до этого никуда не отдавался: справочник заполнялся,
// а роутер про товары не знал (#1014). Адреса — /catalog, /catalog/<группа> и
// /product/<товар>; старый битриксовый «?group=» переводится редиректом 301.

// Каталог обслуживает и корень витрины, и страницу группы, и 301 со старого
// адреса вида /catalog?group=<внешний код или слаг>.
Функция Каталог(Сайт, Путь, СлагГруппы, Запрос) Экспорт
    Старая = "";
    Если Запрос <> Неопределено Тогда
        Старая = СокрЛП(Строка(Запрос.ПараметрЗапроса("group")));
    КонецЕсли;
    Если Не ПустаяСтрока(Старая) И Старая <> "<nil>" Тогда
        Группа = НайтиГруппуТоваров(Сайт, Старая);
        Если Группа = Неопределено Тогда
            Группа = НайтиГруппуПоВнешнемуКоду(Сайт, Старая);
        КонецЕсли;
        Если Группа <> Неопределено Тогда
            // 301, а не 302: адрес сменился навсегда, и вес старой ссылки
            // должен перейти новой — ради этого перенос и делается.
            Возврат Рендер.Редирект(SEO.Префикс(Сайт) + "/catalog/" + СокрЛП(Строка(Группа.Слаг)), 301);
        КонецЕсли;
        Возврат Рендер.НеНайдено(Сайт, Путь);
    КонецЕсли;

    Если ПустаяСтрока(СлагГруппы) Тогда
        Возврат Рендер.СписокТоваров(Сайт, Неопределено, ЭлементыКаталога(Сайт, Неопределено), Путь);
    КонецЕсли;

    Группа = НайтиГруппуТоваров(Сайт, СлагГруппы);
    Если Группа = Неопределено Тогда
        Возврат Рендер.НеНайдено(Сайт, Путь);
    КонецЕсли;
    Возврат Рендер.СписокТоваров(Сайт, Группа, ЭлементыКаталога(Сайт, Группа.Ссылка), Путь);
КонецФункции

// ЭлементыКаталога — то, что показывается в разделе: сперва подгруппы, затем
// товары. Корень витрины (Родитель = Неопределено) показывает верхний уровень,
// а не все позиции подряд: каталог из выгрузки — это дерево, и вываливать его
// плоским списком значит показать тысячу строк вместо трёх разделов.
Функция ЭлементыКаталога(Сайт, Родитель) Экспорт
    Список = Новый Массив;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Артикул, Цена, Валюта, is_folder КАК ЭтоГруппа, parent_id КАК Родитель,
    |СтатусПубликации, ДатаПубликации, Картинка.ПубличнаяСсылка КАК КартинкаСсылка, КартинкаURL
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт
    |УПОРЯДОЧИТЬ ПО is_folder УБЫВ, Наименование";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Список;
    КонецЕсли;
    Результат = З.Выполнить();

    ПрефиксСайта = SEO.Префикс(Сайт);
    Для Каждого Стр Из Результат Цикл
        Если Не ВРодителе(Стр, Родитель) Тогда
            Продолжить;
        КонецЕсли;
        Слаг = СокрЛП(Строка(Стр.Слаг));
        Если ПустаяСтрока(Слаг) ИЛИ Слаг = "<nil>" Тогда
            // Позиция без слага недостижима по адресу — показывать ссылку на
            // неё значит вести посетителя в 404.
            Продолжить;
        КонецЕсли;
        Элемент = Новый Структура;
        Элемент.Вставить("Заголовок", Стр.Наименование);
        // Та же очерёдность, что и в карточке: своя картинка из медиатеки
        // важнее адреса из выгрузки. Без запасного варианта витрина сразу
        // после импорта стояла без единой картинки — адреса в базе были, а
        // список их не смотрел.
        Картинка = Рендер.ТекстЗначения(Стр.КартинкаСсылка);
        Если ПустаяСтрока(Картинка) Тогда
            Картинка = Рендер.ТекстЗначения(Стр.КартинкаURL);
        КонецЕсли;
        Элемент.Вставить("Картинка", Картинка);
        Элемент.Вставить("Дата", Неопределено);
        Если Стр.ЭтоГруппа Тогда
            Элемент.Вставить("Адрес", ПрефиксСайта + "/catalog/" + Слаг);
            Элемент.Вставить("Анонс", БезопасныйHTML("<span>Раздел каталога</span>"));
        Иначе
            Если Не Опубликовано(Стр) Тогда
                Продолжить;
            КонецЕсли;
            Элемент.Вставить("Адрес", ПрефиксСайта + "/product/" + Слаг);
            Элемент.Вставить("Анонс", БезопасныйHTML(ПодписьТовара(Стр)));
        КонецЕсли;
        Список.Добавить(Элемент);
    КонецЦикла;
    Возврат Список;
КонецФункции

// ВРодителе сравнивает родителя строки с искомым. Неопределено = верхний
// уровень: у корневых позиций родитель пустой.
Функция ВРодителе(Стр, Родитель)
    Если Родитель = Неопределено Тогда
        Возврат Не ЗначениеЗаполнено(Стр.Родитель);
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Стр.Родитель) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Строка(Стр.Родитель) = Строка(Родитель);
КонецФункции

// ПодписьТовара — артикул и цена строкой под названием в списке.
Функция ПодписьТовара(Стр) Экспорт
    Части = Новый Массив;
    Артикул = СокрЛП(Строка(Стр.Артикул));
    Если Не ПустаяСтрока(Артикул) И Артикул <> "<nil>" Тогда
        Части.Добавить("Артикул " + Артикул);
    КонецЕсли;
    Если ЗначениеЗаполнено(Стр.Цена) Тогда
        Части.Добавить(Формат(Стр.Цена, "ЧДЦ=2") + " " + ВалютаИлиРубли(Стр.Валюта));
    КонецЕсли;
    Возврат СтрСоединить(Части, " · ");
КонецФункции

Функция ВалютаИлиРубли(Значение) Экспорт
    Валюта = СокрЛП(Строка(Значение));
    Если ПустаяСтрока(Валюта) ИЛИ Валюта = "<nil>" Тогда
        Возврат "RUB";
    КонецЕсли;
    Если ВРег(Валюта) = "RUR" Тогда
        // RUR — код из YML-выгрузок Яндекса, для посетителя он ничего не значит.
        Возврат "RUB";
    КонецЕсли;
    Возврат ВРег(Валюта);
КонецФункции

Функция НайтиТовар(Сайт, Слаг) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Артикул, Цена, Валюта, Описание, is_folder КАК ЭтоГруппа,
    |СтатусПубликации, ДатаПубликации, ЗаголовокSEO, ОписаниеSEO,
    |Картинка.ПубличнаяСсылка КАК КартинкаСсылка, КартинкаURL
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Искомый = НормализоватьПуть(Слаг);
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Стр.ЭтоГруппа ИЛИ Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если НРег(СокрЛП(Строка(Стр.Слаг))) = Искомый Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Группы статусом публикации не управляются: раздел виден, пока в нём есть что
// показать. Иначе пришлось бы держать статус синхронным с содержимым руками.
Функция НайтиГруппуТоваров(Сайт, Слаг) Экспорт
    Искомый = НормализоватьПуть(Слаг);
    Для Каждого Стр Из ГруппыКаталога(Сайт) Цикл
        Если НРег(СокрЛП(Строка(Стр.Слаг))) = Искомый Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция НайтиГруппуПоВнешнемуКоду(Сайт, Код) Экспорт
    Искомый = НРег(СокрЛП(Строка(Код)));
    Для Каждого Стр Из ГруппыКаталога(Сайт) Цикл
        Если НРег(СокрЛП(Строка(Стр.ВнешнийКод))) = Искомый Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция ГруппыКаталога(Сайт) Экспорт
    Список = Новый Массив;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, ВнешнийКод, is_folder КАК ЭтоГруппа, parent_id КАК Родитель
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт
    |УПОРЯДОЧИТЬ ПО Наименование";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Список;
    КонецЕсли;
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Стр.ЭтоГруппа Тогда
            Список.Добавить(Стр);
        КонецЕсли;
    КонецЦикла;
    Возврат Список;
КонецФункции

Функция АнонсыНовостей(Сайт, СлагКатегории) Экспорт
    Список = Новый Массив;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Анонс, СтатусПубликации, ДатаПубликации,
    |Картинка.ПубличнаяСсылка КАК КартинкаСсылка, Категория.Слаг КАК СлагКатегории
    |ИЗ Справочник.Новости
    |ГДЕ Сайт = &Сайт
    |УПОРЯДОЧИТЬ ПО ДатаПубликации УБЫВ";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Список;
    КонецЕсли;
    Результат = З.Выполнить();

    Искомая = НРег(СокрЛП(Строка(СлагКатегории)));
    ПрефиксСайта = SEO.Префикс(Сайт);
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если Не ПустаяСтрока(Искомая) И НРег(СокрЛП(Строка(Стр.СлагКатегории))) <> Искомая Тогда
            Продолжить;
        КонецЕсли;
        Элемент = Новый Структура;
        Элемент.Вставить("Заголовок", Стр.Наименование);
        Элемент.Вставить("Адрес", ПрефиксСайта + "/news/" + СокрЛП(Строка(Стр.Слаг)));
        Элемент.Вставить("Дата", Стр.ДатаПубликации);
        Элемент.Вставить("Картинка", Рендер.ТекстЗначения(Стр.КартинкаСсылка));
        // Анонс — richtext, поэтому идёт через санитайзер: форматирование
        // остаётся, скрипты вырезаются.
        Элемент.Вставить("Анонс", БезопасныйHTML(Строка(Стр.Анонс)));
        Список.Добавить(Элемент);
    КонецЦикла;
    Возврат Список;
КонецФункции

Функция НайтиНовость(Сайт, Слаг) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Анонс, Содержимое, СтатусПубликации,
    |ДатаПубликации, ЗаголовокSEO, ОписаниеSEO,
    |Картинка.ПубличнаяСсылка КАК КартинкаСсылка
    |ИЗ Справочник.Новости
    |ГДЕ Сайт = &Сайт";
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Результат = З.Выполнить();
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Слаг) = НормализоватьПуть(Слаг) Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// НайтиПоТексту превращает выдачу полнотекстового поиска в данные для списка.
//
// Индекс возвращает ссылки на объекты любых видов, поэтому результат
// фильтруется дважды: по типу (страницы и новости — то, что вообще имеет адрес
// на сайте) и по публикации (черновик в индексе есть, а посетителю не положен).
Функция НайтиПоТексту(Сайт, Текст) Экспорт
    Результат = Новый Массив;
    Если ПустаяСтрока(Текст) Тогда
        Возврат Результат;
    КонецЕсли;
    Если Сайт = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Сайт.Ссылка) Тогда
        Возврат Результат;
    КонецЕсли;

    // Сайт и допустимые типы входят в исходный FTS-запрос ДО top-30. Если
    // отфильтровать их после глобального LIMIT, совпадения другого tenant-а
    // (или товаров/меню этого же сайта) вытеснят страницы и новости целиком.
    Найдено = ПолнотекстовыйПоиск(Текст, 30, "Сайт", Сайт.Ссылка,
        ["Страницы", "Новости", "Товары"]);

    // Справочник читается ОДИН раз в соответствие «ссылка → строка», а не на
    // каждое совпадение. Иначе один запрос посетителя к /search разворачивался
    // бы в до 30 полных чтений таблицы: поиск по определению даёт пачку
    // попаданий, и выборка внутри цикла умножается на их число.
    Страницы = Неопределено;
    Новости = Неопределено;
    Товары = Неопределено;

    Для Каждого Совпадение Из Найдено Цикл
        Вид = НРег(Строка(Совпадение.Объект));
        Если Вид = "страницы" Тогда
            Если Страницы = Неопределено Тогда
                Страницы = ИндексПоСсылке("ВЫБРАТЬ Ссылка, Наименование, Слаг, ОписаниеSEO,
                |СтатусПубликации, ДатаПубликации ИЗ Справочник.Страницы
                |ГДЕ Сайт = &Сайт", Сайт);
            КонецЕсли;
            Стр = Страницы.Получить(Совпадение.Ссылка);
            Если Стр <> Неопределено И Опубликовано(Стр) Тогда
                Результат.Добавить(ЭлементВыдачи(Строка(Стр.Наименование),
                    SEO.Префикс(Сайт) + "/" + НормализоватьПуть(Стр.Слаг), Строка(Стр.ОписаниеSEO)));
            КонецЕсли;
        ИначеЕсли Вид = "новости" Тогда
            Если Новости = Неопределено Тогда
                Новости = ИндексПоСсылке("ВЫБРАТЬ Ссылка, Наименование, Слаг, Анонс,
                |СтатусПубликации, ДатаПубликации ИЗ Справочник.Новости
                |ГДЕ Сайт = &Сайт", Сайт);
            КонецЕсли;
            Нов = Новости.Получить(Совпадение.Ссылка);
            Если Нов <> Неопределено И Опубликовано(Нов) Тогда
                Результат.Добавить(ЭлементВыдачи(Строка(Нов.Наименование),
                    SEO.Префикс(Сайт) + "/news/" + НормализоватьПуть(Нов.Слаг), Строка(Нов.Анонс)));
            КонецЕсли;
        ИначеЕсли Вид = "товары" Тогда
            // Товар — такой же адресуемый контент, как страница и новость.
            // Без него поиск по сайту-каталогу бесполезен: посетитель ищет
            // «Боржоми», а находит разве что новость, где это слово упомянуто.
            Если Товары = Неопределено Тогда
                Товары = ИндексПоСсылке("ВЫБРАТЬ Ссылка, Наименование, Слаг, Артикул, Цена, Валюта,
                |is_folder КАК ЭтоГруппа, СтатусПубликации, ДатаПубликации
                |ИЗ Справочник.Товары
                |ГДЕ Сайт = &Сайт", Сайт);
            КонецЕсли;
            Тов = Товары.Получить(Совпадение.Ссылка);
            // Группа адресуется другим разделом сайта, а публикацией она не
            // управляется: раздел виден, пока в нём есть что показать.
            Если Тов <> Неопределено И Не Тов.ЭтоГруппа И Опубликовано(Тов) Тогда
                Результат.Добавить(ЭлементВыдачи(Строка(Тов.Наименование),
                    SEO.Префикс(Сайт) + "/product/" + НормализоватьПуть(Тов.Слаг),
                    ПодписьТовара(Тов)));
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// ИндексПоСсылке выполняет запрос и раскладывает строки в соответствие по
// ссылке.
//
// Ключ — САМА ссылка, а не Строка(Ссылка): строковое представление ссылки это
// наименование объекта, а не идентификатор, так что по нему совпали бы разные
// объекты с одинаковым названием, а объект, найденный поиском, — не совпал бы
// вовсе. Соответствие сравнивает ключи-ссылки по идентификатору.
Функция ИндексПоСсылке(ТекстЗапроса, Сайт) Экспорт
    Индекс = Новый Соответствие;
    З = Новый Запрос;
    З.Текст = ТекстЗапроса;
    Если Не УстановитьПараметрСайта(З, Сайт) Тогда
        Возврат Индекс;
    КонецЕсли;
    Для Каждого Стр Из З.Выполнить() Цикл
        Индекс.Вставить(Стр.Ссылка, Стр);
    КонецЦикла;
    Возврат Индекс;
КонецФункции

Функция ЭлементВыдачи(Заголовок, Адрес, Описание) Экспорт
    Элемент = Новый Структура;
    Элемент.Вставить("Заголовок", Заголовок);
    Элемент.Вставить("Адрес", Адрес);
    // Описание идёт через санитайзер: у новостей это richtext-анонс.
    Элемент.Вставить("Анонс", БезопасныйHTML(Описание));
    Элемент.Вставить("Дата", Неопределено);
    Элемент.Вставить("Картинка", "");
    Возврат Элемент;
КонецФункции

// Обработать — точка входа сервиса.
Функция Обработать(Путь, Запрос) Экспорт
    Сайт = ТекущийСайт(Запрос);
    Нормализованный = НормализоватьПуть(Путь);

    // Канонизацией адреса (301 с /about/ на /about) роутер НЕ занимается:
    // платформа сама отбрасывает пустые сегменты при разборе шаблона {*путь},
    // а сравнение исходного адреса с нормализованным ломается на кириллице —
    // путь приходит в процентном кодировании, и приведение к нижнему регистру
    // меняет сами escape-последовательности. Проверено на /нет-такой:
    // «канонизация» отвечала 301 на саму себя вместо честного 404.
    Редирект = НайтиРедирект(Сайт, Нормализованный);
    Если Редирект <> Неопределено Тогда
        Код = 301;
        Если Редирект.Код = 302 Тогда
            Код = 302;
        КонецЕсли;
        Возврат Рендер.Редирект(Редирект.Куда, Код);
    КонецЕсли;

    // Куда вести адрес, решает таблица правил МаршрутыURL, а не зашитые в код
    // сравнения (план 129, решение 5). Пустой справочник = правила по
    // умолчанию, поэтому база без настроенных маршрутов работает как раньше.
    Маршрут = ПодобратьМаршрут(Сайт, Нормализованный);
    Если Маршрут <> Неопределено Тогда
        Ответ = ОтдатьПоМаршруту(Сайт, Маршрут, Нормализованный, Запрос);
        Если Ответ <> Неопределено Тогда
            Возврат Ответ;
        КонецЕсли;
    КонецЕсли;

    // Корень пустой базы — не ошибка, а «сайт ещё не наполнен»: администратор,
    // открывший сайт сразу после migrate, не должен решать, что всё сломано.
    // Для остальных адресов 404 остаётся правильным ответом.
    Если ПустаяСтрока(Нормализованный) И Не ЕстьКонтент(Сайт) Тогда
        Возврат Рендер.СайтПуст(Сайт);
    КонецЕсли;

    Возврат Рендер.НеНайдено(Сайт, Нормализованный);
КонецФункции
