// Роутер публичного сайта (план 129, слайс C3).
//
// Разбирает адрес и решает, ЧТО показать; как это выглядит — дело Рендера.
// Разделение не косметическое: подбор контента проверяется обработкой без
// сервера, а рендер можно менять, не трогая правила адресов.
//
// Порядок решений жёсткий и важен:
//   1. редирект (301) — старые адреса не должны отвечать 404 после переезда;
//   2. страница по слагу;
//   3. 404 — со страницей ошибки, а не голым текстом.
//
// Неопубликованный материал даёт 404, а не 403: существование черновика — тоже
// информация, и «доступ запрещён» подсказывает, что по этому адресу что-то есть.

// ТекущийСайт возвращает СТРУКТУРУ с параметрами сайта, а не ссылку.
//
// Ссылка из результата запроса не разыменовывает реквизиты в контексте
// HTTP-сервиса: ЗначениеРеквизитаОбъекта(Ссылка, "Домен") молча возвращает
// Неопределено, и в canonical уезжает «https://<nil>/…». Поэтому всё нужное
// (включая поля стиля и шаблона) берётся ОДНИМ запросом с разыменованием
// через точку — заодно это дешевле цепочки обращений на каждый рендер.
//
// Домен сравнивается без учёта регистра и порта; если совпадения нет — первый
// активный сайт (типовой случай «одна база — один сайт»).
Функция ТекущийСайт(Запрос) Экспорт
    Хост = "";
    Если Запрос <> Неопределено Тогда
        Хост = НРег(Запрос.Заголовки.Получить("Host"));
        Если Не ПустаяСтрока(Хост) Тогда
            Поз = СтрНайти(Хост, ":");
            Если Поз > 0 Тогда
                Хост = Лев(Хост, Поз - 1);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Наименование, Домен, Язык, РоботсTxt, Активен,
    |Стиль.ЦветОсновной КАК ЦветОсновной, Стиль.ЦветДополнительный КАК ЦветДополнительный,
    |Стиль.ЦветФона КАК ЦветФона, Стиль.CSS КАК CSS, Шаблон.МакетHTML КАК МакетHTML
    |ИЗ Справочник.Сайты";
    Результат = З.Выполнить();

    Запасной = Неопределено;
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Параметры = ПараметрыСайта(Стр);
        Если Запасной = Неопределено Тогда
            Запасной = Параметры;
        КонецЕсли;
        Если Не ПустаяСтрока(Хост) И НРег(Строка(Стр.Домен)) = Хост Тогда
            Возврат Параметры;
        КонецЕсли;
    КонецЦикла;
    Возврат Запасной;
КонецФункции

Функция ПараметрыСайта(Стр) Экспорт
    П = Новый Структура;
    П.Вставить("Наименование", Строка(Стр.Наименование));
    П.Вставить("Домен", СокрЛП(Строка(Стр.Домен)));
    П.Вставить("Язык", СокрЛП(Строка(Стр.Язык)));
    П.Вставить("РоботсTxt", Строка(Стр.РоботсTxt));
    П.Вставить("ЦветОсновной", Строка(Стр.ЦветОсновной));
    П.Вставить("ЦветДополнительный", Строка(Стр.ЦветДополнительный));
    П.Вставить("ЦветФона", Строка(Стр.ЦветФона));
    П.Вставить("CSS", Строка(Стр.CSS));
    П.Вставить("МакетHTML", Строка(Стр.МакетHTML));
    Возврат П;
КонецФункции

// НормализоватьПуть приводит адрес к каноничному виду: без ведущего и
// замыкающего слэша, в нижнем регистре. Пустая строка = главная страница.
Функция НормализоватьПуть(Путь) Экспорт
    Значение = СокрЛП(Строка(Путь));
    Пока Лев(Значение, 1) = "/" Цикл
        Значение = Сред(Значение, 2);
    КонецЦикла;
    Пока СтрДлина(Значение) > 0 И Прав(Значение, 1) = "/" Цикл
        Значение = Лев(Значение, СтрДлина(Значение) - 1);
    КонецЦикла;
    Возврат НРег(Значение);
КонецФункции

// НайтиРедирект возвращает адрес назначения или пустую строку.
Функция НайтиРедирект(Путь) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Откуда, Куда, Код, Активен ИЗ Справочник.Редиректы";
    Результат = З.Выполнить();
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Откуда) = Путь Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// НайтиСтраницу подбирает опубликованную страницу по слагу. Пустой путь —
// главная: страница со слагом «главная» либо первая опубликованная по порядку.
Функция НайтиСтраницу(Путь) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Заголовок, Содержимое, СтатусПубликации,
    |ДатаПубликации, ЗаголовокSEO, ОписаниеSEO, Порядок
    |ИЗ Справочник.Страницы";
    Результат = З.Выполнить();

    Искомый = Путь;
    Если ПустаяСтрока(Искомый) Тогда
        Искомый = "главная";
    КонецЕсли;

    Первая = Неопределено;
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если Первая = Неопределено Тогда
            Первая = Стр;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Слаг) = Искомый Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;

    // Главная работает и без страницы со слагом «главная»: иначе свежая база
    // отвечала бы 404 на собственный корень, и это выглядело бы поломкой.
    Если ПустаяСтрока(Путь) Тогда
        Возврат Первая;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// Опубликовано — единая проверка видимости материала: статус и дата. Держать её
// в одном месте важно, иначе черновик рано или поздно утечёт наружу через
// какой-нибудь один забытый список.
Функция Опубликовано(Стр) Экспорт
    Если Строка(Стр.СтатусПубликации) <> "Опубликовано" Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Стр.ДатаПубликации <> Неопределено И ЗначениеЗаполнено(Стр.ДатаПубликации) Тогда
        Если Стр.ДатаПубликации > ТекущаяДатаВремя() Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Возврат Истина;
КонецФункции

// АнонсыНовостей — данные для списка /news: только опубликованные, свежие
// сверху. Возвращает Массив структур, разметку рисует шаблон.
Функция АнонсыНовостей() Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Анонс, СтатусПубликации, ДатаПубликации
    |ИЗ Справочник.Новости
    |УПОРЯДОЧИТЬ ПО ДатаПубликации УБЫВ";
    Результат = З.Выполнить();

    Список = Новый Массив;
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Элемент = Новый Структура;
        Элемент.Вставить("Заголовок", Стр.Наименование);
        Элемент.Вставить("Адрес", "/hs/site/news/" + СокрЛП(Строка(Стр.Слаг)));
        Элемент.Вставить("Дата", Стр.ДатаПубликации);
        // Анонс — richtext, поэтому идёт через санитайзер: форматирование
        // остаётся, скрипты вырезаются.
        Элемент.Вставить("Анонс", БезопасныйHTML(Строка(Стр.Анонс)));
        Список.Добавить(Элемент);
    КонецЦикла;
    Возврат Список;
КонецФункции

Функция НайтиНовость(Слаг) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Слаг, Анонс, Содержимое, СтатусПубликации,
    |ДатаПубликации, ЗаголовокSEO, ОписаниеSEO
    |ИЗ Справочник.Новости";
    Результат = З.Выполнить();
    Для Каждого Стр Из Результат Цикл
        Если Не Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Если НормализоватьПуть(Стр.Слаг) = НормализоватьПуть(Слаг) Тогда
            Возврат Стр;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Обработать — точка входа сервиса.
Функция Обработать(Путь, Запрос) Экспорт
    Сайт = ТекущийСайт(Запрос);
    Нормализованный = НормализоватьПуть(Путь);

    // Канонизацией адреса (301 с /about/ на /about) роутер НЕ занимается:
    // платформа сама отбрасывает пустые сегменты при разборе шаблона {*путь},
    // а сравнение исходного адреса с нормализованным ломается на кириллице —
    // путь приходит в процентном кодировании, и приведение к нижнему регистру
    // меняет сами escape-последовательности. Проверено на /нет-такой:
    // «канонизация» отвечала 301 на саму себя вместо честного 404.
    Редирект = НайтиРедирект(Нормализованный);
    Если Редирект <> Неопределено Тогда
        Код = 301;
        Если Редирект.Код = 302 Тогда
            Код = 302;
        КонецЕсли;
        Возврат Рендер.Редирект(Редирект.Куда, Код);
    КонецЕсли;

    // Новости раньше страниц: слаг «news» у страницы не должен перекрывать
    // раздел публикаций — иначе список новостей пропадёт от одной случайной
    // страницы с таким же адресом.
    Если Нормализованный = "news" Тогда
        Возврат Рендер.СписокНовостей(Сайт, АнонсыНовостей(), Нормализованный);
    КонецЕсли;
    Если Лев(Нормализованный, 5) = "news/" Тогда
        Слаг = Сред(Нормализованный, 6);
        Новость = НайтиНовость(Слаг);
        Если Новость <> Неопределено Тогда
            Возврат Рендер.КарточкаНовости(Сайт, Новость, Нормализованный);
        КонецЕсли;
        Возврат Рендер.НеНайдено(Сайт, Нормализованный);
    КонецЕсли;

    Страница = НайтиСтраницу(Нормализованный);
    Если Страница <> Неопределено Тогда
        Возврат Рендер.Страница(Сайт, Страница, Нормализованный);
    КонецЕсли;

    Возврат Рендер.НеНайдено(Сайт, Нормализованный);
КонецФункции
