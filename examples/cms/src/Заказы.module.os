// Оформление заказа с сайта и его страница (план 155, слайсы S4–S6).
//
// Заказ — обычный документ платформы. Из-за этого «магазин» получает бесплатно
// всё, ради чего вообще заводят учётную систему: нумерацию, список с отбором,
// печатную форму, права и историю. Ничего из этого не пришлось бы писать здесь
// заново — и не написано.

// СрокЖизниСообщения не нужен: страница заказа открывается по ссылке сколько
// угодно раз. Ограничение доступа — неподбираемый UUID документа, а не время.

Функция МаксДлинаКомментария() Экспорт
    Возврат 2000;
КонецФункции

// Оформить создаёт документ по содержимому корзины.
//
// Возвращает Структуру {Код, Сообщение, Ид}. Ид непустой только при успехе —
// по нему вызывающий делает редирект на страницу заказа (PRG: перезагрузка
// страницы после POST не должна создавать второй заказ).
Функция Оформить(Сайт, Описание, Данные) Экспорт
    // Корзина, уже превращённая в заказ, второй заказ не создаёт. Это не
    // тонкость: «обновить страницу после отправки» делает каждый второй.
    Если Описание.Оформлена И Не ПустаяСтрока(Описание.Заказ) Тогда
        Возврат Готово("", Описание.Заказ);
    КонецЕсли;

    Имя = Формы.Поле(Данные, "name");
    Контакт = Формы.Поле(Данные, "contact");
    Комментарий = Формы.Поле(Данные, "comment");

    Если ПустаяСтрока(Имя) Тогда
        Возврат Отказ("Укажите, как к вам обращаться.");
    КонецЕсли;
    Если ПустаяСтрока(Контакт) Тогда
        Возврат Отказ("Укажите почту или телефон — без них заказ некому подтвердить.");
    КонецЕсли;
    // Пределы длины — те же, что у заявок, и по той же причине: единственный
    // предел без них — общий лимит тела запроса платформы, то есть мегабайты
    // в справочник с одного POST.
    Если СтрДлина(Имя) > Формы.МаксДлинаИмени() Тогда
        Возврат Отказ("Имя длиннее " + Формы.МаксДлинаИмени() + " символов.");
    КонецЕсли;
    Если СтрДлина(Контакт) > Формы.МаксДлинаКонтакта() Тогда
        Возврат Отказ("Контакт длиннее " + Формы.МаксДлинаКонтакта() + " символов.");
    КонецЕсли;
    Если СтрДлина(Комментарий) > МаксДлинаКомментария() Тогда
        Возврат Отказ("Комментарий длиннее " + МаксДлинаКомментария() + " символов — сократите, пожалуйста.");
    КонецЕсли;
    Если Не Формы.ПроверитьПочту(Контакт) И Не Формы.ПроверитьТелефон(Контакт) Тогда
        Возврат Отказ("Не похоже на почту или телефон — проверьте контакт.");
    КонецЕсли;

    Состав = Корзина.Содержимое(Сайт, Описание);
    Если Состав.Позиций = 0 Тогда
        // Пустая корзина на оформлении — это либо снятые с публикации товары,
        // либо вторая вкладка. И то и другое лечится возвратом в каталог.
        Возврат Отказ("Корзина пуста — возможно, товары сняли с публикации.");
    КонецЕсли;

    Заказ = Документы.ЗаказПокупателя.Создать();
    Заказ.Дата = ТекущаяДатаВремя();
    Заказ.Сайт = Сайт.Ссылка;
    Заказ.Наименование = Имя;
    Заказ.Контакт = Контакт;
    Заказ.Комментарий = Комментарий;
    Заказ.Статус = Перечисления.СтатусЗаказа.Новый;
    Заказ.Сумма = Состав.Итого;
    Для Каждого Строка_ Из Состав.Строки Цикл
        Стр = Заказ.Товары.Добавить();
        Стр.Товар = Справочники.Товары.НайтиПоИдентификатору(Строка_.Ид);
        Стр.Наименование = Строка_.Заголовок;
        Стр.Артикул = Строка_.Артикул;
        Стр.Количество = Строка_.Количество;
        Стр.Цена = Строка_.ЦенаЧислом;
        Стр.Сумма = Строка_.СуммаЧислом;
    КонецЦикла;
    СсылкаЗаказа = Заказ.Записать();

    // Корзина закрывается СРАЗУ после записи заказа: между этими действиями
    // посетитель успевает нажать «оформить» второй раз.
    ОбъектКорзины = Описание.Ссылка.ПолучитьОбъект();
    ОбъектКорзины.Оформлена = Истина;
    ОбъектКорзины.Заказ = СсылкаЗаказа;
    ОбъектКорзины.Строки.Очистить();
    ОбъектКорзины.Записать();

    ОтправитьПисьма(Сайт, СсылкаЗаказа, Имя, Контакт, Состав);
    Возврат Готово("", СсылкаЗаказа.УникальныйИдентификатор());
КонецФункции

// ОтправитьПисьма — best effort и ничего больше.
//
// Письмо отправляется ПОСЛЕ записи заказа и не может её отменить: база без
// настроенного SMTP — обычное состояние демо-стенда, и терять из-за него
// оформленный заказ недопустимо. Неудача остаётся в реквизите заказа, чтобы
// менеджер видел «письмо не ушло», а не гадал, почему клиент не отвечает.
Процедура ОтправитьПисьма(Сайт, СсылкаЗаказа, Имя, Контакт, Состав) Экспорт
    Ошибка = "";
    Номер = НомерЗаказа(СсылкаЗаказа);
    Тема = "Заказ " + Номер + " принят";
    Тело = "Здравствуйте, " + Имя + "!" + Символы.ПС
        + "Ваш заказ " + Номер + " на сумму " + Состав.ИтогоСтрокой + " принят." + Символы.ПС
        + "Мы свяжемся с вами по контакту: " + Контакт + "." + Символы.ПС;

    Если Формы.ПроверитьПочту(Контакт) Тогда
        Попытка
            ОтправитьПисьмо(Контакт, Тема, Тело);
        Исключение
            Ошибка = "покупателю: " + ОписаниеОшибки();
        КонецПопытки;
    КонецЕсли;

    Менеджер = "";
    Если Сайт <> Неопределено Тогда
        Менеджер = СокрЛП(Строка(Сайт.ПочтаМенеджера));
    КонецЕсли;
    Если Не ПустаяСтрока(Менеджер) И Менеджер <> "<nil>" Тогда
        Попытка
            ОтправитьПисьмо(Менеджер, "Новый заказ с сайта: " + Номер,
                "Заказ " + Номер + " на сумму " + Состав.ИтогоСтрокой + Символы.ПС
                + "Покупатель: " + Имя + ", контакт: " + Контакт);
        Исключение
            Если Не ПустаяСтрока(Ошибка) Тогда
                Ошибка = Ошибка + "; ";
            КонецЕсли;
            Ошибка = Ошибка + "менеджеру: " + ОписаниеОшибки();
        КонецПопытки;
    КонецЕсли;

    Если ПустаяСтрока(Ошибка) Тогда
        Возврат;
    КонецЕсли;
    Объект = СсылкаЗаказа.ПолучитьОбъект();
    Объект.ОшибкаОтправкиПисьма = Лев(Ошибка, 500);
    Объект.Записать();
КонецПроцедуры

Функция НомерЗаказа(СсылкаЗаказа) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Номер ИЗ Документ.ЗаказПокупателя ГДЕ Ссылка = &Ид";
    З.УстановитьПараметр("Ид", СсылкаЗаказа.УникальныйИдентификатор());
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Рендер.ТекстЗначения(Стр.Номер);
    КонецЦикла;
    Возврат "";
КонецФункции

// НайтиЗаказ отдаёт данные для страницы /shop/order/<UUID>.
//
// Сайт в условии — не формальность: заказ соседнего сайта в одной базе не
// должен открываться по адресу этого.
Функция НайтиЗаказ(Сайт, Ид) Экспорт
    Если Сайт = Неопределено ИЛИ ПустаяСтрока(Ид) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Не Новый Регекс("^[0-9a-fA-F\-]{36}$").Совпадает(Ид) Тогда
        Возврат Неопределено;
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, Номер, Дата, Наименование, Контакт, Комментарий, Сумма, Статус
    |ИЗ Документ.ЗаказПокупателя
    |ГДЕ Ссылка = &Ид И Сайт = &Сайт";
    З.УстановитьПараметр("Ид", Ид);
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Для Каждого Стр Из З.Выполнить() Цикл
        Данные = Новый Структура;
        Данные.Вставить("Ид", Ид);
        Данные.Вставить("Номер", Рендер.ТекстЗначения(Стр.Номер));
        Данные.Вставить("Дата", Стр.Дата);
        Данные.Вставить("Имя", Рендер.ТекстЗначения(Стр.Наименование));
        Данные.Вставить("Контакт", Рендер.ТекстЗначения(Стр.Контакт));
        Данные.Вставить("Комментарий", Рендер.ТекстЗначения(Стр.Комментарий));
        Данные.Вставить("Статус", СтатусТекстом(Стр.Статус));
        Данные.Вставить("Строки", СтрокиЗаказа(Ид));
        Данные.Вставить("Итого", Роутер.ЦенаСтрокой(Число(Стр.Сумма), ВалютаЗаказа(Сайт)));
        Возврат Данные;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// СтрокиЗаказа читает табличную часть через объект: запросом строки табличных
// частей в этой платформе не выбираются.
Функция СтрокиЗаказа(Ид) Экспорт
    Результат = Новый Массив;
    Ссылка = Документы.ЗаказПокупателя.НайтиПоИдентификатору(Ид);
    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Результат;
    КонецЕсли;
    Объект = Ссылка.ПолучитьОбъект();
    Для Каждого Стр Из Объект.Товары Цикл
        Строка_ = Новый Структура;
        Строка_.Вставить("Заголовок", Рендер.ТекстЗначения(Стр.Наименование));
        Строка_.Вставить("Артикул", Рендер.ТекстЗначения(Стр.Артикул));
        Строка_.Вставить("Количество", Число(Стр.Количество));
        Строка_.Вставить("Цена", Роутер.ЦенаСтрокой(Число(Стр.Цена), ""));
        Строка_.Вставить("Сумма", Роутер.ЦенаСтрокой(Число(Стр.Сумма), ""));
        Результат.Добавить(Строка_);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// ВалютаЗаказа — валюта витрины сайта. В заказе она не хранится: пример ведёт
// одну валюту, и заводить реквизит ради строки в подписи незачем.
Функция ВалютаЗаказа(Сайт) Экспорт
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Валюта ИЗ Справочник.Товары ГДЕ Сайт = &Сайт";
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Для Каждого Стр Из З.Выполнить() Цикл
        Значение = Рендер.ТекстЗначения(Стр.Валюта);
        Если Не ПустаяСтрока(Значение) Тогда
            Возврат Значение;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция СтатусТекстом(Статус) Экспорт
    Значение = Рендер.ТекстЗначения(Статус);
    Если Значение = "Новый" Тогда
        Возврат "Принят, ждёт подтверждения";
    ИначеЕсли Значение = "ВРаботе" Тогда
        Возврат "В работе";
    ИначеЕсли Значение = "Выполнен" Тогда
        Возврат "Выполнен";
    ИначеЕсли Значение = "Отменён" Тогда
        Возврат "Отменён";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция Готово(Сообщение, Ид) Экспорт
    Р = Новый Структура;
    Р.Вставить("Код", 200);
    Р.Вставить("Сообщение", Сообщение);
    Р.Вставить("Ид", Ид);
    Возврат Р;
КонецФункции

Функция Отказ(Сообщение) Экспорт
    Р = Новый Структура;
    Р.Вставить("Код", 422);
    Р.Вставить("Сообщение", Сообщение);
    Р.Вставить("Ид", "");
    Возврат Р;
КонецФункции
