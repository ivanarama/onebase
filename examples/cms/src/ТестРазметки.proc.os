// Регресс-защита разметки: проверяется ГОТОВЫЙ HTML, а не промежуточные данные.
//
// Повод — незаполненная ссылка даёт не пустоту, а строку «<nil>»: она непустая
// и потому проходит и ПустаяСтрока(), и {{if}} в шаблоне. Позиция без картинки
// получала src="<nil>", браузер запрашивал несуществующий адрес и рисовал
// битую картинку, а в og:image «<nil>» уезжал в соцсети и в превью мессенджеров.
// Ни check, ни lint, ни тесты подбора контента этого не видели: данные-то
// находились правильные.
//
// Тест идёт той же цепочкой, что и посетитель: данные берутся у роутера,
// разметка собирается рендером — то есть ровно тем кодом, который вызывает
// Сайт.service.os. Проверять хелпер напрямую бессмысленно: зелёный тест на
// функции, которую прод не зовёт, опаснее отсутствующего.
Процедура Выполнить()
    // Свой сайт: тест не должен зависеть от демо-наполнения и от того, какие
    // сайты завели соседние тесты. Неактивный — чтобы не перехватывать выбор
    // сайта по умолчанию у других тестов той же базы.
    СайтОбъект = Справочники.Сайты.Создать();
    СайтОбъект.Наименование = "Тест разметки";
    СайтОбъект.Домен = "markup.example";
    СайтОбъект.ПрефиксПути = "hs/site/";
    СайтОбъект.Активен = Ложь;
    Сайт = СайтОбъект.Записать();
    // Структура собирается как в проде: рендер получает от роутера не ссылку,
    // а набор полей, и урезанная структура проверяла бы не тот путь.
    ПараметрыСайта = Новый Структура;
    ПараметрыСайта.Вставить("Ссылка", Сайт);
    ПараметрыСайта.Вставить("Домен", "markup.example");
    ПараметрыСайта.Вставить("ПрефиксПути", "hs/site/");

    // ─── новость без обложки ─────────────────────────────────────────────
    Новость = Справочники.Новости.Создать();
    Новость.Наименование = "Разметка без обложки";
    Новость.Слаг = "markup-no-cover";
    Новость.Анонс = "Анонс без картинки";
    Новость.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Новость.ДатаПубликации = ТекущаяДата();
    Новость.Сайт = Сайт;
    СсылкаНовости = Новость.Записать();

    Анонсы = Роутер.АнонсыНовостей(ПараметрыСайта, "");
    Утверждать.Равно(Анонсы.Количество(), 1, "предусловие: список новостей содержит созданную запись");
    Утверждать.Равно(Анонсы[0].Картинка, "", "новость без обложки даёт пустой адрес картинки, а не «<nil>»");

    HTMLСписка = Разметка(Рендер.СписокНовостей(ПараметрыСайта, Анонсы, "news"));
    БезNil(HTMLСписка, "список новостей");
    Утверждать.Ложь(СтрНайти(HTMLСписка, "<img") > 0,
        "без обложки картинка не рисуется вовсе, а не рисуется битой");

    Карточка = Роутер.НайтиНовость(ПараметрыСайта, "markup-no-cover");
    Утверждать.Заполнено(Карточка, "предусловие: карточка новости находится по слагу");
    HTMLКарточки = Разметка(Рендер.КарточкаНовости(ПараметрыСайта, Карточка, "news/markup-no-cover"));
    БезNil(HTMLКарточки, "карточка новости");
    Утверждать.Ложь(СтрНайти(HTMLКарточки, "og:image") > 0,
        "без обложки og:image не выводится — иначе соцсеть получит несуществующий адрес");

    // ─── товар и раздел каталога без картинки ────────────────────────────
    Раздел = Справочники.Товары.Создать();
    Раздел.Наименование = "Раздел без картинки";
    Раздел.Слаг = "markup-group";
    Раздел.is_folder = Истина;
    Раздел.Сайт = Сайт;
    СсылкаРаздела = Раздел.Записать();

    Товар = Справочники.Товары.Создать();
    Товар.Наименование = "Товар без картинки";
    Товар.Слаг = "markup-product";
    Товар.Цена = 100;
    Товар.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Товар.ДатаПубликации = ТекущаяДата();
    Товар.Родитель = СсылкаРаздела;
    Товар.Сайт = Сайт;
    Товар.Записать();

    Витрина = Роутер.ЭлементыКаталога(ПараметрыСайта, Неопределено);
    Утверждать.Равно(Витрина.Количество(), 1, "предусловие: витрина показывает раздел верхнего уровня");
    Утверждать.Равно(Витрина[0].Картинка, "", "раздел без картинки даёт пустой адрес, а не «<nil>»");
    БезNil(Разметка(Рендер.СписокТоваров(ПараметрыСайта, Неопределено, Витрина, "catalog")), "витрина каталога");

    Группа = Роутер.НайтиГруппуТоваров(ПараметрыСайта, "markup-group");
    Утверждать.Заполнено(Группа, "предусловие: раздел находится по слагу");
    ВРазделе = Роутер.ЭлементыКаталога(ПараметрыСайта, Группа.Ссылка);
    Утверждать.Равно(ВРазделе.Количество(), 1, "предусловие: раздел содержит товар");
    Утверждать.Равно(ВРазделе[0].Картинка, "", "товар без картинки даёт пустой адрес, а не «<nil>»");
    БезNil(Разметка(Рендер.СписокТоваров(ПараметрыСайта, Группа, ВРазделе, "catalog/markup-group")), "раздел каталога");

    НайденныйТовар = Роутер.НайтиТовар(ПараметрыСайта, "markup-product");
    Утверждать.Заполнено(НайденныйТовар, "предусловие: карточка товара находится по слагу");
    БезNil(Разметка(Рендер.КарточкаТовара(ПараметрыСайта, НайденныйТовар, "product/markup-product")),
        "карточка товара");

    // ─── страница поиска ─────────────────────────────────────────────────
    БезNil(Разметка(Рендер.СтраницаПоиска(ПараметрыСайта, "разметка", Анонсы)), "страница поиска");

    // ─── сайт без домена ─────────────────────────────────────────────────
    // Домен — необязательный реквизит: сайт заводят раньше, чем знают адрес.
    // Пока он пуст, canonical выводится относительным. Проверка именно здесь,
    // а не в тесте SEO: «https://<nil>/» — дефект РАЗМЕТКИ, он виден только в
    // готовой странице и уезжает в поисковую выдачу.
    БезДомена = Новый Структура;
    БезДомена.Вставить("Ссылка", Сайт);
    БезДомена.Вставить("ПрефиксПути", "hs/site/");
    Утверждать.Равно(SEO.БазовыйАдрес(БезДомена), "",
        "сайт без домена не получает выдуманный базовый адрес");
    Утверждать.Равно(SEO.Канонический(БезДомена, "news"), "",
        "без домена canonical не выводится вовсе — пустая строка гасит тег в шаблоне");
    БезNil(Разметка(Рендер.СписокНовостей(БезДомена, Анонсы, "news")), "список новостей без домена");

    // ─── пустая база встречает приглашением, а не ошибкой ────────────────
    // Администратор, открывший сайт сразу после migrate, видел 404 «Страница
    // не найдена» и решал, что сломалось. Сайт не сломан — он пустой, и это
    // разные вещи. Для несуществующих адресов 404 остаётся правильным.
    ПустойСайтОбъект = Справочники.Сайты.Создать();
    ПустойСайтОбъект.Наименование = "Тест пустого сайта";
    ПустойСайтОбъект.Домен = "empty.example";
    ПустойСайтОбъект.Активен = Ложь;
    ПустойСайт = Новый Структура;
    ПустойСайт.Вставить("Ссылка", ПустойСайтОбъект.Записать());

    Утверждать.Ложь(Роутер.ЕстьКонтент(ПустойСайт), "новый сайт считается пустым");
    // Обработать() без запроса берёт активный сайт, поэтому корень проверяем
    // напрямую через рендер — тем же вызовом, который делает роутер.
    Ответ = Рендер.СайтПуст(ПустойСайт);
    Утверждать.Равно(Ответ.КодСостояния, 200,
        "пустой сайт отвечает 200, а не ошибкой");
    HTMLПустого = Разметка(Ответ);
    БезNil(HTMLПустого, "страница пустого сайта");
    Утверждать.Истина(СтрНайти(HTMLПустого, "Страницы") > 0,
        "приглашение объясняет, где завести первую страницу");

    // Как только контент появился, приглашение больше не показывается.
    СтраницаПустого = Справочники.Страницы.Создать();
    СтраницаПустого.Наименование = "Первая страница пустого сайта";
    СтраницаПустого.Слаг = "empty-first";
    СтраницаПустого.СтатусПубликации = Перечисления.СтатусПубликации.Черновик;
    СтраницаПустого.Сайт = ПустойСайт.Ссылка;
    СтраницаПустого.Записать();
    // Черновик тоже считается: базой уже занимались, и приглашение «добавьте
    // первую страницу» стало бы неуместным.
    Утверждать.Истина(Роутер.ЕстьКонтент(ПустойСайт),
        "черновик считается контентом — приглашение уходит");

    // ─── экранирование не пострадало ─────────────────────────────────────
    // Заодно фиксируем, что защита от «<nil>» не превратилась в вырезание
    // угловых скобок вообще: имя со скриптом обязано приходить текстом.
    Опасная = Справочники.Новости.Создать();
    Опасная.Наименование = "Опасная <script>alert(1)</script>";
    Опасная.Слаг = "markup-xss";
    Опасная.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Опасная.ДатаПубликации = ТекущаяДата();
    Опасная.Сайт = Сайт;
    Опасная.Записать();

    HTMLСXSS = Разметка(Рендер.СписокНовостей(ПараметрыСайта,
        Роутер.АнонсыНовостей(ПараметрыСайта, ""), "news"));
    Утверждать.Ложь(СтрНайти(HTMLСXSS, "<script>alert(1)</script>") > 0,
        "имя со скриптом не попадает в разметку исполняемым тегом");
    Утверждать.Истина(СтрНайти(HTMLСXSS, "&lt;script&gt;") > 0,
        "имя со скриптом показывается посетителю текстом");
КонецПроцедуры

// Разметка достаёт тело ответа. Проверять надо именно его: код состояния у
// страницы с битой картинкой такой же 200, как у исправной.
Функция Разметка(Ответ)
    Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

// БезNil — общая проверка для всех страниц. «<nil>» ищется в трёх видах: как
// есть, экранированным html/template и процентно-кодированным в атрибуте
// адреса — именно в последнем виде дефект и попал в src.
Процедура БезNil(HTML, Где)
    Утверждать.Ложь(СтрНайти(HTML, "<nil>") > 0, Где + ": в разметке нет «<nil>»");
    Утверждать.Ложь(СтрНайти(HTML, "&lt;nil&gt;") > 0, Где + ": в разметке нет экранированного «<nil>»");
    // Не просто «нет вхождения», а сам фрагмент: при провале в отчёте видно
    // место, а не только факт. Иначе поиск виновного атрибута начинается с
    // ручного дампа страницы.
    Утверждать.Равно(Окрестность(HTML, "%3cnil%3e"), "",
        Где + ": в адресах нет кодированного «<nil>»");
КонецПроцедуры

// Окрестность возвращает кусок разметки вокруг искомого текста — или пустую
// строку, если его нет.
Функция Окрестность(HTML, Искомое)
    Поз = СтрНайти(НРег(HTML), Искомое);
    Если Поз = 0 Тогда
        Возврат "";
    КонецЕсли;
    Начало = Макс(1, Поз - 120);
    // Переносы схлопываются: многострочный фрагмент в отчёте обрезается по
    // первой строке, и виновный атрибут в него не попадает.
    Возврат СтрЗаменить(СтрЗаменить(Сред(HTML, Начало, 260), Символы.ПС, " "), Символы.ВК, " ");
КонецФункции
