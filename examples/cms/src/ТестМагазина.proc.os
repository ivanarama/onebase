// Регресс-защита корзины и заказа (план 156).
//
// Проверяется то, что не видно глазом на демонстрации: цена берётся из базы, а
// не из формы; чужая корзина не открывается; повторная отправка не плодит
// заказы. Разметку эти тесты не трогают — за ней следит ТестРазметки.
//
// Тест работает в одной базе с демо-контентом, поэтому заводит собственный сайт
// и собственные товары.
Процедура Выполнить()
    СайтОбъект = Справочники.Сайты.Создать();
    СайтОбъект.Наименование = "Тест магазина";
    СайтОбъект.Домен = "shop-test.local";
    СайтОбъект.ПрефиксПути = "hs/site/";
    СайтОбъект.Активен = Истина;
    Сайт = СайтОбъект.Записать();
    // Структура параметров собирается вручную по той же причине, что и в
    // ТестРоутера: ТекущийСайт выбирает сайт по заголовку Host, а его здесь нет.
    Параметры = Новый Структура;
    Параметры.Вставить("Ссылка", Сайт);
    Параметры.Вставить("ПрефиксПути", "hs/site/");
    Параметры.Вставить("ПочтаМенеджера", "");
    Параметры.Вставить("ПриёмЗаказов", Истина);

    ЧужойСайт = Справочники.Сайты.Создать();
    ЧужойСайт.Наименование = "Тест магазина — соседний сайт";
    ЧужойСайт.Домен = "shop-neighbour.local";
    ЧужойСайт.Активен = Истина;
    СсылкаЧужого = ЧужойСайт.Записать();
    ПараметрыЧужого = Новый Структура;
    ПараметрыЧужого.Вставить("Ссылка", СсылкаЧужого);
    ПараметрыЧужого.Вставить("ПрефиксПути", "");
    ПараметрыЧужого.Вставить("ПочтаМенеджера", "");
    ПараметрыЧужого.Вставить("ПриёмЗаказов", Истина);

    Ведро = СоздатьТовар("Тест ведро", "test-vedro", 120, Сайт, Перечисления.СтатусПубликации.Опубликовано);
    Швабра = СоздатьТовар("Тест швабра", "test-shvabra", 350, Сайт, Перечисления.СтатусПубликации.Опубликовано);
    Черновик = СоздатьТовар("Тест черновик", "test-draft-tovar", 900, Сайт, Перечисления.СтатусПубликации.Черновик);

    // ─── приём заказов выключается у сайта ───────────────────────────────
    БезЗаказов = Новый Структура;
    БезЗаказов.Вставить("Ссылка", Сайт);
    БезЗаказов.Вставить("ПрефиксПути", "hs/site/");
    БезЗаказов.Вставить("ПочтаМенеджера", "");
    БезЗаказов.Вставить("ПриёмЗаказов", Ложь);
    Утверждать.Ложь(Рендер.ПриёмЗаказов(БезЗаказов), "снятый флаг выключает корзину");
    Утверждать.Истина(Рендер.ПриёмЗаказов(Параметры), "поднятый флаг включает корзину");
    Утверждать.Ложь(Рендер.ПриёмЗаказов(Неопределено), "без сайта корзины нет");

    // ─── разбор куки ─────────────────────────────────────────────────────
    Ид = "3f2504e0-4f89-11d3-9a0c-0305e82c3301";
    Утверждать.Равно(Корзина.ИдИзКуки("ob_cart=" + Ид), Ид, "кука читается");
    Утверждать.Равно(Корзина.ИдИзКуки("other=1; ob_cart=" + Ид + "; third=2"), Ид,
        "кука читается среди соседних");
    Утверждать.Равно(Корзина.ИдИзКуки("ob_cart=не-uuid"), "",
        "значение не похожее на UUID отбрасывается до запроса в базу");
    Утверждать.Равно(Корзина.ИдИзКуки(""), "", "пустой заголовок не ломает разбор");

    // ─── защита от запроса с чужого сайта ────────────────────────────────
    Утверждать.Истина(Корзина.ИсточникСовпадает("shop-test.local", "https://shop-test.local/hs/site/product/x"),
        "свой источник проходит");
    Утверждать.Ложь(Корзина.ИсточникСовпадает("shop-test.local", "https://evil.example/attack.html"),
        "чужой источник отвергается");
    Утверждать.Ложь(Корзина.ИсточникСовпадает("shop-test.local", ""),
        "запрос без Origin и Referer отвергается");
    // Подделка «своё имя как приставка к чужому домену» — классический обход
    // сравнения по вхождению строки.
    Утверждать.Ложь(Корзина.ИсточникСовпадает("shop-test.local", "https://shop-test.local.evil.example/x"),
        "домен-приставка не считается своим");

    // ─── количество ──────────────────────────────────────────────────────
    Утверждать.Равно(Корзина.ПроверитьКоличество("3"), 3, "обычное количество принимается");
    Утверждать.Равно(Корзина.ПроверитьКоличество("0"), 0, "ноль отвергается");
    Утверждать.Равно(Корзина.ПроверитьКоличество("-2"), 0, "отрицательное отвергается");
    Утверждать.Равно(Корзина.ПроверитьКоличество("2,5"), 0, "дробное отвергается");
    Утверждать.Равно(Корзина.ПроверитьКоличество("1000"), 0, "выше предела отвергается");
    Утверждать.Равно(Корзина.ПроверитьКоличество(""), 0, "пустое отвергается");

    // ─── товар из браузера ───────────────────────────────────────────────
    Утверждать.Заполнено(Корзина.НайтиТовар(Параметры, Ведро.УникальныйИдентификатор()), "опубликованный товар находится");
    Утверждать.Равно(Корзина.НайтиТовар(Параметры, Черновик.УникальныйИдентификатор()), Неопределено,
        "черновик в корзину не попадает");
    Утверждать.Равно(Корзина.НайтиТовар(ПараметрыЧужого, Ведро.УникальныйИдентификатор()), Неопределено,
        "товар соседнего сайта недоступен");
    Утверждать.Равно(Корзина.НайтиТовар(Параметры, "не-uuid"), Неопределено,
        "мусор вместо идентификатора отвергается");

    // ─── наполнение корзины ──────────────────────────────────────────────
    Описание = Корзина.ЗавестиКорзину(Параметры);
    Утверждать.Заполнено(Описание.Ид, "у новой корзины есть идентификатор");
    Утверждать.Ложь(Описание.Оформлена, "новая корзина не оформлена");

    Результат = Корзина.Положить(Параметры, Описание, Ведро.УникальныйИдентификатор(), "2");
    Утверждать.Равно(Результат.Код, 200, "товар кладётся в корзину");
    Состав = Корзина.Содержимое(Параметры, Описание);
    Утверждать.Равно(Состав.Позиций, 1, "в корзине одна позиция");
    Утверждать.Равно(Состав.Строки[0].Количество, 2, "количество сохранено");
    // Цена приходит из справочника, а не из формы: 120 × 2.
    Утверждать.Равно(Состав.Итого, 240, "итог считается по цене справочника");

    // Повторное добавление того же товара увеличивает количество, а не
    // создаёт вторую строку — иначе корзина заполняется дублями.
    Корзина.Положить(Параметры, Описание, Ведро.УникальныйИдентификатор(), "3");
    Состав = Корзина.Содержимое(Параметры, Описание);
    Утверждать.Равно(Состав.Позиций, 1, "повтор не создаёт вторую строку");
    Утверждать.Равно(Состав.Строки[0].Количество, 5, "количество суммируется");

    Утверждать.Равно(Корзина.Положить(Параметры, Описание, Черновик.УникальныйИдентификатор(), "1").Код, 422,
        "снятый с публикации товар в корзину не кладётся");
    Утверждать.Равно(Корзина.Положить(Параметры, Описание, Ведро.УникальныйИдентификатор(), "0").Код, 422,
        "нулевое количество отвергается");

    // ─── чужая корзина ───────────────────────────────────────────────────
    Утверждать.Равно(Корзина.НайтиКорзину(ПараметрыЧужого, Описание.Ид), Неопределено,
        "корзина не открывается с соседнего сайта");
    Утверждать.Равно(Корзина.НайтиКорзину(Параметры, "3f2504e0-4f89-11d3-9a0c-0305e82c3399"),
        Неопределено, "подобранный идентификатор не отдаёт чужую корзину");

    // ─── изменение и удаление ────────────────────────────────────────────
    Корзина.Положить(Параметры, Описание, Швабра.УникальныйИдентификатор(), "1");
    Корзина.Изменить(Параметры, Описание, Ведро.УникальныйИдентификатор(), "1", Ложь);
    Состав = Корзина.Содержимое(Параметры, Описание);
    Утверждать.Равно(Состав.Позиций, 2, "в корзине две позиции");
    Утверждать.Равно(Состав.Итого, 470, "итог пересчитан: 120 + 350");

    Корзина.Изменить(Параметры, Описание, Швабра.УникальныйИдентификатор(), "", Истина);
    Состав = Корзина.Содержимое(Параметры, Описание);
    Утверждать.Равно(Состав.Позиций, 1, "позиция удалена");
    Утверждать.Равно(Состав.Итого, 120, "итог после удаления");

    // ─── оформление ──────────────────────────────────────────────────────
    Утверждать.Равно(Заказы.Оформить(Параметры, Описание, ДанныеФормы("", "ivan@example.com", "")).Код, 422,
        "без имени заказ не оформляется");
    Утверждать.Равно(Заказы.Оформить(Параметры, Описание, ДанныеФормы("Иван", "", "")).Код, 422,
        "без контакта заказ не оформляется");
    Утверждать.Равно(Заказы.Оформить(Параметры, Описание, ДанныеФормы("Иван", "не почта и не телефон", "")).Код, 422,
        "негодный контакт отвергается");

    Оформление = Заказы.Оформить(Параметры, Описание, ДанныеФормы("Иван", "ivan@example.com", "Позвоните после обеда"));
    Утверждать.Равно(Оформление.Код, 200, "заказ оформляется");
    Утверждать.Заполнено(Оформление.Ид, "оформление возвращает идентификатор заказа");

    Заказ = Заказы.НайтиЗаказ(Параметры, Оформление.Ид);
    Утверждать.Заполнено(Заказ, "заказ открывается по своей ссылке");
    Утверждать.Равно(Заказ.Строки.Количество(), 1, "в заказе одна строка");
    Утверждать.Равно(Заказ.Строки[0].Заголовок, "Тест ведро", "наименование зафиксировано в заказе");
    Утверждать.Равно(Заказ.Имя, "Иван", "имя покупателя сохранено");
    Утверждать.Равно(Заказы.НайтиЗаказ(ПараметрыЧужого, Оформление.Ид), Неопределено,
        "заказ не открывается с соседнего сайта");

    // Корзина после оформления пуста и закрыта: иначе «дозаказ» дописывал бы
    // строки в уже отданный менеджеру заказ.
    Закрытая = Корзина.НайтиКорзину(Параметры, Описание.Ид);
    Утверждать.Истина(Закрытая.Оформлена, "корзина помечена оформленной");
    Утверждать.Равно(Корзина.Содержимое(Параметры, Закрытая).Позиций, 0, "корзина очищена");

    // ─── повторная отправка формы ────────────────────────────────────────
    Повтор = Заказы.Оформить(Параметры, Закрытая, ДанныеФормы("Иван", "ivan@example.com", ""));
    Утверждать.Равно(Повтор.Код, 200, "повторная отправка не отвечает ошибкой");
    Утверждать.Равно(Повтор.Ид, Оформление.Ид, "повторная отправка ведёт на тот же заказ");
    Утверждать.Равно(КоличествоЗаказов(Сайт), 1, "второй заказ не создан");

    // ─── цена не берётся из формы ────────────────────────────────────────
    // Прямая проверка обещания «цену определяет база»: в форме приходит только
    // товар и количество, поле цены игнорируется целиком.
    Вторая = Корзина.ЗавестиКорзину(Параметры);
    Корзина.Положить(Параметры, Вторая, Швабра.УникальныйИдентификатор(), "2");
    Данные = ДанныеФормы("Пётр", "+7 999 000-11-22", "");
    Данные.Вставить("price", "1");
    Данные.Вставить("total", "1");
    ВтороеОформление = Заказы.Оформить(Параметры, Вторая, Данные);
    Утверждать.Равно(ВтороеОформление.Код, 200, "второй заказ оформляется");
    ЗаказПётр = Заказы.НайтиЗаказ(Параметры, ВтороеОформление.Ид);
    Утверждать.Равно(ЗаказПётр.Строки[0].Количество, 2, "количество из формы принято");
    Утверждать.Равно(СуммаЗаказа(ВтороеОформление.Ид), 700, "сумма посчитана по базе: 350 × 2");
КонецПроцедуры

Функция СоздатьТовар(Наименование, Слаг, Цена, Сайт, Статус)
    Товар = Справочники.Товары.Создать();
    Товар.Наименование = Наименование;
    Товар.Слаг = Слаг;
    Товар.Цена = Цена;
    Товар.Валюта = "RUB";
    Товар.Артикул = "T-" + Слаг;
    Товар.СтатусПубликации = Статус;
    Товар.Сайт = Сайт;
    Возврат Товар.Записать();
КонецФункции

Функция ДанныеФормы(Имя, Контакт, Комментарий)
    Данные = Новый Соответствие;
    Данные.Вставить("name", Имя);
    Данные.Вставить("contact", Контакт);
    Данные.Вставить("comment", Комментарий);
    Возврат Данные;
КонецФункции

Функция КоличествоЗаказов(Сайт)
    Счётчик = 0;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказПокупателя ГДЕ Сайт = &Сайт";
    З.УстановитьПараметр("Сайт", Сайт);
    Для Каждого Стр Из З.Выполнить() Цикл
        Счётчик = Счётчик + 1;
    КонецЦикла;
    Возврат Счётчик;
КонецФункции

Функция СуммаЗаказа(Ид)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Сумма ИЗ Документ.ЗаказПокупателя ГДЕ Ссылка = &Ид";
    З.УстановитьПараметр("Ид", Ид);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Число(Стр.Сумма);
    КонецЦикла;
    Возврат 0;
КонецФункции
