// Модель рабочего места менеджера. Цены и названия уже оформленного заказа
// остаются снимком: при смене статуса товары из каталога не перечитываются.
Процедура ПроверитьПолучение(Заказ) Экспорт
    Если ЗначениеЗаполнено(Заказ.АдресДоставки) Тогда
        Если НЕ ЗначениеЗаполнено(Заказ.Покупатель) Тогда
            ВызватьИсключение "Сначала выберите покупателя";
        КонецЕсли;
        Адрес = Заказ.АдресДоставки.ПолучитьОбъект();
        Если Адрес.Владелец <> Заказ.Покупатель Тогда
            ВызватьИсключение "Адрес принадлежит другому покупателю";
        КонецЕсли;
    КонецЕсли;
    Если ЗначениеЗаполнено(Заказ.ПунктВыдачи) Тогда
        Если НЕ ЗначениеЗаполнено(Заказ.Город) Тогда
            ВызватьИсключение "Сначала выберите город";
        КонецЕсли;
        Пункт = Заказ.ПунктВыдачи.ПолучитьОбъект();
        Если Пункт.Владелец <> Заказ.Город Тогда
            ВызватьИсключение "Пункт выдачи находится в другом городе";
        КонецЕсли;
    КонецЕсли;
    Если Строка(Заказ.СпособПолучения) = "Доставка" И ЗначениеЗаполнено(Заказ.ПунктВыдачи) Тогда
        ВызватьИсключение "Для доставки очистите пункт выдачи";
    КонецЕсли;
    Если Строка(Заказ.СпособПолучения) = "Самовывоз" И ЗначениеЗаполнено(Заказ.АдресДоставки) Тогда
        ВызватьИсключение "Для самовывоза очистите адрес доставки";
    КонецЕсли;
КонецПроцедуры

Процедура Пересчитать(Заказ) Экспорт
    Итог = 0;
    Для Каждого Стр Из Заказ.Товары Цикл
        Если Стр.Количество <= 0 ИЛИ Стр.Цена < 0 Тогда
            ВызватьИсключение "Количество должно быть положительным, цена — неотрицательной";
        КонецЕсли;
        Стр.Сумма = Стр.Количество * Стр.Цена;
        Итог = Итог + Стр.Сумма;
    КонецЦикла;
    Заказ.Сумма = Итог;
КонецПроцедуры

Процедура ПроверитьПодтверждение(Заказ) Экспорт
    ПроверитьПолучение(Заказ);
    Если Заказ.Товары.Количество() = 0 Тогда
        ВызватьИсключение "Добавьте товары";
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Заказ.Покупатель) Тогда
        ВызватьИсключение "Свяжите заказ с покупателем";
    КонецЕсли;
    Если Строка(Заказ.СпособПолучения) = "Доставка" Тогда
        Если НЕ ЗначениеЗаполнено(Заказ.АдресДоставки) Тогда
            ВызватьИсключение "Укажите адрес доставки";
        КонецЕсли;
    ИначеЕсли Строка(Заказ.СпособПолучения) = "Самовывоз" Тогда
        Если НЕ ЗначениеЗаполнено(Заказ.ПунктВыдачи) Тогда
            ВызватьИсключение "Укажите пункт выдачи";
        КонецЕсли;
    Иначе
        ВызватьИсключение "Укажите способ получения";
    КонецЕсли;
    Пересчитать(Заказ);
КонецПроцедуры
