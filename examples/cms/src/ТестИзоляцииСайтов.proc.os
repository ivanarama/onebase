// Регресс-защита многосайтовости: одинаковые публичные адреса допустимы у
// разных сайтов, но ни одна выборка не должна возвращать соседний контент.
Процедура Выполнить()
    СайтА = СоздатьСайт("Изоляция А", "isolation-a.example");
    СайтБ = СоздатьСайт("Изоляция Б", "isolation-b.example");

    // Один и тот же слаг обязан разрешаться внутри выбранного сайта.
    СоздатьСтраницу(СайтА.Ссылка, "Страница сайта А", "shared-slug");
    СоздатьСтраницу(СайтБ.Ссылка, "Страница сайта Б", "shared-slug");
    СоздатьСтраницу(СайтА.Ссылка, "Только сайт А", "only-site-a");
    СоздатьСтраницу(СайтБ.Ссылка, "Только сайт Б", "only-site-b");

    Утверждать.Равно(Роутер.НайтиСтраницу(СайтА, "shared-slug").Заголовок,
        "Страница сайта А", "сайт А получает свою страницу при одинаковом слаге");
    Утверждать.Равно(Роутер.НайтиСтраницу(СайтБ, "shared-slug").Заголовок,
        "Страница сайта Б", "сайт Б получает свою страницу при одинаковом слаге");
    Утверждать.Равно(Роутер.НайтиСтраницу(СайтБ, "only-site-a"), Неопределено,
        "отсутствующая страница не подменяется страницей другого сайта");

    ПоискА = Роутер.НайтиПоТексту(СайтА, "Страница");
    Утверждать.Равно(ПоискА.Количество(), 1,
        "полнотекстовая выдача содержит совпадения только выбранного сайта");
    Утверждать.Равно(ПоискА[0].Заголовок, "Страница сайта А",
        "полнотекстовый поиск не возвращает одноимённый материал соседнего сайта");

    // Совпадающий шаблон маршрута может означать разный контент на сайтах.
    СоздатьМаршрут(СайтА.Ссылка, "Маршрут сайта А", "shared-route/{слаг}", "Новости");
    СоздатьМаршрут(СайтБ.Ссылка, "Маршрут сайта Б", "shared-route/{слаг}", "Товар");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(СайтА, "shared-route/item").ТипКонтента,
        "Новости", "маршрут сайта А не перекрывается правилом сайта Б");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(СайтБ, "shared-route/item").ТипКонтента,
        "Товар", "маршрут сайта Б не перекрывается правилом сайта А");

    // Код меню одинаков, различается только владелец записи.
    СоздатьПунктМеню(СайтА.Ссылка, "Пункт сайта А", "shared-menu", "/site-a");
    СоздатьПунктМеню(СайтБ.Ссылка, "Пункт сайта Б", "shared-menu", "/site-b");
    МенюА = Меню.Пункты(СайтА, "shared-menu", "");
    МенюБ = Меню.Пункты(СайтБ, "shared-menu", "");
    Утверждать.Равно(МенюА.Количество(), 1, "меню сайта А содержит только свой пункт");
    Утверждать.Равно(МенюБ.Количество(), 1, "меню сайта Б содержит только свой пункт");
    Утверждать.Равно(МенюА[0].Заголовок, "Пункт сайта А", "сайт А не видит пункт сайта Б");
    Утверждать.Равно(МенюБ[0].Заголовок, "Пункт сайта Б", "сайт Б не видит пункт сайта А");

    // Остальные публичные карточки и списки используют тот же параметр Сайт.
    СоздатьНовость(СайтА.Ссылка, "Новость сайта А", "shared-news");
    СоздатьНовость(СайтБ.Ссылка, "Новость сайта Б", "shared-news");
    Утверждать.Равно(Роутер.НайтиНовость(СайтА, "shared-news").Наименование,
        "Новость сайта А", "карточка новости изолирована по сайту");
    Утверждать.Равно(Роутер.АнонсыНовостей(СайтБ, "")[0].Заголовок,
        "Новость сайта Б", "список новостей изолирован по сайту");

    ГруппаА = СоздатьГруппу(СайтА.Ссылка, "Группа сайта А", "shared-group");
    ГруппаБ = СоздатьГруппу(СайтБ.Ссылка, "Группа сайта Б", "shared-group");
    СоздатьТовар(СайтА.Ссылка, ГруппаА, "Товар сайта А", "shared-product");
    СоздатьТовар(СайтБ.Ссылка, ГруппаБ, "Товар сайта Б", "shared-product");
    Утверждать.Равно(Роутер.НайтиГруппуТоваров(СайтА, "shared-group").Наименование,
        "Группа сайта А", "группа каталога изолирована по сайту");
    Утверждать.Равно(Роутер.НайтиТовар(СайтБ, "shared-product").Наименование,
        "Товар сайта Б", "карточка товара изолирована по сайту");
    Утверждать.Равно(Роутер.ЭлементыКаталога(СайтА, Неопределено)[0].Заголовок,
        "Группа сайта А", "витрина каталога не содержит группу другого сайта");

    СоздатьРедирект(СайтА.Ссылка, "Редирект сайта А", "shared-old", "/site-a");
    СоздатьРедирект(СайтБ.Ссылка, "Редирект сайта Б", "shared-old", "/site-b");
    Утверждать.Равно(Роутер.НайтиРедирект(СайтА, "shared-old").Куда,
        "/site-a", "редирект выбирается только внутри текущего сайта");

    КартаА = SEO.Sitemap(СайтА);
    Утверждать.Истина(СтрНайти(КартаА, "only-site-a") > 0,
        "sitemap содержит адрес своего сайта");
    Утверждать.Равно(СтрНайти(КартаА, "only-site-b"), 0,
        "sitemap не содержит адрес другого сайта");
КонецПроцедуры

Функция СоздатьСайт(Наименование, Домен)
    Объект = Справочники.Сайты.Создать();
    Объект.Наименование = Наименование;
    Объект.Домен = Домен;
    Объект.ПрефиксПути = "/hs/site";
    Объект.Активен = Истина;
    Ссылка = Объект.Записать();

    Параметры = Новый Структура;
    Параметры.Вставить("Ссылка", Ссылка);
    Параметры.Вставить("Наименование", Наименование);
    Параметры.Вставить("Домен", Домен);
    Параметры.Вставить("ПрефиксПути", "/hs/site");
    Возврат Параметры;
КонецФункции

Процедура СоздатьСтраницу(Сайт, Наименование, Слаг)
    Стр = Справочники.Страницы.Создать();
    Стр.Наименование = Наименование;
    Стр.Заголовок = Наименование;
    Стр.Слаг = Слаг;
    Стр.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Стр.ДатаПубликации = ТекущаяДата();
    Стр.Сайт = Сайт;
    Стр.Записать();
КонецПроцедуры

Процедура СоздатьМаршрут(Сайт, Наименование, Шаблон, ТипКонтента)
    Маршрут = Справочники.МаршрутыURL.Создать();
    Маршрут.Наименование = Наименование;
    Маршрут.Шаблон = Шаблон;
    Маршрут.ТипКонтента = ТипКонтента;
    Маршрут.Приоритет = 1;
    Маршрут.Активен = Истина;
    Маршрут.Сайт = Сайт;
    Маршрут.Записать();
КонецПроцедуры

Процедура СоздатьПунктМеню(Сайт, Наименование, Код, Адрес)
    Пункт = Справочники.Меню.Создать();
    Пункт.Наименование = Наименование;
    Пункт.КодМеню = Код;
    Пункт.ТипСсылки = Перечисления.ТипСсылкиМеню.ВнешнийАдрес;
    Пункт.Адрес = Адрес;
    Пункт.Порядок = 1;
    Пункт.Активен = Истина;
    Пункт.Сайт = Сайт;
    Пункт.Записать();
КонецПроцедуры

Процедура СоздатьНовость(Сайт, Наименование, Слаг)
    Новость = Справочники.Новости.Создать();
    Новость.Наименование = Наименование;
    Новость.Слаг = Слаг;
    Новость.Анонс = Наименование;
    Новость.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Новость.ДатаПубликации = ТекущаяДата();
    Новость.Сайт = Сайт;
    Новость.Записать();
КонецПроцедуры

Функция СоздатьГруппу(Сайт, Наименование, Слаг)
    Группа = Справочники.Товары.Создать();
    Группа.Наименование = Наименование;
    Группа.Слаг = Слаг;
    Группа.is_folder = Истина;
    Группа.Сайт = Сайт;
    Возврат Группа.Записать();
КонецФункции

Процедура СоздатьТовар(Сайт, Родитель, Наименование, Слаг)
    Товар = Справочники.Товары.Создать();
    Товар.Наименование = Наименование;
    Товар.Слаг = Слаг;
    Товар.parent_id = Родитель;
    Товар.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Товар.ДатаПубликации = ТекущаяДата();
    Товар.Сайт = Сайт;
    Товар.Записать();
КонецПроцедуры

Процедура СоздатьРедирект(Сайт, Наименование, Откуда, Куда)
    Редирект = Справочники.Редиректы.Создать();
    Редирект.Наименование = Наименование;
    Редирект.Откуда = Откуда;
    Редирект.Куда = Куда;
    Редирект.Код = 301;
    Редирект.Активен = Истина;
    Редирект.Сайт = Сайт;
    Редирект.Записать();
КонецПроцедуры
