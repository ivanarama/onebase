// Ежедневная очистка удаляет только брошенные корзины. Оформленные корзины
// сохраняются вместе со ссылкой на заказ: это история уже совершённой операции,
// а не временное состояние анонимного посетителя.
Процедура Выполнить() Экспорт
    Граница = ДобавитьДень(ТекущаяДатаВремя(), -45);
    ВсегоУдалено = 0;

    Пока Истина Цикл
        Запрос = Новый Запрос;
        // Порция ограничивает память и длительность одной выборки. Цикл берёт
        // следующую сотню, поэтому накопившийся хвост убирается за один запуск,
        // не загружаясь целиком.
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
        |  Ссылка
        |ИЗ Справочник.Корзины
        |ГДЕ Оформлена = &Оформлена
        |  И Дата < &Граница
        |УПОРЯДОЧИТЬ ПО Дата, Ссылка";
        Запрос.УстановитьПараметр("Оформлена", Ложь);
        Запрос.УстановитьПараметр("Граница", Граница);
        Строки = Запрос.Выполнить();
        Выбрано = Строки.Количество();

        Для Каждого Стр Из Строки Цикл
            // Поле Ссылка результата запроса — UUID-строка. Повторный поиск
            // возвращает связанную с менеджером ссылку, у которой Удалить()
            // идёт штатным delete-path и каскадно очищает табличную часть.
            Ссылка = Справочники.Корзины.НайтиПоИдентификатору(Строка(Стр.Ссылка));
            Если Не ЗначениеЗаполнено(Ссылка) Тогда
                Продолжить;
            КонецЕсли;

            // Между выборкой и удалением корзину могли оформить или обновить.
            // Перечитываем её непосредственно перед необратимой операцией.
            Объект = Ссылка.ПолучитьОбъект();
            Если Объект.Оформлена = Истина
                ИЛИ Не ЗначениеЗаполнено(Объект.Дата)
                ИЛИ Объект.Дата >= Граница Тогда
                Продолжить;
            КонецЕсли;

            // Удаление связано с _version, которую ПолучитьОбъект() прочитал
            // вместе с проверенными полями. Если корзину успели изменить между
            // проверкой и DELETE, новая версия остаётся на месте.
            Если Объект.УдалитьЕслиНеИзменен() Тогда
                ВсегоУдалено = ВсегоУдалено + 1;
            КонецЕсли;
        КонецЦикла;

        Если Выбрано < 100 Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Сообщить("Очистка корзин: удалено " + Строка(ВсегоУдалено) + ".");
КонецПроцедуры
