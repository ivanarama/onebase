// HTTP-обработчики корзины и заказа (план 156, слайсы S2–S5).
//
// Обработчики тонкие: разбор и правила — в Корзина.module.os и Заказы.module.os,
// чтобы их можно было проверить обработкой `kind: test` без поднятого сервера.
// Функции внутри одного .service.os друг друга НЕ видят, поэтому общего
// помощника здесь нет ни одного — всё общее живёт в модулях.

// GET /cart — корзина посетителя.
//
// Имя обработчика — ПоказатьКорзину, а не Корзина: модуль корзины называется
// Корзина, и одноимённая функция в этом же файле перекрыла бы обращения к нему.
Функция ПоказатьКорзину(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Если Сайт = Неопределено Тогда
        Возврат Рендер.АдресНеПривязан(Роутер.ХостЗапроса(Запрос));
    КонецЕсли;
    Если Не Рендер.ПриёмЗаказов(Сайт) Тогда
        // Выключенный приём заказов закрывает адреса магазина, а не только
        // прячет кнопку: обработчик, отвечающий при снятом флаге, — это
        // «выключено на вид». 404, а не 403: сайта-магазина здесь просто нет.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Страница не найдена",
            "Этот сайт не принимает заказы через корзину.");
    КонецЕсли;
    Описание = Корзина.НайтиКорзину(Сайт, Корзина.ЗначениеКуки(Запрос));
    Состав = Корзина.Содержимое(Сайт, Описание);
    Возврат Рендер.СтраницаКорзины(Сайт, Состав, "", 200);
КонецФункции

// POST /cart/add — «В корзину» из карточки товара.
//
// Успех отвечает редиректом (303), а не страницей: перезагрузка после POST
// иначе повторяет добавление, и у покупателя вместо одной коробки шесть.
// Отказ, наоборот, отдаётся страницей — редирект потерял бы объяснение.
Функция ДобавитьВКорзину(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Если Сайт = Неопределено Тогда
        Возврат Рендер.АдресНеПривязан(Роутер.ХостЗапроса(Запрос));
    КонецЕсли;
    Если Не Рендер.ПриёмЗаказов(Сайт) Тогда
        // Выключенный приём заказов закрывает адреса магазина, а не только
        // прячет кнопку: обработчик, отвечающий при снятом флаге, — это
        // «выключено на вид». 404, а не 403: сайта-магазина здесь просто нет.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Страница не найдена",
            "Этот сайт не принимает заказы через корзину.");
    КонецЕсли;
    Если Не Корзина.ПроверитьИсточник(Запрос) Тогда
        Возврат Рендер.СтраницаСообщение(Сайт, 403, "Запрос отклонён",
            "Похоже, форма отправлена не с этого сайта. Откройте страницу товара заново.");
    КонецЕсли;

    Данные = Запрос.ФормаДанные();
    Описание = Корзина.НайтиКорзину(Сайт, Корзина.ЗначениеКуки(Запрос));
    Новая = Ложь;
    // Оформленная корзина не пополняется: её строки уже уехали в документ.
    // Посетитель, вернувшийся «дозаказать», начинает новую — это обычный путь,
    // а не ошибка.
    Если Описание = Неопределено ИЛИ Описание.Оформлена Тогда
        Описание = Корзина.ЗавестиКорзину(Сайт);
        Новая = Истина;
    КонецЕсли;

    Результат = Корзина.Положить(Сайт, Описание, Формы.Поле(Данные, "product"),
        Формы.Поле(Данные, "qty"));
    Если Результат.Код <> 200 Тогда
        Состав = Корзина.Содержимое(Сайт, Описание);
        Ответ = Рендер.СтраницаКорзины(Сайт, Состав, Результат.Сообщение, Результат.Код);
        Если Новая Тогда
            Ответ.УстановитьЗаголовок("Set-Cookie",
                Корзина.ЗаголовокКуки(Запрос, Сайт, Описание.Ид));
        КонецЕсли;
        Возврат Ответ;
    КонецЕсли;

    Ответ = Рендер.Редирект(SEO.ПрефиксСервиса(Сайт, "shop") + "/cart", 303);
    Если Новая Тогда
        Ответ.УстановитьЗаголовок("Set-Cookie",
            Корзина.ЗаголовокКуки(Запрос, Сайт, Описание.Ид));
    КонецЕсли;
    Возврат Ответ;
КонецФункции

// POST /cart/update — изменение количества и удаление позиции.
Функция ИзменитьКорзину(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Если Сайт = Неопределено Тогда
        Возврат Рендер.АдресНеПривязан(Роутер.ХостЗапроса(Запрос));
    КонецЕсли;
    Если Не Рендер.ПриёмЗаказов(Сайт) Тогда
        // Выключенный приём заказов закрывает адреса магазина, а не только
        // прячет кнопку: обработчик, отвечающий при снятом флаге, — это
        // «выключено на вид». 404, а не 403: сайта-магазина здесь просто нет.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Страница не найдена",
            "Этот сайт не принимает заказы через корзину.");
    КонецЕсли;
    Если Не Корзина.ПроверитьИсточник(Запрос) Тогда
        Возврат Рендер.СтраницаСообщение(Сайт, 403, "Запрос отклонён",
            "Похоже, форма отправлена не с этого сайта. Откройте корзину заново.");
    КонецЕсли;

    Описание = Корзина.НайтиКорзину(Сайт, Корзина.ЗначениеКуки(Запрос));
    Если Описание = Неопределено ИЛИ Описание.Оформлена Тогда
        // Корзины уже нет — показываем пустую, а не ошибку: посетитель, скорее
        // всего, оформил заказ во второй вкладке.
        Возврат Рендер.Редирект(SEO.ПрефиксСервиса(Сайт, "shop") + "/cart", 303);
    КонецЕсли;

    Данные = Запрос.ФормаДанные();
    Удалить = НРег(Формы.Поле(Данные, "action")) = "remove";
    Результат = Корзина.Изменить(Сайт, Описание, Формы.Поле(Данные, "product"),
        Формы.Поле(Данные, "qty"), Удалить);
    Если Результат.Код <> 200 Тогда
        Состав = Корзина.Содержимое(Сайт, Описание);
        Возврат Рендер.СтраницаКорзины(Сайт, Состав, Результат.Сообщение, Результат.Код);
    КонецЕсли;
    Возврат Рендер.Редирект(SEO.ПрефиксСервиса(Сайт, "shop") + "/cart", 303);
КонецФункции

// GET /checkout — форма контактов поверх состава корзины.
Функция ФормаЗаказа(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Если Сайт = Неопределено Тогда
        Возврат Рендер.АдресНеПривязан(Роутер.ХостЗапроса(Запрос));
    КонецЕсли;
    Если Не Рендер.ПриёмЗаказов(Сайт) Тогда
        // Выключенный приём заказов закрывает адреса магазина, а не только
        // прячет кнопку: обработчик, отвечающий при снятом флаге, — это
        // «выключено на вид». 404, а не 403: сайта-магазина здесь просто нет.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Страница не найдена",
            "Этот сайт не принимает заказы через корзину.");
    КонецЕсли;
    Описание = Корзина.НайтиКорзину(Сайт, Корзина.ЗначениеКуки(Запрос));
    Если Описание <> Неопределено И Описание.Оформлена И Не ПустаяСтрока(Описание.Заказ) Тогда
        Возврат Рендер.Редирект(SEO.ПрефиксСервиса(Сайт, "shop") + "/order/" + Описание.Заказ, 303);
    КонецЕсли;
    Состав = Корзина.Содержимое(Сайт, Описание);
    Возврат Рендер.СтраницаОформления(Сайт, Состав, "", 200);
КонецФункции

// POST /checkout — создание заказа.
Функция Оформить(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Если Сайт = Неопределено Тогда
        Возврат Рендер.АдресНеПривязан(Роутер.ХостЗапроса(Запрос));
    КонецЕсли;
    Если Не Рендер.ПриёмЗаказов(Сайт) Тогда
        // Выключенный приём заказов закрывает адреса магазина, а не только
        // прячет кнопку: обработчик, отвечающий при снятом флаге, — это
        // «выключено на вид». 404, а не 403: сайта-магазина здесь просто нет.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Страница не найдена",
            "Этот сайт не принимает заказы через корзину.");
    КонецЕсли;
    Если Не Корзина.ПроверитьИсточник(Запрос) Тогда
        Возврат Рендер.СтраницаСообщение(Сайт, 403, "Запрос отклонён",
            "Похоже, форма отправлена не с этого сайта. Откройте корзину заново.");
    КонецЕсли;

    Описание = Корзина.НайтиКорзину(Сайт, Корзина.ЗначениеКуки(Запрос));
    Если Описание = Неопределено Тогда
        Возврат Рендер.СтраницаКорзины(Сайт, Корзина.Содержимое(Сайт, Неопределено),
            "Корзина пуста — возможно, истёк срок её хранения.", 422);
    КонецЕсли;

    Результат = Заказы.Оформить(Сайт, Описание, Запрос.ФормаДанные());
    Если Результат.Код <> 200 Тогда
        Состав = Корзина.Содержимое(Сайт, Описание);
        Возврат Рендер.СтраницаОформления(Сайт, Состав, Результат.Сообщение, Результат.Код);
    КонецЕсли;
    Возврат Рендер.Редирект(SEO.ПрефиксСервиса(Сайт, "shop") + "/order/" + Результат.Ид, 303);
КонецФункции

// GET /order/{ид} — страница заказа по неподбираемой ссылке.
Функция ПоказатьЗаказ(Запрос) Экспорт
    Сайт = Роутер.ТекущийСайт(Запрос);
    Если Сайт = Неопределено Тогда
        Возврат Рендер.АдресНеПривязан(Роутер.ХостЗапроса(Запрос));
    КонецЕсли;
    Если Не Рендер.ПриёмЗаказов(Сайт) Тогда
        // Выключенный приём заказов закрывает адреса магазина, а не только
        // прячет кнопку: обработчик, отвечающий при снятом флаге, — это
        // «выключено на вид». 404, а не 403: сайта-магазина здесь просто нет.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Страница не найдена",
            "Этот сайт не принимает заказы через корзину.");
    КонецЕсли;
    Заказ = Заказы.НайтиЗаказ(Сайт, Запрос.ПараметрыURL.Получить("ид"));
    Если Заказ = Неопределено Тогда
        // 404 без подробностей намеренно: «такого заказа нет» и «заказ чужой»
        // для постороннего должны выглядеть одинаково.
        Возврат Рендер.СтраницаСообщение(Сайт, 404, "Заказ не найден",
            "Проверьте ссылку из письма — возможно, она перенесена не полностью.");
    КонецЕсли;
    Возврат Рендер.СтраницаЗаказа(Сайт, Заказ);
КонецФункции
