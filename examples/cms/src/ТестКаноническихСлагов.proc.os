// Регресс-защита канонизации слагов и UNIQUE-индексов.
//
// Роутер считает «About», «/about/» и «about» одним адресом. Объектные модули
// обязаны привести значение ДО записи, чтобы индекс проверял ту же
// уникальность. Для страниц, новостей и товаров область уникальности — сайт;
// категории остаются общими для всей базы.
Процедура Выполнить()
    Сайт1 = СоздатьСайтТеста("Слаги: сайт 1", "slug-one.example");
    Сайт2 = СоздатьСайтТеста("Слаги: сайт 2", "slug-two.example");

    Страница = Справочники.Страницы.Создать();
    Страница.Наименование = "Каноническая страница";
    Страница.Слаг = " /Canonical-Page/ ";
    Страница.Сайт = Сайт1;
    Страница.Записать();
    Утверждать.Равно(Страница.Слаг, "canonical-page",
        "страница хранит тот же канонический слаг, который сравнивает роутер");

    ОшибкаДубля = "";
    Попытка
        Дубль = Справочники.Страницы.Создать();
        Дубль.Наименование = "Дубль канонической страницы";
        Дубль.Слаг = "CANONICAL-PAGE/";
        Дубль.Сайт = Сайт1;
        Дубль.Записать();
    Исключение
        ОшибкаДубля = ОписаниеОшибки();
    КонецПопытки;
    Утверждать.Заполнено(ОшибкаДубля,
        "нормализованный дубль страницы на том же сайте отклоняется UNIQUE-индексом");

    // Тот же путь на другом сайте допустим: область адресов задаёт реквизит
    // Сайт, поэтому индекс составной [Сайт, Слаг].
    ДругойСайт = Справочники.Страницы.Создать();
    ДругойСайт.Наименование = "Та же страница другого сайта";
    ДругойСайт.Слаг = "/Canonical-Page/";
    ДругойСайт.Сайт = Сайт2;
    ДругойСайт.Записать();
    Утверждать.Равно(ДругойСайт.Слаг, "canonical-page",
        "одинаковый канонический слаг разрешён на другом сайте");

    Новость = Справочники.Новости.Создать();
    Новость.Наименование = "Каноническая новость";
    Новость.Слаг = "/News-Slug/";
    Новость.Сайт = Сайт1;
    Новость.Записать();
    Утверждать.Равно(Новость.Слаг, "news-slug", "слаг новости канонизируется до записи");

    Товар = Справочники.Товары.Создать();
    Товар.Наименование = "Канонический товар";
    Товар.Слаг = " /Product-Slug// ";
    Товар.Сайт = Сайт1;
    Товар.Записать();
    Утверждать.Равно(Товар.Слаг, "product-slug", "слаг товара канонизируется до записи");

    Категория = Справочники.КатегорииКонтента.Создать();
    Категория.Наименование = "Каноническая категория";
    Категория.Слаг = "/Shared-Category/";
    Категория.Записать();
    Утверждать.Равно(Категория.Слаг, "shared-category", "слаг категории канонизируется до записи");

    ОшибкаКатегории = "";
    Попытка
        ДубльКатегории = Справочники.КатегорииКонтента.Создать();
        ДубльКатегории.Наименование = "Дубль общей категории";
        ДубльКатегории.Слаг = "SHARED-CATEGORY/";
        ДубльКатегории.Записать();
    Исключение
        ОшибкаКатегории = ОписаниеОшибки();
    КонецПопытки;
    Утверждать.Заполнено(ОшибкаКатегории,
        "категории используют глобальную уникальность канонического слага");

    // ─── адреса, которые собирает импорт ─────────────────────────────────
    // Проверяется та же функция, которую зовёт обработка импорта: адреса
    // товаров и разделов уходят в поисковую выдачу и в письма, и «починка»
    // адресов после переезда стоит дороже, чем сам переезд.
    СайтИмпорта = СоздатьСайтТеста("Тест слагов импорта", "import-slugs.example");

    Утверждать.Равно(ИмпортYML.Транслитерация("Бельгийское пиво"), "belgiyskoe-pivo",
        "мягкий знак выбрасывается, а не превращается в дефис");
    Утверждать.Равно(ИмпортYML.Транслитерация("Вода «Ессентуки» №17, 0,5 л"),
        "voda-essentuki-17-0-5-l",
        "кавычки, запятые и служебные знаки схлопываются в один дефис");
    Утверждать.Равно(ИмпортYML.Транслитерация("   "), "",
        "пустое значение не превращается в дефис");

    // Свободный адрес занимается как есть: раздел «Грузия» с кодом «gruziya»
    // раньше получал /catalog/gruziya-gruziya — код дублировал сам себя.
    Утверждать.Равно(ИмпортYML.Слаг(СайтИмпорта, "Грузия", "gruziya"), "gruziya",
        "внешний код не приписывается, пока адрес свободен");

    ИмпортYML.ЗаписатьТовар(СайтИмпорта, "gruziya", "Грузия", Истина,
        ИмпортYML.Слаг(СайтИмпорта, "Грузия", "gruziya"));
    // Второй раздел с тем же названием — код разводит адреса.
    Утверждать.Равно(ИмпортYML.Слаг(СайтИмпорта, "Грузия", "gruziya-2"), "gruziya-gruziya-2",
        "при столкновении адрес разводится внешним кодом");

    // Занятость считается в пределах сайта: составной UNIQUE это разрешает.
    ДругойСайт = СоздатьСайтТеста("Тест слагов импорта Б", "import-slugs-b.example");
    Утверждать.Равно(ИмпортYML.Слаг(ДругойСайт, "Грузия", "gruziya"), "gruziya",
        "занятый адрес соседнего сайта не мешает своему");

    // Длинные наименования обрезаются по границе слова: адрес в 200 символов
    // не читается и рвётся при переносе в письме.
    Длинное = "Вода минеральная природная лечебно столовая газированная в стеклянной бутылке объёмом ноль пять литра";
    Адрес = ИмпортYML.Транслитерация(Длинное);
    Утверждать.Истина(СтрДлина(Адрес) <= 70, "длинный адрес обрезается");
    Утверждать.Равно(Прав(Адрес, 1) = "-", Ложь, "обрезанный адрес не кончается дефисом");
КонецПроцедуры

Функция СоздатьСайтТеста(Наименование, Домен)
    Сайт = Справочники.Сайты.Создать();
    Сайт.Наименование = Наименование;
    Сайт.Домен = Домен;
    Сайт.Активен = Истина;
    Возврат Сайт.Записать();
КонецФункции
