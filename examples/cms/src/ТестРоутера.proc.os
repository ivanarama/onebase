// Регресс-защита правил роутера (план 129).
//
// Проверяется подбор контента — та часть, где ошибка не видна глазом: страница
// открывается, но не та, либо черновик утекает наружу. Разметку эти тесты не
// трогают: она проверяется браузером.
//
// Тест сам создаёт данные и работает в одной базе с демо-контентом, поэтому
// слаги нарочно уникальные.
Процедура Выполнить()
    Сайт = Справочники.Сайты.НайтиПоНаименованию("Демо-сайт");

    // ─── нормализация адреса ─────────────────────────────────────────────
    Утверждать.Равно(Роутер.НормализоватьПуть("/About/"), "about", "ведущий и замыкающий слэш срезаются, регистр приводится");
    Утверждать.Равно(Роутер.НормализоватьПуть(""), "", "пустой путь остаётся пустым — это главная");

    // ─── опубликованное находится ────────────────────────────────────────
    СоздатьСтраницуТеста("Тест публичная", "test-public", Перечисления.СтатусПубликации.Опубликовано, Сайт);
    Найденная = Роутер.НайтиСтраницу("test-public");
    Утверждать.Заполнено(Найденная, "опубликованная страница находится по слагу");

    // Регистр слага не должен мешать: адрес из письма приходит как угодно.
    Утверждать.Заполнено(Роутер.НайтиСтраницу("TEST-PUBLIC"), "слаг ищется без учёта регистра");

    // ─── черновик наружу не уходит ───────────────────────────────────────
    СоздатьСтраницуТеста("Тест черновик", "test-draft", Перечисления.СтатусПубликации.Черновик, Сайт);
    Утверждать.Равно(Роутер.НайтиСтраницу("test-draft"), Неопределено, "черновик не отдаётся посетителю");

    // ─── дата публикации в будущем ───────────────────────────────────────
    Отложенная = Справочники.Страницы.Создать();
    Отложенная.Наименование = "Тест отложенная";
    Отложенная.Слаг = "test-future";
    Отложенная.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Отложенная.ДатаПубликации = ДобавитьДень(ТекущаяДата(), 7);
    Отложенная.Сайт = Сайт;
    Отложенная.Записать();
    Утверждать.Равно(Роутер.НайтиСтраницу("test-future"), Неопределено,
        "материал с датой публикации в будущем ещё не виден");

    // ─── дата публикации СЕГОДНЯШНЯЯ, с временем ─────────────────────────
    //
    // Страж на сравнение дат из запроса. Дата из SQLite приходит строкой
    // «2026-08-18T19:30:00Z», и без приведения сравнивается с текущим
    // моментом как ТЕКСТ: «T» больше пробела в представлении времени, поэтому
    // только что изданный материал считался будущим и исчезал с сайта.
    //
    // Дата берётся ИМЕННО текущим моментом, а не ТекущаяДата(): полночь
    // сохраняется по UTC во вчерашний день на машинах с положительным
    // смещением, префиксы дат расходятся, и строковое сравнение случайно даёт
    // верный ответ. Проверка с полуночью краснела бы только на UTC-хосте — то
    // есть у автора была бы зелёной.
    Свежая = Справочники.Страницы.Создать();
    Свежая.Наименование = "Тест сегодняшняя";
    Свежая.Слаг = "test-today";
    Свежая.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Свежая.ДатаПубликации = ТекущаяДатаВремя();
    Свежая.Сайт = Сайт;
    Свежая.Записать();
    Утверждать.Заполнено(Роутер.НайтиСтраницу("test-today"),
        "изданный сегодняшним числом материал виден сразу, в любой временной зоне");

    // ─── несуществующий адрес ────────────────────────────────────────────
    Утверждать.Равно(Роутер.НайтиСтраницу("нет-такой-страницы"), Неопределено, "несуществующий слаг даёт Неопределено");
КонецПроцедуры

Процедура СоздатьСтраницуТеста(Наименование, Слаг, Статус, Сайт)
    Если ЗначениеЗаполнено(Справочники.Страницы.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Стр = Справочники.Страницы.Создать();
    Стр.Наименование = Наименование;
    Стр.Слаг = Слаг;
    Стр.Заголовок = Наименование;
    Стр.СтатусПубликации = Статус;
    Стр.ДатаПубликации = ТекущаяДата();
    Стр.Сайт = Сайт;
    Стр.Записать();
КонецПроцедуры
