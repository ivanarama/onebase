// Регресс-защита правил роутера (план 129).
//
// Проверяется подбор контента — та часть, где ошибка не видна глазом: страница
// открывается, но не та, либо черновик утекает наружу. Разметку эти тесты не
// трогают: она проверяется браузером.
//
// Тест сам создаёт данные и работает в одной базе с демо-контентом, поэтому
// слаги нарочно уникальные.
Процедура Выполнить()
    // Тест не зависит от демо-наполнения: собственный сайт одновременно
    // задаёт владельца всех созданных ниже публичных данных.
    СайтОбъект = Справочники.Сайты.Создать();
    СайтОбъект.Наименование = "Тест напрямую";
    СайтОбъект.Домен = "localhost";
    СайтОбъект.ПрефиксПути = "hs/site/";
    СайтОбъект.Активен = Истина;
    Сайт = СайтОбъект.Записать();
    ПараметрыСайта = Новый Структура;
    ПараметрыСайта.Вставить("Ссылка", Сайт);

    // ─── нормализация адреса ─────────────────────────────────────────────
    Утверждать.Равно(Роутер.НормализоватьПуть("/About/"), "about", "ведущий и замыкающий слэш срезаются, регистр приводится");
    Утверждать.Равно(Роутер.НормализоватьПуть(""), "", "пустой путь остаётся пустым — это главная");

    // ─── опубликованное находится ────────────────────────────────────────
    СоздатьСтраницуТеста("Тест публичная", "test-public", Перечисления.СтатусПубликации.Опубликовано, Сайт);
    Найденная = Роутер.НайтиСтраницу(ПараметрыСайта, "test-public");
    Утверждать.Заполнено(Найденная, "опубликованная страница находится по слагу");

    // Регистр слага не должен мешать: адрес из письма приходит как угодно.
    Утверждать.Заполнено(Роутер.НайтиСтраницу(ПараметрыСайта, "TEST-PUBLIC"), "слаг ищется без учёта регистра");

    // ─── черновик наружу не уходит ───────────────────────────────────────
    СоздатьСтраницуТеста("Тест черновик", "test-draft", Перечисления.СтатусПубликации.Черновик, Сайт);
    Утверждать.Равно(Роутер.НайтиСтраницу(ПараметрыСайта, "test-draft"), Неопределено, "черновик не отдаётся посетителю");

    // ─── дата публикации в будущем ───────────────────────────────────────
    Отложенная = Справочники.Страницы.Создать();
    Отложенная.Наименование = "Тест отложенная";
    Отложенная.Слаг = "test-future";
    Отложенная.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Отложенная.ДатаПубликации = ДобавитьДень(ТекущаяДата(), 7);
    Отложенная.Сайт = Сайт;
    Отложенная.Записать();
    Утверждать.Равно(Роутер.НайтиСтраницу(ПараметрыСайта, "test-future"), Неопределено,
        "материал с датой публикации в будущем ещё не виден");

    // ─── дата публикации СЕГОДНЯШНЯЯ, с временем ─────────────────────────
    //
    // Страж на сравнение дат из запроса. Дата из SQLite приходит строкой
    // «2026-08-18T19:30:00Z», и без приведения сравнивается с текущим
    // моментом как ТЕКСТ: «T» больше пробела в представлении времени, поэтому
    // только что изданный материал считался будущим и исчезал с сайта.
    //
    // Дата берётся ИМЕННО текущим моментом, а не ТекущаяДата(): полночь
    // сохраняется по UTC во вчерашний день на машинах с положительным
    // смещением, префиксы дат расходятся, и строковое сравнение случайно даёт
    // верный ответ. Проверка с полуночью краснела бы только на UTC-хосте — то
    // есть у автора была бы зелёной.
    Свежая = Справочники.Страницы.Создать();
    Свежая.Наименование = "Тест сегодняшняя";
    Свежая.Слаг = "test-today";
    Свежая.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Свежая.ДатаПубликации = ТекущаяДатаВремя();
    Свежая.Сайт = Сайт;
    Свежая.Записать();
    Утверждать.Заполнено(Роутер.НайтиСтраницу(ПараметрыСайта, "test-today"),
        "изданный сегодняшним числом материал виден сразу, в любой временной зоне");

    // ─── несуществующий адрес ────────────────────────────────────────────
    Утверждать.Равно(Роутер.НайтиСтраницу(ПараметрыСайта, "нет-такой-страницы"), Неопределено, "несуществующий слаг даёт Неопределено");

    // ─── витрина каталога (#1014) ────────────────────────────────────────
    Группа = Справочники.Товары.Создать();
    Группа.Наименование = "Тест группа";
    Группа.Слаг = "test-group";
    Группа.is_folder = Истина;
    Группа.Сайт = Сайт;
    СсылкаГруппы = Группа.Записать();

    Товар = Справочники.Товары.Создать();
    Товар.Наименование = "Тест товар";
    Товар.Слаг = "test-product";
    Товар.Артикул = "T-1";
    Товар.Цена = 100;
    Товар.parent_id = СсылкаГруппы;
    Товар.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Товар.ДатаПубликации = ТекущаяДата();
    Товар.Сайт = Сайт;
    Товар.Записать();

    Утверждать.Заполнено(Роутер.НайтиТовар(ПараметрыСайта, "test-product"), "опубликованный товар находится по слагу");
    Утверждать.Равно(Роутер.НайтиТовар(ПараметрыСайта, "test-group"), Неопределено, "группа товаром не считается");
    Утверждать.Заполнено(Роутер.НайтиГруппуТоваров(ПараметрыСайта, "test-group"), "группа находится по слагу");

    // ─── таблица маршрутов (план 129, решение 5) ─────────────────────────
    //
    // Пустой справочник = правила по умолчанию: база без настроенных
    // маршрутов обязана работать так же, как раньше.
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "news").ТипКонтента, "Новости", "умолчание: список новостей");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "news/hello").Слаг, "hello", "умолчание: слаг новости из шаблона");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "product/test-product").ТипКонтента, "Товар", "умолчание: карточка товара");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "about").ТипКонтента, "Страница", "умолчание: страница по слагу");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "").ТипКонтента, "Страница", "умолчание: корень сайта");

    // Шаблон без подстановки выигрывает у «{слаг}» независимо от приоритета:
    // иначе страница со слагом «news» перекрыла бы раздел публикаций.
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "catalog").ТипКонтента, "Каталог", "точный шаблон важнее подстановки");

    // Правило из справочника добавляет адрес и перекрывает умолчание с тем же
    // шаблоном; остальные умолчания при этом продолжают работать.
    СоздатьМаршрут(Сайт, "Статьи", "stati/{слаг}", "Новости", 10);
    СоздатьМаршрут(Сайт, "Новости страницей", "news", "Страница", 5);
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "stati/hello").ТипКонтента, "Новости", "правило справочника действует");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "stati/hello").Слаг, "hello", "подстановка правила справочника");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "news").ТипКонтента, "Страница", "правило справочника перекрывает умолчание");
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "product/test-product").ТипКонтента, "Товар",
        "прочие умолчания остаются в силе при заполненном справочнике");

    // Неактивное правило не действует.
    СоздатьМаршрут(Сайт, "Выключенное", "arhiv", "Новости", 1, Ложь);
    Утверждать.Равно(Роутер.ПодобратьМаршрут(ПараметрыСайта, "arhiv").ТипКонтента, "Страница",
        "неактивное правило игнорируется — адрес обрабатывается умолчанием");

    // ─── канонический адрес и префикс сайта (#1014) ──────────────────────
    //
    // Раньше «/hs/site/» было зашито в код: за reverse proxy, который отдаёт
    // сайт в корне домена, canonical и sitemap указывали на адреса, которых
    // снаружи нет, — прокси добавлял свой префикс ещё раз. Теперь префикс
    // берётся из реквизита сайта.
    // Сайты создаются тестом, а не берутся из демо-контента: onebase test
    // запускается на ЧИСТОЙ базе (в CI — рядом с check и migrate), и опора на
    // заполнение сделала бы проверку зависимой от чужого шага.
    СПрефиксом = СайтОбъект;
    Утверждать.Равно(SEO.Префикс(СПрефиксом), "/hs/site", "префикс нормализуется: «hs/site/» → «/hs/site»");
    Утверждать.Равно(SEO.Канонический(СПрефиксом, "about"), "https://localhost/hs/site/about",
        "канонический адрес собирается с префиксом сайта");

    // Неактивный намеренно: ТекущийСайт ниже обязан вернуть сайт с префиксом,
    // а не этот. Для прямых проверок SEO активность не нужна.
    БезПрефикса = Справочники.Сайты.Создать();
    БезПрефикса.Наименование = "Тест за прокси";
    БезПрефикса.Домен = "proxy.example";
    БезПрефикса.Активен = Ложь;
    БезПрефикса.Записать();
    Утверждать.Равно(SEO.Префикс(БезПрефикса), "", "пустой префикс = сайт отдаётся в корне домена");
    Утверждать.Равно(SEO.Канонический(БезПрефикса, "about"), "https://proxy.example/about",
        "за прокси канонический адрес не содержит /hs/site");

    // Ключевая проверка: префикс обязан доезжать до рендера ТЕМ ЖЕ путём, что
    // и в проде — через ТекущийСайт, который отдаёт структуру, а не строку
    // запроса. Раньше проверка шла по объекту справочника и потому проходила,
    // хотя в структуре реквизита не было вовсе: canonical, sitemap и меню
    // теряли префикс при заполненном реквизите (#1014).
    СайтИзРоутера = Роутер.ТекущийСайт(Неопределено);
    Утверждать.Заполнено(СайтИзРоутера, "ТекущийСайт возвращает активный сайт");
    Утверждать.Равно(СайтИзРоутера.Ссылка, Сайт,
        "структура ТекущийСайт сохраняет ссылку выбранного сайта для фильтрации контента");
    Утверждать.Равно(SEO.Префикс(СайтИзРоутера), "/hs/site",
        "префикс доезжает до рендера через ТекущийСайт, а не только читается у объекта");
    Утверждать.Равно(SEO.Канонический(СайтИзРоутера, "about"), "https://localhost/hs/site/about",
        "канонический адрес рендера собирается с префиксом");
КонецПроцедуры

Процедура СоздатьМаршрут(Сайт, Наименование, Шаблон, ТипКонтента, Приоритет, Активен = Истина)
    М = Справочники.МаршрутыURL.Создать();
    М.Наименование = Наименование;
    М.Шаблон = Шаблон;
    М.ТипКонтента = ТипКонтента;
    М.Приоритет = Приоритет;
    М.Активен = Активен;
    М.Сайт = Сайт;
    М.Записать();
КонецПроцедуры

Процедура СоздатьСтраницуТеста(Наименование, Слаг, Статус, Сайт)
    Если ЗначениеЗаполнено(Справочники.Страницы.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Стр = Справочники.Страницы.Создать();
    Стр.Наименование = Наименование;
    Стр.Слаг = Слаг;
    Стр.Заголовок = Наименование;
    Стр.СтатусПубликации = Статус;
    Стр.ДатаПубликации = ТекущаяДата();
    Стр.Сайт = Сайт;
    Стр.Записать();
КонецПроцедуры
