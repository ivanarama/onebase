// Демо-контент сайта: стиль, сайт, три страницы и один редирект (план 129).
//
// Заполнение — ОТДЕЛЬНАЯ обработка, а не побочный эффект запроса к сайту.
// В конфигурации, с которой начинался этот пример, демо-данные создавались
// на каждом HTTP-запросе: боевой сайт нельзя было запустить пустым, и каждый
// заход посетителя проверял наличие десятков элементов.
//
// Идемпотентна: повторный запуск ничего не дублирует.
Процедура Выполнить()
    Если ЗначениеЗаполнено(Справочники.СтилиСайта.НайтиПоНаименованию("Базовый")) = Ложь Тогда
        Стиль = Справочники.СтилиСайта.Создать();
        Стиль.Наименование = "Базовый";
        Стиль.ЦветОсновной = "#2563eb";
        Стиль.ЦветДополнительный = "#0f172a";
        Стиль.ЦветФона = "#ffffff";
        Стиль.Описание = "Палитра по умолчанию";
        Стиль.Записать();
    КонецЕсли;
    Стиль = Справочники.СтилиСайта.НайтиПоНаименованию("Базовый");

    Если ЗначениеЗаполнено(Справочники.Сайты.НайтиПоНаименованию("Демо-сайт")) = Ложь Тогда
        Сайт = Справочники.Сайты.Создать();
        Сайт.Наименование = "Демо-сайт";
        Сайт.Домен = "localhost";
        Сайт.Стиль = Стиль;
        Сайт.Язык = "ru";
        Сайт.РоботсTxt = "User-agent: *" + Символы.ПС + "Disallow:";
        Сайт.Активен = Истина;
        Сайт.Записать();
    КонецЕсли;
    Сайт = Справочники.Сайты.НайтиПоНаименованию("Демо-сайт");

    СоздатьСтраницу(Сайт, "Главная", "главная", "Добро пожаловать",
        "<p>Это демонстрационный сайт на OneBase. Контент правится в разделе «Сайт».</p>");
    СоздатьСтраницу(Сайт, "О компании", "about", "О компании",
        "<p>Страница создана обработкой «Заполнить демо-контент сайта».</p>");
    СоздатьСтраницу(Сайт, "Контакты", "contacts", "Контакты",
        "<p>Телефон и адрес — обычные поля справочника, правятся без программиста.</p>");

    Если ЗначениеЗаполнено(Справочники.Редиректы.НайтиПоНаименованию("/o-kompanii")) = Ложь Тогда
        Ред = Справочники.Редиректы.Создать();
        Ред.Наименование = "/o-kompanii";
        Ред.Откуда = "o-kompanii";
        Ред.Куда = "/hs/site/about";
        Ред.Код = 301;
        Ред.Активен = Истина;
        Ред.Сайт = Сайт;
        Ред.Записать();
    КонецЕсли;

    СоздатьНовость(Сайт, "Открылся новый сайт", "novyy-sayt",
        "<p>Сайт переехал на OneBase: контент и учёт теперь в одной базе.</p>",
        "<p>Раньше страницы правились в отдельной CMS, а цены приходилось переносить руками. "
        + "Теперь и то и другое живёт в одной системе.</p>");
    СоздатьНовость(Сайт, "Как мы считаем сроки поставки", "sroki-postavki",
        "<p>Короткая заметка о том, откуда берутся сроки в карточке товара.</p>",
        "<p>Срок считается по остаткам и графику поставок — те же данные, что видит менеджер.</p>");

    СоздатьПунктМеню(Сайт, "Главная", "Главное", 10, "/hs/site/");
    СоздатьПунктМеню(Сайт, "О компании", "Главное", 20, "/hs/site/about");
    СоздатьПунктМеню(Сайт, "Новости", "Главное", 30, "/hs/site/news");
    СоздатьПунктМеню(Сайт, "Контакты", "Главное", 40, "/hs/site/contacts");
    СоздатьПунктМеню(Сайт, "Контакты (подвал)", "Подвал", 10, "/hs/site/contacts");

    Сообщить("Демо-контент сайта готов: откройте /hs/site/");
КонецПроцедуры

Процедура СоздатьНовость(Сайт, Наименование, Слаг, Анонс, Содержимое)
    Если ЗначениеЗаполнено(Справочники.Новости.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Нов = Справочники.Новости.Создать();
    Нов.Наименование = Наименование;
    Нов.Слаг = Слаг;
    Нов.Анонс = Анонс;
    Нов.Содержимое = Содержимое;
    Нов.Автор = "Редакция";
    Нов.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Нов.ДатаПубликации = ТекущаяДата();
    Нов.ЗаголовокSEO = Наименование;
    Нов.Сайт = Сайт;
    Нов.Записать();
КонецПроцедуры

Процедура СоздатьПунктМеню(Сайт, Наименование, КодМеню, Порядок, Адрес)
    Если ЗначениеЗаполнено(Справочники.Меню.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Пункт = Справочники.Меню.Создать();
    Пункт.Наименование = Наименование;
    Пункт.КодМеню = КодМеню;
    // Тип «внешний адрес» выбран осознанно: демо не должно зависеть от того,
    // в каком порядке созданы страницы. В боевом сайте пункт ссылается на
    // объект — тогда смена слага не ломает меню.
    Пункт.ТипСсылки = Перечисления.ТипСсылкиМеню.ВнешнийАдрес;
    Пункт.Адрес = Адрес;
    Пункт.Порядок = Порядок;
    Пункт.Активен = Истина;
    Пункт.Сайт = Сайт;
    Пункт.Записать();
КонецПроцедуры

Процедура СоздатьСтраницу(Сайт, Наименование, Слаг, Заголовок, Содержимое)
    Если ЗначениеЗаполнено(Справочники.Страницы.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Стр = Справочники.Страницы.Создать();
    Стр.Наименование = Наименование;
    Стр.Слаг = Слаг;
    Стр.Заголовок = Заголовок;
    Стр.Содержимое = Содержимое;
    Стр.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Стр.ДатаПубликации = ТекущаяДата();
    Стр.ЗаголовокSEO = Заголовок;
    Стр.Сайт = Сайт;
    Стр.Записать();
КонецПроцедуры
