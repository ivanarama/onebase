// Демо-контент сайта: стиль, сайт, три страницы и один редирект (план 129).
//
// Заполнение — ОТДЕЛЬНАЯ обработка, а не побочный эффект запроса к сайту.
// В конфигурации, с которой начинался этот пример, демо-данные создавались
// на каждом HTTP-запросе: боевой сайт нельзя было запустить пустым, и каждый
// заход посетителя проверял наличие десятков элементов.
//
// Идемпотентна: повторный запуск ничего не дублирует.
//
// Требует прав РЕДАКТОРА: создаются сайт, стиль, шаблон и маршруты — то, что
// контент-менеджеру недоступно намеренно. Права проверяются заранее, иначе
// обработка падала на первой же записи сообщением платформы про отказ
// доступа: технически верным, но не объясняющим, чего не хватает и кому.
Процедура Выполнить()
    Попытка
        Заполнить();
    Исключение
        // Отказ прав объясняем словами. Платформа сообщает «Записать(X): доступ
        // к данным запрещён…» — верно, но не говорит, чего не хватает и кому.
        // Пробную запись для проверки прав НЕ делаем: она оставляла бы в базе
        // мусорный элемент при каждом запуске.
        Текст = ОписаниеОшибки();
        Если СтрНайти(Текст, "доступ") > 0 ИЛИ СтрНайти(Текст, "denied") > 0 Тогда
            ВызватьИсключение "Для заполнения демо-контентом нужна роль «Редактор сайта»:"
                + " обработка создаёт сайт, стиль, шаблон и маршруты адресов."
                + " Под ролью «Контент-менеджер» это недоступно намеренно —"
                + " ошибка в макете или маршруте ломает сайт целиком."
                + " Каталог товаров контент-менеджер загружает сам, обработкой"
                + " «Импорт каталога из YML-выгрузки»." + Символы.ПС
                + "Исходная ошибка: " + Текст;
        КонецЕсли;
        ВызватьИсключение Текст;
    КонецПопытки;
КонецПроцедуры

// ВерсияМакета — номер поставляемой вёрстки. Растёт, когда меняется
// МакетПоУмолчанию: по нему демо-базы прежних сборок получают новое оформление.
Функция ВерсияМакета()
    Возврат "3";
КонецФункции

// ПоставлявшиесяВерсии — номера, которые ставила САМА платформа, через запятую.
// Перетираем только их: любое другое значение поставил человек, а значит макет
// правили руками. Проверки «версия не равна поставляемой» для этого мало — под
// неё попадает и номер, поднятый руками, то есть ровно тот случай, ради которого
// правку и помечают. Ставите новую вёрстку — допишите сюда прежний номер.
Функция ПоставлявшиесяВерсии()
    Возврат "1,2,3";
КонецФункции

// ПрежнийДемоТекст — правда, если содержимое страницы совпадает с тем, что
// клали ПРЕЖНИЕ сборки. Только такой текст обновляется: любое отличие означает,
// что страницу правил человек, и его работа важнее свежести примера.
//
// Список растёт с каждой сменой демо-текстов. Выглядит громоздко, зато решение
// принимается по факту, а не по догадке «наверное, не трогали».
Функция ПрежнийДемоТекст(Текст) Экспорт
    Если ПустаяСтрока(Текст) ИЛИ Текст = "<nil>" Тогда
        Возврат Истина;
    КонецЕсли;
    Прежние = Новый Массив;
    Прежние.Добавить("<p>Это демонстрационный сайт на OneBase. Контент правится в разделе «Сайт».</p>");
    Прежние.Добавить("<p>Страница создана обработкой «Заполнить демо-контент сайта».</p>");
    Прежние.Добавить("<p>Телефон и адрес — обычные поля справочника, правятся без программиста.</p>");
    Для Каждого Вариант Из Прежние Цикл
        Если Текст = Вариант Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Процедура Заполнить()
    Если ЗначениеЗаполнено(Справочники.СтилиСайта.НайтиПоНаименованию("Базовый")) = Ложь Тогда
        Стиль = Справочники.СтилиСайта.Создать();
        Стиль.Наименование = "Базовый";
        Стиль.ЦветОсновной = "#2563eb";
        Стиль.ЦветДополнительный = "#0f172a";
        Стиль.ЦветФона = "#ffffff";
        Стиль.Описание = "Палитра по умолчанию";
        Стиль.Записать();
    КонецЕсли;
    // Шаблон заводится в базе, а не остаётся умолчанием в модуле: раздел 10
    // плана 129 требует, чтобы макет правился ПОЛЕМ КОДА в карточке, а не
    // только правкой Рендер.МакетПоУмолчанию. Разметка та же, поэтому вид
    // сайта не меняется — меняется место, где её правят (#1014).
    Если ЗначениеЗаполнено(Справочники.ШаблоныСайта.НайтиПоНаименованию("Базовый")) = Ложь Тогда
        Шаблон = Справочники.ШаблоныСайта.Создать();
        Шаблон.Наименование = "Базовый";
        Шаблон.Версия = ВерсияМакета();
        Шаблон.Описание = "Каркас страницы: шапка с меню и поиском, содержимое,"
            + " витрина карточками, подвал.";
        Шаблон.МакетHTML = Рендер.МакетПоУмолчанию();
        Шаблон.Записать();
    КонецЕсли;
    Шаблон = Справочники.ШаблоныСайта.НайтиПоНаименованию("Базовый");

    // Макет живёт В БАЗЕ, поэтому базы прежних сборок держат прежнюю вёрстку:
    // повторное заполнение их не трогало бы, и обновлённое оформление не
    // увидел бы никто. Обновляем по номеру версии — и только его: если версию
    // подняли руками, значит макет правили, и перетирать его нельзя.
    ОбъектШаблона = Шаблон.ПолучитьОбъект();
    Версия = СокрЛП(Строка(ОбъектШаблона.Версия));
    Если Версия <> ВерсияМакета()
        И СтрНайти("," + ПоставлявшиесяВерсии() + ",", "," + Версия + ",") > 0 Тогда
        ОбъектШаблона.МакетHTML = Рендер.МакетПоУмолчанию();
        ОбъектШаблона.Версия = ВерсияМакета();
        ОбъектШаблона.Записать();
        Сообщить("Макет «Базовый» обновлён до версии " + ВерсияМакета()
            + ": шапка с меню и поиском, витрина карточками, адаптив под телефон.");
    КонецЕсли;

    Стиль = Справочники.СтилиСайта.НайтиПоНаименованию("Базовый");

    Если ЗначениеЗаполнено(Справочники.Сайты.НайтиПоНаименованию("Демо-сайт")) = Ложь Тогда
        Сайт = Справочники.Сайты.Создать();
        Сайт.Наименование = "Демо-сайт";
        // «*» — сайт отвечает на любой адрес. С «localhost» демо открывалось
        // ровно по одному имени: лаунчер ведёт на 127.0.0.1, показ с соседнего
        // ноутбука идёт по имени машины, и там полная база встречала
        // приглашением «добавьте первую страницу».
        Сайт.Домен = "*";
        Сайт.Стиль = Стиль;
        Сайт.Шаблон = Шаблон;
        Сайт.Язык = "ru";
        Сайт.РоботсTxt = "User-agent: *" + Символы.ПС + "Disallow:";
        // Демо открывается прямо у платформы, без reverse proxy, поэтому в
        // canonical и sitemap.xml нужен префикс «/hs/site». За прокси, который
        // отдаёт сайт в корне домена, поле оставляют пустым (#1014).
        Сайт.ПрефиксПути = "/hs/site";
        Сайт.Активен = Истина;
        Сайт.Записать();
    КонецЕсли;
    Сайт = Справочники.Сайты.НайтиПоНаименованию("Демо-сайт");

    // Базы, заполненные прежними сборками, уже держат демо-сайт на «localhost»
    // — повторный запуск обработки их не трогал бы, и сайт так и остался бы
    // виден с одного адреса. Переводим на «*», но только с того самого
    // значения: домен, выставленный руками, чужой и затирать его нельзя.
    // «127.0.0.1» сюда попадает тоже — нормализация сводит его к localhost.
    ОбъектСайта = Сайт.ПолучитьОбъект();
    Если Роутер.НормализоватьДомен(ОбъектСайта.Домен) = "localhost" Тогда
        ОбъектСайта.Домен = "*";
        ОбъектСайта.Записать();
    КонецЕсли;

    СоздатьСтраницу(Сайт, "Главная", "главная", "Оптовые поставки воды и напитков",
        "<p>Работаем с магазинами, кафе и офисами: минеральная вода, лимонады,"
        + " энергетики и пиво — со склада и под заказ. Отгружаем от одной палеты,"
        + " доставку по городу считаем в день заявки.</p>"
        + "<ul><li>Более 60 позиций в наличии, прайс обновляется ежедневно</li>"
        + "<li>Отсрочка платежа постоянным покупателям</li>"
        + "<li>Свои машины: доставка на следующий день по городу</li></ul>"
        + "<p>Ниже — разделы каталога и свежие новости. Нужна цена под ваш объём —"
        + " напишите нам через форму на странице «Контакты».</p>");
    СоздатьСтраницу(Сайт, "О компании", "about", "О компании",
        "<p>Мы поставляем напитки с 2004 года. Начинали с одной точки на оптовом"
        + " рынке, сейчас держим склад на 1200 паллетомест и работаем с сетями,"
        + " кафе и корпоративными заказчиками.</p>"
        + "<p>Каждую позицию берём напрямую у производителя или его официального"
        + " представителя: на любую партию есть документы, а на воду —"
        + " протоколы лабораторных исследований.</p>"
        + "<p><b>Как мы работаем.</b> Заявка до 16:00 — отгрузка на следующий"
        + " день. Возврат непроданного товара по договорённости. Менеджер за"
        + " каждым клиентом закреплён поимённо, а не «горячей линией».</p>"
        + "<p>Эта страница — обычный элемент справочника «Страницы»:"
        + " контент-менеджер правит её в интерфейсе, без программиста и"
        + " без выкладки сайта.</p>");
    Форма = СоздатьФорму();
    СоздатьСтраницу(Сайт, "Контакты", "contacts", "Контакты",
        "<p><b>Склад и офис:</b> Ростов-на-Дону, ул. Складская, 14, корпус 3.</p>"
        + "<p><b>Телефон:</b> +7 863 000-00-00, будни с 9:00 до 18:00.<br>"
        + "<b>Почта:</b> zakaz@example.com</p>"
        + "<p>Самовывоз со склада — ежедневно с 8:00 до 20:00, по предварительной"
        + " заявке. Для новых покупателей готовим счёт в день обращения.</p>"
        + "<p>Оставьте заявку — перезвоним и пришлём прайс:</p>", Форма);

    Если ЗначениеЗаполнено(Справочники.Редиректы.НайтиПоНаименованию("/o-kompanii")) = Ложь Тогда
        Ред = Справочники.Редиректы.Создать();
        Ред.Наименование = "/o-kompanii";
        Ред.Откуда = "o-kompanii";
        Ред.Куда = SEO.Префикс(Сайт.ПолучитьОбъект()) + "/about";
        Ред.Код = 301;
        Ред.Активен = Истина;
        Ред.Сайт = Сайт;
        Ред.Записать();
    КонецЕсли;

    // Картинка кладётся в базу, а не ссылается на внешний CDN: сайт должен
    // работать без чужого сервера. Публичный адрес выдаёт хук ПриЗаписи
    // справочника Медиа. Создаём ДО новостей — иначе обложке неоткуда взяться
    // в момент их записи.
    Обложка = СоздатьМедиа("Обложка новости");

    СоздатьНовость(Сайт, "Открылся новый сайт", "novyy-sayt",
        "<p>Сайт переехал на OneBase: контент и учёт теперь в одной базе.</p>",
        "<p>Раньше страницы правились в отдельной CMS, а цены приходилось переносить руками. "
        + "Теперь и то и другое живёт в одной системе.</p>", Обложка);
    СоздатьНовость(Сайт, "Как мы считаем сроки поставки", "sroki-postavki",
        "<p>Короткая заметка о том, откуда берутся сроки в карточке товара.</p>",
        "<p>Срок считается по остаткам и графику поставок — те же данные, что видит менеджер.</p>");

    // Адреса пунктов собираются из префикса сайта: зашитый «/hs/site/» за
    // reverse proxy ведёт в никуда (#1014).
    //
    // Префикс читается у ОБЪЕКТА, а не у ссылки: у ссылки реквизита нет, и
    // SEO.Префикс молча вернул бы пустоту — меню собралось бы без префикса при
    // заполненном реквизите сайта.
    Префикс = SEO.Префикс(Сайт.ПолучитьОбъект());
    СоздатьПунктМеню(Сайт, "Главная", "Главное", 10, Префикс + "/");
    СоздатьПунктМеню(Сайт, "О компании", "Главное", 20, Префикс + "/about");
    СоздатьПунктМеню(Сайт, "Каталог", "Главное", 30, Префикс + "/catalog");
    СоздатьПунктМеню(Сайт, "Новости", "Главное", 40, Префикс + "/news");
    СоздатьПунктМеню(Сайт, "Контакты", "Главное", 50, Префикс + "/contacts");
    СоздатьПунктМеню(Сайт, "Контакты (подвал)", "Подвал", 10, Префикс + "/contacts");

    // Маршруты заводятся явно, хотя те же правила действуют и по умолчанию:
    // так администратор видит таблицу адресов и может её менять, не трогая
    // модули (план 129, решение 5).
    СоздатьМаршрут(Сайт, "Корень сайта", "/", "Страница", 5);
    СоздатьМаршрут(Сайт, "Список новостей", "news", "Новости", 10);
    СоздатьМаршрут(Сайт, "Карточка новости", "news/{слаг}", "Новости", 20);
    СоздатьМаршрут(Сайт, "Витрина каталога", "catalog", "Каталог", 30);
    СоздатьМаршрут(Сайт, "Раздел каталога", "catalog/{слаг}", "Каталог", 40);
    СоздатьМаршрут(Сайт, "Карточка товара", "product/{слаг}", "Товар", 50);
    СоздатьМаршрут(Сайт, "Страница по слагу", "{слаг}", "Страница", 100);

    // Пара заявок — чтобы на рабочем столе было видно, чем заканчивается путь
    // посетителя: форма на сайте пишет сюда же. Одна помечена спамом: заявку
    // с подозрительными данными конфигурация НЕ выбрасывает, и это стоит
    // видеть в демо, а не узнавать из документации.
    СоздатьЗаявку(Форма, "Ирина Соколова", "irina@example.com",
        "Здравствуйте! Интересует поставка воды в офис, 20 бутылей в месяц.",
        Перечисления.СтатусЗаявки.Новая);
    СоздатьЗаявку(Форма, "Пётр Гаврилов", "+7 999 123-45-67",
        "Добрый день, пришлите прайс, пожалуйста.",
        Перечисления.СтатусЗаявки.Новая);
    СоздатьЗаявку(Форма, "SEO Promo", "promo@example.invalid",
        "Продвижение сайта в топ за 3 дня, скидка 90%!",
        Перечисления.СтатусЗаявки.Спам);

    Сообщить("Демо-контент сайта готов: откройте /hs/site/");
КонецПроцедуры

Процедура СоздатьЗаявку(Форма, Имя, Контакт, Сообщение, Статус)
    Если ЗначениеЗаполнено(Справочники.Заявки.НайтиПоНаименованию(Имя)) Тогда
        Возврат;
    КонецЕсли;
    З = Справочники.Заявки.Создать();
    З.Наименование = Имя;
    З.Форма = Форма;
    З.Дата = ТекущаяДата();
    З.Контакт = Контакт;
    З.Сообщение = Сообщение;
    З.Статус = Статус;
    З.Записать();
КонецПроцедуры

// СоздатьМедиа кладёт крошечный PNG (красный квадрат 1×1) в поле карточки.
// Base64 взят литералом, чтобы демо не требовало внешних файлов.
Функция СоздатьМедиа(Наименование)
    Если ЗначениеЗаполнено(Справочники.Медиа.НайтиПоНаименованию(Наименование)) Тогда
        Возврат Справочники.Медиа.НайтиПоНаименованию(Наименование);
    КонецЕсли;
    // Подложка 12×8 точек: браузер растягивает её со сглаживанием, и в карточке
    // получается мягкая заливка. Прежний вариант был одним КРАСНЫМ пикселем —
    // на витрине он превращался в алый квадрат посреди аккуратных карточек.
    // Внешних файлов демо по-прежнему не требует: картинка лежит здесь же.
    PNG = "";
    М = Справочники.Медиа.Создать();
    М.Наименование = Наименование;
    М.Файл = СохранитьКартинку(PNG, "image/png");
    М.Тип = Перечисления.ТипМедиа.Изображение;
    М.Альт = Наименование;
    М.Активен = Истина;
    М.Записать();
    Возврат Справочники.Медиа.НайтиПоНаименованию(Наименование);
КонецФункции

Процедура СоздатьНовость(Сайт, Наименование, Слаг, Анонс, Содержимое, Картинка = Неопределено)
    Если ЗначениеЗаполнено(Справочники.Новости.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Нов = Справочники.Новости.Создать();
    Если Картинка <> Неопределено Тогда
        Нов.Картинка = Картинка;
    КонецЕсли;
    Нов.Наименование = Наименование;
    Нов.Слаг = Слаг;
    Нов.Анонс = Анонс;
    Нов.Содержимое = Содержимое;
    Нов.Автор = "Редакция";
    Нов.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Нов.ДатаПубликации = ТекущаяДата();
    Нов.ЗаголовокSEO = Наименование;
    Нов.Сайт = Сайт;
    Нов.Записать();
КонецПроцедуры

Процедура СоздатьМаршрут(Сайт, Наименование, Шаблон, ТипКонтента, Приоритет)
    Если ЗначениеЗаполнено(Справочники.МаршрутыURL.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    М = Справочники.МаршрутыURL.Создать();
    М.Наименование = Наименование;
    М.Шаблон = Шаблон;
    М.ТипКонтента = ТипКонтента;
    М.Приоритет = Приоритет;
    М.Активен = Истина;
    М.Сайт = Сайт;
    М.Записать();
КонецПроцедуры

Процедура СоздатьПунктМеню(Сайт, Наименование, КодМеню, Порядок, Адрес)
    Если ЗначениеЗаполнено(Справочники.Меню.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Пункт = Справочники.Меню.Создать();
    Пункт.Наименование = Наименование;
    Пункт.КодМеню = КодМеню;
    // Тип «внешний адрес» выбран осознанно: демо не должно зависеть от того,
    // в каком порядке созданы страницы. В боевом сайте пункт ссылается на
    // объект — тогда смена слага не ломает меню.
    Пункт.ТипСсылки = Перечисления.ТипСсылкиМеню.ВнешнийАдрес;
    Пункт.Адрес = Адрес;
    Пункт.Порядок = Порядок;
    Пункт.Активен = Истина;
    Пункт.Сайт = Сайт;
    Пункт.Записать();
КонецПроцедуры

// СоздатьФорму заводит форму обратной связи для страницы «Контакты».
Функция СоздатьФорму()
    Если ЗначениеЗаполнено(Справочники.ФормыОбратнойСвязи.НайтиПоНаименованию("Обратная связь")) Тогда
        Возврат Справочники.ФормыОбратнойСвязи.НайтиПоНаименованию("Обратная связь");
    КонецЕсли;
    Ф = Справочники.ФормыОбратнойСвязи.Создать();
    Ф.Наименование = "Обратная связь";
    Ф.Код = "contact";
    Ф.ЗаголовокФормы = "Напишите нам";
    Ф.ТекстКнопки = "Отправить";
    Ф.ТекстБлагодарности = "Спасибо! Мы ответим в течение рабочего дня.";
    Ф.Активна = Истина;
    Ф.Записать();
    Возврат Справочники.ФормыОбратнойСвязи.НайтиПоНаименованию("Обратная связь");
КонецФункции

Процедура СоздатьСтраницу(Сайт, Наименование, Слаг, Заголовок, Содержимое, Форма = Неопределено)
    Существующая = Справочники.Страницы.НайтиПоНаименованию(Наименование);
    Если ЗначениеЗаполнено(Существующая) Тогда
        // Демо-текст обновляется, но только если его НЕ ТРОГАЛИ: сравниваем с
        // тем, что клали прежние сборки. Совпало — заменяем, не совпало —
        // человек правил страницу, и она остаётся как есть. Без этого базы,
        // заполненные раньше, навсегда оставались бы с прежними двумя строками.
        Объект = Существующая.ПолучитьОбъект();
        Если ПрежнийДемоТекст(СокрЛП(Строка(Объект.Содержимое))) Тогда
            Объект.Содержимое = Содержимое;
            // Заголовок обновляется вместе с текстом, а не отдельно: они
            // написаны друг под друга, и «Добро пожаловать» над рассказом про
            // оптовые поставки выглядит остатком прошлой версии.
            Объект.Заголовок = Заголовок;
            Объект.ЗаголовокSEO = Заголовок;
            Объект.Записать();
        КонецЕсли;
        Возврат;
    КонецЕсли;
    Стр = Справочники.Страницы.Создать();
    Если Форма <> Неопределено Тогда
        Стр.Форма = Форма;
    КонецЕсли;
    Стр.Наименование = Наименование;
    Стр.Слаг = Слаг;
    Стр.Заголовок = Заголовок;
    Стр.Содержимое = Содержимое;
    Стр.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Стр.ДатаПубликации = ТекущаяДата();
    Стр.ЗаголовокSEO = Заголовок;
    Стр.Сайт = Сайт;
    Стр.Записать();
КонецПроцедуры
