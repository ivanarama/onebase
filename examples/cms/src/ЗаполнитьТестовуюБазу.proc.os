// Демо-контент сайта: стиль, сайт, три страницы и один редирект (план 129).
//
// Заполнение — ОТДЕЛЬНАЯ обработка, а не побочный эффект запроса к сайту.
// В конфигурации, с которой начинался этот пример, демо-данные создавались
// на каждом HTTP-запросе: боевой сайт нельзя было запустить пустым, и каждый
// заход посетителя проверял наличие десятков элементов.
//
// Идемпотентна: повторный запуск ничего не дублирует.
Процедура Выполнить()
    Если ЗначениеЗаполнено(Справочники.СтилиСайта.НайтиПоНаименованию("Базовый")) = Ложь Тогда
        Стиль = Справочники.СтилиСайта.Создать();
        Стиль.Наименование = "Базовый";
        Стиль.ЦветОсновной = "#2563eb";
        Стиль.ЦветДополнительный = "#0f172a";
        Стиль.ЦветФона = "#ffffff";
        Стиль.Описание = "Палитра по умолчанию";
        Стиль.Записать();
    КонецЕсли;
    // Шаблон заводится в базе, а не остаётся умолчанием в модуле: раздел 10
    // плана 129 требует, чтобы макет правился ПОЛЕМ КОДА в карточке, а не
    // только правкой Рендер.МакетПоУмолчанию. Разметка та же, поэтому вид
    // сайта не меняется — меняется место, где её правят (#1014).
    Если ЗначениеЗаполнено(Справочники.ШаблоныСайта.НайтиПоНаименованию("Базовый")) = Ложь Тогда
        Шаблон = Справочники.ШаблоныСайта.Создать();
        Шаблон.Наименование = "Базовый";
        Шаблон.Версия = "1";
        Шаблон.Описание = "Каркас страницы: шапка, меню, содержимое, список, подвал.";
        Шаблон.МакетHTML = Рендер.МакетПоУмолчанию();
        Шаблон.Записать();
    КонецЕсли;
    Шаблон = Справочники.ШаблоныСайта.НайтиПоНаименованию("Базовый");

    Стиль = Справочники.СтилиСайта.НайтиПоНаименованию("Базовый");

    Если ЗначениеЗаполнено(Справочники.Сайты.НайтиПоНаименованию("Демо-сайт")) = Ложь Тогда
        Сайт = Справочники.Сайты.Создать();
        Сайт.Наименование = "Демо-сайт";
        Сайт.Домен = "localhost";
        Сайт.Стиль = Стиль;
        Сайт.Шаблон = Шаблон;
        Сайт.Язык = "ru";
        Сайт.РоботсTxt = "User-agent: *" + Символы.ПС + "Disallow:";
        // Демо открывается прямо у платформы, без reverse proxy, поэтому в
        // canonical и sitemap.xml нужен префикс «/hs/site». За прокси, который
        // отдаёт сайт в корне домена, поле оставляют пустым (#1014).
        Сайт.ПрефиксПути = "/hs/site";
        Сайт.Активен = Истина;
        Сайт.Записать();
    КонецЕсли;
    Сайт = Справочники.Сайты.НайтиПоНаименованию("Демо-сайт");

    СоздатьСтраницу(Сайт, "Главная", "главная", "Добро пожаловать",
        "<p>Это демонстрационный сайт на OneBase. Контент правится в разделе «Сайт».</p>");
    СоздатьСтраницу(Сайт, "О компании", "about", "О компании",
        "<p>Страница создана обработкой «Заполнить демо-контент сайта».</p>");
    Форма = СоздатьФорму();
    СоздатьСтраницу(Сайт, "Контакты", "contacts", "Контакты",
        "<p>Телефон и адрес — обычные поля справочника, правятся без программиста.</p>", Форма);

    Если ЗначениеЗаполнено(Справочники.Редиректы.НайтиПоНаименованию("/o-kompanii")) = Ложь Тогда
        Ред = Справочники.Редиректы.Создать();
        Ред.Наименование = "/o-kompanii";
        Ред.Откуда = "o-kompanii";
        Ред.Куда = SEO.Префикс(Сайт.ПолучитьОбъект()) + "/about";
        Ред.Код = 301;
        Ред.Активен = Истина;
        Ред.Сайт = Сайт;
        Ред.Записать();
    КонецЕсли;

    // Картинка кладётся в базу, а не ссылается на внешний CDN: сайт должен
    // работать без чужого сервера. Публичный адрес выдаёт хук ПриЗаписи
    // справочника Медиа. Создаём ДО новостей — иначе обложке неоткуда взяться
    // в момент их записи.
    Обложка = СоздатьМедиа("Обложка новости");

    СоздатьНовость(Сайт, "Открылся новый сайт", "novyy-sayt",
        "<p>Сайт переехал на OneBase: контент и учёт теперь в одной базе.</p>",
        "<p>Раньше страницы правились в отдельной CMS, а цены приходилось переносить руками. "
        + "Теперь и то и другое живёт в одной системе.</p>", Обложка);
    СоздатьНовость(Сайт, "Как мы считаем сроки поставки", "sroki-postavki",
        "<p>Короткая заметка о том, откуда берутся сроки в карточке товара.</p>",
        "<p>Срок считается по остаткам и графику поставок — те же данные, что видит менеджер.</p>");

    // Адреса пунктов собираются из префикса сайта: зашитый «/hs/site/» за
    // reverse proxy ведёт в никуда (#1014).
    //
    // Префикс читается у ОБЪЕКТА, а не у ссылки: у ссылки реквизита нет, и
    // SEO.Префикс молча вернул бы пустоту — меню собралось бы без префикса при
    // заполненном реквизите сайта.
    Префикс = SEO.Префикс(Сайт.ПолучитьОбъект());
    СоздатьПунктМеню(Сайт, "Главная", "Главное", 10, Префикс + "/");
    СоздатьПунктМеню(Сайт, "О компании", "Главное", 20, Префикс + "/about");
    СоздатьПунктМеню(Сайт, "Каталог", "Главное", 30, Префикс + "/catalog");
    СоздатьПунктМеню(Сайт, "Новости", "Главное", 40, Префикс + "/news");
    СоздатьПунктМеню(Сайт, "Контакты", "Главное", 50, Префикс + "/contacts");
    СоздатьПунктМеню(Сайт, "Контакты (подвал)", "Подвал", 10, Префикс + "/contacts");

    // Маршруты заводятся явно, хотя те же правила действуют и по умолчанию:
    // так администратор видит таблицу адресов и может её менять, не трогая
    // модули (план 129, решение 5).
    СоздатьМаршрут(Сайт, "Корень сайта", "/", "Страница", 5);
    СоздатьМаршрут(Сайт, "Список новостей", "news", "Новости", 10);
    СоздатьМаршрут(Сайт, "Карточка новости", "news/{слаг}", "Новости", 20);
    СоздатьМаршрут(Сайт, "Витрина каталога", "catalog", "Каталог", 30);
    СоздатьМаршрут(Сайт, "Раздел каталога", "catalog/{слаг}", "Каталог", 40);
    СоздатьМаршрут(Сайт, "Карточка товара", "product/{слаг}", "Товар", 50);
    СоздатьМаршрут(Сайт, "Страница по слагу", "{слаг}", "Страница", 100);

    Сообщить("Демо-контент сайта готов: откройте /hs/site/");
КонецПроцедуры

// СоздатьМедиа кладёт крошечный PNG (красный квадрат 1×1) в поле карточки.
// Base64 взят литералом, чтобы демо не требовало внешних файлов.
Функция СоздатьМедиа(Наименование)
    Если ЗначениеЗаполнено(Справочники.Медиа.НайтиПоНаименованию(Наименование)) Тогда
        Возврат Справочники.Медиа.НайтиПоНаименованию(Наименование);
    КонецЕсли;
    PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
    М = Справочники.Медиа.Создать();
    М.Наименование = Наименование;
    М.Файл = СохранитьКартинку(PNG, "image/png");
    М.Тип = Перечисления.ТипМедиа.Изображение;
    М.Альт = Наименование;
    М.Активен = Истина;
    М.Записать();
    Возврат Справочники.Медиа.НайтиПоНаименованию(Наименование);
КонецФункции

Процедура СоздатьНовость(Сайт, Наименование, Слаг, Анонс, Содержимое, Картинка = Неопределено)
    Если ЗначениеЗаполнено(Справочники.Новости.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Нов = Справочники.Новости.Создать();
    Если Картинка <> Неопределено Тогда
        Нов.Картинка = Картинка;
    КонецЕсли;
    Нов.Наименование = Наименование;
    Нов.Слаг = Слаг;
    Нов.Анонс = Анонс;
    Нов.Содержимое = Содержимое;
    Нов.Автор = "Редакция";
    Нов.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Нов.ДатаПубликации = ТекущаяДата();
    Нов.ЗаголовокSEO = Наименование;
    Нов.Сайт = Сайт;
    Нов.Записать();
КонецПроцедуры

Процедура СоздатьМаршрут(Сайт, Наименование, Шаблон, ТипКонтента, Приоритет)
    Если ЗначениеЗаполнено(Справочники.МаршрутыURL.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    М = Справочники.МаршрутыURL.Создать();
    М.Наименование = Наименование;
    М.Шаблон = Шаблон;
    М.ТипКонтента = ТипКонтента;
    М.Приоритет = Приоритет;
    М.Активен = Истина;
    М.Сайт = Сайт;
    М.Записать();
КонецПроцедуры

Процедура СоздатьПунктМеню(Сайт, Наименование, КодМеню, Порядок, Адрес)
    Если ЗначениеЗаполнено(Справочники.Меню.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Пункт = Справочники.Меню.Создать();
    Пункт.Наименование = Наименование;
    Пункт.КодМеню = КодМеню;
    // Тип «внешний адрес» выбран осознанно: демо не должно зависеть от того,
    // в каком порядке созданы страницы. В боевом сайте пункт ссылается на
    // объект — тогда смена слага не ломает меню.
    Пункт.ТипСсылки = Перечисления.ТипСсылкиМеню.ВнешнийАдрес;
    Пункт.Адрес = Адрес;
    Пункт.Порядок = Порядок;
    Пункт.Активен = Истина;
    Пункт.Сайт = Сайт;
    Пункт.Записать();
КонецПроцедуры

// СоздатьФорму заводит форму обратной связи для страницы «Контакты».
Функция СоздатьФорму()
    Если ЗначениеЗаполнено(Справочники.ФормыОбратнойСвязи.НайтиПоНаименованию("Обратная связь")) Тогда
        Возврат Справочники.ФормыОбратнойСвязи.НайтиПоНаименованию("Обратная связь");
    КонецЕсли;
    Ф = Справочники.ФормыОбратнойСвязи.Создать();
    Ф.Наименование = "Обратная связь";
    Ф.Код = "contact";
    Ф.ЗаголовокФормы = "Напишите нам";
    Ф.ТекстКнопки = "Отправить";
    Ф.ТекстБлагодарности = "Спасибо! Мы ответим в течение рабочего дня.";
    Ф.Активна = Истина;
    Ф.Записать();
    Возврат Справочники.ФормыОбратнойСвязи.НайтиПоНаименованию("Обратная связь");
КонецФункции

Процедура СоздатьСтраницу(Сайт, Наименование, Слаг, Заголовок, Содержимое, Форма = Неопределено)
    Если ЗначениеЗаполнено(Справочники.Страницы.НайтиПоНаименованию(Наименование)) Тогда
        Возврат;
    КонецЕсли;
    Стр = Справочники.Страницы.Создать();
    Если Форма <> Неопределено Тогда
        Стр.Форма = Форма;
    КонецЕсли;
    Стр.Наименование = Наименование;
    Стр.Слаг = Слаг;
    Стр.Заголовок = Заголовок;
    Стр.Содержимое = Содержимое;
    Стр.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
    Стр.ДатаПубликации = ТекущаяДата();
    Стр.ЗаголовокSEO = Заголовок;
    Стр.Сайт = Сайт;
    Стр.Записать();
КонецПроцедуры
