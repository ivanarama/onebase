// Общие операции YML-импорта, вынесенные из обработки для регресс-тестов.

// ОбязательныйСайт разрешает только существующую ссылку. Импорт без владельца
// не должен создавать невидимые записи, а случайный UUID — считаться tenant-ом.
Функция ОбязательныйСайт(Значение) Экспорт
    Если Не ЗначениеЗаполнено(Значение) Тогда
        ВызватьИсключение "Выберите сайт-владелец импортируемого каталога";
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Сайты
    |ГДЕ Ссылка = &Сайт";
    З.УстановитьПараметр("Сайт", Значение);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Сайты.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    ВызватьИсключение "Выбранный сайт не найден";
КонецФункции

// ЗаписатьТовар обеспечивает идемпотентность внутри сайта. Внешний код не
// глобален: одинаковая выгрузка может независимо загружаться в два tenant-а.
Функция ЗаписатьТовар(Сайт, ВнешнийКод, Наименование, ЭтоГруппа, НовыйСлаг) Экспорт
    Существующий = НайтиПоВнешнемуКоду(Сайт, ВнешнийКод);
    Если ЗначениеЗаполнено(Существующий) Тогда
        Объект = Существующий.ПолучитьОбъект();
        Объект.Сайт = Сайт;
        Объект.Наименование = Наименование;
        ТекущийСлаг = СокрЛП(Строка(Объект.Слаг));
        Если ПустаяСтрока(ТекущийСлаг) ИЛИ ТекущийСлаг = "<nil>" Тогда
            Объект.Слаг = НовыйСлаг;
        КонецЕсли;
        // Признак группы приходится проставлять при каждой записи: он не
        // читается ПолучитьОбъект(), а Upsert пишет его всегда — без этого
        // повторный импорт превращал разделы каталога в обычные позиции.
        Объект.is_folder = ЭтоГруппа;
        Объект.Записать();
        Возврат Существующий;
    КонецЕсли;

    Новый_ = Справочники.Товары.Создать();
    Новый_.Сайт = Сайт;
    Новый_.Наименование = Наименование;
    Новый_.ВнешнийКод = ВнешнийКод;
    Новый_.Слаг = НовыйСлаг;
    // Признак группы и родитель хранятся служебными колонками, и в DSL у них
    // нет русских имён: «Объект.ЭтоГруппа = Истина» молча не срабатывает.
    Новый_.is_folder = ЭтоГруппа;
    Возврат Новый_.Записать();
КонецФункции

// ЗагрузитьКартинку тянет изображение выгрузки в медиатеку и возвращает ссылку
// на элемент «Медиа» (или Неопределено, если не получилось).
//
// Раньше импорт сохранял адрес картинки в реквизит и на этом заканчивал —
// «загрузка в медиатеку отдельным шагом». Шага не было, а публичная страница
// отдаётся с политикой «img-src 'self' data:»: чужой адрес браузер не покажет.
// Каталог приезжал с нулём картинок, и увидеть это можно было только глазами:
// в разметке тег есть, curl доволен, на странице пусто. Своя картинка отдаётся
// с /pub/<токен> — тот же адрес, что и сайт, политика его пропускает, и каталог
// перестаёт зависеть от чужого сервера.
//
// Сбой не роняет импорт: адрес остаётся в реквизите, а неудача попадает в отчёт.
// Повторный импорт картинку не перекачивает — элемент медиатеки ищется по имени.
Функция ЗагрузитьКартинку(Адрес, Наименование) Экспорт
    Если ПустаяСтрока(Адрес) ИЛИ Адрес = "<nil>" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Готовая = Справочники.Медиа.НайтиПоНаименованию(Наименование);
    Если ЗначениеЗаполнено(Готовая) Тогда
        Возврат Готовая;
    КонецЕсли;

    // Скачивание — ДО транзакции: чужой сервер отвечает сколько хочет, и держать
    // на это время открытую транзакцию значит копить блокировки на каждой
    // картинке каталога.
    Ответ = HTTPПолучить(Адрес);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "адрес ответил " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Тип = ТипИзображения(Ответ.ПолучитьЗаголовок("Content-Type"));

    // Картинка сохраняется В ТОЙ ЖЕ записи, что создаёт элемент медиатеки, и
    // без владельца — тем же способом, что и демо-заполнение. Вариант с
    // владельцем (третий аргумент) требует открытой транзакции, а внутри неё
    // запись объекта и запись блоба расходятся: элемент появляется, блоб — нет,
    // и картинка молча теряется. Плата за простой путь известна: блоб без
    // владельца не попадает под сборку мусора, поэтому повторный импорт
    // переиспользует элемент по имени, а не качает картинку заново.
    Элемент = Справочники.Медиа.Создать();
    Элемент.Наименование = Наименование;
    Элемент.Файл = СохранитьКартинку(Base64Строка(Ответ.ПолучитьТелоКакСтроку()), Тип);
    Элемент.Тип = Перечисления.ТипМедиа.Изображение;
    Элемент.Альт = Наименование;
    Элемент.Активен = Истина;
    // Публичную ссылку /pub/<токен> выдаёт хук ПриЗаписи справочника «Медиа».
    Возврат Элемент.Записать();
КонецФункции

// ТипИзображения проверяет, что пришла картинка, а не страница-заглушка.
// Без проверки «404 в оформлении сайта» с кодом 200 сохранялся бы как
// изображение: СохранитьКартинку принимает только image/*, и без разбора
// заголовка импорт падал бы там, где достаточно пропустить картинку.
Функция ТипИзображения(Заголовок) Экспорт
    Значение = НРег(СокрЛП(Строка(Заголовок)));
    Поз = СтрНайти(Значение, ";");
    Если Поз > 0 Тогда
        Значение = СокрЛП(Лев(Значение, Поз - 1));
    КонецЕсли;
    Если Лев(Значение, 6) <> "image/" Тогда
        ВызватьИсключение "по адресу не изображение, а " + ?(ПустаяСтрока(Значение), "ответ без типа", Значение);
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция НайтиПоВнешнемуКоду(Сайт, ВнешнийКод)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт И ВнешнийКод = &ВнешнийКод";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("ВнешнийКод", ВнешнийКод);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Товары.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Слаг собирает адрес позиции. Транслитерация намеренно простая: задача —
// получить читаемый и устойчивый адрес, а не идеальную латинизацию.
//
// Внешний код в хвост НЕ добавляется, пока адрес свободен: раздел «Грузия» с
// кодом «gruziya» иначе получал адрес /catalog/gruziya-gruziya, а карточка —
// хвост из полного наименования, уже переведённого в начале адреса. Код
// приписывается только при столкновении — тогда он и нужен.
Функция Слаг(Сайт, Наименование, ВнешнийКод) Экспорт
    Кандидат = Транслитерация(Наименование);
    Если ПустаяСтрока(Кандидат) Тогда
        Кандидат = Транслитерация(ВнешнийКод);
    КонецЕсли;
    Если ПустаяСтрока(Кандидат) Тогда
        Кандидат = "item";
    КонецЕсли;
    Если Не СлагЗанят(Сайт, Кандидат) Тогда
        Возврат Кандидат;
    КонецЕсли;

    // Столкновение: две позиции с одинаковым названием. Код внешней системы
    // уникален по определению, поэтому он и разводит адреса.
    Хвост = Транслитерация(ВнешнийКод);
    Если ПустаяСтрока(Хвост) Тогда
        Возврат Кандидат;
    КонецЕсли;
    Возврат Кандидат + "-" + Хвост;
КонецФункции

// СлагЗанят проверяет адрес в пределах САЙТА: составной UNIQUE-индекс
// (Сайт, Слаг) разрешает один и тот же адрес разным сайтам.
Функция СлагЗанят(Сайт, Кандидат)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт И Слаг = &Слаг";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("Слаг", Кандидат);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Истина;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция Транслитерация(Значение) Экспорт
    Таблица = Новый Соответствие;
    Латиница = "a b v g d e e zh z i y k l m n o p r s t u f h c ch sh sch y e yu ya";
    Кириллица = "а б в г д е ё ж з и й к л м н о п р с т у ф х ц ч ш щ ы э ю я";
    ЧастиЛат = СтрРазделить(Латиница, " ");
    ЧастиКир = СтрРазделить(Кириллица, " ");
    Для Сч = 0 По ЧастиКир.Количество() - 1 Цикл
        Таблица.Вставить(ЧастиКир[Сч], ЧастиЛат[Сч]);
    КонецЦикла;
    // Твёрдый и мягкий знаки выбрасываются, а не заменяются: в таблице им
    // соответствовал дефис, и «Бельгийское пиво» превращалось в «bel-giyskoe».
    Таблица.Вставить("ъ", "");
    Таблица.Вставить("ь", "");

    Исходная = НРег(СокрЛП(Строка(Значение)));
    Результат = "";
    Для Сч = 1 По СтрДлина(Исходная) Цикл
        Символ = Сред(Исходная, Сч, 1);
        Замена = Таблица.Получить(Символ);
        Если Замена <> Неопределено Тогда
            Результат = Результат + Замена;
        Иначе
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;

    // Всё, что не буква/цифра, схлопывается в дефис — регекс здесь уместнее
    // цепочки СтрЗаменить: список «плохих» символов иначе придётся пополнять
    // каждый раз, когда в выгрузке встретится новый.
    Результат = Новый Регекс("[^a-z0-9]+").Заменить(Результат, "-");
    Результат = Новый Регекс("^-+|-+$").Заменить(Результат, "");

    // Длина ограничена: наименования в выгрузках доходят до 200 символов, а
    // адрес такой длины не читается и плохо переносится в письме.
    Если СтрДлина(Результат) > 70 Тогда
        Результат = Лев(Результат, 70);
        Результат = Новый Регекс("-[a-z0-9]*$").Заменить(Результат, "");
    КонецЕсли;
    Возврат Результат;
КонецФункции
