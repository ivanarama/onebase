// Общие операции YML-импорта, вынесенные из обработки для регресс-тестов.

// ОбязательныйСайт разрешает только существующую ссылку. Импорт без владельца
// не должен создавать невидимые записи, а случайный UUID — считаться tenant-ом.
Функция ОбязательныйСайт(Значение) Экспорт
    Если Не ЗначениеЗаполнено(Значение) Тогда
        ВызватьИсключение "Выберите сайт-владелец импортируемого каталога";
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Сайты
    |ГДЕ Ссылка = &Сайт";
    З.УстановитьПараметр("Сайт", Значение);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Сайты.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    ВызватьИсключение "Выбранный сайт не найден";
КонецФункции

// ЗаписатьТовар обеспечивает идемпотентность внутри сайта. Внешний код не
// глобален: одинаковая выгрузка может независимо загружаться в два tenant-а.
Функция ЗаписатьТовар(Сайт, ВнешнийКод, Наименование, ЭтоГруппа, НовыйСлаг) Экспорт
    Существующий = НайтиПоВнешнемуКоду(Сайт, ВнешнийКод);
    Если ЗначениеЗаполнено(Существующий) Тогда
        Объект = Существующий.ПолучитьОбъект();
        Объект.Сайт = Сайт;
        Объект.Наименование = Наименование;
        ТекущийСлаг = СокрЛП(Строка(Объект.Слаг));
        Если ПустаяСтрока(ТекущийСлаг) ИЛИ ТекущийСлаг = "<nil>" Тогда
            Объект.Слаг = НовыйСлаг;
        КонецЕсли;
        // Признак группы приходится проставлять при каждой записи: он не
        // читается ПолучитьОбъект(), а Upsert пишет его всегда — без этого
        // повторный импорт превращал разделы каталога в обычные позиции.
        Объект.is_folder = ЭтоГруппа;
        Объект.Записать();
        Возврат Существующий;
    КонецЕсли;

    Новый_ = Справочники.Товары.Создать();
    Новый_.Сайт = Сайт;
    Новый_.Наименование = Наименование;
    Новый_.ВнешнийКод = ВнешнийКод;
    Новый_.Слаг = НовыйСлаг;
    // Признак группы и родитель хранятся служебными колонками, и в DSL у них
    // нет русских имён: «Объект.ЭтоГруппа = Истина» молча не срабатывает.
    Новый_.is_folder = ЭтоГруппа;
    Возврат Новый_.Записать();
КонецФункции

// Наибольший размер картинки каталога. Ограничение считается по base64 ДО
// декодирования: иначе стомегабайтный «аватар» разворачивается в память целиком
// ещё до того, как его отвергнут.
Функция ПределКартинкиБайт() Экспорт
    Возврат 5242880;
КонецФункции

// ЗагрузитьКартинку тянет изображение выгрузки в медиатеку и возвращает ссылку
// на элемент «Медиа» (Неопределено — картинки нет или источник не разрешён).
//
// Раньше импорт сохранял адрес картинки в реквизит и на этом заканчивал —
// «загрузка в медиатеку отдельным шагом». Шага не было, а публичная страница
// отдаётся с политикой «img-src 'self' data:»: чужой адрес браузер не покажет.
// Каталог приезжал с нулём картинок, и увидеть это можно было только глазами:
// в разметке тег есть, curl доволен, на странице пусто. Своя картинка отдаётся
// с /pub/<токен> — тот же адрес, что и сайт, политика его пропускает, и каталог
// перестаёт зависеть от чужого сервера.
//
// Три границы, без которых загрузка по адресу из чужого файла небезопасна:
//   1. Идём ТОЛЬКО на домен, названный оператором в параметре обработки.
//      Адрес в выгрузке пишет тот, кто её прислал, и без этой границы сервер
//      сходит по нему куда угодно внутри периметра.
//   2. Формат определяется по САМИМ БАЙТАМ, а не по заголовку ответа: заголовок
//      пишет тот же чужой сервер.
//   3. Ключ элемента медиатеки — адрес картинки в области сайта, а не
//      отображаемое имя: названия товаров повторяются.
//
// Сбой не роняет импорт: адрес остаётся в реквизите, а неудача попадает в отчёт.
Функция ЗагрузитьКартинку(Сайт, Адрес, Наименование, Источник) Экспорт
    Если ПустаяСтрока(Адрес) ИЛИ Адрес = "<nil>" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Не ИсточникРазрешён(Адрес, Источник) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Готовая = НайтиКартинку(Сайт, Адрес);
    Если ЗначениеЗаполнено(Готовая) Тогда
        Возврат Готовая;
    КонецЕсли;

    Ответ = HTTPПолучить(Адрес);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "адрес ответил " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Данные = Base64Строка(Ответ.ПолучитьТелоКакСтроку());
    Если СтрДлина(Данные) / 4 * 3 > ПределКартинкиБайт() Тогда
        ВызватьИсключение "картинка больше " + Строка(ПределКартинкиБайт() / 1048576) + " МБ";
    КонецЕсли;
    Тип = ФорматКартинки(Данные);

    // Картинка сохраняется В ТОЙ ЖЕ записи, что создаёт элемент медиатеки, и
    // без владельца — тем же способом, что и демо-заполнение. Вариант с
    // владельцем (третий аргумент) требует открытой транзакции, а внутри неё
    // запись объекта и запись блоба расходятся: элемент появляется, блоб — нет,
    // и картинка молча теряется. Плата за простой путь известна: блоб без
    // владельца не попадает под сборку мусора, поэтому повторный импорт
    // переиспользует элемент по ключу, а не качает картинку заново.
    Элемент = Справочники.Медиа.Создать();
    Элемент.Наименование = Наименование;
    Элемент.Файл = СохранитьКартинку(Данные, Тип);
    Элемент.Тип = Перечисления.ТипМедиа.Изображение;
    Элемент.Альт = Наименование;
    Элемент.Сайт = Сайт;
    Элемент.ВнешнийКлюч = Адрес;
    Элемент.Активен = Истина;
    // Публичную ссылку /pub/<токен> выдаёт хук ПриЗаписи справочника «Медиа».
    Возврат Элемент.Записать();
КонецФункции

// НайтиКартинку ищет уже загруженное изображение по АДРЕСУ ИСТОЧНИКА в пределах
// сайта. По наименованию искать нельзя: названия товаров повторяются и внутри
// каталога, и между сайтами — второй товар получал бы картинку первого, а его
// собственный адрес не запрашивался бы вовсе.
//
// Неактивный элемент тоже считается найденным: снятие галки «Активен» отзывает
// публикацию осознанно, и импорт не должен обходить это решение новой записью.
Функция НайтиКартинку(Сайт, Адрес) Экспорт
    Если Не ЗначениеЗаполнено(Сайт) ИЛИ ПустаяСтрока(Адрес) Тогда
        Возврат Неопределено;
    КонецЕсли;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Медиа
    |ГДЕ Сайт = &Сайт И ВнешнийКлюч = &Ключ";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("Ключ", Адрес);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Медиа.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// ИсточникРазрешён — граница исходящих запросов. Разрешён ровно один адрес,
// названный оператором: домен, а при необходимости и порт («example.com» либо
// «example.com:8443»).
//
// Порт сверяется отдельно от домена: без этого выгрузка водила бы сервер по
// портам разрешённого хоста, и «картинка» с 127.0.0.1:5432 превращалась бы в
// сканирование сети изнутри. Домен без порта означает обычные 80 и 443 — если
// картинки лежат на другом порту, оператор называет его явно.
//
// Адреса автонастройки (169.254.0.0/16, среди них 169.254.169.254 с ключами
// облака) запрещены всегда: каталогов там не бывает, а цена ошибки предельная.
Функция ИсточникРазрешён(Адрес, Источник) Экспорт
    Разрешённый = НРег(СокрЛП(Строка(Источник)));
    Если ПустаяСтрока(Разрешённый) Тогда
        Возврат Ложь;
    КонецЕсли;
    РазрешённыйХост = Разрешённый;
    РазрешённыйПорт = "";
    Граница = СтрНайти(Разрешённый, ":");
    Если Граница > 0 Тогда
        РазрешённыйХост = Лев(Разрешённый, Граница - 1);
        РазрешённыйПорт = СокрЛП(Сред(Разрешённый, Граница + 1));
    КонецЕсли;

    Значение = НРег(СокрЛП(Строка(Адрес)));
    Если Лев(Значение, 7) = "http://" Тогда
        Остаток = Сред(Значение, 8);
        ПортПоУмолчанию = "80";
    ИначеЕсли Лев(Значение, 8) = "https://" Тогда
        Остаток = Сред(Значение, 9);
        ПортПоУмолчанию = "443";
    Иначе
        // Прочие схемы (file:, data:, gopher:) — не адрес каталога.
        Возврат Ложь;
    КонецЕсли;
    // Учётные данные в адресе («http://разрешённый@внутренний/») переносят
    // настоящий хост за собаку: сравнение с доменом до неё пропустило бы чужой.
    Если СтрНайти(Остаток, "@") > 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Авторитет = Остаток;
    Поз = СтрНайти(Авторитет, "/");
    Если Поз > 0 Тогда
        Авторитет = Лев(Авторитет, Поз - 1);
    КонецЕсли;
    Хост = Авторитет;
    Порт = ПортПоУмолчанию;
    Двоеточие = СтрНайти(Авторитет, ":");
    Если Двоеточие > 0 Тогда
        Хост = Лев(Авторитет, Двоеточие - 1);
        Порт = СокрЛП(Сред(Авторитет, Двоеточие + 1));
    КонецЕсли;
    Если Лев(Хост, 8) = "169.254." Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Хост <> РазрешённыйХост Тогда
        Возврат Ложь;
    КонецЕсли;
    Если ПустаяСтрока(РазрешённыйПорт) Тогда
        Возврат Порт = "80" ИЛИ Порт = "443";
    КонецЕсли;
    Возврат Порт = РазрешённыйПорт;
КонецФункции

// ФорматКартинки определяет формат по НАЧАЛЬНЫМ БАЙТАМ, а не по заголовку
// ответа: Content-Type пишет тот же сервер, что и тело, и «image/png» поверх
// страницы-заглушки или SVG раньше считался успешной загрузкой. SVG отвергается
// намеренно: это документ со скриптами, и публичная выдача его картинкой не
// рисует.
//
// Сигнатура сверяется в base64: там границы байтов не зависят от кодировки
// строки, тогда как сырое тело — это байты, и посимвольное сравнение на них
// врёт. Первые байты каждого формата дают устойчивое начало base64.
Функция ФорматКартинки(ДанныеBase64) Экспорт
    Данные = СокрЛП(Строка(ДанныеBase64));
    Если ПустаяСтрока(Данные) Тогда
        ВызватьИсключение "пустой ответ";
    КонецЕсли;
    // 89 50 4E 47 0D 0A 1A 0A
    Если Лев(Данные, 11) = "iVBORw0KGgo" Тогда
        Возврат "image/png";
    КонецЕсли;
    // FF D8 FF
    Если Лев(Данные, 4) = "/9j/" Тогда
        Возврат "image/jpeg";
    КонецЕсли;
    // 47 49 46 38 («GIF8»)
    Если Лев(Данные, 6) = "R0lGOD" Тогда
        Возврат "image/gif";
    КонецЕсли;
    // 52 49 46 46 («RIFF») + байты 9–11 «EBP» из «WEBP»: одного RIFF мало, под
    // ним же лежат звук и видео.
    Если Лев(Данные, 5) = "UklGR" И Сред(Данные, 13, 4) = "RUJQ" Тогда
        Возврат "image/webp";
    КонецЕсли;
    ВызватьИсключение "по адресу не картинка поддерживаемого формата"
        + " (ожидаются PNG, JPEG, GIF, WEBP)";
КонецФункции

Функция НайтиПоВнешнемуКоду(Сайт, ВнешнийКод)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт И ВнешнийКод = &ВнешнийКод";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("ВнешнийКод", ВнешнийКод);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Товары.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Слаг собирает адрес позиции. Транслитерация намеренно простая: задача —
// получить читаемый и устойчивый адрес, а не идеальную латинизацию.
//
// Внешний код в хвост НЕ добавляется, пока адрес свободен: раздел «Грузия» с
// кодом «gruziya» иначе получал адрес /catalog/gruziya-gruziya, а карточка —
// хвост из полного наименования, уже переведённого в начале адреса. Код
// приписывается только при столкновении — тогда он и нужен.
Функция Слаг(Сайт, Наименование, ВнешнийКод) Экспорт
    Кандидат = Транслитерация(Наименование);
    Если ПустаяСтрока(Кандидат) Тогда
        Кандидат = Транслитерация(ВнешнийКод);
    КонецЕсли;
    Если ПустаяСтрока(Кандидат) Тогда
        Кандидат = "item";
    КонецЕсли;
    Если Не СлагЗанят(Сайт, Кандидат) Тогда
        Возврат Кандидат;
    КонецЕсли;

    // Столкновение: две позиции с одинаковым названием. Код внешней системы
    // уникален по определению, поэтому он и разводит адреса.
    Хвост = Транслитерация(ВнешнийКод);
    Если ПустаяСтрока(Хвост) Тогда
        Возврат Кандидат;
    КонецЕсли;
    Возврат Кандидат + "-" + Хвост;
КонецФункции

// СлагЗанят проверяет адрес в пределах САЙТА: составной UNIQUE-индекс
// (Сайт, Слаг) разрешает один и тот же адрес разным сайтам.
Функция СлагЗанят(Сайт, Кандидат)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт И Слаг = &Слаг";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("Слаг", Кандидат);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Истина;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция Транслитерация(Значение) Экспорт
    Таблица = Новый Соответствие;
    Латиница = "a b v g d e e zh z i y k l m n o p r s t u f h c ch sh sch y e yu ya";
    Кириллица = "а б в г д е ё ж з и й к л м н о п р с т у ф х ц ч ш щ ы э ю я";
    ЧастиЛат = СтрРазделить(Латиница, " ");
    ЧастиКир = СтрРазделить(Кириллица, " ");
    Для Сч = 0 По ЧастиКир.Количество() - 1 Цикл
        Таблица.Вставить(ЧастиКир[Сч], ЧастиЛат[Сч]);
    КонецЦикла;
    // Твёрдый и мягкий знаки выбрасываются, а не заменяются: в таблице им
    // соответствовал дефис, и «Бельгийское пиво» превращалось в «bel-giyskoe».
    Таблица.Вставить("ъ", "");
    Таблица.Вставить("ь", "");

    Исходная = НРег(СокрЛП(Строка(Значение)));
    Результат = "";
    Для Сч = 1 По СтрДлина(Исходная) Цикл
        Символ = Сред(Исходная, Сч, 1);
        Замена = Таблица.Получить(Символ);
        Если Замена <> Неопределено Тогда
            Результат = Результат + Замена;
        Иначе
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;

    // Всё, что не буква/цифра, схлопывается в дефис — регекс здесь уместнее
    // цепочки СтрЗаменить: список «плохих» символов иначе придётся пополнять
    // каждый раз, когда в выгрузке встретится новый.
    Результат = Новый Регекс("[^a-z0-9]+").Заменить(Результат, "-");
    Результат = Новый Регекс("^-+|-+$").Заменить(Результат, "");

    // Длина ограничена: наименования в выгрузках доходят до 200 символов, а
    // адрес такой длины не читается и плохо переносится в письме.
    Если СтрДлина(Результат) > 70 Тогда
        Результат = Лев(Результат, 70);
        Результат = Новый Регекс("-[a-z0-9]*$").Заменить(Результат, "");
    КонецЕсли;
    Возврат Результат;
КонецФункции
