// Общие операции YML-импорта, вынесенные из обработки для регресс-тестов.

// ОбязательныйСайт разрешает только существующую ссылку. Импорт без владельца
// не должен создавать невидимые записи, а случайный UUID — считаться tenant-ом.
Функция ОбязательныйСайт(Значение) Экспорт
    Если Не ЗначениеЗаполнено(Значение) Тогда
        ВызватьИсключение "Выберите сайт-владелец импортируемого каталога";
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Сайты
    |ГДЕ Ссылка = &Сайт";
    З.УстановитьПараметр("Сайт", Значение);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Сайты.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    ВызватьИсключение "Выбранный сайт не найден";
КонецФункции

// ЗаписатьТовар обеспечивает идемпотентность внутри сайта. Внешний код не
// глобален: одинаковая выгрузка может независимо загружаться в два tenant-а.
Функция ЗаписатьТовар(Сайт, ВнешнийКод, Наименование, ЭтоГруппа, НовыйСлаг) Экспорт
    Существующий = НайтиПоВнешнемуКоду(Сайт, ВнешнийКод);
    Если ЗначениеЗаполнено(Существующий) Тогда
        Объект = Существующий.ПолучитьОбъект();
        Объект.Сайт = Сайт;
        Объект.Наименование = Наименование;
        ТекущийСлаг = СокрЛП(Строка(Объект.Слаг));
        Если ПустаяСтрока(ТекущийСлаг) ИЛИ ТекущийСлаг = "<nil>" Тогда
            Объект.Слаг = НовыйСлаг;
        КонецЕсли;
        // Признак группы приходится проставлять при каждой записи: он не
        // читается ПолучитьОбъект(), а Upsert пишет его всегда — без этого
        // повторный импорт превращал разделы каталога в обычные позиции.
        Объект.is_folder = ЭтоГруппа;
        Объект.Записать();
        Возврат Существующий;
    КонецЕсли;

    Новый_ = Справочники.Товары.Создать();
    Новый_.Сайт = Сайт;
    Новый_.Наименование = Наименование;
    Новый_.ВнешнийКод = ВнешнийКод;
    Новый_.Слаг = НовыйСлаг;
    // Признак группы и родитель хранятся служебными колонками, и в DSL у них
    // нет русских имён: «Объект.ЭтоГруппа = Истина» молча не срабатывает.
    Новый_.is_folder = ЭтоГруппа;
    Возврат Новый_.Записать();
КонецФункции

Функция НайтиПоВнешнемуКоду(Сайт, ВнешнийКод)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка
    |ИЗ Справочник.Товары
    |ГДЕ Сайт = &Сайт И ВнешнийКод = &ВнешнийКод";
    З.УстановитьПараметр("Сайт", Сайт);
    З.УстановитьПараметр("ВнешнийКод", ВнешнийКод);
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Справочники.Товары.НайтиПоИдентификатору(Строка(Стр.Ссылка));
    КонецЦикла;
    Возврат Неопределено;
КонецФункции
