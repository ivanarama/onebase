// Меню сайта (план 129, слайс C4).
//
// Возвращает ДАННЫЕ (Массив структур), а не готовый HTML. Разметку рисует
// шаблон страницы: если бы меню склеивалось строками и вставлялось в макет
// целиком, его пришлось бы помечать доверенным HTML — и заголовок пункта,
// введённый контент-менеджером, обошёл бы экранирование.

// Пункты возвращает пункты меню по коду, отсортированные по Порядку.
// ТекущийПуть нужен, чтобы подсветить активный пункт.
Функция Пункты(Сайт, КодМеню, ТекущийПуть) Экспорт
    З = Новый Запрос;
    // Слаги берём точками прямо в запросе, а не разыменовываем ссылку потом:
    // в результате запроса ссылочный реквизит приходит сырым идентификатором,
    // и ЗначениеРеквизитаОбъекта на нём возвращает Неопределено. Адрес тогда
    // собирался как «/hs/site/<nil>» — ссылка в никуда в каждом пункте меню,
    // указывающем на объект. В демо-данных этого не видно: там все пункты
    // заданы внешним адресом.
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, КодМеню, ТипСсылки, Страница, Новость,
    |Категория, Товар, Адрес, Порядок, Активен,
    |Страница.Слаг КАК СлагСтраницы, Новость.Слаг КАК СлагНовости,
    |Категория.Слаг КАК СлагКатегории, Товар.Слаг КАК СлагТовара
    |ИЗ Справочник.Меню
    |УПОРЯДОЧИТЬ ПО Порядок";
    Результат = З.Выполнить();

    Пункты = Новый Массив;
    Для Каждого Стр Из Результат Цикл
        Если Не Стр.Активен Тогда
            Продолжить;
        КонецЕсли;
        Если НРег(СокрЛП(Строка(Стр.КодМеню))) <> НРег(СокрЛП(Строка(КодМеню))) Тогда
            Продолжить;
        КонецЕсли;
        Адрес = АдресПункта(Сайт, Стр);
        Если ПустаяСтрока(Адрес) Тогда
            // Пункт без цели молча пропускаем: в меню он был бы ссылкой в
            // никуда, а это хуже отсутствующего пункта.
            Продолжить;
        КонецЕсли;
        Пункт = Новый Структура;
        Пункт.Вставить("Заголовок", Стр.Наименование);
        Пункт.Вставить("Адрес", Адрес);
        Пункт.Вставить("Активный", Активен(Сайт, Адрес, ТекущийПуть));
        Пункты.Добавить(Пункт);
    КонецЦикла;
    Возврат Пункты;
КонецФункции

// АдресПункта собирает адрес по типу ссылки. Внешний адрес берётся как есть,
// внутренние — через слаг объекта и префикс сайта: зашитый «/hs/site/» за
// reverse proxy вёл в никуда (#1014).
Функция АдресПункта(Сайт, Стр) Экспорт
    Префикс = SEO.Префикс(Сайт);
    Тип = Строка(Стр.ТипСсылки);
    Если Тип = "ВнешнийАдрес" Тогда
        Возврат СокрЛП(Строка(Стр.Адрес));
    ИначеЕсли Тип = "Страница" И ЗначениеЗаполнено(Стр.СлагСтраницы) Тогда
        Возврат Префикс + "/" + СокрЛП(Строка(Стр.СлагСтраницы));
    ИначеЕсли Тип = "Новость" И ЗначениеЗаполнено(Стр.СлагНовости) Тогда
        Возврат Префикс + "/news/" + СокрЛП(Строка(Стр.СлагНовости));
    ИначеЕсли Тип = "Категория" И ЗначениеЗаполнено(Стр.СлагКатегории) Тогда
        // Раньше адрес собирался как «news?категория=…», а роутер этот
        // параметр не читал: пункт вёл на полный список новостей. Теперь
        // список фильтруется, и ссылка означает то, что обещает.
        Возврат Префикс + "/news?категория=" + СокрЛП(Строка(Стр.СлагКатегории));
    ИначеЕсли Тип = "Товар" И ЗначениеЗаполнено(Стр.СлагТовара) Тогда
        Возврат Префикс + "/product/" + СокрЛП(Строка(Стр.СлагТовара));
    КонецЕсли;
    Возврат СокрЛП(Строка(Стр.Адрес));
КонецФункции

// Активен сравнивает адрес пункта с текущим путём. Сравнение по «хвосту»
// адреса: в макете ссылки абсолютные, а роутер знает только путь внутри сайта.
// Префикс берётся у сайта, а не зашит: за прокси он пустой.
Функция Активен(Сайт, Адрес, ТекущийПуть) Экспорт
    Хвост = Строка(Адрес);
    Префикс = SEO.Префикс(Сайт) + "/";
    Если Лев(Хвост, СтрДлина(Префикс)) = Префикс Тогда
        Хвост = Сред(Хвост, СтрДлина(Префикс) + 1);
    КонецЕсли;
    // Параметры запроса в сравнении не участвуют: пункт «Категория» ведёт на
    // «news?категория=…», а текущий путь — это «news».
    Позиция = СтрНайти(Хвост, "?");
    Если Позиция > 0 Тогда
        Хвост = Лев(Хвост, Позиция - 1);
    КонецЕсли;
    Возврат НРег(СокрЛП(Хвост)) = НРег(СокрЛП(Строка(ТекущийПуть)));
КонецФункции
