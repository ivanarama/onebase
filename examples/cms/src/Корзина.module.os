// Корзина покупателя и оформление заказа (план 156, слайсы S3–S4).
//
// Три правила, на которых держится модуль:
//
// 1. В куке лежит ТОЛЬКО идентификатор корзины. Состав и цены живут в базе:
//    кука подделывается, а вместе с ней подделывалась бы и цена.
// 2. Цену, наименование и артикул берёт база. Из браузера принимаются лишь
//    ссылка на товар и количество — иначе «купить за 1 ₽» делается правкой
//    скрытого поля в инспекторе браузера.
// 3. Всё, что меняет состояние, проверяет заголовок Origin. Токена в форме
//    нет: второго секрета взять негде (генератора случайных значений в DSL не
//    существует), а сверка источника — стандартная защита без состояния.

Функция ИмяКуки() Экспорт
    Возврат "ob_cart";
КонецФункции

// СрокКукиСекунд — 30 дней. Корзину оптовик набирает не за один заход: типовой
// сценарий «посмотрел днём, дозаказал вечером» не должен терять состав.
Функция СрокКукиСекунд() Экспорт
    Возврат 2592000;
КонецФункции

// МаксПозиций ограничивает НОМЕНКЛАТУРНЫЕ строки, а не количество товара:
// корзина — цель для накачки, каждая позиция стоит строки в базе.
Функция МаксПозиций() Экспорт
    Возврат 50;
КонецФункции

Функция МаксКоличество() Экспорт
    Возврат 999;
КонецФункции

// ─────────────────────────── куки ───────────────────────────

// ЗначениеКуки достаёт идентификатор корзины из заголовка Cookie.
//
// Шаблон намеренно допускает только символы UUID: значение куки приходит от
// клиента, а дальше идёт в поиск по базе. Мусор отсекается здесь, а не в трёх
// местах ниже.
Функция ЗначениеКуки(Запрос) Экспорт
    Если Запрос = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат ИдИзКуки(Запрос.ПолучитьЗаголовок("Cookie"));
КонецФункции

// ИдИзКуки отделён от ЗначениеКуки, чтобы разбор проверялся тестом: объект
// запроса тест подделать не может, а строку заголовка — легко.
Функция ИдИзКуки(Заголовок) Экспорт
    Текст = Строка(Заголовок);
    Если ПустаяСтрока(Текст) ИЛИ Текст = "<nil>" Тогда
        Возврат "";
    КонецЕсли;
    Рег = Новый Регекс("(?:^|;\s*)" + ИмяКуки() + "=([0-9a-fA-F\-]{36})");
    Найдено = Рег.Найти(Текст);
    Если Найдено = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Найдено.Группы[1];
КонецФункции

// ЗаголовокКуки собирает Set-Cookie.
//
// HttpOnly — потому что идентификатор корзины скрипту не нужен (скриптов на
// сайте нет вовсе). SameSite=Lax — чтобы кука не прикладывалась к чужим
// POST-запросам; это дополнение к проверке Origin, а не замена ей.
//
// Secure ставится только на HTTPS: на демо-стенде по http кука с этим
// признаком просто не сохранилась бы, и корзина молча теряла бы товары.
Функция ЗаголовокКуки(Запрос, Значение) Экспорт
    Результат = ИмяКуки() + "=" + Значение + "; Path=/; Max-Age=" + СрокКукиСекунд()
        + "; HttpOnly; SameSite=Lax";
    Если ЭтоHTTPS(Запрос) Тогда
        Результат = Результат + "; Secure";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЭтоHTTPS(Запрос) Экспорт
    Если Запрос = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Схема = НРег(СокрЛП(Строка(Запрос.ПолучитьЗаголовок("X-Forwarded-Proto"))));
    Возврат Схема = "https";
КонецФункции

// ─────────────────────── защита от подделки ───────────────────────

// ПроверитьИсточник — защита от запроса, отправленного с чужого сайта.
//
// Браузер сам сообщает происхождение: Origin приходит на любой POST, Referer —
// почти всегда. Сравнивается ХОСТ, а не строка целиком: порт и схема у стенда
// и у боевого сайта разные, а подделать хост, не подделав его в браузере,
// нельзя.
//
// Запрос вообще без обоих заголовков отвергается. Живой браузер их шлёт;
// молчит обычно скрипт, а скрипту здесь делать нечего.
Функция ПроверитьИсточник(Запрос) Экспорт
    Если Запрос = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Источник = Строка(Запрос.ПолучитьЗаголовок("Origin"));
    Если ПустаяСтрока(Источник) ИЛИ Источник = "<nil>" Тогда
        Источник = Строка(Запрос.ПолучитьЗаголовок("Referer"));
    КонецЕсли;
    Возврат ИсточникСовпадает(Роутер.ХостЗапроса(Запрос), Источник);
КонецФункции

// ИсточникСовпадает вынесен из ПроверитьИсточник ради теста: сравнение хостов
// — это и есть правило, а чтение двух заголовков вокруг него проверять нечем.
Функция ИсточникСовпадает(Свой, Источник) Экспорт
    Если ПустаяСтрока(Свой) Тогда
        // Хоста нет — сравнивать не с чем, и «пропустить на всякий случай»
        // здесь означало бы выключить проверку целиком.
        Возврат Ложь;
    КонецЕсли;
    Текст = Строка(Источник);
    Если ПустаяСтрока(Текст) ИЛИ Текст = "<nil>" Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Роутер.НормализоватьДомен(ХостИзАдреса(Текст)) = Свой;
КонецФункции

// ХостИзАдреса вырезает хост из «https://имя:порт/путь». Разбирать URL целиком
// незачем: сравнивается только хост.
Функция ХостИзАдреса(Адрес) Экспорт
    Значение = СокрЛП(Строка(Адрес));
    Позиция = СтрНайти(Значение, "://");
    Если Позиция > 0 Тогда
        Значение = Сред(Значение, Позиция + 3);
    КонецЕсли;
    Косая = СтрНайти(Значение, "/");
    Если Косая > 0 Тогда
        Значение = Лев(Значение, Косая - 1);
    КонецЕсли;
    Возврат Значение;
КонецФункции

// ─────────────────────────── корзина ───────────────────────────

// НайтиКорзину возвращает Структуру {Ссылка, Ид, Оформлена, Заказ} или
// Неопределено. Оформленная корзина тоже возвращается: по ней страница
// оформления уводит на созданный заказ вместо второго такого же.
Функция НайтиКорзину(Сайт, Ид) Экспорт
    Если Сайт = Неопределено ИЛИ ПустаяСтрока(Ид) Тогда
        Возврат Неопределено;
    КонецЕсли;

    З = Новый Запрос;
    // Сайт в условии обязателен: одна база держит несколько сайтов, и корзина
    // соседнего сайта не должна открываться здесь даже по верному идентификатору.
    // Заказ.Ссылка — разыменование поля-ссылки через точку: само поле «Заказ»
    // в выборке пришло бы ПРЕДСТАВЛЕНИЕМ («ЗС-000001»), а адрес заказа
    // собирается по идентификатору.
    З.Текст = "ВЫБРАТЬ Ссылка, Оформлена, Заказ.Ссылка КАК ИдЗаказа
    |ИЗ Справочник.Корзины
    |ГДЕ Ссылка = &Ид И Сайт = &Сайт";
    З.УстановитьПараметр("Ид", Ид);
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Для Каждого Стр Из З.Выполнить() Цикл
        Описание = Новый Структура;
        Описание.Вставить("Ссылка", Справочники.Корзины.НайтиПоИдентификатору(Ид));
        Описание.Вставить("Ид", Ид);
        Описание.Вставить("Оформлена", Стр.Оформлена = Истина);
        Описание.Вставить("Заказ", Рендер.ТекстЗначения(Стр.ИдЗаказа));
        Возврат Описание;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// ЗавестиКорзину создаёт пустую корзину и возвращает её описание.
Функция ЗавестиКорзину(Сайт) Экспорт
    Объект = Справочники.Корзины.Создать();
    // Наименование — для человека в списке справочника, а не ключ: искать
    // корзину по нему незачем, у неё есть UUID.
    Объект.Наименование = "Корзина от " + Формат(ТекущаяДатаВремя(), "ДФ=dd.MM.yyyy HH:mm");
    Объект.Сайт = Сайт.Ссылка;
    Объект.Дата = ТекущаяДатаВремя();
    Объект.Оформлена = Ложь;
    Ссылка = Объект.Записать();

    Описание = Новый Структура;
    Описание.Вставить("Ссылка", Ссылка);
    // Строка(Ссылка) дала бы ПРЕДСТАВЛЕНИЕ («Корзина от 25.08.2026»), а не
    // идентификатор: UUID у ссылки отдаёт только УникальныйИдентификатор().
    Описание.Вставить("Ид", Ссылка.УникальныйИдентификатор());
    Описание.Вставить("Оформлена", Ложь);
    Описание.Вставить("Заказ", "");
    Возврат Описание;
КонецФункции

// Содержимое собирает строки корзины с АКТУАЛЬНЫМИ данными товаров.
//
// Цена не хранится в корзине намеренно: между «положил» и «оформил» проходят
// дни, и показывать вчерашнюю цену — обман, а считать по ней — убыток. Данные
// берутся ОДНИМ запросом по списку ссылок, а не запросом на строку.
Функция Содержимое(Сайт, Описание) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Строки", Новый Массив);
    Результат.Вставить("Итого", 0);
    Результат.Вставить("ИтогоСтрокой", "");
    Результат.Вставить("Позиций", 0);
    Результат.Вставить("Валюта", "");
    Результат.Вставить("РазныеВалюты", Ложь);
    Если Описание = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    Объект = Описание.Ссылка.ПолучитьОбъект();
    Ссылки = Новый Массив;
    Количества = Новый Соответствие;
    Для Каждого Стр Из Объект.Строки Цикл
        // Ключ — идентификатор, а не Строка(Стр.Товар): от ссылки Строка() даёт
        // представление товара, а названия повторяются.
        Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
            Продолжить;
        КонецЕсли;
        Ключ = Стр.Товар.УникальныйИдентификатор();
        Ссылки.Добавить(Ключ);
        Количества.Вставить(Ключ, Число(Стр.Количество));
    КонецЦикла;
    Если Ссылки.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    З = Новый Запрос;
    // Публикация проверяется здесь же: снятый с публикации товар не должен
    // оформляться в заказ только потому, что лежал в корзине со вчера. Сама
    // проверка — Роутер.Опубликовано, а не условие в SQL: статус и дата
    // публикации обязаны читаться в ОДНОМ месте, иначе черновик рано или поздно
    // утечёт через забытый список.
    З.Текст = "ВЫБРАТЬ Ссылка, Наименование, Артикул, Слаг, Цена, Валюта,
    |СтатусПубликации, ДатаПубликации,
    |Картинка.ПубличнаяСсылка КАК КартинкаСсылка, КартинкаURL
    |ИЗ Справочник.Товары
    |ГДЕ Ссылка В (&Ссылки) И Сайт = &Сайт
    |УПОРЯДОЧИТЬ ПО Наименование";
    З.УстановитьПараметр("Ссылки", Ссылки);
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);

    Итого = 0;
    Валюта = "";
    Префикс = SEO.Префикс(Сайт);
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Не Роутер.Опубликовано(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Ключ = Рендер.ТекстЗначения(Стр.Ссылка);
        Количество = Количества.Получить(Ключ);
        Если Количество = Неопределено ИЛИ Количество <= 0 Тогда
            Продолжить;
        КонецЕсли;
        Цена = Число(Стр.Цена);
        Сумма = Цена * Количество;
        КодВалюты = Роутер.ВалютаИлиРубли(Стр.Валюта);
        Если ПустаяСтрока(Валюта) Тогда
            Валюта = КодВалюты;
        ИначеЕсли КодВалюты <> Валюта Тогда
            // С этого места числового итога больше нет: складывать величины
            // в разных валютах нельзя даже ради промежуточного отображения.
            Результат.Вставить("РазныеВалюты", Истина);
        КонецЕсли;
        Если Не Результат.РазныеВалюты Тогда
            Итого = Итого + Сумма;
        КонецЕсли;

        Строка_ = Новый Структура;
        Строка_.Вставить("Ид", Ключ);
        Строка_.Вставить("Заголовок", Строка(Стр.Наименование));
        Строка_.Вставить("Артикул", Рендер.ТекстЗначения(Стр.Артикул));
        Строка_.Вставить("Количество", Количество);
        Строка_.Вставить("Цена", Роутер.ЦенаСтрокой(Цена, КодВалюты));
        Строка_.Вставить("Сумма", Роутер.ЦенаСтрокой(Сумма, КодВалюты));
        Строка_.Вставить("ЦенаЧислом", Цена);
        Строка_.Вставить("СуммаЧислом", Сумма);
        Строка_.Вставить("Валюта", КодВалюты);
        Слаг = Рендер.ТекстЗначения(Стр.Слаг);
        Если ПустаяСтрока(Слаг) Тогда
            Строка_.Вставить("Адрес", "");
        Иначе
            Строка_.Вставить("Адрес", Префикс + "/product/" + Слаг);
        КонецЕсли;
        Картинка = Рендер.ТекстЗначения(Стр.КартинкаСсылка);
        Если ПустаяСтрока(Картинка) Тогда
            Картинка = Рендер.ТекстЗначения(Стр.КартинкаURL);
        КонецЕсли;
        Строка_.Вставить("Картинка", Картинка);
        Результат.Строки.Добавить(Строка_);
    КонецЦикла;

    Результат.Вставить("Позиций", Результат.Строки.Количество());
    Если Результат.РазныеВалюты Тогда
        Результат.Вставить("Итого", Неопределено);
        Результат.Вставить("Валюта", "");
        Результат.Вставить("ИтогоСтрокой", "Итог не рассчитан: в корзине разные валюты.");
    Иначе
        Результат.Вставить("Итого", Итого);
        Результат.Вставить("Валюта", Валюта);
        Результат.Вставить("ИтогоСтрокой", Роутер.ЦенаСтрокой(Итого, Валюта));
    КонецЕсли;
    Возврат Результат;
КонецФункции

// ПроверитьКоличество приводит присланное значение к целому в допустимых
// границах. Возвращает 0, если значение негодное — вызывающий отвечает отказом.
Функция ПроверитьКоличество(Значение) Экспорт
    Текст = СокрЛП(Строка(Значение));
    Если ПустаяСтрока(Текст) Тогда
        Возврат 0;
    КонецЕсли;
    // Только цифры: «1e3», «2,5» и «-1» — не количество штук. Дробное
    // количество примеру не нужно, а молча округлять присланное нельзя.
    Если Не Новый Регекс("^[0-9]{1,3}$").Совпадает(Текст) Тогда
        Возврат 0;
    КонецЕсли;
    Количество = Число(Текст);
    Если Количество < 1 ИЛИ Количество > МаксКоличество() Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Количество;
КонецФункции

// НайтиТовар возвращает ссылку на опубликованный товар СВОЕГО сайта или
// Неопределено. Проверка сайта и публикации здесь, а не у вызывающего: это
// единственная точка, где идентификатор из браузера превращается в товар.
Функция НайтиТовар(Сайт, Ид) Экспорт
    Если Сайт = Неопределено ИЛИ ПустаяСтрока(Ид) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Не Новый Регекс("^[0-9a-fA-F\-]{36}$").Совпадает(Ид) Тогда
        Возврат Неопределено;
    КонецЕсли;

    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка, СтатусПубликации, ДатаПубликации, is_folder КАК ЭтоГруппа
    |ИЗ Справочник.Товары
    |ГДЕ Ссылка = &Ид И Сайт = &Сайт";
    З.УстановитьПараметр("Ид", Ид);
    З.УстановитьПараметр("Сайт", Сайт.Ссылка);
    Для Каждого Стр Из З.Выполнить() Цикл
        Если Не Роутер.Опубликовано(Стр) Тогда
            Возврат Неопределено;
        КонецЕсли;
        // Раздел каталога — не товар: у него нет цены, и «положить в корзину»
        // раздел можно было бы только подделкой формы.
        Если Стр.ЭтоГруппа = Истина Тогда
            Возврат Неопределено;
        КонецЕсли;
        Возврат Справочники.Товары.НайтиПоИдентификатору(Ид);
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Положить добавляет товар в корзину или увеличивает количество имеющейся
// строки. Возвращает Структуру {Код, Сообщение}.
Функция Положить(Сайт, Описание, ИдТовара, Количество) Экспорт
    Товар = НайтиТовар(Сайт, ИдТовара);
    Если Товар = Неопределено Тогда
        Возврат Отказ("Товар не найден или снят с публикации.");
    КонецЕсли;
    Штук = ПроверитьКоличество(Количество);
    Если Штук = 0 Тогда
        Возврат Отказ("Количество должно быть целым числом от 1 до " + МаксКоличество() + ".");
    КонецЕсли;

    Объект = Описание.Ссылка.ПолучитьОбъект();
    Ключ = Товар.УникальныйИдентификатор();
    Найдено = Ложь;
    Строки = Новый Массив;
    Для Каждого Стр Из Объект.Строки Цикл
        Текущий = ИдентификаторСтроки(Стр);
        Новое = Число(Стр.Количество);
        Если Текущий = Ключ Тогда
            Найдено = Истина;
            Новое = Новое + Штук;
            Если Новое > МаксКоличество() Тогда
                Новое = МаксКоличество();
            КонецЕсли;
        КонецЕсли;
        Строки.Добавить(ПараСтроки(Текущий, Новое));
    КонецЦикла;

    Если Не Найдено Тогда
        Если Строки.Количество() >= МаксПозиций() Тогда
            Возврат Отказ("В корзине уже " + МаксПозиций()
                + " позиций — оформите заказ или удалите лишнее.");
        КонецЕсли;
        Строки.Добавить(ПараСтроки(Ключ, Штук));
    КонецЕсли;

    ПерезаписатьСтроки(Объект, Строки);
    Возврат Успех("Товар добавлен в корзину.");
КонецФункции

// Изменить ставит новое количество или удаляет строку (количество 0).
Функция Изменить(Сайт, Описание, ИдТовара, Количество, Удалить) Экспорт
    Объект = Описание.Ссылка.ПолучитьОбъект();
    Штук = 0;
    Если Не Удалить Тогда
        Штук = ПроверитьКоличество(Количество);
        Если Штук = 0 Тогда
            Возврат Отказ("Количество должно быть целым числом от 1 до " + МаксКоличество() + ".");
        КонецЕсли;
    КонецЕсли;

    Строки = Новый Массив;
    Найдено = Ложь;
    Для Каждого Стр Из Объект.Строки Цикл
        Текущий = ИдентификаторСтроки(Стр);
        Если Текущий = ИдТовара Тогда
            Найдено = Истина;
            Если Удалить Тогда
                Продолжить;
            КонецЕсли;
            Строки.Добавить(ПараСтроки(Текущий, Штук));
            Продолжить;
        КонецЕсли;
        Строки.Добавить(ПараСтроки(Текущий, Число(Стр.Количество)));
    КонецЦикла;

    Если Не Найдено Тогда
        // Не ошибка: строку могли удалить во второй вкладке. Корзина уже в том
        // состоянии, которого просил посетитель.
        Возврат Успех("");
    КонецЕсли;

    ПерезаписатьСтроки(Объект, Строки);
    Если Удалить Тогда
        Возврат Успех("Позиция удалена из корзины.");
    КонецЕсли;
    Возврат Успех("Количество изменено.");
КонецФункции

// ПерезаписатьСтроки — единственный способ изменить состав: у табличной части
// есть Добавить, Очистить и Удалить(индекс), но не «поменять по ключу», а
// удаление по индексу внутри обхода сдвигает остальные строки.
Процедура ПерезаписатьСтроки(Объект, Строки) Экспорт
    Объект.Строки.Очистить();
    Для Каждого Пара Из Строки Цикл
        Если Пара.Количество <= 0 Тогда
            Продолжить;
        КонецЕсли;
        Новая = Объект.Строки.Добавить();
        Новая.Товар = Справочники.Товары.НайтиПоИдентификатору(Пара.Товар);
        Новая.Количество = Пара.Количество;
    КонецЦикла;
    Объект.Дата = ТекущаяДатаВремя();
    Объект.Записать();
КонецПроцедуры

// ИдентификаторСтроки — UUID товара строки корзины (пустая строка, если товар
// не заполнен). Отдельной функцией, потому что вызывается из трёх обходов, а
// вызов метода у незаполненной ссылки — ошибка рантайма, а не пустое значение.
Функция ИдентификаторСтроки(Стр) Экспорт
    Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Стр.Товар.УникальныйИдентификатор();
КонецФункции

Функция ПараСтроки(Товар, Количество) Экспорт
    П = Новый Структура;
    П.Вставить("Товар", Товар);
    П.Вставить("Количество", Количество);
    Возврат П;
КонецФункции

Функция Успех(Сообщение) Экспорт
    Р = Новый Структура;
    Р.Вставить("Код", 200);
    Р.Вставить("Сообщение", Сообщение);
    Возврат Р;
КонецФункции

Функция Отказ(Сообщение) Экспорт
    Р = Новый Структура;
    Р.Вставить("Код", 422);
    Р.Вставить("Сообщение", Сообщение);
    Возврат Р;
КонецФункции
