// Импорт каталога из YML-выгрузки (план 129, слайс C12).
//
// YML — формат Яндекс.Маркета, который умеет отдавать почти любая российская
// CMS, включая 1С-Битрикс. Поэтому переезд на OneBase не требует ни доступа к
// чужой базе, ни конвертера инфоблоков: выгрузили каталог — загрузили.
//
// Идемпотентность держится на внешнем коде: повторный запуск обновляет
// существующие позиции, а не плодит дубли. Это важнее скорости — выгрузку
// запускают повторно чаще, чем кажется (упал импорт, добавили товар, сверяют).
//
// Запуск:
//   onebase procrun --project examples/cms --sqlite cms.db
//     --proc ИмпортИзYML --set Сайт=<UUID сайта>
//     --file Файл=examples/cms/demo/catalog.yml

Процедура Выполнить()
    // Параметры обработки читаются через точку: это MapThis, метода Получить
    // у него нет — попытка обратиться как к Соответствию падает в рантайме.
    Путь = "";
    Сайт = Неопределено;
    Источник = "";
    Если Параметры <> Неопределено Тогда
        Путь = СокрЛП(Строка(Параметры.Файл));
        Сайт = Параметры.Сайт;
        Источник = СокрЛП(Строка(Параметры.ИсточникКартинок));
        Если Источник = "<nil>" Тогда
            Источник = "";
        КонецЕсли;
    КонецЕсли;
    Сайт = ИмпортYML.ОбязательныйСайт(Сайт);
    Если ПустаяСтрока(Путь) ИЛИ Путь = "<nil>" Тогда
        // Сообщение читает и тот, кто стоит перед формой в браузере: ключ
        // командной строки ему ничего не объясняет, поэтому он идёт вторым.
        ВызватьИсключение "Приложите файл выгрузки в поле «Файл выгрузки (YML)»."
            + " После запуска поле пустеет — вернуть выбранный файл браузер не"
            + " позволяет, приложите его заново." + Символы.ПС
            + "Из командной строки: --file Файл=<путь к catalog.yml>."
            + " Пример выгрузки — examples/cms/demo/catalog.yml";
    КонецЕсли;

    // Содержимое приходит файловым параметром (--file), а не открывается по
    // пути: DSL исполняется в файловой песочнице, и произвольный путь ей
    // недоступен — это защита, а не помеха. Заодно тот же код работает из
    // веб-интерфейса, где пользователь прикладывает файл, а не диктует путь.
    Текст = Путь;
    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Файл выгрузки пуст";
    КонецЕсли;

    Дерево = ПрочитатьXML(Текст);
    Магазин = НайтиЭлемент(Дерево, "shop");
    Если Магазин = Неопределено Тогда
        ВызватьИсключение "Это не YML-выгрузка: не найден элемент shop";
    КонецЕсли;

    Категории = ЗагрузитьКатегории(НайтиЭлемент(Магазин, "categories"), Сайт);
    Итог = ЗагрузитьТовары(НайтиЭлемент(Магазин, "offers"), Категории, Сайт, Источник);

    // Отчёт называет то, что оказалось В БАЗЕ, а не число разобранных строк.
    // Раньше он печатал количество предложений выгрузки: «товаров 62» при 50
    // позициях в базе. Расхождение объяснимо (один товар лежит в нескольких
    // разделах), но цифра, не сходящаяся с каталогом, отправляет искать
    // пропажу вместо чтения объяснения.
    Сообщить("Импорт завершён: разделов " + Категории.Количество()
        + ", позиций " + Итог.Позиций + " из " + Итог.Предложений + " предложений выгрузки");
    Если Итог.Повторов > 0 Тогда
        Сообщить("Повторов по внешнему коду: " + Итог.Повторов
            + " — один товар встречается в нескольких разделах выгрузки."
            + " У позиции каталога раздел один, поэтому она осталась в последнем."
            + " Разделы, потерявшие таким образом все позиции, на витрине будут пустыми.");
    КонецЕсли;
    Если Итог.Картинок > 0 Тогда
        Сообщить("Картинок загружено в медиатеку: " + Итог.Картинок);
    КонецЕсли;
    Если Итог.ЧужойИсточник > 0 Тогда
        // Отдельная строка, а не «не удалось»: это не сбой, а сработавшая
        // граница. Молчание здесь означало бы каталог без картинок с виду
        // успешного импорта — ровно то, что чинил этот пример.
        Если ПустаяСтрока(Источник) Тогда
            Сообщить("Картинки не скачивались (" + Итог.ЧужойИсточник + " адресов):"
                + " не заполнен параметр «Домен, с которого качать картинки»."
                + " Адреса из выгрузки серверу не указ — домен называет оператор.");
        Иначе
            Сообщить("Пропущено адресов не с домена «" + Источник + "»: " + Итог.ЧужойИсточник
                + ". Разрешён только он, по http/https и обычному порту.");
        КонецЕсли;
    КонецЕсли;
    Если Итог.БезКартинки > 0 Тогда
        Сообщить("Не удалось загрузить картинок: " + Итог.БезКартинки
            + ". Адреса сохранены в реквизите «Адрес картинки в источнике», но на"
            + " сайте такие картинки не появятся: страница отдаётся с политикой"
            + " «изображения только со своего адреса»." + Символы.ПС
            + "Первая причина: " + Итог.ОшибкаКартинки);
    КонецЕсли;
КонецПроцедуры

// НайтиЭлемент возвращает первый дочерний элемент с указанным именем.
Функция НайтиЭлемент(Узел, Имя)
    Если Узел = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого Элемент Из Узел.Элементы Цикл
        Если НРег(Строка(Элемент.Имя)) = НРег(Имя) Тогда
            Возврат Элемент;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// ТекстЭлемента — значение дочернего элемента или пустая строка.
Функция ТекстЭлемента(Узел, Имя)
    Элемент = НайтиЭлемент(Узел, Имя);
    Если Элемент = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат СокрЛП(Строка(Элемент.Текст));
КонецФункции

// ЗагрузитьКатегории создаёт группы товаров и возвращает Соответствие
// «внешний id → ссылка». Родитель проставляется вторым проходом: в выгрузке
// потомок может идти раньше родителя, и однопроходная загрузка молча потеряла
// бы иерархию.
Функция ЗагрузитьКатегории(Узел, Сайт)
    Соответствия = Новый Соответствие;
    Если Узел = Неопределено Тогда
        Возврат Соответствия;
    КонецЕсли;

    Для Каждого Элемент Из Узел.Элементы Цикл
        ВнешнийКод = СокрЛП(Строка(Элемент.Атрибуты.Получить("id")));
        Наименование = СокрЛП(Строка(Элемент.Текст));
        Если ПустаяСтрока(ВнешнийКод) ИЛИ ПустаяСтрока(Наименование) Тогда
            Продолжить;
        КонецЕсли;
        // Слаг нужен и группе: без него раздел /catalog/<группа> недостижим,
        // а витрина показывает позицию без ссылки (#1014). Задаётся в ТОЙ ЖЕ
        // записи, что создаёт группу: повторное сохранение иерархического
        // объекта из DSL сбрасывает признак группы и родителя — служебные поля
        // не читаются ПолучитьОбъект(), а Upsert пишет их всегда.
        Соответствия.Вставить(ВнешнийКод,
            ИмпортYML.ЗаписатьТовар(Сайт, ВнешнийКод, Наименование, Истина,
                ИмпортYML.Слаг(Сайт, Наименование, ВнешнийКод)));
    КонецЦикла;

    Для Каждого Элемент Из Узел.Элементы Цикл
        Родитель = СокрЛП(Строка(Элемент.Атрибуты.Получить("parentId")));
        Если ПустаяСтрока(Родитель) Тогда
            Продолжить;
        КонецЕсли;
        ВнешнийКод = СокрЛП(Строка(Элемент.Атрибуты.Получить("id")));
        Ссылка = Соответствия.Получить(ВнешнийКод);
        СсылкаРодителя = Соответствия.Получить(Родитель);
        Если Ссылка = Неопределено ИЛИ СсылкаРодителя = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Объект = Ссылка.ПолучитьОбъект();
        // Родитель — идентификатором строкой (ссылка не разбирается), а
        // признак группы приходится задавать заново: эта запись иначе снимет
        // его, и подраздел каталога станет обычной позицией.
        Объект.Сайт = Сайт;
        Объект.parent_id = Строка(СсылкаРодителя.УникальныйИдентификатор());
        Объект.is_folder = Истина;
        Объект.Записать();
    КонецЦикла;
    Возврат Соответствия;
КонецФункции

Функция ЗагрузитьТовары(Узел, Категории, Сайт, Источник)
    Итог = Новый Структура;
    Итог.Вставить("Предложений", 0);
    Итог.Вставить("Позиций", 0);
    Итог.Вставить("Повторов", 0);
    Итог.Вставить("Картинок", 0);
    Итог.Вставить("БезКартинки", 0);
    Итог.Вставить("ЧужойИсточник", 0);
    Итог.Вставить("ОшибкаКартинки", "");
    Если Узел = Неопределено Тогда
        Возврат Итог;
    КонецЕсли;
    Встреченные = Новый Соответствие;
    Для Каждого Предложение Из Узел.Элементы Цикл
        ВнешнийКод = СокрЛП(Строка(Предложение.Атрибуты.Получить("id")));
        Наименование = ТекстЭлемента(Предложение, "name");
        Если ПустаяСтрока(Наименование) Тогда
            // Товар без названия показывать нечем: пропускаем, но не молча —
            // иначе расхождение «в выгрузке 500, в базе 498» ищут вручную.
            Сообщить("Пропущен товар без наименования, код " + ВнешнийКод);
            Продолжить;
        КонецЕсли;

        Итог.Предложений = Итог.Предложений + 1;
        Если Встреченные.Получить(ВнешнийКод) = Неопределено Тогда
            Встреченные.Вставить(ВнешнийКод, Истина);
            Итог.Позиций = Итог.Позиций + 1;
        Иначе
            Итог.Повторов = Итог.Повторов + 1;
        КонецЕсли;

        Ссылка = ИмпортYML.ЗаписатьТовар(Сайт, ВнешнийКод, Наименование, Ложь,
            ИмпортYML.Слаг(Сайт, Наименование, ВнешнийКод));
        Объект = Ссылка.ПолучитьОбъект();
        Объект.Сайт = Сайт;
        Объект.Артикул = ТекстЭлемента(Предложение, "vendorCode");
        Объект.Цена = Число(?(ПустаяСтрока(ТекстЭлемента(Предложение, "price")), "0",
            ТекстЭлемента(Предложение, "price")));
        Объект.Валюта = ТекстЭлемента(Предложение, "currencyId");
        Объект.Описание = ТекстЭлемента(Предложение, "description");
        // Адрес источника сохраняется в любом случае — по нему видно, откуда
        // картинка, и его можно перезагрузить позже.
        Объект.КартинкаURL = ТекстЭлемента(Предложение, "picture");
        // Сама картинка тянется в медиатеку: внешний адрес на сайте не покажется
        // (политика страницы разрешает изображения только со своего адреса), а
        // каталог не должен зависеть от чужого сервера. Ошибка одной картинки не
        // прекращает импорт: сорок девять товаров важнее одной обложки.
        Если Не ПустаяСтрока(Объект.КартинкаURL) И Объект.КартинкаURL <> "<nil>"
            И (Объект.Картинка = Неопределено ИЛИ Не ЗначениеЗаполнено(Объект.Картинка)) Тогда
            Попытка
                Медиа = ИмпортYML.ЗагрузитьКартинку(Сайт, Объект.КартинкаURL, Наименование, Источник);
                Если Медиа <> Неопределено Тогда
                    Объект.Картинка = Медиа;
                    Итог.Картинок = Итог.Картинок + 1;
                Иначе
                    // Неопределено при заполненном адресе означает одно: адрес не
                    // с разрешённого домена, запрос не делался.
                    Итог.ЧужойИсточник = Итог.ЧужойИсточник + 1;
                КонецЕсли;
            Исключение
                Итог.БезКартинки = Итог.БезКартинки + 1;
                Если ПустаяСтрока(Итог.ОшибкаКартинки) Тогда
                    Итог.ОшибкаКартинки = ОписаниеОшибки();
                КонецЕсли;
            КонецПопытки;
        КонецЕсли;
        Объект.СтатусПубликации = Перечисления.СтатусПубликации.Опубликовано;
        Объект.ДатаПубликации = ТекущаяДата();

        Категория = Категории.Получить(ТекстЭлемента(Предложение, "categoryId"));
        Если Категория <> Неопределено Тогда
            // Именно идентификатор строкой: ссылку parent_id не разбирает и
            // молча оставляет позицию в корне каталога.
            Объект.parent_id = Строка(Категория.УникальныйИдентификатор());
        КонецЕсли;
        Объект.Записать();
    КонецЦикла;
    Возврат Итог;
КонецФункции
