// Тесты каркаса проектной базы: onebase test --project examples/sppr
// --sqlite :memory:. Проверяют то, что каркас даёт агентам: гейт этапов,
// права ролей, трассировку и результат аудита.
Процедура Выполнить()
    // --- права ролей ---
    Утверждать.РольМожет("Проектировщик", "справочник", "Функция", "изменять", "проектировщик правит функции");
    Утверждать.РольНеМожет("Тестировщик", "справочник", "Функция", "изменять", "тестировщик функции не правит");
    Утверждать.РольМожет("Тестировщик", "документ", "Ошибка", "провести", "тестировщик проводит ошибку");
    Утверждать.РольНеМожет("Разработчик", "документ", "ПубликацияПравила", "провести", "правила публикует руководитель");

    // --- гейт этапов: перескок НаПроверке из Новой отклоняется ---
    СсылкаПроекта = Справочники.Проект.НайтиПоРеквизиту("Наименование", "Тестовый проект")
    Если ЗначениеЗаполнено(СсылкаПроекта) = Ложь Тогда
        Пр = Справочники.Проект.Создать()
        Пр.Наименование = "Тестовый проект"
        СсылкаПроекта = Пр.Записать()
    КонецЕсли

    Зад = Документы.Задача.Создать()
    Зад.Дата = ТекущаяДата()
    Зад.Заголовок = "Проверка гейта этапов"
    Зад.Проект = СсылкаПроекта
    Зад.Тип = "Разработка"
    Зад.Статус = "Новая"
    Зад.Приоритет = "Средний"
    СсылкаЗадачи = Зад.Записать()

    Провал = Ложь
    Попытка
        Об = СсылкаЗадачи.ПолучитьОбъект()
        Об.Статус = "НаПроверке"
        Об.Записать()
    Исключение
        Провал = Истина
    КонецПопытки
    Утверждать.Истина(Провал, "strict-гейт отверг перескок Новая → НаПроверке")

    // легальный переход по маршруту проходит
    Об2 = СсылкаЗадачи.ПолучитьОбъект()
    Об2.Статус = "Принята"
    Об2.Записать()
    Текущий = ""
    Для Каждого Стр Из ЧитающийЗадачу(СсылкаЗадачи) Цикл
        Текущий = Стр.Статус
    КонецЦикла
    Утверждать.Равно(Текущий, "Принята", "переход Новая → Принята прошёл")

    // --- история статусов: каждый переход пишется отдельной строкой с номером,
    // старый статус берётся из предыдущего перехода (ключ — Задача + Переход) ---
    ПерейтиПроведя(СсылкаЗадачи, "Принята")
    ПерейтиПроведя(СсылкаЗадачи, "ВРаботе")
    ПерейтиПроведя(СсылкаЗадачи, "НаПроверке")
    ЗИ = Новый Запрос
    ЗИ.Текст = "ВЫБРАТЬ Р.Переход, Р.СтарыйСтатус, Р.НовыйСтатус, Р.Исполнитель " +
        "ИЗ РегистрСведений.ИсторияСтатусовЗадач.СрезПоследних(&Д) КАК Р " +
        "ГДЕ Р.Задача = &Задача УПОРЯДОЧИТЬ ПО Р.Переход"
    ЗИ.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    ЗИ.УстановитьПараметр("Задача", СсылкаЗадачи)
    Н = 0
    ПервыйСтарый = ""
    ПредСтатус = ""
    ПоследнийСтатус = ""
    Исполнитель = ""
    Для Каждого СтрИ Из ЗИ.Выполнить() Цикл
        Н = Н + 1
        Если Н = 1 Тогда
            ПервыйСтарый = СтрИ.СтарыйСтатус
        ИначеЕсли СтрИ.СтарыйСтатус <> ПредСтатус Тогда
            Н = -1
        КонецЕсли
        ПредСтатус = СтрИ.НовыйСтатус
        ПоследнийСтатус = СтрИ.НовыйСтатус
        Исполнитель = СтрИ.Исполнитель
    КонецЦикла
    Утверждать.Равно(Н, 3, "история записала три перехода подряд")
    Утверждать.Равно(ПервыйСтарый, "", "первый переход не имеет старого статуса")
    Утверждать.Равно(ПоследнийСтатус, "НаПроверке", "история дошла до НаПроверке")
    Утверждать.Равно(Исполнитель, "system:Задача", "история фиксирует исполнителя перехода")

    // --- трассировка: функция → объект → файл ---
    Фтест = Справочники.Функция.Создать()
    Фтест.Код = "T.1"
    Фтест.Наименование = "Тестовая функция"
    Фтест.Тип = "Функция"
    Фтест.Статус = "Черновик"
    Фтест.Проект = СсылкаПроекта
    СсылкаФункции = Фтест.Записать()

    Обт = Справочники.ОбъектМетаданных.Создать()
    Обт.Имя = "ТестовыйДокумент"
    Обт.Тип = "Документ"
    Обт.ПутьФайла = "documents/ТестовыйДокумент.yaml"
    Обт.Функция = СсылкаФункции
    Обт.Проект = СсылкаПроекта
    Обт.Статус = "Черновик"
    Обт.Контроль = "Добавлено"
    СсылкаОбъекта = Обт.Записать()

    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи()
    Мен.Функция = СсылкаФункции
    Мен.Объект = СсылкаОбъекта
    Мен.ПутьФайла = "documents/ТестовыйДокумент.yaml"
    Мен.Коммит = "TESTCOMMIT"
    Мен.Записать()

    Коммит = ""
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ Т.Коммит КАК Коммит ИЗ РегистрСведений.Трассировка КАК Т ГДЕ Т.Функция = &Ф"
    З.УстановитьПараметр("Ф", СсылкаФункции)
    Для Каждого Стр Из З.Выполнить() Цикл
        Коммит = Стр.Коммит
    КонецЦикла
    Утверждать.Равно(Коммит, "TESTCOMMIT", "трассировка читается по функции")

    // --- аудит: утверждённая функция без сценария попадает в результат ---
    Футв = Справочники.Функция.Создать()
    Футв.Код = "T.2"
    Футв.Наименование = "Функция без сценария"
    Футв.Тип = "Функция"
    Футв.Статус = "Черновик"
    Футв.Проект = СсылкаПроекта
    СсылкаФункции2 = Футв.Записать()
    Перейти(СсылкаФункции2, "НаСогласовании")
    Перейти(СсылкаФункции2, "Утверждена")

    Пр = Справочники.ПравилоПроверки.Создать()
    Пр.Код = "TEST-FUNC-NOSCEN"
    Пр.Наименование = "Функция без сценария (тест)"
    Пр.ОбъектПроверки = "Функция"
    Пр.Важность = "Предупреждение"
    // Запрос правила самодостаточен: параметров в нём нет, условие записано
    // литералом — регламентное задание выполняет его без подстановок.
    Пр.ТекстЗапроса = "ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'нет сценария' КАК Информация ИЗ Справочник.Функция КАК Ф ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сценарий КАК С ПО С.Функция = Ф.Ссылка ГДЕ С.Ссылка ЕСТЬ ПУСТО И Ф.Статус = 'Утверждена' И Ф.Код = 'T.2'"
    Пр.Активно = Истина
    Пр.Предопределённое = Ложь
    Пр.Владелец = "Тест"
    Пр.Проект = СсылкаПроекта
    СсылкаПравила = Пр.Записать()

    Пуб = Документы.ПубликацияПравила.Создать()
    Пуб.Дата = ТекущаяДата()
    Пуб.Правило = СсылкаПравила
    Пуб.Важность = "Предупреждение"
    Пуб.Текст = "Функция должна быть подтверждена сценарием"
    Пуб.Статус = "Опубликовано"
    Пуб.Основание = "Тест каркаса"
    Пуб.Провести()

    Нарушений = ПрименитьПравила(ТекущаяДата())
    Утверждать.Истина(Нарушений > 0, "аудит нашёл нарушение")

    Найденный = ""
    З2 = Новый Запрос
    З2.Текст = "ВЫБРАТЬ Р.Объект КАК Объект ИЗ РегистрСведений.РезультатыПроверки.СрезПоследних(&Д) КАК Р ГДЕ Р.Правило = &Правило"
    З2.УстановитьПараметр("Д", ТекущаяДата())
    З2.УстановитьПараметр("Правило", СсылкаПравила)
    Для Каждого Стр Из З2.Выполнить() Цикл
        Найденный = Стр.Объект
    КонецЦикла
    Утверждать.Равно(Найденный, "T.2", "результат аудита записан по функции")

    // --- мост метаданных: описание целевого проекта -> объекты ---
    // Описание собирается как данные и сериализуется: тест проходит тот же
    // разбор, что и импорт из файла, без файловых операций (песочница).
    Дописания = Новый Соответствие;
    Дописания.Вставить("schemaVersion", 1);
    Каталоги = Новый Массив;
    Кат1 = Новый Соответствие;
    Кат1.Вставить("name", "ТестовСправочник");
    Кат1.Вставить("title", "Тестовый справочник");
    Источник1 = Новый Соответствие;
    Источник1.Вставить("file", "catalogs/тестовсправочник.yaml");
    Кат1.Вставить("source", Источник1);
    Поля1 = Новый Массив;
    Поле1 = Новый Соответствие;
    Поле1.Вставить("name", "Наименование");
    Поле1.Вставить("type", "string");
    Поля1.Добавить(Поле1);
    Кат1.Вставить("fields", Поля1);
    Каталоги.Добавить(Кат1);
    Дописания.Вставить("catalogs", Каталоги);
    Виджеты = Новый Массив;
    Вид1 = Новый Соответствие;
    Вид1.Вставить("name", "ТестовВиджет");
    Вид1.Вставить("title", "Тестовый виджет");
    Вид1.Вставить("type", "list");
    Виджеты.Добавить(Вид1);
    Дописания.Вставить("widgets", Виджеты);
    Док = Новый Соответствие;
    Док.Вставить("name", "ТестовДокумент");
    Док.Вставить("title", "Тестовый документ");
    Источник2 = Новый Соответствие;
    Источник2.Вставить("file", "documents/тестовдокумент.yaml");
    Док.Вставить("source", Источник2);
    Докмассив = Новый Массив;
    Докмассив.Добавить(Док);
    Дописания.Вставить("documents", Докмассив);
    Модули = Новый Массив;
    Мод1 = Новый Соответствие;
    Мод1.Вставить("name", "ТестовыйМодуль");
    Мод1.Вставить("kind", "module");
    Источник3 = Новый Соответствие;
    Источник3.Вставить("file", "src/тестовыймодуль.module.os");
    Мод1.Вставить("source", Источник3);
    Проц1 = Новый Соответствие;
    Проц1.Вставить("name", "Проверить");
    ПараметрыП = Новый Массив;
    ПараметрыП.Добавить("Значение");
    Проц1.Вставить("params", ПараметрыП);
    Процы = Новый Массив;
    Процы.Добавить(Проц1);
    Мод1.Вставить("procedures", Процы);
    Модассив = Новый Массив;
    Модассив.Добавить(Мод1);
    Дописания.Вставить("modules", Модассив);
    // Имя регламентного задания совпадает с именем документа: объект
    // различается типом, по одному имени они сливаются.
    Задание = Новый Соответствие;
    Задание.Вставить("name", "ТестовДокумент");
    Задание.Вставить("title", "Тестовое регламентное задание");
    Задание.Вставить("schedule", "0 8 * * *");
    Заданиемассив = Новый Массив;
    Заданиемассив.Добавить(Задание);
    Дописания.Вставить("scheduledJobs", Заданиемассив);

    Новых = Импорт.ПрименитьДанные(Дописания, СсылкаПроекта, Неопределено)
    Утверждать.Равно(Новых, 5, "мост создал объекты из описания")

    СсылкаТест = Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", "ТестовСправочник")
    Утверждать.Истина(ЗначениеЗаполнено(СсылкаТест), "каталог описания стал объектом")

    // Ссылка читается запросом: реквизиты справочника через точку доступны
    // только для стандартных полей, и тест обязан проверять то, что видит
    // агент в отчёте, а не приватный доступ к объекту.
    ТипОбъекта = "";
    ПутьОбъекта = "";
    КонтрольОбъекта = "";
    ВладелецЗаполнен = Ложь;
    З4 = Новый Запрос
    З4.Текст = "ВЫБРАТЬ О.Тип КАК Тип, О.ПутьФайла КАК Путь, О.Контроль КАК Контроль, О.Функция КАК Владелец ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя"
    З4.УстановитьПараметр("Имя", "ТестовСправочник")
    Для Каждого Стр Из З4.Выполнить() Цикл
        ТипОбъекта = Стр.Тип
        ПутьОбъекта = Стр.Путь
        КонтрольОбъекта = Стр.Контроль
        ВладелецЗаполнен = ЗначениеЗаполнено(Стр.Владелец)
    КонецЦикла
    Утверждать.Равно(ТипОбъекта, "Справочник", "тип объекта распознан")
    Утверждать.Равно(ПутьОбъекта, "catalogs/тестовсправочник.yaml", "путь файла записан")
    Утверждать.Равно(КонтрольОбъекта, "НеПроверено", "импорт помечен как не проверенный")
    Утверждать.Ложь(ВладелецЗаполнен, "функцию объекту назначает проектировщик, не импорт")

    ИмяПоля = ""
    З3 = Новый Запрос
    З3.Текст = "ВЫБРАТЬ РЕ.ИмяРеквизита КАК ИмяРеквизита ИЗ Справочник.ОбъектМетаданных.Реквизиты КАК РЕ ГДЕ РЕ.Ссылка = &Ссылка"
    З3.УстановитьПараметр("Ссылка", СсылкаТест)
    Для Каждого Стр Из З3.Выполнить() Цикл
        ИмяПоля = Стр.ИмяРеквизита
    КонецЦикла
    Утверждать.Равно(ИмяПоля, "Наименование", "реквизит целевого объекта записан в табличную часть")

    // Подпись модуля из описания: агент вызывает процедуру по контракту,
    // поэтому список параметров должен попасть в табличную часть объекта.
    Подпись = ""
    З6 = Новый Запрос
    З6.Текст = "ВЫБРАТЬ РЕ.ИмяРеквизита КАК Имя, РЕ.ТипРеквизита КАК Тип ИЗ Справочник.ОбъектМетаданных.Реквизиты КАК РЕ ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектМетаданных КАК О ПО РЕ.Ссылка = О.Ссылка ГДЕ О.Имя = &Имя"
    З6.УстановитьПараметр("Имя", "ТестовыйМодуль")
    Для Каждого Стр Из З6.Выполнить() Цикл
        Если Стр.Имя = "Проверить" Тогда
            Подпись = Стр.Тип
        КонецЕсли
    КонецЦикла
    Утверждать.Равно(Подпись, "(Значение)", "подпись процедуры модуля записана")

    // Текст: проверка, что разбор файла и разбор данных дают один результат.
    Новых2 = Импорт.ПрименитьОписание(ЗаписатьJSON(Дописания), СсылкаПроекта, Неопределено)
    Утверждать.Равно(Новых2, 0, "повторный импорт не плодит объектов")

    ТипВиджета = "";
    ПутьВиджета = "X";
    З5 = Новый Запрос
    З5.Текст = "ВЫБРАТЬ О.Тип КАК Тип, О.ПутьФайла КАК Путь ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя"
    З5.УстановитьПараметр("Имя", "ТестовВиджет")
    Для Каждого Стр Из З5.Выполнить() Цикл
        ТипВиджета = Стр.Тип
        ПутьВиджета = Стр.Путь
    КонецЦикла
    Утверждать.Равно(ТипВиджета, "Виджет", "виджет описан без файла")
    Утверждать.Равно(ПутьВиджета, "", "у виджета нет файла-источника")

    // Раздельность по типу: одно имя - два объекта (документ и задание).
    ЧислоЗаданий = 0
    З8 = Новый Запрос
    З8.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя"
    З8.УстановитьПараметр("Имя", "ТестовДокумент")
    Для Каждого Стр Из З8.Выполнить() Цикл
        ЧислоЗаданий = Стр.Н
    КонецЦикла
    Утверждать.Равно(ЧислоЗаданий, 2, "одно имя - два объекта разных типов")
КонецПроцедуры

Процедура Перейти(Ссылка, НовыйСтатус)
    Об = Ссылка.ПолучитьОбъект()
    Об.Статус = НовыйСтатус
    Об.Записать()
КонецПроцедуры

// проведение нужно для истории статусов: модуль проведения пишет
// строку перехода только при проведении документа
Процедура ПерейтиПроведя(Ссылка, НовыйСтатус)
    Об = Ссылка.ПолучитьОбъект()
    Об.Статус = НовыйСтатус
    Об.Записать()
    Об.Провести()
КонецПроцедуры

Функция ЧитающийЗадачу(Ссылка)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ З.Статус КАК Статус ИЗ Документ.Задача КАК З ГДЕ З.Ссылка = &Ссылка"
    З.УстановитьПараметр("Ссылка", Ссылка)
    Возврат З.Выполнить()
КонецФункции
