// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/расстановка_функций.feature.
// Функция: Расстановка функций целевого проекта
// Сценарий: узлы дерева функций закрепляют свои объекты: 2.2 / internal/ledger
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «2.2»
//   Дано заведён объект метаданных «internal/ledger» типа «GoПакет»
//   Когда объект «internal/ledger» закреплён за функцией с кодом «2.2»
//   То функция объекта «internal/ledger» имеет код «2.2»
//   И трассировка содержит запись функции «2.2» для объекта «internal/ledger»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «2.2»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "2.2"
    Ф.Наименование = "функция " + "2.2"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Дано заведён объект метаданных «internal/ledger» типа «GoПакет»
    Об = Справочники.ОбъектМетаданных.Создать()
    Об.Имя = "internal/ledger"
    Об.Тип = "GoПакет"
    Об.Проект = ПроектСсылка
    Об.Контроль = "НеПроверено"
    ОбъектСсылка = Об.Записать()
    // Когда объект «internal/ledger» закреплён за функцией с кодом «2.2»
    ФункцияСсылка = Справочники.Функция.НайтиПоРеквизиту("Код", "2.2")
    ОбъектСсылка = Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", "internal/ledger")
    Об = ОбъектСсылка.ПолучитьОбъект()
    Об.Функция = ФункцияСсылка
    Об.Записать()
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи()
    Мен.Функция = ФункцияСсылка
    Мен.Объект = ОбъектСсылка
    Мен.ПутьФайла = "internal/ledger"
    Мен.Записать()
    // То функция объекта «internal/ledger» имеет код «2.2»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Функция.Код КАК Код ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = 'internal/ledger'"
    КодОбъекта = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодОбъекта = Стр.Код
    КонецЦикла
    Утверждать.Равно(КодОбъекта, "2.2", "функция объекта «internal/ledger» имеет код «2.2»")
    // И трассировка содержит запись функции «2.2» для объекта «internal/ledger»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.Трассировка.СрезПоследних(&Д) КАК Т ГДЕ Т.Функция.Код = '2.2' И Т.Объект.Имя = 'internal/ledger'"
    З.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Истина(Н > 0, "трассировка содержит запись функции «2.2» для объекта «internal/ledger»")
КонецПроцедуры
