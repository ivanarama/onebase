// Демо-расстановка функций для проекта «OneBase — развитие платформы»:
// объекты целевого проекта, которые мост принёс без функции, закрепляются за
// узлами развития платформы (2.x, 3.x). Узлы механизмов каркаса (4.x)
// расставляет обработка `РасставитьФункции` — она часть каркаса.
//
// Порядок: ЗаполнитьДемоданные -> Саморазвитие -> ИмпортОписания ->
// РасставитьФункции -> РасставитьФункцииДемо -> АудитПравил
//
// Пары «имя:тип»: объект одного типа может носить имя объекта другого
// (обработка и регламентное задание «АудитПравил»).
Процедура Выполнить()
    Ф21 = Справочники.Функция.НайтиПоРеквизиту("Код", "2.1")
    Ф22 = Справочники.Функция.НайтиПоРеквизиту("Код", "2.2")
    Ф23 = Справочники.Функция.НайтиПоРеквизиту("Код", "2.3")
    Ф24 = Справочники.Функция.НайтиПоРеквизиту("Код", "2.4")
    Ф31 = Справочники.Функция.НайтиПоРеквизиту("Код", "3.1")

    // Функции целевого проекта: объекты, которые мост принёс без функции,
    // закрепляются за узлами развития платформы. Пары «имя:тип» — объект
    // одного типа может носить имя объекта другого типа.
    Назначить("Импорт:Модуль;Импортописания:Модуль;ИмпортОписания:Обработка", Ф21)
    Назначить("Сценарий:Справочник;ВидСценария:Перечисление;Тестыкаркаса:Модуль;ТестыКаркаса:Обработка;Ошибка:Документ;СтатусОшибки:Перечисление;Ошибки:Подсистема;Саморазвитие:Модуль;Саморазвитие:Обработка", Ф22)
    Назначить("СвязиФункций:РегистрСведений;Экспортidef0:Модуль;ЭкспортIDEF0:Обработка", Ф23)
    Назначить("Исполнитель:Справочник;ПрофильПользователя:Справочник;Проектировщик:Роль;Разработчик:Роль;Тестировщик:Роль;Руководитель:Роль", Ф24)
    Назначить("Очередь:Справочник;ОчередьЗадач:РегистрСведений;ИсторияСтатусовЗадач:РегистрСведений;СтатусЗадачи:Перечисление;ТипЗадачи:Перечисление;Приоритет:Перечисление;ТипСвязиЗадач:Перечисление;Задачи:Подсистема;Планирование:Подсистема", Ф31)
КонецПроцедуры


Процедура Назначить(Список, СсылкаФункции)
    Для Каждого Эл Из СтрРазделить(Список, ";") Цикл
        Тек = СокрЛП(Эл)
        Позиция = СтрНайти(Тек, ":")
        Если Позиция = 0 Тогда
            Продолжить
        КонецЕсли
        ИмяОбъекта = Лев(Тек, Позиция - 1)
        ТипОбъекта = Сред(Тек, Позиция + 1, СтрДлина(Тек) - Позиция)
        СсылкаОбъекта = НайтиОбъектПоИмениИТипу(ИмяОбъекта, ТипОбъекта)
        Если ЗначениеЗаполнено(СсылкаОбъекта) = Ложь Тогда
            Сообщить("Пропущено: " + ИмяОбъекта + " (" + ТипОбъекта + ") нет в импорте")
            Продолжить
        КонецЕсли
        Об = СсылкаОбъекта.ПолучитьОбъект()
        Об.Функция = СсылкаФункции
        Об.Контроль = "Проверено"
        Об.Записать()
    КонецЦикла
КонецПроцедуры

Функция НайтиОбъектПоИмениИТипу(Имя, Тип)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя И О.Тип = &Тип"
    З.УстановитьПараметр("Имя", Имя)
    З.УстановитьПараметр("Тип", Тип)
    Ссылка = Неопределено
    Для Каждого Стр Из З.Выполнить() Цикл
        Ссылка = Справочники.ОбъектМетаданных.НайтиПоИдентификатору(Строка(Стр.Ссылка.УникальныйИдентификатор()))
    КонецЦикла
    Возврат Ссылка
КонецФункции
