// Обработка импорта описания целевого проекта. Тонкая обёртка: весь импорт
// живёт в модуле Импорт, тест гоняет модуль тем же путём.
Процедура Выполнить()
    Текст = "";
    Проект = Неопределено;
    Корневая = Неопределено;

    Если Параметры <> Неопределено Тогда
        Текст = СокрЛП(Строка(Параметры.Файл));
        Проект = Параметры.Проект;
        Корневая = Параметры.КорневаяФункция;
    КонецЕсли;

    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Приложите описание целевого проекта." + Символы.ПС +
            "Сначала выгрузите описание: onebase describe --project <целевой> > desc.json." + Символы.ПС +
            "Из командной строки: --file Файл=desc.json --set Проект=<id проекта>." + Символы.ПС +
            "Из формы: поле «Описание целевого проекта (JSON)».";
    КонецЕсли;

    Новых = Импорт.ПрименитьОписание(Текст, Проект, Корневая);
    Сообщить("Импорт описания: новых объектов " + Формат(Новых, "ЧН=0") + ".");
    Сообщить("Назначьте функции объектам (справочник «Объекты метаданных»), затем прогоните аудит:" +
        " правило «Объект целевого проекта без функции» покажет незакреплённые.");
КонецПроцедуры
