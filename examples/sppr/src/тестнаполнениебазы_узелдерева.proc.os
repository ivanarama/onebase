// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: узел дерева заводится под Existing родителем
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «2»
//   Когда по списку узлов «2.1;Разбор;2;позиции;4» заведено дерево функций
//   То функция с кодом «2.1» имеет статус «Черновик»
//   И функция с кодом «2.1» имеет результат «позиции»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «2»
    Ф = Справочники.Функция.Создать()
    Ф.Код = 2
    Ф.Наименование = "функция " + 2
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Когда по списку узлов «2.1;Разбор;2;позиции;4» заведено дерево функций
    Наполнение.ЗавестиДеревоИзСписка("2.1;Разбор;2;позиции;4", ПроектСсылка)
    // То функция с кодом «2.1» имеет статус «Черновик»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Статус КАК Статус ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код"
    З.УстановитьПараметр("Код", "2.1")
    КодФункции = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодФункции = Стр.Статус
    КонецЦикла
    Утверждать.Равно(КодФункции, "Черновик", "функция с кодом «2.1» имеет статус «Черновик»")
    // И функция с кодом «2.1» имеет результат «позиции»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Результат КАК Результат ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код"
    З.УстановитьПараметр("Код", "2.1")
    РезультатФункции = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        РезультатФункции = Стр.Результат
    КонецЦикла
    Утверждать.Равно(РезультатФункции, "позиции", "функция с кодом «2.1» имеет результат «позиции»")
КонецПроцедуры
