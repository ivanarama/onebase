// Обработка дерева функций целевого проекта. Тонкая обёртка: логика в модуле
// Наполнение, тест гоняет модуль тем же путём. Узлы идемпотентны по коду,
// статус «Черновик» — утверждение остаётся за руководителем.
Процедура Выполнить()
    Текст = "";
    Проект = Неопределено;

    Если Параметры <> Неопределено Тогда
        Текст = СокрЛП(Строка(Параметры.Файл));
        Проект = Параметры.Проект;
        Если Проект = Неопределено И ЗначениеЗаполнено(Параметры.ИмяПроекта) Тогда
            Проект = Наполнение.НайтиИлиСоздатьПроект(СокрЛП(Параметры.ИмяПроекта));
        КонецЕсли;
    КонецЕсли;

    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Приложите JSON-массив узлов дерева: [{""код"":""1.1"",""наименование"":""…"",""родитель"":""1""}].";
    КонецЕсли;

    Наполнение.ЗавестиДеревоИзJSON(Текст, Проект);
    Сообщить("Дерево функций заведено (Черновик). Утверждение — за руководителем.");
КонецПроцедуры
