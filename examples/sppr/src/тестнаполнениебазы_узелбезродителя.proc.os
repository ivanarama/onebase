// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: узел без родителя не имеет родительской функции
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Когда по списку узлов «6.2;Срез;;;1» заведено дерево функций
//   То у функции с кодом «6.2» родителя нет

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Когда по списку узлов «6.2;Срез;;;1» заведено дерево функций
    Наполнение.ЗавестиДеревоИзСписка("6.2;Срез;;;1", ПроектСсылка)
    // То у функции с кодом «6.2» родителя нет
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ Справочник.Функция КАК Ф, Справочник.Функция КАК Р ГДЕ Ф.Код = &Код И Ф.parent_id = Р.Ссылка"
    З.УстановитьПараметр("Код", "6.2")
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Истина(Н = 0, "у функции с кодом «6.2» родителя нет")
КонецПроцедуры
