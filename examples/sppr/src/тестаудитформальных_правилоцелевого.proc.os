// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/аудит_правил.feature.
// Функция: Аудит формальных правил
// Сценарий: правило целевого проекта применяет итог прогона, аудит базы его не трогает
// Шаг-таблица:
//   Дано заведён проект «Каркас-аудит»
//   Дано заведено правило аудита «А-91» стороны «ЦелевойПроект» проекта «Каркас-аудит» с запросом «ВЫБРАТЬ 'Проект' КАК ТипОбъект, П.Наименование КАК Объект, 'итог прогона' КАК Информация ИЗ Справочник.Проект КАК П ГДЕ П.Наименование = 'Каркас-аудит'»
//   Когда правило «А-91» опубликовано с важностью «Предупреждение»
//   Когда проведён аудит базы
//   То результатов правила «А-91» 0 строк
//   Когда проведён итог прогона проекта «Каркас-аудит»
//   То результатов правила «А-91» 1 строк

Процедура Выполнить()
    // Дано заведён проект «Каркас-аудит»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Каркас-аудит"
    ПроектСсылка = Пр.Записать()
    // Дано заведено правило аудита «А-91» стороны «ЦелевойПроект» проекта «Каркас-аудит» с запросом «ВЫБРАТЬ 'Проект' КАК ТипОбъект, П.Наименование КАК Объект, 'итог прогона' КАК Информация ИЗ Справочник.Проект КАК П ГДЕ П.Наименование = 'Каркас-аудит'»
    Пр = Справочники.ПравилоПроверки.Создать()
    Пр.Код = "А-91"
    Пр.Наименование = "правило " + "А-91"
    Пр.СторонаПроверки = "ЦелевойПроект"
    Пр.Проект = Наполнение.НайтиИлиСоздатьПроект("Каркас-аудит")
    Пр.ТекстЗапроса = "ВЫБРАТЬ 'Проект' КАК ТипОбъект, П.Наименование КАК Объект, 'итог прогона' КАК Информация ИЗ Справочник.Проект КАК П ГДЕ П.Наименование = 'Каркас-аудит'"
    Пр.Активно = Истина
    ПравилоСсылка = Пр.Записать()
    // Когда правило «А-91» опубликовано с важностью «Предупреждение»
    Док = Документы.ПубликацияПравила.Создать()
    Док.Дата = ТекущаяДата()
    Док.Правило = ПравилоСсылка
    Док.Важность = "Предупреждение"
    Док.Текст = "публикация " + "А-91"
    Док.Статус = "Опубликовано"
    Док.Записать()
    Док.Провести()
    // Когда проведён аудит базы
    Аудит.ПрименитьПравила(ТекущаяДата())
    // То результатов правила «А-91» 0 строк
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.РезультатыПроверки.СрезПоследних(&Д) КАК Р ГДЕ Р.Правило.Код = &Код"
    З.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    З.УстановитьПараметр("Код", "А-91")
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Равно(Н, 0, "результатов правила «А-91» 0 строк")
    // Когда проведён итог прогона проекта «Каркас-аудит»
    Аудит.ЗаписатьИтогПрогона(Наполнение.НайтиИлиСоздатьПроект("Каркас-аудит"), ТекущаяДата())
    // То результатов правила «А-91» 1 строк
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.РезультатыПроверки.СрезПоследних(&Д) КАК Р ГДЕ Р.Правило.Код = &Код"
    З.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    З.УстановитьПараметр("Код", "А-91")
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Равно(Н, 1, "результатов правила «А-91» 1 строк")
КонецПроцедуры
