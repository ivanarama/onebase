// Общий модуль аудита формальных правил (паттерн плана 89: правило — данные,
// действующая версия правила — периодический регистр, применение —
// регламентное задание).
//
// Текст запроса правила самодостаточен: параметров в нём нет, условие записано
// литералом. Результат правила — строки с фиксированным набором колонок:
// ТипОбъект, Объект, Информация.

// Применяет опубликованные активные правила стороны «База» на дату, пишет
// результаты. Правила целевого проекта применяются ЗаписатьИтогПрогона.
// Возвращает число зафиксированных нарушений.
Функция ПрименитьПравила(НаДату)
    Запрос = Новый Запрос
    Запрос.Текст = "ВЫБРАТЬ П.Ссылка КАК Правило, П.Код КАК Код, П.ТекстЗапроса КАК ТекстЗапроса, Д.Важность КАК Важность " +
        "ИЗ РегистрСведений.ДействующиеПравила.СрезПоследних(&НаДату) КАК Д " +
        "ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилоПроверки КАК П ПО Д.Правило = П.Ссылка " +
        "ГДЕ Д.Статус = &Статус И П.Активно = &Активен " +
        "И (П.СторонаПроверки = &База ИЛИ П.СторонаПроверки = &Пусто) " +
        "УПОРЯДОЧИТЬ ПО П.Код"
    Запрос.УстановитьПараметр("НаДату", НаДату)
    Запрос.УстановитьПараметр("Статус", "Опубликовано")
    Запрос.УстановитьПараметр("Активен", Истина)
    Запрос.УстановитьПараметр("База", "База")
    Запрос.УстановитьПараметр("Пусто", "")

    Нарушений = 0
    Для Каждого Прав Из Запрос.Выполнить() Цикл
        Если ЗначениеЗаполнено(Прав.ТекстЗапроса) = Ложь Тогда
            Продолжить
        КонецЕсли
        Нарушений = Нарушений + ПрименитьПравило(Прав.Правило, Прав.ТекстЗапроса, Прав.Важность, НаДату)
    КонецЦикла
    Возврат Нарушений
КонецФункции

// Применяет опубликованные активные правила стороны «ЦелевойПроект» и пишет
// результат целевой проверки в «РезультатыПроверки» базы. Проект участвует
// выбором среза: запросы правил обращаются к импортированным данным проекта.
// Возвращает число зафиксированных нарушений.
Функция ЗаписатьИтогПрогона(Проект, НаДату)
    Запрос = Новый Запрос
    Запрос.Текст = "ВЫБРАТЬ П.Ссылка КАК Правило, П.Код КАК Код, П.ТекстЗапроса КАК ТекстЗапроса, Д.Важность КАК Важность " +
        "ИЗ РегистрСведений.ДействующиеПравила.СрезПоследних(&НаДату) КАК Д " +
        "ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилоПроверки КАК П ПО Д.Правило = П.Ссылка " +
        "ГДЕ Д.Статус = &Статус И П.Активно = &Активен " +
        "И П.СторонаПроверки = &Целевой И П.Проект = &Проект " +
        "УПОРЯДОЧИТЬ ПО П.Код"
    Запрос.УстановитьПараметр("НаДату", НаДату)
    Запрос.УстановитьПараметр("Статус", "Опубликовано")
    Запрос.УстановитьПараметр("Активен", Истина)
    Запрос.УстановитьПараметр("Целевой", "ЦелевойПроект")
    Запрос.УстановитьПараметр("Проект", Проект)

    Нарушений = 0
    Для Каждого Прав Из Запрос.Выполнить() Цикл
        Если ЗначениеЗаполнено(Прав.ТекстЗапроса) = Ложь Тогда
            Продолжить
        КонецЕсли
        Нарушений = Нарушений + ПрименитьПравило(Прав.Правило, Прав.ТекстЗапроса, Прав.Важность, НаДату)
    КонецЦикла
    Возврат Нарушений
КонецФункции

// Выполняет запрос правила и пишет строки результата. Возвращает число строк.
Функция ПрименитьПравило(Правило, ТекстЗапроса, Важность, НаДату)
    Запрос = Новый Запрос
    Запрос.Текст = ТекстЗапроса

    N = 0
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Мен = РегистрыСведений.РезультатыПроверки.СоздатьМенеджерЗаписи()
        Мен.Период = НаДату
        Мен.Правило = Правило
        Мен.ТипОбъекта = Стр.ТипОбъект
        Мен.Объект = Стр.Объект
        Мен.Информация = Стр.Информация
        Мен.Важность = Важность
        Мен.Исключение = Ложь
        Мен.Записать()
        N = N + 1
    КонецЦикла
    Возврат N
КонецФункции
