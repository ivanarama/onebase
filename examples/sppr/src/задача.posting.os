// Проведение «Задачи»: пишет строку истории статусов. Платформенная история
// этапов (план 121) фиксирует переходы маршрута в карточке и в отчёте
// «где застряло»; этот регистр доступен агенту запросом и содержит автора,
// старый статус и комментарий.
Процедура ОбработкаПроведения()
    Старый = ""
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ Р.НовыйСтатус КАК НовыйСтатус ИЗ РегистрСведений.ИсторияСтатусовЗадач.СрезПоследних(&Д) КАК Р ГДЕ Р.Задача = &Задача"
    З.УстановитьПараметр("Д", this.Дата)
    З.УстановитьПараметр("Задача", this.Ссылка)
    Для Каждого Стр Из З.Выполнить() Цикл
        Старый = Стр.НовыйСтатус
    КонецЦикла

    Автор = ИмяПользователя()
    Если ЗначениеЗаполнено(Автор) = Ложь Тогда
        Автор = "system:Задача";
    КонецЕсли

    Мен = РегистрыСведений.ИсторияСтатусовЗадач.СоздатьМенеджерЗаписи();
    Мен.Период = this.Дата;
    Мен.Задача = this.Ссылка;
    Мен.СтарыйСтатус = Старый;
    Мен.НовыйСтатус = this.Статус;
    Мен.Исполнитель = Автор;
    Мен.Комментарий = this.Описание;
    Мен.Записать();
КонецПроцедуры
