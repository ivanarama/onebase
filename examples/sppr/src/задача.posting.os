// Проведение «Задачи»: пишет строку истории статусов. Платформенная история
// этапов (план 121) фиксирует переходы маршрута в карточке и в отчёте
// «где застряло»; этот регистр доступен агенту запросом и содержит автора,
// старый статус и комментарий.
Процедура ОбработкаПроведения()
    // Номер перехода: записи одного прогона идут в одну секунду, период
    // periodic-регистра их не разделяет, поэтому ключом строки является
    // задача + номер перехода. Старый статус берётся из строки с
    // предыдущим номером.
    Н = 0
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.ИсторияСтатусовЗадач.СрезПоследних(&Д) КАК Р ГДЕ Р.Задача = &Задача"
    З.УстановитьПараметр("Д", this.Дата)
    З.УстановитьПараметр("Задача", this.Ссылка)
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла

    Старый = ""
    Если Н > 0 Тогда
        З2 = Новый Запрос
        З2.Текст = "ВЫБРАТЬ Р.НовыйСтатус КАК НовыйСтатус ИЗ РегистрСведений.ИсторияСтатусовЗадач.СрезПоследних(&Д) КАК Р ГДЕ Р.Задача = &Задача И Р.Переход = &П"
        З2.УстановитьПараметр("Д", this.Дата)
        З2.УстановитьПараметр("Задача", this.Ссылка)
        З2.УстановитьПараметр("П", Н)
        Для Каждого Стр2 Из З2.Выполнить() Цикл
            Старый = Стр2.НовыйСтатус
        КонецЦикла
    КонецЕсли

    Автор = ИмяПользователя()
    Если ЗначениеЗаполнено(Автор) = Ложь Тогда
        Автор = "system:Задача";
    КонецЕсли

    Мен = РегистрыСведений.ИсторияСтатусовЗадач.СоздатьМенеджерЗаписи();
    Мен.Период = this.Дата;
    Мен.Задача = this.Ссылка;
    Мен.Переход = Н + 1;
    Мен.СтарыйСтатус = Старый;
    Мен.НовыйСтатус = this.Статус;
    Мен.Исполнитель = Автор;
    Мен.Комментарий = this.Описание;
    Мен.Записать();
КонецПроцедуры
