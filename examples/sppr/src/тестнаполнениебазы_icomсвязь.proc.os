// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: ICOM-связь записывается в регистр
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «4.1»
//   Дано заведена функция с кодом «4.2»
//   Когда по списку «4.1;4.2;Вход;слова» записаны связи функций
//   То связь функции «4.1» имеет источник с кодом «4.2» вида «Вход»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «4.1»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "4.1"
    Ф.Наименование = "функция " + "4.1"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Дано заведена функция с кодом «4.2»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "4.2"
    Ф.Наименование = "функция " + "4.2"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Когда по списку «4.1;4.2;Вход;слова» записаны связи функций
    Наполнение.ЗаписатьСвязиПоСписку("4.1;4.2;Вход;слова")
    // То связь функции «4.1» имеет источник с кодом «4.2» вида «Вход»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.СвязиФункций КАК С ГДЕ С.Потребитель.Код = &Потребитель И С.Источник.Код = &Источник И С.Вид = &Вид"
    З.УстановитьПараметр("Потребитель", "4.1")
    З.УстановитьПараметр("Источник", "4.2")
    З.УстановитьПараметр("Вид", "Вход")
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Истина(Н > 0, "связь функции «4.1» имеет источник с кодом «4.2» вида «Вход»")
КонецПроцедуры
