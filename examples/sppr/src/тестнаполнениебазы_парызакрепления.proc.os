// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: пары закрепления назначают функцию объекту
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «3.1»
//   Дано заведён объект метаданных «лексикон» типа «Справочник»
//   Когда по парам «3.1=лексикон:Справочник» объекты закреплены
//   То функция объекта «лексикон» имеет код «3.1»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «3.1»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "3.1"
    Ф.Наименование = "функция " + "3.1"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Дано заведён объект метаданных «лексикон» типа «Справочник»
    Об = Справочники.ОбъектМетаданных.Создать()
    Об.Имя = "лексикон"
    Об.Тип = "Справочник"
    Об.Проект = ПроектСсылка
    Об.Контроль = "НеПроверено"
    ОбъектСсылка = Об.Записать()
    // Когда по парам «3.1=лексикон:Справочник» объекты закреплены
    Наполнение.РасставитьПоСписку("3.1=лексикон:Справочник")
    // То функция объекта «лексикон» имеет код «3.1»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Функция.Код КАК Код ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = 'лексикон'"
    КодОбъекта = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодОбъекта = Стр.Код
    КонецЦикла
    Утверждать.Равно(КодОбъекта, "3.1", "функция объекта «лексикон» имеет код «3.1»")
КонецПроцедуры
