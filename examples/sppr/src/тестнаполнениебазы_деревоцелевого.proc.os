// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: дерево целевого проекта заводится JSON-текстом под новым проектом
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Когда JSON-текстом заведено дерево узлов 0 и 1
//   То функция с кодом «0» имеет статус «Черновик»
//   И функция с кодом «1» относится к проекту «compsem-тест»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Когда JSON-текстом заведено дерево узлов 0 и 1
    JSON = "[{""код"":""0"",""наименование"":""Понимание_текста"",""родитель"":"""",""результат"":""ответ"",""трудозатраты"":2},"
    + "{""код"":""1"",""наименование"":""Приём_данных"",""родитель"":""0"",""результат"":""данные"",""трудозатраты"":1}]"
    Наполнение.ЗавестиДеревоИзJSON(JSON, Наполнение.НайтиИлиСоздатьПроект("compsem-тест"))
    // То функция с кодом «0» имеет статус «Черновик»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Статус КАК Статус ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код"
    З.УстановитьПараметр("Код", 0)
    КодФункции = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодФункции = Стр.Статус
    КонецЦикла
    Утверждать.Равно(КодФункции, "Черновик", "функция с кодом «0» имеет статус «Черновик»")
    // И функция с кодом «1» относится к проекту «compsem-тест»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Проект.Наименование КАК Проект ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код"
    З.УстановитьПараметр("Код", 1)
    ИмяПроекта = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        ИмяПроекта = Стр.Проект
    КонецЦикла
    Утверждать.Равно(ИмяПроекта, "compsem-тест", "функция с кодом «1» относится к проекту «compsem-тест»")
КонецПроцедуры
