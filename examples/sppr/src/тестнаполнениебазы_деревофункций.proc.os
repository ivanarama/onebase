// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: дерево функций заводится из списка узлов
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Когда по списку узлов «1;Книга;;словарь;12» заведено дерево функций
//   То функция с кодом «1» имеет статус «Черновик»
//   И функция с кодом «1» имеет результат «словарь»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Когда по списку узлов «1;Книга;;словарь;12» заведено дерево функций
    Наполнение.ЗавестиДеревоИзСписка("1;Книга;;словарь;12", ПроектСсылка)
    // То функция с кодом «1» имеет статус «Черновик»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Статус КАК Статус ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код"
    З.УстановитьПараметр("Код", 1)
    КодФункции = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодФункции = Стр.Статус
    КонецЦикла
    Утверждать.Равно(КодФункции, "Черновик", "функция с кодом «1» имеет статус «Черновик»")
    // И функция с кодом «1» имеет результат «словарь»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Результат КАК Результат ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код"
    З.УстановитьПараметр("Код", 1)
    РезультатФункции = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        РезультатФункции = Стр.Результат
    КонецЦикла
    Утверждать.Равно(РезультатФункции, "словарь", "функция с кодом «1» имеет результат «словарь»")
КонецПроцедуры
