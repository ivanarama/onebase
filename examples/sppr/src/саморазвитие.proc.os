// Демо-наполнение проектной базы: проект доработки самой OneBase.
// Показывает полный цикл срез A: дерево функций платформы, объекты
// (Go-пакеты, план, документация), ICOM-стрелки, сценарии, очередь,
// контроль объектов, правила аудита над целевым проектом и задачи по срезам B/C/D.
Процедура Выполнить()
    Проект = НайтиИлиСоздатьПроект("OneBase — развитие платформы")
    Аг = НайтиИлиСоздатьИсполнитель("Проектировщик-агент (Claude)", "arch@onebase.local", "Проектировщик")
    Раз = НайтиИлиСоздатьИсполнитель("Разработчик-агент (Codex)", "dev@onebase.local", "Разработчик")
    Тес = НайтиИлиСоздатьИсполнитель("Тестировщик-агент (pi)", "qa@onebase.local", "Тестировщик")
    Рук = НайтиИлиСоздатьИсполнитель("Руководитель-агент (циклер)", "lead@onebase.local", "Руководитель")
    Вла = НайтиИлиСоздатьИсполнитель("Владелец продукта (человек)", "owner@onebase.local", "Владелец")

    Ф2  = СоздатьФункцию("2", "Развитие платформы OneBase", "Платформа, на которой команды ведут прикладные разработки", "Функция", Проект, "", Рук, 200)
    Ф21 = СоздатьФункцию("2.1", "Мост метаданных целевого проекта", "Объекты целевой конфигурации попадают в проектную базу", "Функция", Проект, Ф2, Аг, 40)
    Ф22 = СоздатьФункцию("2.2", "Конвейер Gherkin", "Сценарий превращается в исполняемый тест конфигурации", "Функция", Проект, Ф2, Тес, 60)
    Ф23 = СоздатьФункцию("2.3", "Граф IDEF0", "Дерево функций рисуется по стрелкам регистра связей", "Функция", Проект, Ф2, Аг, 30)
    Ф24 = СоздатьФункцию("2.4", "Ролевой контур агентов", "Каждый агент действует под своей ролью и токеном", "Функция", Проект, Ф2, Раз, 20)
    Ф25 = СоздатьФункцию("2.5", "Ключевые операции", "Действия UI попадают в журнал ключевых операций", "Функция", Проект, Ф2, Раз, 25)
    Ф3  = СоздатьФункцию("3", "Диспетчеризация агентов", "Задачи разбираются циклером по ролям", "Функция", Проект, "", Рук, 50)
    Ф31 = СоздатьФункцию("3.1", "Очередь задач", "Задача встаёт в очередь и получает исполнителя", "Функция", Проект, Ф3, Рук, 15)

    // ── объекты целевого проекта (репозиторий OneBase) ─────────────────────
    СоздатьОбъект("План 218", "План", "Plans/218-sppr-design-ledger.md", "План проектной базы СППР", Ф2, Проект, Рук, "Проверено")
    СоздатьОбъект("internal/metadata", "GoПакет", "internal/metadata/", "Модель данных, stages, валидация", Ф21, Проект, Раз, "Проверено")
    СоздатьОбъект("internal/cli", "GoПакет", "internal/cli/", "CLI: describe, check, test, procrun", Ф21, Проект, Раз, "Проверено")
    СоздатьОбъект("internal/mcp", "GoПакет", "internal/mcp/", "MCP-контур: read-tools и procrun", Ф24, Проект, Раз, "Проверено")
    СоздатьОбъект("internal/auth", "GoПакет", "internal/auth/", "Пользователи, роли, API-токены, 2FA", Ф24, Проект, Раз, "Проверено")
    СоздатьОбъект("internal/dsl", "GoПакет", "internal/dsl/", "Язык и интерпретатор — база компиляции Gherkin", Ф22, Проект, Тес, "НеПроверено")
    СоздатьОбъект("internal/ui", "GoПакет", "internal/ui/", "Управляемые формы: тип диаграммы «граф»", Ф23, Проект, Аг, "НеПроверено")
    СоздатьОбъект("internal/jobqueue", "GoПакет", "internal/jobqueue/", "Регламентные задания и очередь", Ф31, Проект, Рук, "Проверено")
    СоздатьОбъект("docs/mcp.md", "Документация", "docs/mcp.md", "Инвентарь MCP-инструментов и флаги записи", Ф24, Проект, Аг, "Проверено")
    СоздатьОбъект("internal/exchange", "GoПакет", "internal/exchange/", "Планы обмена — функция не назначена", "", Проект, Раз, "НеПроверено")
    СоздатьОбъект("internal/aiassist", "GoПакет", "internal/aiassist/", "ИИ-ассистент — функция не назначена", "", Проект, Раз, "НеПроверено")

    // ── сценарии: основание утверждения функции ────────────────────
    СоздатьСценарий("Мост метаданных: описать OneBase", Ф21, Проект,
        "Функциональный тест 2.1: целевой проект в проектной базе",
        "Шаг 1;onebase describe --project .;JSON: каталоги, документы, регистры, роли|Шаг 2;Заполнить ОбъектыМетаданных по JSON;Каждый пакет и YAML-файл имеет запись с путём|Шаг 3;Привязать функции через регистр Трассировка;Отчёт «Покрытие функций» не имеет пустых строк")
    СоздатьСценарий("Ролевой контур: агент действует под ролью", Ф24, Проект,
        "Функциональный тест 2.4: RBAC над REST v2",
        "Шаг 1;Создать пользователя Разработчик-агент и выдать токен;Роль Разработчик назначена пользователю|Шаг 2;POST /api/v2/catalog/ОбъектМетаданных под токеном;Запись разрешена (право write)|Шаг 3;PUT /api/v2/catalog/Функция под токеном Разработчика;Ответ 403: роль не имеет прав утверждать функции")
    СоздатьСценарий("Очередь: циклер берёт задачу", Ф31, Проект,
        "Функциональный тест 3.1: очередь и роль",
        "Шаг 1;Задача со статусом Новая в очереди;Строка очереди имеет позицию|Шаг 2;Циклер назначает исполнителя и статус Принята;История статусов фиксирует переход|Шаг 3;Циклер пытается перескочить в Выполнена;Гейт этапов отклоняет переход")

    УтвердитьФункцию(Ф21)
    УтвердитьФункцию(Ф24)
    УтвердитьФункцию(Ф31)
    УтвердитьФункцию(Ф31)

    // Функции целевого проекта: объекты, которые мост принёс без функции,
    // закрепляются за узлами развития платформы. Пары «имя:тип» — объект
    // одного типа может носить имя объекта другого типа.
    Назначить("Импорт:Модуль;Импортописания:Модуль;ИмпортОписания:Обработка", Ф21)
    Назначить("Сценарий:Справочник;ВидСценария:Перечисление;Тестыкаркаса:Модуль;ТестыКаркаса:Обработка;Ошибка:Документ;СтатусОшибки:Перечисление;Ошибки:Подсистема;Саморазвитие:Модуль;Саморазвитие:Обработка", Ф22)
    Назначить("СвязиФункций:РегистрСведений;Экспортidef0:Модуль;ЭкспортIDEF0:Обработка", Ф23)
    Назначить("Исполнитель:Справочник;ПрофильПользователя:Справочник;Проектировщик:Роль;Разработчик:Роль;Тестировщик:Роль;Руководитель:Роль", Ф24)
    Назначить("Очередь:Справочник;ОчередьЗадач:РегистрСведений;ИсторияСтатусовЗадач:РегистрСведений;СтатусЗадачи:Перечисление;ТипЗадачи:Перечисление;Приоритет:Перечисление;ТипСвязиЗадач:Перечисление;Задачи:Подсистема;Планирование:Подсистема", Ф31)

    // ── ICOM: стрелки между функциями ──────────────────────────────────────
    ЗаписатьСвязь(Ф2, Ф21, "Выход", "описанные объекты целевого проекта")
    ЗаписатьСвязь(Ф21, Ф2, "Вход", "структура целевой конфигурации (onebase describe)")
    ЗаписатьСвязь(Ф2, Ф22, "Выход", "набор исполняемых тестов конфигурации")
    ЗаписатьСвязь(Ф21, Ф22, "Управление", "объекты как источник формулировок сценариев")
    ЗаписатьСвязь(Ф2, Ф24, "Выход", "пользователи и токены под ролями")
    ЗаписатьСвязь(Ф24, Ф22, "Ресурс", "токен агента как доступ к тестовому контуру")
    ЗаписатьСвязь(Ф31, Ф2, "Вход", "задачи, готовые к работе")

    // ── очередь и контроль объектов ────────────────────────────────────────
    Оч = Справочники.Очередь.НайтиПоРеквизиту("Наименование", "Очередь разработки")
    Если ЗначениеЗаполнено(Оч) = Ложь Тогда
        Пр = Справочники.Очередь.Создать()
        Пр.Наименование = "Очередь разработки"
        Пр.Проект = Проект
        Оч = Пр.Записать()
    КонецЕсли

    // ── правила аудита над целевым проектом и их публикации ────────────────
    П1 = СоздатьПравило("AUD-OBJ-NOFUNC", "Объект целевого проекта без функции", "ОбъектМетаданных",
        "Блокирующее", "ВЫБРАТЬ 'ОбъектМетаданных' КАК ТипОбъект, О.Имя КАК Объект, 'нет функции: объект не закреплён за декомпозицией' КАК Информация ИЗ Справочник.ОбъектМетаданных КАК О ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проект КАК ПР ПО О.Проект = ПР.Ссылка ГДЕ О.Функция ЕСТЬ ПУСТО И ПР.Наименование = 'OneBase — развитие платформы'",
        Проект, "Владелец продукта (человек)")
    П2 = СоздатьПравило("AUD-FUNC-NOTASK", "Утверждённая функция без задачи", "Функция",
        "Предупреждение", "ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'функция утверждена, задач нет' КАК Информация ИЗ Справочник.Функция КАК Ф ЛЕВОЕ СОЕДИНЕНИЕ Документ.Задача КАК З ПО З.Функция = Ф.Ссылка ГДЕ З.Ссылка ЕСТЬ ПУСТО И Ф.Статус = 'Утверждена'",
        Проект, "Руководитель проекта")
    ЗапубликоватьПравило(П1, "Блокирующее", "Объект целевого проекта обязан быть закреплён за функцией декомпозиции", "Демо-наполнение: аудит над репозиторием OneBase")
    ЗапубликоватьПравило(П2, "Предупреждение", "Утверждённая функция должна иметь задачу", "Демо-наполнение: аудит над репозиторием OneBase")

    // ── задачи по срезам B/C/D ──────────────────────────────────────────────
    Т1 = СоздатьЗадачу("Собрать пакет формальных правил над целевой конфигурацией", "20 правил главы аудита: объект без функции, сценарий без функции, нарушение связности ICOM", Проект, Ф2, "Проектирование", "Высокий", Аг, 16, 5, "Принята", Вла)
    Т2 = СоздатьЗадачу("CLI-мост: describe целевого проекта → ОбъектыМетаданных + Трассировка", "Команда, читающая JSON описания и пишущая справочник и регистр", Проект, Ф21, "Разработка", "Высокий", Раз, 40, 10, "Новая", Аг)
    Т3 = СоздатьЗадачу("Расширить enum типов объекта (План, GoПакет, Документация)", "Каркас описывает YAML-конфигурацию, репозиторий описывается пакетами", Проект, Ф21, "Разработка", "Средний", Раз, 4, 3, "Принята", Аг)
    Т4 = СоздатьЗадачу("Прототип компиляции .feature → kind: test", "Парсер Gherkin, шаг-таблица, отчёт JUnit", Проект, Ф22, "Исследование", "Средний", Тес, 20, 14, "Новая", Аг)
    Т5 = СоздатьЗадачу("Тип диаграммы «граф»: узлы и рёбра из регистра связей", "Отрисовка IDEF0 в UI по регистру СвязиФункций", Проект, Ф23, "Проектирование", "Средний", Аг, 30, 21, "Новая", Рук)
    Т6 = СоздатьЗадачу("Провижининг ролей агентов: пользователи + токены, проверка RBAC над v2", "Тест 2.4: роль Разработчика не даёт прав на утверждение функций", Проект, Ф24, "Разработка", "Критический", Раз, 12, 4, "Принята", Рук)
    Т7 = СоздатьЗадачу("Ключевые операции: точки расширения UI и журнал", "ПередНачатомДействия/ПослеВыполненияДействия, журнал операций", Проект, Ф25, "Проектирование", "Низкий", Аг, 25, 30, "Новая", Рук)
    Т8 = СоздатьЗадачу("Циклер очередей: кто разбирает ОчередьЗадач", "Внешний диспетчер: роль агента, очередь, лимит параллельных задач", Проект, Ф31, "Исследование", "Высокий", Рук, 10, 7, "Новая", Вла)

    ЗаписатьСвязьЗадач(Т1, Т2, "Блокирует")
    ЗаписатьСвязьЗадач(Т1, Т3, "Блокирует")
    ЗаписатьСвязьЗадач(Т2, Т4, "ЗависитОт")

    ЗаписатьОчередь(Оч, Т2, 1)
    ЗаписатьОчередь(Оч, Т6, 2)
    ЗаписатьОчередь(Оч, Т1, 3)
    ЗаписатьОчередь(Оч, Т4, 4)

    ЗаписатьКонтроль(НайтиОбъектПоИмени("internal/dsl"), Раз, "НеПроверено")
    ЗаписатьКонтроль(НайтиОбъектПоИмени("internal/ui"), Аг, "НеПроверено")
    ЗаписатьКонтроль(НайтиОбъектПоИмени("internal/mcp"), Раз, "Проверено")

    СоздатьУчёт(Раз, Проект, Т6, 3)

    // Т2 и Т3 закрыты в этой сессии: мост метаданных, идемпотентный
    // прогон и расстановка функций сделаны. Статус ведётся по маршруту
    // этапов, перескок отклоняется гейтом; каждый переход пишется в
    // регистр «История статусов задач» проведением документа.
    ПровестиДо(Т2, "Выполнена")
    ПровестиДо(Т3, "Выполнена")
    СоздатьУчёт(Раз, Проект, Т2, 40)
    СоздатьУчёт(Раз, Проект, Т3, 4)
    // Т6 (провижининг ролей агентов) остаётся «Принята»: пользователи и
    // токены в демо-базе не заведены, RBAC над REST v2 не проверен.
    СоздатьУчёт(Аг, Проект, Т1, 4)
    СоздатьУчёт(Рук, Проект, Т8, 2)

    Сообщить("Проект «OneBase — развитие платформы» заполнен: 8 функций, 11 объектов, 3 сценария, 8 задач, 2 правила аудита.")
    Сообщить("Открыть: /ui/ (главная), /ui/report/покрытиифункций, /ui/report/результатыаудита, /ui/inforeg/трассировка, /ui/processor/экспортidef0")
КонецПроцедуры

// ── helpers ────────────────────────────────────────────────────────────────

Функция НайтиИлиСоздатьПроект(Наименование)
    Ссылка = Справочники.Проект.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = Наименование
    Пр.Описание = "Проект доработки самой платформы OneBase (срезы B/C/D плана 218)"
    Пр.Статус = "Проектирование"
    Пр.ДатаНачала = Дата(2026, 11, 9)
    Пр.ДатаЗавершения = Дата(2027, 4, 30)
    Возврат Пр.Записать()
КонецФункции

Функция НайтиИлиСоздатьИсполнитель(Наименование, Email, РольПроекта)
    Ссылка = Справочники.Исполнитель.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Исполнитель.Создать()
    Пр.Наименование = Наименование
    Пр.Email = Email
    Пр.РольПроекта = РольПроекта
    Пр.ЧасоваяСтавка = 1
    Возврат Пр.Записать()
КонецФункции

Функция СоздатьФункцию(Код, Наименование, Результат, Вид, Проект, Родитель, Ответственный, Трудозатраты)
    Ссылка = Справочники.Функция.НайтиПоРеквизиту("Код", Код)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Функция.Создать()
    Пр.Код = Код
    Пр.Наименование = Наименование
    Пр.Описание = Результат
    Пр.Результат = Результат
    Пр.Тип = Вид
    Пр.Проект = Проект
    Пр.Ответственный = Ответственный
    Пр.Трудозатраты = Трудозатраты
    Пр.Статус = "Черновик"
    Пр.ОтображаетсяИнтерфейсе = Истина
    Пр.НаименованиеИнтерфейса = Наименование
    Если ЗначениеЗаполнено(Родитель) Тогда
        Пр.Родитель = Родитель
    КонецЕсли
    Возврат Пр.Записать()
КонецФункции

Процедура УтвердитьФункцию(Ссылка)
    Об = Ссылка.ПолучитьОбъект()
    Если Об.Статус = "Черновик" Тогда
        Об.Статус = "НаСогласовании"
        Об.Записать()
    КонецЕсли
    Об2 = Ссылка.ПолучитьОбъект()
    Если Об2.Статус = "НаСогласовании" Тогда
        Об2.Статус = "Утверждена"
        Об2.Записать()
    КонецЕсли
КонецПроцедуры

Процедура СоздатьОбъект(Имя, Тип, Путь, Описание, СсылкаФункции, Проект, Ответственный, Контроль)
    Ссылка = Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", Имя)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат
    КонецЕсли
    Пр = Справочники.ОбъектМетаданных.Создать()
    Пр.Имя = Имя
    Пр.Тип = Тип
    Пр.ПутьФайла = Путь
    Пр.Описание = Описание
    Пр.Проект = Проект
    Пр.Ответственный = Ответственный
    Пр.Статус = "Утверждён"
    Пр.Контроль = Контроль
    Если ЗначениеЗаполнено(СсылкаФункции) Тогда
        Пр.Функция = СсылкаФункции
    КонецЕсли
    СсылкаОбъекта = Пр.Записать()
    Если ЗначениеЗаполнено(СсылкаФункции) Тогда
        ЗаписатьТрассировку(СсылкаФункции, СсылкаОбъекта, Путь, "HEAD")
    КонецЕсли
КонецПроцедуры

Функция НайтиОбъектПоИмени(Имя)
    Возврат Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", Имя)
КонецФункции

Процедура ЗаписатьТрассировку(СсылкаФункции, СсылкаОбъекта, Путь, Коммит)
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи()
    Мен.Функция = СсылкаФункции
    Мен.Объект = СсылкаОбъекта
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.ПутьФайла = Путь
    Мен.Коммит = Коммит
    Мен.Записать()
КонецПроцедуры

Функция СоздатьСценарий(Наименование, СсылкаФункции, Проект, Текст, Шаги)
    Ссылка = Справочники.Сценарий.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Сценарий.Создать()
    Пр.Наименование = Наименование
    Пр.Функция = СсылкаФункции
    Пр.Вид = "Сценарий"
    Пр.Текст = Текст
    Пр.Актуален = Истина
    Пр.Проект = Проект
    Ссылка = Пр.Записать()
    Об = Ссылка.ПолучитьОбъект()
    Для Каждого СтрокаШага Из СтрРазделить(Шаги, "|") Цикл
        Части = СтрРазделить(СтрокаШага, ";")
        Стр = Об.Шаги.Добавить()
        Стр.Шаг = Части[0]
        Стр.Действие = Части[1]
        Стр.Ожидание = Части[2]
    КонецЦикла
    Возврат Об.Записать()
КонецФункции

Процедура ЗаписатьСвязь(Потребитель, Источник, Вид, Данные)
    Мен = РегистрыСведений.СвязиФункций.СоздатьМенеджерЗаписи()
    Мен.Потребитель = Потребитель
    Мен.Источник = Источник
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.Вид = Вид
    Мен.Данные = Данные
    Мен.Записать()
КонецПроцедуры

Функция СоздатьПравило(Код, Наименование, ОбъектПроверки, Важность, Текст, Проект, Владелец)
    Ссылка = Справочники.ПравилоПроверки.НайтиПоРеквизиту("Код", Код)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.ПравилоПроверки.Создать()
    Пр.Код = Код
    Пр.Наименование = Наименование
    Пр.ОбъектПроверки = ОбъектПроверки
    Пр.Важность = Важность
    Пр.ТекстЗапроса = Текст
    Пр.Активно = Истина
    Пр.Предопределённое = Ложь
    Пр.Владелец = Владелец
    Пр.Проект = Проект
    Возврат Пр.Записать()
КонецФункции

Процедура ЗапубликоватьПравило(Правило, Важность, Текст, Основание)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.ДействующиеПравила.СрезПоследних(&Д) КАК Д ГДЕ Д.Правило = &Правило"
    З.УстановитьПараметр("Д", ТекущаяДата())
    З.УстановитьПараметр("Правило", Правило)
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Если Н > 0 Тогда
        Возврат
    КонецЕсли
    Пуб = Документы.ПубликацияПравила.Создать()
    Пуб.Дата = ТекущаяДата()
    Пуб.Правило = Правило
    Пуб.Важность = Важность
    Пуб.Текст = Текст
    Пуб.Статус = "Опубликовано"
    Пуб.Основание = Основание
    Пуб.Провести()
КонецПроцедуры

Функция СоздатьЗадачу(Заголовок, Описание, Проект, СсылкаФункции, Тип, Приоритет, Исполнитель, Оценка, СрокДней, ЦелевойСтатус, Автор)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка КАК Ссылка ИЗ Документ.Задача КАК З ГДЕ З.Заголовок = &Заголовок"
    З.УстановитьПараметр("Заголовок", Заголовок)
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат Стр.Ссылка
    КонецЦикла
    Док = Документы.Задача.Создать()
    Док.Дата = ТекущаяДата()
    Док.Заголовок = Заголовок
    Док.Описание = Описание
    Док.Проект = Проект
    Док.Функция = СсылкаФункции
    Док.Тип = Тип
    Док.Приоритет = Приоритет
    Док.Исполнитель = Исполнитель
    Док.Автор = Автор
    Док.Оценка = Оценка
    Док.Срок = ТекущаяДата() + 86400 * СрокДней
    Док.Статус = "Новая"
    Ссылка = Док.Записать()
    Док.Провести()
    Если ЦелевойСтатус = "Принята" Тогда
        Об = Ссылка.ПолучитьОбъект()
        Об.Статус = "Принята"
        Об.Провести()
    КонецЕсли
    Возврат Ссылка
КонецФункции

Процедура ЗаписатьСвязьЗадач(Верх, Низ, Вид)
    Об = Низ.ПолучитьОбъект()
    Стр = Об.Связи.Добавить()
    Стр.Задача = Верх
    Стр.Тип = Вид
    Об.Записать()
КонецПроцедуры

Процедура ЗаписатьОчередь(Очередь, СсылкаЗадачи, Позиция)
    Мен = РегистрыСведений.ОчередьЗадач.СоздатьМенеджерЗаписи()
    Мен.Задача = СсылкаЗадачи
    Мен.Очередь = Очередь
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.Позиция = Позиция
    Мен.Записать()
КонецПроцедуры

Процедура ЗаписатьКонтроль(СсылкаОбъекта, Исполнитель, Статус)
    Если ЗначениеЗаполнено(СсылкаОбъекта) = Ложь Тогда
        Возврат
    КонецЕсли
    Мен = РегистрыСведений.КонтрольОбъектов.СоздатьМенеджерЗаписи()
    Мен.Период = ТекущаяДата()
    Мен.Объект = СсылкаОбъекта
    Мен.Пользователь = Исполнитель
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.Статус = Статус
    Мен.Записать()
КонецПроцедуры

Процедура СоздатьУчёт(Исполнитель, Проект, СсылкаЗадачи, Часы)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.ЗатратыВремени КАК З ГДЕ З.Задача = &Задача И З.Исполнитель = &Исполнитель"
    З.УстановитьПараметр("Задача", СсылкаЗадачи)
    З.УстановитьПараметр("Исполнитель", Исполнитель)
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Если Н > 0 Тогда
        Возврат
    КонецЕсли
    Вид = Справочники.ВидДеятельности.НайтиПоРеквизиту("Наименование", "Разработка")
    Если ЗначениеЗаполнено(Вид) = Ложь Тогда
        В = Справочники.ВидДеятельности.Создать()
        В.Наименование = "Разработка"
        Вид = В.Записать()
    КонецЕсли
    Ур = Документы.УчётВремени.Создать()
    Ур.Дата = ТекущаяДата()
    Ур.Исполнитель = Исполнитель
    Ур.Проект = Проект
    Ур.Задача = СсылкаЗадачи
    Ур.ВидДеятельности = Вид
    Ур.Часы = Часы
    Ур.Провести()
КонецПроцедуры
Процедура Назначить(Список, СсылкаФункции)
    Для Каждого Эл Из СтрРазделить(Список, ";") Цикл
        Тек = СокрЛП(Эл)
        Позиция = СтрНайти(Тек, ":")
        Если Позиция = 0 Тогда
            Продолжить
        КонецЕсли
        ИмяОбъекта = Лев(Тек, Позиция - 1)
        ТипОбъекта = Сред(Тек, Позиция + 1, СтрДлина(Тек) - Позиция)
        СсылкаОбъекта = НайтиОбъектПоИмениИТипу(ИмяОбъекта, ТипОбъекта)
        Если ЗначениеЗаполнено(СсылкаОбъекта) = Ложь Тогда
            Сообщить("Пропущено: " + ИмяОбъекта + " (" + ТипОбъекта + ") нет в импорте")
            Продолжить
        КонецЕсли
        Об = СсылкаОбъекта.ПолучитьОбъект()
        Об.Функция = СсылкаФункции
        Об.Контроль = "Проверено"
        Об.Записать()
    КонецЦикла
КонецПроцедуры

Функция НайтиОбъектПоИмениИТипу(Имя, Тип)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя И О.Тип = &Тип"
    З.УстановитьПараметр("Имя", Имя)
    З.УстановитьПараметр("Тип", Тип)
    Ссылка = Неопределено
    Для Каждого Стр Из З.Выполнить() Цикл
        Ссылка = Справочники.ОбъектМетаданных.НайтиПоИдентификатору(Строка(Стр.Ссылка.УникальныйИдентификатор()))
    КонецЦикла
    Возврат Ссылка
КонецФункции
Процедура ПровестиДо(СсылкаЗадачи, ЦелевойСтатус)
    Маршрут = Новый Массив
    Маршрут.Добавить("Принята")
    Маршрут.Добавить("ВРаботе")
    Маршрут.Добавить("НаПроверке")
    Маршрут.Добавить("Выполнена")
    Для Каждого Статус Из Маршрут Цикл
        Об = СсылкаЗадачи.ПолучитьОбъект()
        Если Об.Статус = Статус Тогда
            Продолжить
        КонецЕсли
        Об.Статус = Статус
        Об.Провести()
        Если Статус = ЦелевойСтатус Тогда
            Возврат
        КонецЕсли
    КонецЦикла
КонецПроцедуры
