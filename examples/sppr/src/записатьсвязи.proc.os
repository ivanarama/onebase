// Обработка ICOM-связей целевого проекта. Тонкая обёртка: логика в модуле
// Наполнение, тест гоняет модуль тем же путём. Связи идемпотентны по паре
// измерений (потребитель, источник).
Процедура Выполнить()
    Список = "";

    Если Параметры <> Неопределено Тогда
        Список = СокрЛП(Строка(Параметры.Список));
    КонецЕсли;

    Если ПустаяСтрока(Список) Тогда
        ВызватьИсключение "Приложите список связей: «потребитель;источник;вид;данные~…».";
    КонецЕсли;

    Проект = Неопределено;
    Если Параметры <> Неопределено Тогда
        ИмяПроекта = СокрЛП(Строка(Параметры.ИмяПроекта));
        Если НЕ ПустаяСтрока(ИмяПроекта) Тогда
            Проект = Наполнение.НайтиИлиСоздатьПроект(ИмяПроекта);
        КонецЕсли;
    КонецЕсли;

    Наполнение.ЗаписатьСвязиПоСписку(Список, Проект);
    Сообщить("Связи функций записаны.");
КонецПроцедуры
