// Проведение «Публикация правила»: строка действующей версии правила на дату
// вступления. Срез последних даёт версию, активную на дату проверки, поэтому
// переиздание правила не меняет смысл уже зафиксированных результатов.
Процедура ОбработкаПроведения()
    Мен = РегистрыСведений.ДействующиеПравила.СоздатьМенеджерЗаписи();
    Мен.Период = this.Дата;
    Мен.Правило = this.Правило;
    Мен.Важность = this.Важность;
    Мен.Текст = this.Текст;
    Мен.Статус = this.Статус;
    Автор = ИмяПользователя();
    Если ЗначениеЗаполнено(Автор) = Ложь Тогда
        Автор = "system:ПубликацияПравила";
    КонецЕсли;
    Мен.Опубликовал = Автор;
    Мен.Основание = this.Основание;
    Мен.Записать();
КонецПроцедуры
