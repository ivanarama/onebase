// Демо-инициализация каркаса (срез A плана 218). Показывает, как агенты
// заполняют проектную базу: дерево функций, связи ICOM, объекты метаданных,
// трассировка, роль, сценарий, правило аудита и его публикация, задача,
// затраты времени. Идемпотентна: сущности ищутся по коду/имени.
Процедура ЗаполнитьКаркас(Проект)
    СсылкаПроект = НайтиИлиСоздатьПроект(Проект)
    СсылкаРазработчик = НайтиИлиСоздатьИсполнитель("Анна Разработчик", "anna@example.com", "Разработчик")
    СсылкаАналитик   = НайтиИлиСоздатьИсполнитель("Иван Аналитик", "ivan@example.com", "Проектировщик")

    // --- дерево функций: [1] Управление заявками → [1.1] Приём заявки ---
    Ф1 = Справочники.Функция.НайтиПоРеквизиту("Код", "1")
    Если ЗначениеЗаполнено(Ф1) = Ложь Тогда
        Пр = Справочники.Функция.Создать()
        Пр.Код = "1"
        Пр.Наименование = "Управление заявками"
        Пр.Описание = "Регистрирует заявки и держит их согласование"
        Пр.Тип = "Функция"
        Пр.Проект = СсылкаПроект
        Пр.Результат = "Заявка в системе"
        Пр.ОтображаетсяИнтерфейсе = Истина
        Пр.НаименованиеИнтерфейса = "Заявки"
        Пр.Ответственный = СсылкаАналитик
        Пр.Трудозатраты = 40
        Пр.Статус = "Черновик"
        Ф1 = Пр.Записать()
    КонецЕсли
    УтвердитьФункцию(Ф1)

    Ф2 = Справочники.Функция.НайтиПоРеквизиту("Код", "1.1")
    Если ЗначениеЗаполнено(Ф2) = Ложь Тогда
        Пр2 = Справочники.Функция.Создать()
        Пр2.Код = "1.1"
        Пр2.Наименование = "Приём заявки"
        Пр2.Описание = "Вносит данные клиента и состав заявки"
        Пр2.Тип = "Функция"
        Пр2.Проект = СсылкаПроект
        Пр2.Родитель = Ф1
        Пр2.Результат = "Заявка с заполненными данными"
        Пр2.ОтображаетсяИнтерфейсе = Истина
        Пр2.НаименованиеИнтерфейса = "Заявки"
        Пр2.Ответственный = СсылкаАналитик
        Пр2.Трудозатраты = 16
        Пр2.Статус = "Черновик"
        Ф2 = Пр2.Записать()
    КонецЕсли
    УтвердитьФункцию(Ф2)

    // --- механизмы самой проектной базы: [4] Проектная база СППР ---
    // Каркас проектирует и себя: узлы 4.x — механизмы модели, трассировки,
    // аудита, задач и прав. Мост вешает на них импортированные объекты
    // целевого проекта, rule аудита находит незакреплённые.
    Ф4 = СоздатьМеханизм("4", "Проектная база СППР", "Проектируемое решение описано данными", СсылкаПроект, "", СсылкаАналитик, 120)
    СоздатьМеханизм("4.1", "Функциональная модель и декомпозиция", "Дерево функций с результатами и стрелками IDEF0", СсылкаПроект, Ф4, СсылкаАналитик, 30)
    СоздатьМеханизм("4.2", "Трассировка и контроль объектов", "Объект целевого проекта закреплён за функцией и путём", СсылкаПроект, Ф4, СсылкаРазработчик, 25)
    СоздатьМеханизм("4.3", "Аудит формальных правил", "Нарушения правил фиксируются по датам", СсылкаПроект, Ф4, СсылкаРазработчик, 25)
    СоздатьМеханизм("4.4", "Задачи, очередь и учёт", "Задача идёт по маршруту статусов и получает исполнителя", СсылкаПроект, Ф4, СсылкаАналитик, 25)
    СоздатьМеханизм("4.5", "Ролевой контур каркаса", "Права ролей ограничивают запись в проектную базу", СсылкаПроект, Ф4, СсылкаРазработчик, 15)

    // Каркас закрывает свои механизмы подтверждениями: сценарий и задача
    // по каждому узлу. Механизмы каркаса реализованы движком платформы,
    // их подтверждает `onebase test` (src/тестыкаркаса.proc.os), поэтому
    // задачи закрыты, а сценарии описаны шагами проверки.
    СоздатьСценарий("Функциональная модель: дерево заводится и утверждается", Справочники.Функция.НайтиПоРеквизиту("Код", "4.1"), СсылкаПроект,
        "Функциональный тест 4.1: src/тестыкаркаса.proc.os",
        "Шаг 1;Создать функцию со статусом Черновик;Функция записана|Шаг 2;Попытаться утвердить функцию без согласования;Гейт этапов отклоняет перескок|Шаг 3;Провести Черновик → НаСогласовании → Утверждена;Отчёт «Дерево функций» показывает узел")
    СоздатьСценарий("Трассировка: объект закреплён за функцией и путём", Справочники.Функция.НайтиПоРеквизиту("Код", "4.2"), СсылкаПроект,
        "Функциональный тест 4.2: src/тестыкаркаса.proc.os",
        "Шаг 1;Импортировать описание целевого проекта;Объект заводится без функции|Шаг 2;Назначить объекту функцию и записать трассировку;Регистр «Трассировка» имеет строку с путём|Шаг 3;Открыть отчёт «Покрытие функций»;Счёт объектов считается различными ссылками")
    СоздатьСценарий("Аудит: правило находит объект без функции", Справочники.Функция.НайтиПоРеквизиту("Код", "4.3"), СсылкаПроект,
        "Функциональный тест 4.3: src/тестыкаркаса.proc.os",
        "Шаг 1;Опубликовать правило запросом без параметров;Публикация фиксирует текст запроса|Шаг 2;Прогнать аудит на дату;Регистр «Результаты проверки» пишет нарушение|Шаг 3;Повторить прогон;Срез последних даёт состояние на дату, история прогонов не переписывается")
    СоздатьСценарий("Задачи: маршрут статусов и очередь", Справочники.Функция.НайтиПоРеквизиту("Код", "4.4"), СсылкаПроект,
        "Функциональный тест 4.4: src/тестыкаркаса.proc.os",
        "Шаг 1;Завести задачу со статусом Новая;Задача стоит в очереди по позиции|Шаг 2;Провести Новую → НаПроверке;Гейт этапов отклоняет перескок|Шаг 3;Провести по маршруту до Выполнена;История статусов фиксирует каждый переход")
    СоздатьСценарий("Права: роль ограничивает запись", Справочники.Функция.НайтиПоРеквизиту("Код", "4.5"), СсылкаПроект,
        "Функциональный тест 4.5: src/тестыкаркаса.proc.os",
        "Шаг 1;Роли каркаса заведены;Права ролей объявлены в config|Шаг 2;Роль Разработчик пишет задачи;Право write разрешено|Шаг 3;Роль Тестировщик пишет результаты аудита;Чтение разрешено, запись правил запрещена")

    ЗакрытьМеханизм("4.1", "Каркас функциональной модели: справочники, отчёт дерева", СсылкаАналитик, 30, СсылкаПроект)
    ЗакрытьМеханизм("4.2", "Мост метаданных и трассировка", СсылкаРазработчик, 25, СсылкаПроект)
    ЗакрытьМеханизм("4.3", "Правила аудита и прогон по расписанию", СсылкаРазработчик, 25, СсылкаПроект)
    ЗакрытьМеханизм("4.4", "Задачи, очередь и учёт времени", СсылкаАналитик, 25, СсылкаПроект)
    ЗакрытьМеханизм("4.5", "Ролевой контур каркаса", СсылкаРазработчик, 15, СсылкаПроект)

    // Корневые узлы тоже закрываются: правило аудита считает и их.
    // Утверждённая функция без сценария и без задачи — проектный долг,
    // даже если её содержательные дети закрыты.
    СоздатьСценарий("Каркас заводится целиком", Справочники.Функция.НайтиПоРеквизиту("Код", "4"), СсылкаПроект,
        "Функциональный тест 4: src/тестыкаркаса.proc.os",
        "Шаг 1;Мигрировать пустую базу каркаса;Регистры и справочники доступны|Шаг 2;ЗаполнитьДемоданные;Дерево механизмов заводится с трассировкой|Шаг 3;Прогнать аудит;Правило находит объект без функции")
    ЗакрытьМеханизм("4", "Каркас проектной базы: модель, трассировка, аудит, задачи, права", СсылкаРазработчик, 120, СсылкаПроект)
    СоздатьСценарий("Заявка проходит приёмку", Справочники.Функция.НайтиПоРеквизиту("Код", "1"), СсылкаПроект,
        "Функциональный тест 1: демо каркаса",
        "Шаг 1;Завести заявку клиента;Заявка записана со статусом Новая|Шаг 2;Заявка принимает правила приёмки;Правило фиксируется публикацией")
    ЗакрытьМеханизм("1", "Демо каркаса: управление заявками", СсылкаАналитик, 40, СсылкаПроект)

    // --- связи ICOM: ресурс 1.1 — роль, вход 1.1 — заявка клиента (1.2),
    // выход 1.1 — данные заявки, управляющая стрелка — правила приёмки ---
    ЗаписатьСвязь(Ф2, Ф1, "Выход", "Заявка с данными")
    ЗаписатьСвязь(Ф1, Ф2, "Управление", "Правила приёмки")

    // --- объекты метаданных и трассировка ---
    О1 = Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", "Заявка")
    Если ЗначениеЗаполнено(О1) = Ложь Тогда
        Пр3 = Справочники.ОбъектМетаданных.Создать()
        Пр3.Имя = "Заявка"
        Пр3.Тип = "Документ"
        Пр3.ПутьФайла = "documents/Заявка.yaml"
        Пр3.Описание = "Документ заявки клиента"
        Пр3.Функция = Ф2
        Пр3.Проект = СсылкаПроект
        Пр3.Статус = "Утверждён"
        Пр3.Контроль = "Проверено"
        Пр3.Ответственный = СсылкаРазработчик
        Стр = Пр3.Реквизиты.Добавить()
        Стр.ИмяРеквизита = "Клиент"
        Стр.ТипРеквизита = "reference:Клиент"
        Стр.Обязательный = Истина
        Стр.Описание = "Кто обращался"
        Стр = Пр3.Реквизиты.Добавить()
        Стр.ИмяРеквизита = "Улица"
        Стр.ТипРеквизита = "string"
        Стр.Обязательный = Истина
        Стр.Описание = "Адрес для выезда"
        О1 = Пр3.Записать()
    КонецЕсли
    ЗаписатьТрассировку(Ф2, О1, "documents/Заявка.yaml", "HEAD")

    Р = Справочники.Роль.НайтиПоРеквизиту("Имя", "Оператор КЦ")
    Если ЗначениеЗаполнено(Р) = Ложь Тогда
        Пр4 = Справочники.Роль.Создать()
        Пр4.Имя = "Оператор КЦ"
        Пр4.ФайлРоли = "roles/ОператорКЦ.yaml"
        Пр4.Описание = "Принимает заявки"
        Пр4.Проект = СсылкаПроект
        Стр = Пр4.Функции.Добавить()
        Стр.Функция = Ф2
        Р = Пр4.Записать()
    КонецЕсли

    Сц = Справочники.Сценарий.НайтиПоРеквизиту("Наименование", "Приём заявки")
    Если ЗначениеЗаполнено(Сц) = Ложь Тогда
        Пр5 = Справочники.Сценарий.Создать()
        Пр5.Наименование = "Приём заявки"
        Пр5.Функция = Ф2
        Пр5.Вид = "Сценарий"
        Пр5.Текст = "Функциональный тест 1.1: приём заявки"
        Пр5.Актуален = Истина
        Пр5.Проект = СсылкаПроект
        Стр = Пр5.Шаги.Добавить()
        Стр.Шаг = "Шаг 1"
        Стр.Действие = "Создать заявку: Иванов, ул. Ленина 1"
        Стр.Ожидание = "Заявка записана, статус «Новая»"
        Стр = Пр5.Шаги.Добавить()
        Стр.Шаг = "Шаг 2"
        Стр.Действие = "Записать заявку без улицы"
        Стр.Ожидание = "Запись заблокирована правилом REQ-STREET"
        Сц = Пр5.Записать()
    КонецЕсли

    // --- правило аудита «функция без сценария» и его публикация ---
    ПР = Справочники.ПравилоПроверки.НайтиПоРеквизиту("Код", "AUD-FUNC-NOSCEN")
    Если ЗначениеЗаполнено(ПР) = Ложь Тогда
        Пр6 = Справочники.ПравилоПроверки.Создать()
        Пр6.Код = "AUD-FUNC-NOSCEN"
        Пр6.Наименование = "Функция без тестового сценария"
        Пр6.ОбъектПроверки = "Функция"
        Пр6.Важность = "Предупреждение"
        Пр6.ТекстЗапроса = "ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'Функция не подтверждена тестовым сценарием' КАК Информация ИЗ Справочник.Функция КАК Ф ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сценарий КАК С ПО С.Функция = Ф.Ссылка ГДЕ С.Ссылка ЕСТЬ ПУСТО И Ф.Статус = 'Утверждена'"
        Пр6.Активно = Истина
        Пр6.Предопределённое = Истина
        Пр6.Владелец = "Руководитель проекта"
        Пр6.Проект = СсылкаПроект
        ПР = Пр6.Записать()
    КонецЕсли

    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.ДействующиеПравила.СрезПоследних(&Д) КАК Д ГДЕ Д.Правило = &Правило"
    З.УстановитьПараметр("Д", Дата(2026, 1, 1))
    З.УстановитьПараметр("Правило", ПР)
    НПравил = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        НПравил = Стр.Н
    КонецЦикла
    Если НПравил = 0 Тогда
        Пуб = Документы.ПубликацияПравила.Создать()
        Пуб.Дата = Дата(2026, 1, 1)
        Пуб.Правило = ПР
        Пуб.Важность = "Предупреждение"
        Пуб.Текст = "Каждая утверждённая функция должна быть подтверждена тестовым сценарием"
        Пуб.Статус = "Опубликовано"
        Пуб.Основание = "Демо-инициализация каркаса СППР"
        Пуб.Провести()
    КонецЕсли

    // --- задача и учёт времени: маршрут статусов проходит по этапам ---
    З2 = Новый Запрос
    З2.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ Документ.Задача КАК З ГДЕ З.Заголовок = &Заголовок"
    З2.УстановитьПараметр("Заголовок", "Реализовать приём заявки (1.1)")
    НЗадач = 0
    Для Каждого Стр Из З2.Выполнить() Цикл
        НЗадач = Стр.Н
    КонецЦикла
    Если НЗадач = 0 Тогда
        Зад = Документы.Задача.Создать()
        Зад.Дата = ТекущаяДата()
        Зад.Заголовок = "Реализовать приём заявки (1.1)"
        Зад.Описание = "Записывает документы 1.1 и тест приёмки"
        Зад.Проект = СсылкаПроект
        Зад.Функция = Ф2
        Зад.Тип = "Разработка"
        Зад.Статус = "Новая"
        Зад.Приоритет = "Высокий"
        Зад.Исполнитель = СсылкаРазработчик
        Зад.Автор = "Планировщик"
        Зад.Срок = ТекущаяДата() + 86400 * 5
        Зад.Оценка = 16
        СсылкаЗадачи = Зад.Записать()
        // проведение пишет строку истории статусов (задача.posting.os)
        Зад.Провести()
        Зад2 = СсылкаЗадачи.ПолучитьОбъект()
        Зад2.Статус = "Принята"
        Зад2.Провести()

        К = Документы.Комментарий.Создать()
        К.Дата = ТекущаяДата()
        К.Задача = СсылкаЗадачи
        К.Автор = "Планировщик"
        К.Текст = "Задача заведена по функции 1.1, подтверждённой сценарием «Приём заявки»"
        К.Записать()

        Ур = Документы.УчётВремени.Создать()
        Ур.Дата = ТекущаяДата()
        Ур.Исполнитель = СсылкаРазработчик
        Ур.Проект = СсылкаПроект
        Ур.Задача = СсылкаЗадачи
        Ур.ВидДеятельности = ВидРазработки()
        Ур.Часы = 4
        Ур.Провести()

        Сообщить("Готово: каркас заполнен. Проверьте «Функции без объектов», «Результаты аудита» и «Где застряло».")
    КонецЕсли
КонецПроцедуры

Процедура Выполнить(Проект, ДатаКонец, Params)
    ЗаполнитьКаркас(Строка(Проект))
КонецПроцедуры

Процедура Выполнить()
    ЗаполнитьКаркас("Проектное управление")
КонецПроцедуры

// ── помощники ──────────────────────────────────────────────────────────────

Функция СоздатьСценарий(Наименование, СсылкаФункции, Проект, Текст, Шаги)
    Ссылка = Справочники.Сценарий.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Сценарий.Создать()
    Пр.Наименование = Наименование
    Пр.Функция = СсылкаФункции
    Пр.Вид = "Сценарий"
    Пр.Текст = Текст
    Пр.Актуален = Истина
    Пр.Проект = Проект
    Для Каждого Эл Из СтрРазделить(Шаги, "|") Цикл
        Части = Новый Массив
        Для Каждого Кусок Из СтрРазделить(СокрЛП(Эл), ";") Цикл
            Части.Добавить(Кусок)
        КонецЦикла
        Если Части.Количество() < 3 Тогда
            Продолжить
        КонецЕсли
        Стр = Пр.Шаги.Добавить()
        Стр.Шаг = Части.Получить(0)
        Стр.Действие = Части.Получить(1)
        Стр.Ожидание = Части.Получить(2)
    КонецЦикла
    Возврат Пр.Записать()
КонецФункции

Процедура ЗакрытьМеханизм(КодФункции, Заголовок, Исполнитель, Часы, Проект)
    СсылкаФункции = Справочники.Функция.НайтиПоРеквизиту("Код", КодФункции)
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка КАК Ссылка ИЗ Документ.Задача КАК З ГДЕ З.Функция = &Функция"
    З.УстановитьПараметр("Функция", СсылкаФункции)
    Для Каждого Стр Из З.Выполнить() Цикл
        Возврат
    КонецЦикла
    Зад = Документы.Задача.Создать()
    Зад.Дата = ТекущаяДата()
    Зад.Заголовок = Заголовок
    Зад.Описание = "Закрыто механизмом каркаса: подтверждено тестом src/тестыкаркаса.proc.os"
    Зад.Проект = Проект
    Зад.Функция = СсылкаФункции
    Зад.Тип = "Разработка"
    Зад.Статус = "Новая"
    Зад.Приоритет = "Высокий"
    Зад.Исполнитель = Исполнитель
    Зад.Автор = "Каркас"
    Зад.Оценка = Часы
    СсылкаЗадачи = Зад.Записать()
    Зад.Провести()
    Об = СсылкаЗадачи.ПолучитьОбъект()
    Об.Статус = "Принята"
    Об.Провести()
    Об = СсылкаЗадачи.ПолучитьОбъект()
    Об.Статус = "ВРаботе"
    Об.Провести()
    Об = СсылкаЗадачи.ПолучитьОбъект()
    Об.Статус = "НаПроверке"
    Об.Провести()
    Об = СсылкаЗадачи.ПолучитьОбъект()
    Об.Статус = "Выполнена"
    Об.Провести()
    Ур = Документы.УчётВремени.Создать()
    Ур.Дата = ТекущаяДата()
    Ур.Исполнитель = Исполнитель
    Ур.Проект = Проект
    Ур.Задача = СсылкаЗадачи
    Ур.ВидДеятельности = ВидРазработки()
    Ур.Часы = Часы
    Ур.Провести()
КонецПроцедуры

Функция СоздатьМеханизм(Код, Наименование, Результат, Проект, Родитель, Ответственный, Трудозатраты)
    Ссылка = Справочники.Функция.НайтиПоРеквизиту("Код", Код)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Функция.Создать()
    Пр.Код = Код
    Пр.Наименование = Наименование
    Пр.Описание = "Механизм проектной базы СППР"
    Пр.Тип = "Функция"
    Пр.Проект = Проект
    Пр.Родитель = Родитель
    Пр.Результат = Результат
    Пр.Ответственный = Ответственный
    Пр.Трудозатраты = Трудозатраты
    Пр.Статус = "Черновик"
    Ссылка = Пр.Записать()
    УтвердитьФункцию(Ссылка)
    Возврат Ссылка
КонецФункции

Функция НайтиИлиСоздатьПроект(Наименование)
    Ссылка = Справочники.Проект.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = Наименование
    Пр.Описание = "Каркас проектной базы СППР (план 218)"
    Пр.Статус = "Проектирование"
    Пр.ДатаНачала = ТекущаяДата()
    Возврат Пр.Записать()
КонецФункции

Функция НайтиИлиСоздатьИсполнитель(Наименование, Email, Роль)
    Ссылка = Справочники.Исполнитель.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Исполнитель.Создать()
    Пр.Наименование = Наименование
    Пр.Email = Email
    Пр.РольПроекта = Роль
    Возврат Пр.Записать()
КонецФункции

// Проводит функцию по маршруту Черновик → НаСогласовании → Утверждена:
// strict-гейт этапов не даёт «перепрыгнуть» через этап.
Процедура УтвердитьФункцию(Ссылка)
    Об = Ссылка.ПолучитьОбъект()
    Если ЗначениеЗаполнено(Об.Статус) = Ложь Тогда
        Об.Статус = "Черновик"
        Об.Записать()
        Об = Ссылка.ПолучитьОбъект()
    КонецЕсли
    Если Об.Статус = "Черновик" Тогда
        Об.Статус = "НаСогласовании"
        Об.Записать()
    КонецЕсли
    Об2 = Об.Ссылка.ПолучитьОбъект()
    Если Об2.Статус = "НаСогласовании" Тогда
        Об2.Статус = "Утверждена"
        Об2.Записать()
    КонецЕсли
КонецПроцедуры

// Справочник видов деятельности нужен для учёта времени; заводим его один раз.
Функция ВидРазработки()
    Ссылка = Справочники.ВидДеятельности.НайтиПоРеквизиту("Наименование", "Разработка")
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.ВидДеятельности.Создать()
    Пр.Наименование = "Разработка"
    Возврат Пр.Записать()
КонецФункции

Процедура ЗаписатьСвязь(Потребитель, Источник, Вид, Данные)
    Мен = РегистрыСведений.СвязиФункций.СоздатьМенеджерЗаписи()
    Мен.Потребитель = Потребитель
    Мен.Источник = Источник
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.Вид = Вид
    Мен.Данные = Данные
    Мен.Записать()
КонецПроцедуры

Процедура УтвердитьФункцию(Ссылка)
    // утверждение проходит по маршруту этапов: Черновик → НаСогласовании → Утверждена
    Об = Ссылка.ПолучитьОбъект()
    Если ЗначениеЗаполнено(Об.Статус) = Ложь Тогда
        Об.Статус = "Черновик"
        Об.Записать()
        Об = Ссылка.ПолучитьОбъект()
    КонецЕсли
    Если Об.Статус = "Черновик" Тогда
        Об.Статус = "НаСогласовании"
        Об.Записать()
    КонецЕсли
    Об2 = Ссылка.ПолучитьОбъект()
    Если Об2.Статус = "НаСогласовании" Тогда
        Об2.Статус = "Утверждена"
        Об2.Записать()
    КонецЕсли
КонецПроцедуры

Процедура ЗаписатьТрассировку(СсылкаФункции, СсылкаОбъекта, ПутьФайла, Коммит)
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи()
    Мен.Функция = СсылкаФункции
    Мен.Объект = СсылкаОбъекта
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.ПутьФайла = ПутьФайла
    Мен.Коммит = Коммит
    Мен.Записать()
КонецПроцедуры
