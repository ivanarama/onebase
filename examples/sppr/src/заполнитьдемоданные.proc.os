// Демо-инициализация каркаса (срез A плана 218). Показывает, как агенты
// заполняют проектную базу: дерево функций, связи ICOM, объекты метаданных,
// трассировка, роль, сценарий, правило аудита и его публикация, задача,
// затраты времени. Идемпотентна: сущности ищутся по коду/имени.
Процедура ЗаполнитьКаркас(Проект)
    СсылкаПроект = НайтиИлиСоздатьПроект(Проект)
    СсылкаРазработчик = НайтиИлиСоздатьИсполнитель("Анна Разработчик", "anna@example.com", "Разработчик")
    СсылкаАналитик   = НайтиИлиСоздатьИсполнитель("Иван Аналитик", "ivan@example.com", "Проектировщик")

    // --- дерево функций: [1] Управление заявками → [1.1] Приём заявки ---
    Ф1 = Справочники.Функция.НайтиПоРеквизиту("Код", "1")
    Если ЗначениеЗаполнено(Ф1) = Ложь Тогда
        Пр = Справочники.Функция.Создать()
        Пр.Код = "1"
        Пр.Наименование = "Управление заявками"
        Пр.Описание = "Регистрирует заявки и держит их согласование"
        Пр.Тип = "Функция"
        Пр.Проект = СсылкаПроект
        Пр.Результат = "Заявка в системе"
        Пр.ОтображаетсяИнтерфейсе = Истина
        Пр.НаименованиеИнтерфейса = "Заявки"
        Пр.Ответственный = СсылкаАналитик
        Пр.Трудозатраты = 40
        Пр.Статус = "Черновик"
        Ф1 = Пр.Записать()
    КонецЕсли
    УтвердитьФункцию(Ф1)

    Ф2 = Справочники.Функция.НайтиПоРеквизиту("Код", "1.1")
    Если ЗначениеЗаполнено(Ф2) = Ложь Тогда
        Пр2 = Справочники.Функция.Создать()
        Пр2.Код = "1.1"
        Пр2.Наименование = "Приём заявки"
        Пр2.Описание = "Вносит данные клиента и состав заявки"
        Пр2.Тип = "Функция"
        Пр2.Проект = СсылкаПроект
        Пр2.Родитель = Ф1
        Пр2.Результат = "Заявка с заполненными данными"
        Пр2.ОтображаетсяИнтерфейсе = Истина
        Пр2.НаименованиеИнтерфейса = "Заявки"
        Пр2.Ответственный = СсылкаАналитик
        Пр2.Трудозатраты = 16
        Пр2.Статус = "Черновик"
        Ф2 = Пр2.Записать()
    КонецЕсли
    УтвердитьФункцию(Ф2)

    // --- связи ICOM: ресурс 1.1 — роль, вход 1.1 — заявка клиента (1.2),
    // выход 1.1 — данные заявки, управляющая стрелка — правила приёмки ---
    ЗаписатьСвязь(Ф2, Ф1, "Выход", "Заявка с данными")
    ЗаписатьСвязь(Ф1, Ф2, "Управление", "Правила приёмки")

    // --- объекты метаданных и трассировка ---
    О1 = Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", "Заявка")
    Если ЗначениеЗаполнено(О1) = Ложь Тогда
        Пр3 = Справочники.ОбъектМетаданных.Создать()
        Пр3.Имя = "Заявка"
        Пр3.Тип = "Документ"
        Пр3.ПутьФайла = "documents/Заявка.yaml"
        Пр3.Описание = "Документ заявки клиента"
        Пр3.Функция = Ф2
        Пр3.Проект = СсылкаПроект
        Пр3.Статус = "Утверждён"
        Пр3.Контроль = "Проверено"
        Пр3.Ответственный = СсылкаРазработчик
        Стр = Пр3.Реквизиты.Добавить()
        Стр.ИмяРеквизита = "Клиент"
        Стр.ТипРеквизита = "reference:Клиент"
        Стр.Обязательный = Истина
        Стр.Описание = "Кто обращался"
        Стр = Пр3.Реквизиты.Добавить()
        Стр.ИмяРеквизита = "Улица"
        Стр.ТипРеквизита = "string"
        Стр.Обязательный = Истина
        Стр.Описание = "Адрес для выезда"
        О1 = Пр3.Записать()
    КонецЕсли
    ЗаписатьТрассировку(Ф2, О1, "documents/Заявка.yaml", "HEAD")

    Р = Справочники.Роль.НайтиПоРеквизиту("Имя", "Оператор КЦ")
    Если ЗначениеЗаполнено(Р) = Ложь Тогда
        Пр4 = Справочники.Роль.Создать()
        Пр4.Имя = "Оператор КЦ"
        Пр4.ФайлРоли = "roles/ОператорКЦ.yaml"
        Пр4.Описание = "Принимает заявки"
        Пр4.Проект = СсылкаПроект
        Стр = Пр4.Функции.Добавить()
        Стр.Функция = Ф2
        Р = Пр4.Записать()
    КонецЕсли

    Сц = Справочники.Сценарий.НайтиПоРеквизиту("Наименование", "Приём заявки")
    Если ЗначениеЗаполнено(Сц) = Ложь Тогда
        Пр5 = Справочники.Сценарий.Создать()
        Пр5.Наименование = "Приём заявки"
        Пр5.Функция = Ф2
        Пр5.Вид = "Сценарий"
        Пр5.Текст = "Функциональный тест 1.1: приём заявки"
        Пр5.Актуален = Истина
        Пр5.Проект = СсылкаПроект
        Стр = Пр5.Шаги.Добавить()
        Стр.Шаг = "Шаг 1"
        Стр.Действие = "Создать заявку: Иванов, ул. Ленина 1"
        Стр.Ожидание = "Заявка записана, статус «Новая»"
        Стр = Пр5.Шаги.Добавить()
        Стр.Шаг = "Шаг 2"
        Стр.Действие = "Записать заявку без улицы"
        Стр.Ожидание = "Запись заблокирована правилом REQ-STREET"
        Сц = Пр5.Записать()
    КонецЕсли

    // --- правило аудита «функция без сценария» и его публикация ---
    ПР = Справочники.ПравилоПроверки.НайтиПоРеквизиту("Код", "AUD-FUNC-NOSCEN")
    Если ЗначениеЗаполнено(ПР) = Ложь Тогда
        Пр6 = Справочники.ПравилоПроверки.Создать()
        Пр6.Код = "AUD-FUNC-NOSCEN"
        Пр6.Наименование = "Функция без тестового сценария"
        Пр6.ОбъектПроверки = "Функция"
        Пр6.Важность = "Предупреждение"
        Пр6.ТекстЗапроса = "ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'Функция не подтверждена тестовым сценарием' КАК Информация ИЗ Справочник.Функция КАК Ф ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сценарий КАК С ПО С.Функция = Ф.Ссылка ГДЕ С.Ссылка ЕСТЬ ПУСТО И Ф.Статус = 'Утверждена'"
        Пр6.Активно = Истина
        Пр6.Предопределённое = Истина
        Пр6.Владелец = "Руководитель проекта"
        Пр6.Проект = СсылкаПроект
        ПР = Пр6.Записать()
    КонецЕсли

    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.ДействующиеПравила.СрезПоследних(&Д) КАК Д ГДЕ Д.Правило = &Правило"
    З.УстановитьПараметр("Д", Дата(2026, 1, 1))
    З.УстановитьПараметр("Правило", ПР)
    НПравил = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        НПравил = Стр.Н
    КонецЦикла
    Если НПравил = 0 Тогда
        Пуб = Документы.ПубликацияПравила.Создать()
        Пуб.Дата = Дата(2026, 1, 1)
        Пуб.Правило = ПР
        Пуб.Важность = "Предупреждение"
        Пуб.Текст = "Каждая утверждённая функция должна быть подтверждена тестовым сценарием"
        Пуб.Статус = "Опубликовано"
        Пуб.Основание = "Демо-инициализация каркаса СППР"
        Пуб.Провести()
    КонецЕсли

    // --- задача и учёт времени: маршрут статусов проходит по этапам ---
    З2 = Новый Запрос
    З2.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ Документ.Задача КАК З ГДЕ З.Заголовок = &Заголовок"
    З2.УстановитьПараметр("Заголовок", "Реализовать приём заявки (1.1)")
    НЗадач = 0
    Для Каждого Стр Из З2.Выполнить() Цикл
        НЗадач = Стр.Н
    КонецЦикла
    Если НЗадач = 0 Тогда
        Зад = Документы.Задача.Создать()
        Зад.Дата = ТекущаяДата()
        Зад.Заголовок = "Реализовать приём заявки (1.1)"
        Зад.Описание = "Записывает документы 1.1 и тест приёмки"
        Зад.Проект = СсылкаПроект
        Зад.Функция = Ф2
        Зад.Тип = "Разработка"
        Зад.Статус = "Новая"
        Зад.Приоритет = "Высокий"
        Зад.Исполнитель = СсылкаРазработчик
        Зад.Автор = "Планировщик"
        Зад.Срок = ТекущаяДата() + 86400 * 5
        Зад.Оценка = 16
        СсылкаЗадачи = Зад.Записать()
        // проведение пишет строку истории статусов (задача.posting.os)
        Зад.Провести()
        Зад2 = СсылкаЗадачи.ПолучитьОбъект()
        Зад2.Статус = "Принята"
        Зад2.Провести()

        К = Документы.Комментарий.Создать()
        К.Дата = ТекущаяДата()
        К.Задача = СсылкаЗадачи
        К.Автор = "Планировщик"
        К.Текст = "Задача заведена по функции 1.1, подтверждённой сценарием «Приём заявки»"
        К.Записать()

        Ур = Документы.УчётВремени.Создать()
        Ур.Дата = ТекущаяДата()
        Ур.Исполнитель = СсылкаРазработчик
        Ур.Проект = СсылкаПроект
        Ур.Задача = СсылкаЗадачи
        Ур.ВидДеятельности = ВидРазработки()
        Ур.Часы = 4
        Ур.Провести()

        Сообщить("Готово: каркас заполнен. Проверьте «Функции без объектов», «Результаты аудита» и «Где застряло».")
    КонецЕсли
КонецПроцедуры

Процедура Выполнить(Проект, ДатаКонец, Params)
    ЗаполнитьКаркас(Строка(Проект))
КонецПроцедуры

Процедура Выполнить()
    ЗаполнитьКаркас("Проектное управление")
КонецПроцедуры

// ── помощники ──────────────────────────────────────────────────────────────

Функция НайтиИлиСоздатьПроект(Наименование)
    Ссылка = Справочники.Проект.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = Наименование
    Пр.Описание = "Каркас проектной базы СППР (план 218)"
    Пр.Статус = "Проектирование"
    Пр.ДатаНачала = ТекущаяДата()
    Возврат Пр.Записать()
КонецФункции

Функция НайтиИлиСоздатьИсполнитель(Наименование, Email, Роль)
    Ссылка = Справочники.Исполнитель.НайтиПоРеквизиту("Наименование", Наименование)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.Исполнитель.Создать()
    Пр.Наименование = Наименование
    Пр.Email = Email
    Пр.РольПроекта = Роль
    Возврат Пр.Записать()
КонецФункции

// Проводит функцию по маршруту Черновик → НаСогласовании → Утверждена:
// strict-гейт этапов не даёт «перепрыгнуть» через этап.
Процедура УтвердитьФункцию(Ссылка)
    Об = Ссылка.ПолучитьОбъект()
    Если ЗначениеЗаполнено(Об.Статус) = Ложь Тогда
        Об.Статус = "Черновик"
        Об.Записать()
        Об = Ссылка.ПолучитьОбъект()
    КонецЕсли
    Если Об.Статус = "Черновик" Тогда
        Об.Статус = "НаСогласовании"
        Об.Записать()
    КонецЕсли
    Об2 = Об.Ссылка.ПолучитьОбъект()
    Если Об2.Статус = "НаСогласовании" Тогда
        Об2.Статус = "Утверждена"
        Об2.Записать()
    КонецЕсли
КонецПроцедуры

// Справочник видов деятельности нужен для учёта времени; заводим его один раз.
Функция ВидРазработки()
    Ссылка = Справочники.ВидДеятельности.НайтиПоРеквизиту("Наименование", "Разработка")
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка
    КонецЕсли
    Пр = Справочники.ВидДеятельности.Создать()
    Пр.Наименование = "Разработка"
    Возврат Пр.Записать()
КонецФункции

Процедура ЗаписатьСвязь(Потребитель, Источник, Вид, Данные)
    Мен = РегистрыСведений.СвязиФункций.СоздатьМенеджерЗаписи()
    Мен.Потребитель = Потребитель
    Мен.Источник = Источник
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.Вид = Вид
    Мен.Данные = Данные
    Мен.Записать()
КонецПроцедуры

Процедура УтвердитьФункцию(Ссылка)
    // утверждение проходит по маршруту этапов: Черновик → НаСогласовании → Утверждена
    Об = Ссылка.ПолучитьОбъект()
    Если ЗначениеЗаполнено(Об.Статус) = Ложь Тогда
        Об.Статус = "Черновик"
        Об.Записать()
        Об = Ссылка.ПолучитьОбъект()
    КонецЕсли
    Если Об.Статус = "Черновик" Тогда
        Об.Статус = "НаСогласовании"
        Об.Записать()
    КонецЕсли
    Об2 = Ссылка.ПолучитьОбъект()
    Если Об2.Статус = "НаСогласовании" Тогда
        Об2.Статус = "Утверждена"
        Об2.Записать()
    КонецЕсли
КонецПроцедуры

Процедура ЗаписатьТрассировку(СсылкаФункции, СсылкаОбъекта, ПутьФайла, Коммит)
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи()
    Мен.Функция = СсылкаФункции
    Мен.Объект = СсылкаОбъекта
    Мен.Прочитать()
    Если Мен.Выбран() Тогда
        Возврат
    КонецЕсли
    Мен.ПутьФайла = ПутьФайла
    Мен.Коммит = Коммит
    Мен.Записать()
КонецПроцедуры
