// Наполнение проектной базы целевым проектом: дерево функций, закрепление
// объектов, ICOM-связи. Логика живёт здесь, обработки — тонкие оболочки с
// параметрами; тест каркаса гоняет модуль тем же путём, что обработка.
//
// Форматы параметров:
//   дерево файлом — JSON-массив узлов {"код","наименование","родитель","результат","трудозатраты"};
//   дерево списком — записи «код;наименование;родитель;результат;труд», разделитель записей «~»;
//   закрепление — записи «кодфункции=имя:тип;имя:тип», разделитель записей «|»;
//   связи — записи «потребитель;источник;вид;данные», разделитель записей «~».
// Функции заводятся статусом «Черновик»: утверждение — полномочие руководителя.

Функция НайтиИлиСоздатьПроект(Наименование)
    Ссылка = Справочники.Проект.НайтиПоРеквизиту("Наименование", СокрЛП(Наименование));
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Пр = Справочники.Проект.Создать();
    Пр.Наименование = СокрЛП(Наименование);
    Пр.Статус = "Проектирование";
    Пр.ДатаНачала = ТекущаяДата();
    Возврат Пр.Записать();
КонецФункции

Функция НайтиФункцияПоКодуВПроекте(Код, Проект)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Ссылка КАК Ссылка ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код И Ф.Проект = &Проект";
    З.УстановитьПараметр("Код", СокрЛП(Код));
    З.УстановитьПараметр("Проект", Проект);
    Ссылка = Неопределено;
    Для Каждого Стр Из З.Выполнить() Цикл
        Ссылка = Справочники.Функция.НайтиПоИдентификатору(Строка(Стр.Ссылка.УникальныйИдентификатор()));
    КонецЦикла;
    Возврат Ссылка;
КонецФункции

Функция НайтиФункцияПоКоду(Код)
    Возврат Справочники.Функция.НайтиПоРеквизиту("Код", СокрЛП(Код));
КонецФункции

Процедура ЗавестиДеревоИзJSON(ТекстJSON, Проект)
    Узлы = ПрочитатьJSON(ТекстJSON);
    Для Каждого Узел Из Узлы Цикл
        ЗавестиУзел(СокрЛП(Узел.Получить("код")), СокрЛП(Узел.Получить("наименование")),
            СокрЛП(Узел.Получить("родитель")), СокрЛП(Узел.Получить("результат")),
            Узел.Получить("трудозатраты"), Проект);
    КонецЦикла;
КонецПроцедуры

Процедура ЗавестиДеревоИзСписка(СтрокаСписка, Проект)
    Для Каждого Эл Из СтрРазделить(СтрокаСписка, "~") Цикл
        Поля = СтрРазделить(СокрЛП(Эл), ";");
        Если Поля.Количество() < 2 Тогда
            Продолжить
        КонецЕсли
        Труд = Неопределено;
        Если Поля.Количество() > 4 Тогда
            Труд = Поля[4];
        КонецЕсли
        Родитель = "";
        Если Поля.Количество() > 2 Тогда
            Родитель = СокрЛП(Поля[2]);
        КонецЕсли
        Результат = "";
        Если Поля.Количество() > 3 Тогда
            Результат = СокрЛП(Поля[3]);
        КонецЕсли
        ЗавестиУзел(СокрЛП(Поля[0]), СокрЛП(Поля[1]), Родитель, Результат, Труд, Проект);
    КонецЦикла;
КонецПроцедуры

Процедура ЗавестиУзел(Код, Наименование, Родитель, Результат, Труд, Проект)
    Если ПустаяСтрока(Код) Тогда
        Продолжить
    КонецЕсли
    Если Проект <> Неопределено Тогда
        Если ЗначениеЗаполнено(НайтиФункцияПоКодуВПроекте(Код, Проект)) Тогда
            Продолжить
        КонецЕсли
    Иначе
        Если ЗначениеЗаполнено(НайтиФункцияПоКоду(Код)) Тогда
            Продолжить
        КонецЕсли
    КонецЕсли
    Об = Справочники.Функция.Создать();
    Об.Код = Код;
    Об.Наименование = Наименование;
    Если НЕ ПустаяСтрока(Родитель) Тогда
        СсылкаРодителя = Неопределено;
        Если Проект <> Неопределено Тогда
            СсылкаРодителя = НайтиФункцияПоКодуВПроекте(Родитель, Проект);
        КонецЕсли
        Если СсылкаРодителя = Неопределено Тогда
            СсылкаРодителя = НайтиФункцияПоКоду(Родитель);
        КонецЕсли
        Если ЗначениеЗаполнено(СсылкаРодителя) Тогда
            Об.Родитель = СсылкаРодителя;
        КонецЕсли;
    КонецЕсли;
    Об.Результат = Результат;
    Если Труд <> Неопределено Тогда
        Об.Трудозатраты = Число(Труд);
    КонецЕсли;
    Если Проект <> Неопределено Тогда
        Об.Проект = Проект;
    КонецЕсли;
    Об.Статус = "Черновик";
    Об.Записать();
КонецПроцедуры

Процедура РасставитьПоСписку(СтрокаПар)
    Для Каждого Эл Из СтрРазделить(СтрокаПар, "|") Цикл
        Тек = СокрЛП(Эл);
        Позиция = СтрНайти(Тек, "=");
        Если Позиция = 0 Тогда
            Продолжить
        КонецЕсли
        Код = Лев(Тек, Позиция - 1);
        СписокОбъектов = Сред(Тек, Позиция + 1, СтрДлина(Тек) - Позиция);
        СсылкаФункции = НайтиФункцияПоКоду(СокрЛП(Код));
        Если НЕ ЗначениеЗаполнено(СсылкаФункции) Тогда
            Сообщить("Пропущено: функция " + СокрЛП(Код) + " нет в базе");
            Продолжить
        КонецЕсли
        Назначить(СписокОбъектов, СсылкаФункции);
    КонецЦикла;
КонецПроцедуры

Процедура Назначить(Список, СсылкаФункции)
    Для Каждого Эл Из СтрРазделить(Список, ";") Цикл
        Тек = СокрЛП(Эл);
        Позиция = СтрНайти(Тек, ":");
        Если Позиция = 0 Тогда
            Продолжить
        КонецЕсли
        ИмяОбъекта = Лев(Тек, Позиция - 1);
        ТипОбъекта = Сред(Тек, Позиция + 1, СтрДлина(Тек) - Позиция);
        СсылкаОбъекта = НайтиОбъектПоИмениИТипу(ИмяОбъекта, ТипОбъекта);
        Если ЗначениеЗаполнено(СсылкаОбъекта) = Ложь Тогда
            Сообщить("Пропущено: " + ИмяОбъекта + " (" + ТипОбъекта + ") нет в импорте");
            Продолжить
        КонецЕсли
        Об = СсылкаОбъекта.ПолучитьОбъект();
        Об.Функция = СсылкаФункции;
        Об.Контроль = "Проверено";
        Об.Записать();
        ЗаписатьТрассировку(СсылкаФункции, СсылкаОбъекта, Об.ПутьФайла);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьТрассировку(СсылкаФункции, СсылкаОбъекта, Путь)
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи();
    Мен.Функция = СсылкаФункции;
    Мен.Объект = СсылкаОбъекта;
    Мен.Прочитать();
    Если Мен.Выбран() = Ложь Тогда
        Мен.ПутьФайла = Путь;
        Мен.Коммит = "assign";
        Мен.Записать();
    КонецЕсли;
КонецПроцедуры

Функция НайтиОбъектПоИмениИТипу(Имя, Тип)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя И О.Тип = &Тип";
    З.УстановитьПараметр("Имя", Имя);
    З.УстановитьПараметр("Тип", Тип);
    Ссылка = Неопределено;
    Для Каждого Стр Из З.Выполнить() Цикл
        Ссылка = Справочники.ОбъектМетаданных.НайтиПоИдентификатору(Строка(Стр.Ссылка.УникальныйИдентификатор()));
    КонецЦикла;
    Возврат Ссылка;
КонецФункции

Процедура ЗаписатьСвязиПоСписку(ТекстСписка, Проект = Неопределено)
    Для Каждого Эл Из СтрРазделить(ТекстСписка, "~") Цикл
        Поля = СтрРазделить(СокрЛП(Эл), ";");
        Если Поля.Количество() < 3 Тогда
            Продолжить
        КонецЕсли
        Если ЗначениеЗаполнено(Проект) Тогда
            СсылкаПотребителя = НайтиФункцияПоКодуВПроекте(СокрЛП(Поля[0]), Проект);
            СсылкаИсточника = НайтиФункцияПоКодуВПроекте(СокрЛП(Поля[1]), Проект);
        Иначе
            СсылкаПотребителя = НайтиФункцияПоКоду(СокрЛП(Поля[0]));
            СсылкаИсточника = НайтиФункцияПоКоду(СокрЛП(Поля[1]));
        КонецЕсли
        Если НЕ ЗначениеЗаполнено(СсылкаПотребителя) Тогда
            Сообщить("Пропущено: потребитель " + СокрЛП(Поля[0]) + " нет в базе");
            Продолжить
        КонецЕсли
        Если НЕ ЗначениеЗаполнено(СсылкаИсточника) Тогда
            Сообщить("Пропущено: источник " + СокрЛП(Поля[1]) + " нет в базе");
            Продолжить
        КонецЕсли
        Мен = РегистрыСведений.СвязиФункций.СоздатьМенеджерЗаписи();
        Мен.Потребитель = СсылкаПотребителя;
        Мен.Источник = СсылкаИсточника;
        Мен.Прочитать();
        Если Мен.Выбран() Тогда
            Продолжить
        КонецЕсли
        Мен.Вид = СокрЛП(Поля[2]);
        Если Поля.Количество() > 3 Тогда
            Мен.Данные = СокрЛП(Поля[3]);
        КонецЕсли;
        Мен.Записать();
    КонецЦикла;
КонецПроцедуры
