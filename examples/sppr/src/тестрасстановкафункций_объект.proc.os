// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/расстановка_функций.feature.
// Функция: Расстановка функций целевого проекта
// Сценарий: объект закрепляется за узлом и попадает в трассировку
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «2.1»
//   Дано заведён объект метаданных «internal/registry» типа «GoПакет»
//   Когда объект «internal/registry» закреплён за функцией с кодом «2.1»
//   То функция объекта «internal/registry» имеет код «2.1»
//   И трассировка содержит запись функции «2.1» для объекта «internal/registry»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «2.1»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "2.1"
    Ф.Наименование = "функция " + "2.1"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Дано заведён объект метаданных «internal/registry» типа «GoПакет»
    Об = Справочники.ОбъектМетаданных.Создать()
    Об.Имя = "internal/registry"
    Об.Тип = "GoПакет"
    Об.Проект = ПроектСсылка
    Об.Контроль = "НеПроверено"
    ОбъектСсылка = Об.Записать()
    // Когда объект «internal/registry» закреплён за функцией с кодом «2.1»
    ФункцияСсылка = Справочники.Функция.НайтиПоРеквизиту("Код", "2.1")
    ОбъектСсылка = Справочники.ОбъектМетаданных.НайтиПоРеквизиту("Имя", "internal/registry")
    Об = ОбъектСсылка.ПолучитьОбъект()
    Об.Функция = ФункцияСсылка
    Об.Записать()
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи()
    Мен.Функция = ФункцияСсылка
    Мен.Объект = ОбъектСсылка
    Мен.ПутьФайла = "internal/registry"
    Мен.Записать()
    // То функция объекта «internal/registry» имеет код «2.1»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Функция.Код КАК Код ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = 'internal/registry'"
    КодОбъекта = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодОбъекта = Стр.Код
    КонецЦикла
    Утверждать.Равно(КодОбъекта, "2.1", "функция объекта «internal/registry» имеет код «2.1»")
    // И трассировка содержит запись функции «2.1» для объекта «internal/registry»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.Трассировка.СрезПоследних(&Д) КАК Т ГДЕ Т.Функция.Код = '2.1' И Т.Объект.Имя = 'internal/registry'"
    З.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Истина(Н > 0, "трассировка содержит запись функции «2.1» для объекта «internal/registry»")
КонецПроцедуры
