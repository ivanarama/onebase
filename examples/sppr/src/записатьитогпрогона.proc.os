// Обработка итога прогона целевой проверки. Тонкая обёртка: логика в модуле
// Аудит, тест каркаса гоняет модуль тем же путём, что обработка.
Процедура Выполнить()
    ИмяПроекта = "";
    НаДату = ТекущаяДата();

    Если Параметры <> Неопределено Тогда
        ИмяПроекта = СокрЛП(Строка(Параметры.ИмяПроекта));
        Если Параметры.НаДату <> Неопределено Тогда
            НаДату = Дата(Параметры.НаДату);
        КонецЕсли;
    КонецЕсли;

    Если ПустаяСтрока(ИмяПроекта) Тогда
        ВызватьИсключение "Приложите имя целевого проекта: «ИмяПроекта».";
    КонецЕсли;

    Проект = Наполнение.НайтиИлиСоздатьПроект(ИмяПроекта);
    N = Аудит.ЗаписатьИтогПрогона(Проект, НаДату);
    Сообщить("Итог прогона «" + ИмяПроекта + "» на " + Формат(НаДату, "ДФ=dd.MM.yyyy") + ": нарушений " + Строка(N));
КонецПроцедуры
