// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/аудит_правил.feature.
// Функция: Аудит формальных правил
// Сценарий: правило стороны «База» находит нарушение аудитом базы
// Шаг-таблица:
//   Дано заведён проект «Каркас-аудит»
//   Дано заведена функция с кодом «9.9»
//   Дано заведено правило аудита «А-90» стороны «База» с запросом «ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'проверка стороны' КАК Информация ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = '9.9'»
//   Когда правило «А-90» опубликовано с важностью «Информация»
//   Когда проведён аудит базы
//   То результатов правила «А-90» 1 строк

Процедура Выполнить()
    // Дано заведён проект «Каркас-аудит»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Каркас-аудит"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «9.9»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "9.9"
    Ф.Наименование = "функция " + "9.9"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Дано заведено правило аудита «А-90» стороны «База» с запросом «ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'проверка стороны' КАК Информация ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = '9.9'»
    Пр = Справочники.ПравилоПроверки.Создать()
    Пр.Код = "А-90"
    Пр.Наименование = "правило " + "А-90"
    Пр.СторонаПроверки = "База"
    Пр.ТекстЗапроса = "ВЫБРАТЬ 'Функция' КАК ТипОбъект, Ф.Код КАК Объект, 'проверка стороны' КАК Информация ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = '9.9'"
    Пр.Активно = Истина
    ПравилоСсылка = Пр.Записать()
    // Когда правило «А-90» опубликовано с важностью «Информация»
    Док = Документы.ПубликацияПравила.Создать()
    Док.Дата = ТекущаяДата()
    Док.Правило = ПравилоСсылка
    Док.Важность = "Информация"
    Док.Текст = "публикация " + "А-90"
    Док.Статус = "Опубликовано"
    Док.Записать()
    Док.Провести()
    // Когда проведён аудит базы
    Аудит.ПрименитьПравила(ТекущаяДата())
    // То результатов правила «А-90» 1 строк
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.РезультатыПроверки.СрезПоследних(&Д) КАК Р ГДЕ Р.Правило.Код = &Код"
    З.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    З.УстановитьПараметр("Код", "А-90")
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Равно(Н, 1, "результатов правила «А-90» 1 строк")
КонецПроцедуры
