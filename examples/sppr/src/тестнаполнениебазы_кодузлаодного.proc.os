// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: код узла одного проекта не перекрывает узел другого
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «7»
//   Когда по списку узлов «7;Знание;;словарь;2» заведено дерево для проекта «Другой проект»
//   То функция с кодом «7» проекта «Другой проект» имеет статус «Черновик»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «7»
    Ф = Справочники.Функция.Создать()
    Ф.Код = 7
    Ф.Наименование = "функция " + 7
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Когда по списку узлов «7;Знание;;словарь;2» заведено дерево для проекта «Другой проект»
    Наполнение.ЗавестиДеревоИзСписка("7;Знание;;словарь;2", Наполнение.НайтиИлиСоздатьПроект("Другой проект"))
    // То функция с кодом «7» проекта «Другой проект» имеет статус «Черновик»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ф.Статус КАК Статус ИЗ Справочник.Функция КАК Ф ГДЕ Ф.Код = &Код И Ф.Проект.Наименование = &Проект"
    З.УстановитьПараметр("Код", 7)
    З.УстановитьПараметр("Проект", "Другой проект")
    СтатусВПроекте = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        СтатусВПроекте = Стр.Статус
    КонецЦикла
    Утверждать.Равно(СтатусВПроекте, "Черновик", "функция с кодом «7» проекта «Другой проект» имеет статус «Черновик»")
КонецПроцедуры
