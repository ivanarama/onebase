// Проведение «Учёт времени»: пишет строку затрат в регистр.
// Ключ строки — (Исполнитель, Проект, Задача, Вид деятельности, Период),
// поэтому повторное проведение того же дня перезаписывает строку (это
// перепроведение того же документа), а суммирование по нескольким документам
// одного дня — бизнес-решение целевой конфигурации.
Процедура ОбработкаПроведения()
    Мен = РегистрыСведений.ЗатратыВремени.СоздатьМенеджерЗаписи();
    Мен.Период = this.Дата;
    Мен.Исполнитель = this.Исполнитель;
    Мен.Проект = this.Проект;
    Мен.Задача = this.Задача;
    Мен.ВидДеятельности = this.ВидДеятельности;
    Мен.Часы = this.Часы;
    Мен.Записать();
КонецПроцедуры
