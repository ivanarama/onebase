// Мост метаданных (функция 2.1, план 218). Описание целевого проекта,
// выданное `onebase describe --project .`, превращается в справочник
// «Объекты метаданных», табличную часть «Реквизиты» и регистр «Трассировка».
//
// Модуль вызывается из обработки ИмпортОписания (файловый параметр) и из
// тестов каркаса (описание в тексте). Разделение нужно, чтобы тест гонял тот
// же путь, что и импорт из файла, а не приватную функцию.
//
//   onebase describe --project <целевой> > desc.json
//   onebase procrun --project examples/sppr --sqlite <файл> --proc ИмпортОписания \
//       --file Файл=desc.json --set Проект=<id> [--set КорневаяФункция=<id>]
//
// Функцию-владельца импорт не назначает: закрепление объекта за декомпозицией
// — решение проектировщика. Параметр КорневаяФункция пишет трассировку как
// временного владельца, чтобы импорт можно было проверить трассировкой сразу.
Перем ВсегоНовых;
Перем ВсегоОбновлённых;

Функция ПрименитьОписание(Текст, Проект, КорневаяФункция) Экспорт
    // Текст — путь обработки: файл описания приходит строкой и разбирается здесь.
    Текст = СокрЛП(Строка(Текст));
    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Описание пустое";
    КонецЕсли;
    Возврат ПрименитьДанные(ПрочитатьJSON(Текст), Проект, КорневаяФункция);
КонецФункции

Функция ПрименитьДанные(Д, Проект, КорневаяФункция) Экспорт
    // Разобранное описание — путь теста: тест собирает описание как данные и
    // зовёт тот же код, что и обработка, без файловых операций (песочница).
    ВсегоНовых = 0;
    ВсегоОбновлённых = 0;
    Если Д = Неопределено Тогда
        ВызватьИсключение "Описание пустое или не разобрано";
    КонецЕсли;
    Если Д.Получить("schemaVersion") = Неопределено Тогда
        ВызватьИсключение "В описании нет schemaVersion — описание неполное или чужое";
    КонецЕсли;

    ОбработатьРаздел(Д, "catalogs", "Справочник", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "documents", "Документ", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "registers", "РегистрНакопления", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "infoRegisters", "РегистрСведений", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "enums", "Перечисление", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "constants", "Константа", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "reports", "Отчёт", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "processors", "Обработка", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "subsystems", "Подсистема", Проект, КорневаяФункция);
    // У виджета нет файла-источника (он собирается из запроса), поэтому путь
    // останется пустым — аудит не требует пути, только функцию.
    ОбработатьРаздел(Д, "widgets", "Виджет", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "roles", "Роль", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "scheduledJobs", "РегламентноеЗадание", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "journals", "Журнал", Проект, КорневаяФункция);
    ОбработатьРаздел(Д, "modules", "Модуль", Проект, КорневаяФункция);

    Возврат ВсегоНовых;
КонецФункции

Функция ВсегоОбъектов(Д) Экспорт
    // Число объектов в описании — нужно отчётам и тестам, чтобы не считать
    // разделы вручную.
    Н = 0;
    Для Каждого КлючИЗначение Из Д Цикл
        Если ТипЗнч(КлючИЗначение.Значение) = "Массив" Тогда
            Для Каждого Эл Из КлючИЗначение.Значение Цикл
                Н = Н + 1;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Возврат Н;
КонецФункции

// ── helpers ────────────────────────────────────────────────────────────────

Процедура ОбработатьРаздел(Д, Ключ, Вид, Проект, Корневая)
    Раздел = Д.Получить(Ключ);
    Если Раздел = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Для Каждого Эл Из Раздел Цикл
        Имя = СокрЛП(Строка(Эл.Получить("name")));
        Если ПустаяСтрока(Имя) Тогда
            Продолжить;
        КонецЕсли;
        Путь = "";
        Источник = Эл.Получить("source");
        Если Источник <> Неопределено Тогда
            Путь = СокрЛП(Строка(Источник.Получить("file")));
        КонецЕсли;
        Заголовок = СокрЛП(Строка(Эл.Получить("title")));
        Если Вид = "Виджет" Тогда
            // Тип виджета (kpi/list/chart/actions) — часть описания: он задаёт
            // форму объекта, без него объект описан только именем.
            Заголовок = Заголовок + " [" + СокрЛП(Строка(Эл.Получить("type"))) + "]"
        КонецЕсли
        Ссылка = СоздатьОбъект(Имя, Вид, Путь, Заголовок, Проект);
        Если Ссылка = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ЗаполнитьРеквизиты(Ссылка, Эл);
        ЗаполнитьПроцедуры(Ссылка, Эл);
        ЗаписатьТрассировкуИмпорта(Корневая, Ссылка, Путь);
    КонецЦикла;
КонецПроцедуры

// Создание объекта по имени и типу. Повторный импорт существующего объекта
// ничего не меняет: запись считается уже сделанной проектировщиком, и
// назначенная им функция не перетирается.
Функция СоздатьОбъект(Имя, Вид, Путь, Заголовок, Проект)
    // Совпадение ищется по имени и типу: регламентное задание и обработка
    // называются одинаково, и по одному имени они сливаются в один объект.
    Ссылка = Неопределено;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка ИЗ Справочник.ОбъектМетаданных КАК О ГДЕ О.Имя = &Имя И О.Тип = &Тип";
    З.УстановитьПараметр("Имя", Имя);
    З.УстановитьПараметр("Тип", Вид);
    Для Каждого Стр Из З.Выполнить() Цикл
        // Ссылка из результата запроса не привязана к менеджеру объекта:
        // для правки нужен переход по идентификатору.
        Ссылка = Справочники.ОбъектМетаданных.НайтиПоИдентификатору(Строка(Стр.Ссылка.УникальныйИдентификатор()));
    КонецЦикла;
    Если ЗначениеЗаполнено(Ссылка) Тогда
        ВсегоОбновлённых = ВсегоОбновлённых + 1;
        Возврат Ссылка;
    КонецЕсли;
    Пр = Справочники.ОбъектМетаданных.Создать();
    Пр.Имя = Имя;
    Пр.Тип = Вид;
    Пр.ПутьФайла = Путь;
    Пр.Описание = Заголовок;
    Пр.Проект = Проект;
    Пр.Статус = "Черновик";
    Пр.Контроль = "НеПроверено";
    ВсегоНовых = ВсегоНовых + 1;
    Возврат Пр.Записать();
КонецФункции

// Состав полей целевой конфигурации пишется в табличную часть: объект
// описывает себя не только именем, но и реквизитами, по ним агент видит
// сужение типов и переименования.
Процедура ЗаполнитьРеквизиты(Ссылка, Эл)
    Поля = Эл.Получить("fields");
    Если Поля = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Об = Ссылка.ПолучитьОбъект();
    Есть = Новый Соответствие;
    Для Каждого Стр Из Об.Реквизиты Цикл
        Есть.Вставить(Стр.ИмяРеквизита, Истина);
    КонецЦикла;
    Добавлено = Ложь;
    Для Каждого Поле Из Поля Цикл
        ИмяРеквизита = СокрЛП(Строка(Поле.Получить("name")));
        Если ПустаяСтрока(ИмяРеквизита) Тогда
            Продолжить;
        КонецЕсли;
        Если Есть.Получить(ИмяРеквизита) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Стр = Об.Реквизиты.Добавить();
        Стр.ИмяРеквизита = ИмяРеквизита;
        Стр.ТипРеквизита = СокрЛП(Строка(Поле.Получить("type")));
        Стр.Обязательный = Ложь;
        Есть.Вставить(ИмяРеквизита, Истина);
        Добавлено = Истина;
    КонецЦикла;
    Если Добавлено Тогда
        Об.Записать();
    КонецЕсли;
КонецПроцедуры

// Имена процедур модуля пишутся в ту же табличную часть: контракт модуля
// (какие процедуры видны извне) важнее для агента, чем форматирование кода.
Процедура ЗаполнитьПроцедуры(Ссылка, Эл)
    Проц = Эл.Получить("procedures");
    Если Проц = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Об = Ссылка.ПолучитьОбъект();
    Есть = Новый Соответствие;
    Для Каждого Стр Из Об.Реквизиты Цикл
        Есть.Вставить(Стр.ИмяРеквизита, Истина);
    КонецЦикла;
    Добавлено = Ложь;
    Для Каждого Пр Из Проц Цикл
        ИмяПр = СокрЛП(Строка(Пр.Получить("name")));
        Если ПустаяСтрока(ИмяПр) Тогда
            Продолжить;
        КонецЕсли;
        Если Есть.Получить(ИмяПр) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        // Список параметров — подпись процедуры: без него агент видит имя и
        // не может вызвать процедуру по контракту.
        Подпись = "";
        ПараметрыПр = Пр.Получить("params");
        Если ПараметрыПр <> Неопределено Тогда
            Для Каждого П Из ПараметрыПр Цикл
                Если ПустаяСтрока(Подпись) = Ложь Тогда
                    Подпись = Подпись + ", ";
                КонецЕсли;
                Подпись = Подпись + СокрЛП(Строка(П));
            КонецЦикла;
        КонецЕсли;
        Стр = Об.Реквизиты.Добавить();
        Стр.ИмяРеквизита = ИмяПр;
        Стр.ТипРеквизита = "(" + Подпись + ")";
        Стр.Обязательный = Ложь;
        Стр.Описание = "процедура модуля";
        Есть.Вставить(ИмяПр, Истина);
        Добавлено = Истина;
    КонецЦикла;
    Если Добавлено Тогда
        Об.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьТрассировкуИмпорта(Корневая, СсылкаОбъекта, Путь)
    Если ЗначениеЗаполнено(Корневая) = Ложь Тогда
        Возврат;
    КонецЕсли;
    Мен = РегистрыСведений.Трассировка.СоздатьМенеджерЗаписи();
    Мен.Функция = Корневая;
    Мен.Объект = СсылкаОбъекта;
    Мен.Прочитать();
    Если Мен.Выбран() Тогда
        Возврат;
    КонецЕсли;
    Мен.ПутьФайла = Путь;
    Мен.Коммит = "describe";
    Мен.Записать();
КонецПроцедуры
