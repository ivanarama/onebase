// Текст графа IDEF0 (mermaid) по регистру связей. Отрисовку делает внешний
// рендер (dot/mermaid), платформа отдаёт агенту граф как данные — это срез A,
// отрисовка в интерфейсе описана в плане 218 (срез D).
Процедура ПостроитьГраф(КорневаяФункция)
    Запрос = Новый Запрос
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ " +
        "П.Код КАК КодП, П.Наименование КАК НазП, " +
        "Ист.Код КАК КодИ, Ист.Наименование КАК НазИ, " +
        "С.Вид КАК Вид, С.Данные КАК Данные " +
        "ИЗ РегистрСведений.СвязиФункций КАК С " +
        "ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Функция КАК П ПО С.Потребитель = П.Ссылка " +
        "ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Функция КАК Ист ПО С.Источник = Ист.Ссылка " +
        "ГДЕ (&КорневаяФункция ЕСТЬ ПУСТО ИЛИ С.Потребитель = &КорневаяФункция ИЛИ С.Источник = &КорневаяФункция) " +
        "УПОРЯДОЧИТЬ ПО П.Код, Ист.Код"
    Запрос.УстановитьПараметр("КорневаяФункция", КорневаяФункция)

    Текст = "graph TD"
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        УзелП = СтрЗаменить(Стр.КодП, ".", "_")
        УзелИ = СтрЗаменить(Стр.КодИ, ".", "_")
        Текст = Текст + Символы.ПС + "  F" + УзелП + "[" + Стр.КодП + " " + Стр.НазП + "] -->|" + Стр.Вид + " " + Стр.Данные + "| F" + УзелИ + "[" + Стр.КодИ + " " + Стр.НазИ + "]"
    КонецЦикла
    Сообщить(Текст)
КонецПроцедуры

Процедура Выполнить(КорневаяФункция, ДатаКонец, Params)
    ПостроитьГраф(КорневаяФункция)
КонецПроцедуры

Процедура Выполнить()
    ПостроитьГраф(Неопределено)
КонецПроцедуры
