// Расстановка функций по импортированному описанию (шаг проектировщика после
// моста). Мост создаёт объекты без функции; закрепление объекта за узлом
// декомпозиции — проектное решение, его заводит проектировщик под ролью
// Проектировщик. Объект помечается «Проверено» и получает трассировку.
//
// Порядок наполнения проектной базы:
//   ЗаполнитьДемоданные -> дерево механизмов базы (узлы 4.x)
//   ИмпортОписания --file desc.json --set Проект=... --set КорневаяФункция=...
//   ЗавестиДеревоФункций --file дерево.json --set Проект=...
//   РасставитьФункции --set Пары="код=имя:тип|..."
//   АудитПравил
//
// Без параметра «Пары» зашитые пары узлов каркаса (список задаётся парами
// «имя:тип»: объект одного типа может носить имя объекта другого).
Процедура Выполнить()
    Пары = "";
    ИмяПроекта = "";
    Если Параметры <> Неопределено Тогда
        Пары = СокрЛП(Строка(Параметры.Пары));
        ИмяПроекта = СокрЛП(Строка(Параметры.ИмяПроекта));
    КонецЕсли;

    Если ПустаяСтрока(Пары) Тогда
        Ф41 = Справочники.Функция.НайтиПоРеквизиту("Код", "4.1")
        Ф42 = Справочники.Функция.НайтиПоРеквизиту("Код", "4.2")
        Ф43 = Справочники.Функция.НайтиПоРеквизиту("Код", "4.3")
        Ф44 = Справочники.Функция.НайтиПоРеквизиту("Код", "4.4")
        Ф45 = Справочники.Функция.НайтиПоРеквизиту("Код", "4.5")
        СтрокаПар = ""
            + "4.1=Функция:Справочник;Проект:Справочник;Исполнитель:Справочник;ВидДеятельности:Справочник;Механизм:Справочник;ПрофильПользователя:Справочник;Подсистема:Справочник;СтатусПроекта:Перечисление;ТипФункции:Перечисление;СтатусФункции:Перечисление;ВидСвязи:Перечисление;ДеревоФункций:Отчёт;ФункцииВсего:Виджет;Моделирование:Подсистема;Заполнитьдемоданные:Модуль;ЗаполнитьДемоданные:Обработка"
            + "|4.2=ОбъектМетаданных:Справочник;Трассировка:РегистрСведений;ВерсииОбъектов:РегистрСведений;КонтрольОбъектов:РегистрСведений;СтатусОбъекта:Перечисление;СтатусКонтроля:Перечисление;ТипОбъектаМетаданных:Перечисление;ТрассировкаФункции:Отчёт;ПокрытиеФункций:Отчёт;ФункцииБезОбъектов:Виджет"
            + "|4.3=ПравилоПроверки:Справочник;ПубликацияПравила:Документ;ДействующиеПравила:РегистрСведений;РезультатыПроверки:РегистрСведений;ВажностьПравила:Перечисление;СтатусПубликации:Перечисление;ПубликацияПравила:Модуль;Аудит:Модуль;Аудитправил:Модуль;АудитПравил:Обработка;АудитПравил:РегламентноеЗадание;РезультатыАудита:Отчёт;НарушенияПравил:Виджет"
            + "|4.4=Задача:Документ;Комментарий:Документ;ОчередьЗадач:РегистрСведений;Очередь:Справочник;ИсторияСтатусовЗадач:РегистрСведений;УчётВремени:Документ;ЗатратыВремени:РегистрСведений;ПланыЗанятости:РегистрСведений;СтатусЗадачи:Перечисление;ТипЗадачи:Перечисление;Приоритет:Перечисление;Задача:Модуль;УчётВремени:Модуль;ТипСвязиЗадач:Перечисление;ПросроченныеЗадачи:Отчёт;ЗадачиПоИсполнителям:Отчёт;ЗадачиВРаботе:Виджет;ЗадачиПоСтатусам:Виджет;БыстрыеДействия:Виджет;Задачи:Подсистема;Планирование:Подсистема"
            + "|4.5=Проектировщик:Роль;Разработчик:Роль;Тестировщик:Роль;Руководитель:Роль;Роль:Справочник;Настройки:Подсистема";
        Наполнение.РасставитьПоСписку(СтрокаПар);
        Сообщить("Расстановка функций: пакеты Go, планы и документацию закрепляет проектировщик — описания `describe` их не видит.");
    Иначе
        Проект = Неопределено;
        Если НЕ ПустаяСтрока(ИмяПроекта) Тогда
            Проект = Наполнение.НайтиИлиСоздатьПроект(ИмяПроекта);
        КонецЕсли;
        Наполнение.РасставитьПоСписку(Пары, Проект);
        Сообщить("Расстановка функций по параметру «Пары».");
    КонецЕсли;
КонецПроцедуры
