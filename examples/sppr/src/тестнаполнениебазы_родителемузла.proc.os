// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/наполнение_базы.feature.
// Функция: Наполнение базы целевым проектом
// Сценарий: родителем узла дерева является функция с кодом родителя
// Шаг-таблица:
//   Дано заведён проект «Целевой проект»
//   Дано заведена функция с кодом «6»
//   Когда по списку узлов «6.1;Разбор;6;позиции;3» заведено дерево функций
//   То родителем функции с кодом «6.1» является функция с кодом «6»

Процедура Выполнить()
    // Дано заведён проект «Целевой проект»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Целевой проект"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «6»
    Ф = Справочники.Функция.Создать()
    Ф.Код = 6
    Ф.Наименование = "функция " + 6
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Когда по списку узлов «6.1;Разбор;6;позиции;3» заведено дерево функций
    Наполнение.ЗавестиДеревоИзСписка("6.1;Разбор;6;позиции;3", ПроектСсылка)
    // То родителем функции с кодом «6.1» является функция с кодом «6»
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Р.Код КАК Код ИЗ Справочник.Функция КАК Ф, Справочник.Функция КАК Р ГДЕ Ф.Код = &Код И Ф.parent_id = Р.Ссылка"
    З.УстановитьПараметр("Код", "6.1")
    КодРодителя = ""
    Для Каждого Стр Из З.Выполнить() Цикл
        КодРодителя = Стр.Код
    КонецЦикла
    Утверждать.Равно(КодРодителя, 6, "родителем функции с кодом «6.1» является функция с кодом «6»")
КонецПроцедуры
