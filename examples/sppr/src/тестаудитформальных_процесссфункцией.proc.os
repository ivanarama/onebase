// Тест скомпилирован onebase gherkin compile — правка руками рвёт связь с features/аудит_правил.feature.
// Функция: Аудит формальных правил
// Сценарий: процесс с шагом-функцией нарушения аудита не даёт
// Шаг-таблица:
//   Дано заведён проект «Каркас-аудит»
//   Дано заведена функция с кодом «11»
//   Дано заведён процесс «P2»
//   Когда шаг «Анализ» процесса «P2» закреплён за функцией с кодом «11»
//   Дано заведено правило аудита «А-93» стороны «База» с запросом «ВЫБРАТЬ 'Процесс' КАК ТипОбъект, П.Код КАК Объект, 'процесс без функций' КАК Информация ИЗ Справочник.Процесс КАК П ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Процесс.Шаги КАК Ш ПО Ш.Ссылка = П.Ссылка ГДЕ Ш.Ссылка ЕСТЬ ПУСТО»
//   Когда правило «А-93» опубликовано с важностью «Блокирующее»
//   Когда проведён аудит базы
//   То результатов правила «А-93» 0 строк

Процедура Выполнить()
    // Дано заведён проект «Каркас-аудит»
    Пр = Справочники.Проект.Создать()
    Пр.Наименование = "Каркас-аудит"
    ПроектСсылка = Пр.Записать()
    // Дано заведена функция с кодом «11»
    Ф = Справочники.Функция.Создать()
    Ф.Код = "11"
    Ф.Наименование = "функция " + "11"
    Ф.Проект = ПроектСсылка
    Ф.Статус = "Черновик"
    ФункцияСсылка = Ф.Записать()
    // Дано заведён процесс «P2»
    Прц = Справочники.Процесс.Создать()
    Прц.Код = "P2"
    Прц.Наименование = "процесс " + "P2"
    Прц.Триггер = "внешнее событие"
    Прц.Начало = "состояние начала"
    Прц.Завершение = "состояние завершения"
    Прц.Проект = ПроектСсылка
    ПроцессСсылка = Прц.Записать()
    // Когда шаг «Анализ» процесса «P2» закреплён за функцией с кодом «11»
    Прц = ПроцессСсылка.ПолучитьОбъект()
    Стр = Прц.Шаги.Добавить()
    Стр.Номер = Прц.Шаги.Количество() + 1
    Стр.Наименование = "Анализ"
    Стр.ТипШага = "Шаг"
    Стр.Функция = ФункцияСсылка
    Прц.Записать()
    // Дано заведено правило аудита «А-93» стороны «База»
    Пр = Справочники.ПравилоПроверки.Создать()
    Пр.Код = "А-93"
    Пр.Наименование = "правило " + "А-93"
    Пр.СторонаПроверки = "База"
    Пр.ТекстЗапроса = "ВЫБРАТЬ 'Процесс' КАК ТипОбъект, П.Код КАК Объект, 'процесс без функций' КАК Информация ИЗ Справочник.Процесс КАК П ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Процесс.Шаги КАК Ш ПО Ш.Ссылка = П.Ссылка ГДЕ Ш.Ссылка ЕСТЬ ПУСТО"
    Пр.Активно = Истина
    ПравилоСсылка = Пр.Записать()
    // Когда правило «А-93» опубликовано с важностью «Блокирующее»
    Док = Документы.ПубликацияПравила.Создать()
    Док.Дата = ТекущаяДата()
    Док.Правило = ПравилоСсылка
    Док.Важность = "Блокирующее"
    Док.Текст = "публикация " + "А-93"
    Док.Статус = "Опубликовано"
    Док.Записать()
    Док.Провести()
    // Когда проведён аудит базы
    Аудит.ПрименитьПравила(ТекущаяДата())
    // То результатов правила «А-93» 0 строк
    З = Новый Запрос
    З.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ РегистрСведений.РезультатыПроверки.СрезПоследних(&Д) КАК Р ГДЕ Р.Правило.Код = &Код"
    З.УстановитьПараметр("Д", ТекущаяДата() + 86400 * 30)
    З.УстановитьПараметр("Код", "А-93")
    Н = 0
    Для Каждого Стр Из З.Выполнить() Цикл
        Н = Стр.Н
    КонецЦикла
    Утверждать.Равно(Н, 0, "результатов правила «А-93» 0 строк")
КонецПроцедуры
