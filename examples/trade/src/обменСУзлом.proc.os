// Демонстрация очереди фоновых заданий (план 130): одно задание, много задач,
// каждая со своим узлом. Из очереди задачи разбираются параллельно — столько
// сразу, сколько исполнителей в пуле (queue.workers в config/app.yaml).
//
// Обмена здесь нет: обработка изображает сеанс паузой, чтобы в мониторе очереди
// было видно, как задачи расходятся по исполнителям.
Процедура Выполнить(Узел = "")
  Если Узел = "" Тогда
    Сообщить("Узел не задан — задача поставлена без параметра Узел");
    Возврат;
  КонецЕсли;

  Сообщить("Обмен с узлом " + Узел + ": начат");
  Приостановить(2);
  Сообщить("Обмен с узлом " + Узел + ": завершён");
КонецПроцедуры
