// Обработчики формы «Заказ покупателя».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Статус) Тогда
        Объект.Статус = "Новый";
    КонецЕсли;
КонецПроцедуры

// Обработчик колонки «Количество» табличной части: срабатывает на правку
// именно этой ячейки. Доступны ИмяТабличнойЧасти, НомерСтроки,
// ТекущаяКолонка и сама строка в ТекущаяСтрока.
//
// Резерв заполняется подсказкой, а не жёстко: зарезервировать часть заказа —
// обычное дело, поэтому уже введённое пользователем значение не перетирается.
// @directive=&НаСервере
Процедура КоличествоПриИзменении()
    Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Резерв) Тогда
        ТекущаяСтрока.Резерв = ТекущаяСтрока.Количество;
    ИначеЕсли ТекущаяСтрока.Резерв > ТекущаяСтрока.Количество Тогда
        ТекущаяСтрока.Резерв = ТекущаяСтрока.Количество;
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте товары");
    КонецЕсли;
    // Пересчёт суммы
    Итог = 0;
    Для Каждого Стр Из Объект.Товары Цикл
        Стр.Сумма = Стр.Количество * Стр.Цена;
        Итог = Итог + Стр.Сумма;
    КонецЦикла;
    Объект.Сумма = Итог;
КонецПроцедуры
