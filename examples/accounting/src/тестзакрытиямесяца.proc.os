// Закрытие месяца обнуляет субсчета 90, переносит финансовый результат на 99 и
// не удваивает его при перепроведении. Запуск:
//   onebase test --project examples/accounting --sqlite :memory: --run ЗакрытияМесяца

Процедура Выполнить()
    Покупатель = Справочники.Контрагент.Создать();
    Покупатель.Наименование = "ООО Покупатель";
    СсылкаПокупателя = Покупатель.Записать();

    Товар = Справочники.Номенклатура.Создать();
    Товар.Наименование = "Стол";
    СсылкаТовара = Товар.Записать();

    // Выручка 1000 (Кт 90.1), себестоимость 600 (Дт 90.2), НДС 200 (Дт 90.3):
    // прибыль 200.
    Реализация = Документы.РеализацияТоваров.Создать();
    Реализация.Дата = Дата(2026, 3, 15);
    Реализация.Покупатель = СсылкаПокупателя;
    Стр = Реализация.Товары.Добавить();
    Стр.Номенклатура = СсылкаТовара;
    Стр.Количество = 1;
    Стр.Сумма = 1000;
    Стр.Себестоимость = 600;
    Стр.НДС = 200;
    Реализация.Провести();

    Закрытие = Документы.ЗакрытиеМесяца.Создать();
    Закрытие.Дата = Дата(2026, 3, 31, 23, 59, 59);
    Закрытие.Провести();
    ПроверитьСальдо("после закрытия");

    // Перепроведение закрытия: переносы не удваиваются.
    Закрытие.Провести();
    ПроверитьСальдо("после перепроведения закрытия");
КонецПроцедуры

Процедура ПроверитьСальдо(Когда)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Счёт, СУММА(СуммаОстаток) КАК Сальдо
        ИЗ РегистрБухгалтерии.БухУчёт.Остатки()
        СГРУППИРОВАТЬ ПО Счёт";
    Сальдо = Новый Соответствие;
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Сальдо.Вставить(Стр.Счёт, Стр.Сальдо);
    КонецЦикла;

    Утверждать.Равно(Сальдо.Получить("90.1"), 0, "выручка 90.1 закрыта " + Когда);
    Утверждать.Равно(Сальдо.Получить("90.2"), 0, "себестоимость 90.2 закрыта " + Когда);
    Утверждать.Равно(Сальдо.Получить("90.3"), 0, "НДС 90.3 закрыт " + Когда);
    Утверждать.Равно(Сальдо.Получить("90.9"), 0, "90.9 закрыт на 99 " + Когда);
    // Сальдо считается как Дт − Кт: прибыль 200 — кредитовое сальдо 99.
    Утверждать.Равно(Сальдо.Получить("99"), -200, "прибыль 200 на кредите 99 " + Когда);
КонецПроцедуры
