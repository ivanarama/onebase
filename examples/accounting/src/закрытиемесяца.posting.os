// Закрытие месяца: сальдо субсчетов 90 переносится на 90.9, результат 90.9 — на 99.
//   Кредитовое сальдо (выручка 90.1):               Дт 90.1 — Кт 90.9
//   Дебетовое сальдо (себестоимость 90.2, НДС 90.3): Дт 90.9 — Кт 90.2 / 90.3
//   Прибыль (кредитовое сальдо 90.9):               Дт 90.9 — Кт 99
//   Убыток (дебетовое сальдо 90.9):                 Дт 99   — Кт 90.9
//
// Берётся сальдо на момент документа, а не обороты за всё время: при
// перепроведении собственные прежние проводки закрытия в него не попадают, и
// закрытие не удваивается. Сальдо сворачивается по счёту — аналитика субконто
// в примере не закрывается.
Процедура ОбработкаПроведения()
  Движения.БухУчёт.Очистить();

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Счёт, СУММА(СуммаОстаток) КАК Сальдо
    ИЗ РегистрБухгалтерии.БухУчёт.Остатки(&МоментВремени)
    ГДЕ Счёт = '90.1' ИЛИ Счёт = '90.2' ИЛИ Счёт = '90.3' ИЛИ Счёт = '90.9'
    СГРУППИРОВАТЬ ПО Счёт";
  Запрос.УстановитьПараметр("МоментВремени", this.МоментВремени());

  // Сальдо 90.9 после переноса (Дт − Кт): его собственное сальдо плюс
  // перенесённые сальдо субсчетов.
  Результат = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Результат = Результат + Стр.Сальдо;
    Если Стр.Счёт = "90.9" ИЛИ Стр.Сальдо = 0 Тогда
      Продолжить;
    КонецЕсли;
    Дв = Движения.БухУчёт.Добавить();
    Дв.Период = this.Дата;
    Дв.Сумма  = Абс(Стр.Сальдо);
    Если Стр.Сальдо < 0 Тогда
      // Кредитовое сальдо закрывается дебетом субсчёта.
      Дв.СчётДт = Стр.Счёт;
      Дв.СчётКт = "90.9";
    Иначе
      // Дебетовое сальдо закрывается кредитом субсчёта.
      Дв.СчётДт = "90.9";
      Дв.СчётКт = Стр.Счёт;
    КонецЕсли;
  КонецЦикла;

  // Финансовый результат: кредитовое сальдо 90.9 — прибыль, дебетовое — убыток.
  Если Результат <> 0 Тогда
    Дв = Движения.БухУчёт.Добавить();
    Дв.Период = this.Дата;
    Дв.Сумма  = Абс(Результат);
    Если Результат < 0 Тогда
      Дв.СчётДт = "90.9";
      Дв.СчётКт = "99";
    Иначе
      Дв.СчётДт = "99";
      Дв.СчётКт = "90.9";
    КонецЕсли;
  КонецЕсли;
КонецПроцедуры
